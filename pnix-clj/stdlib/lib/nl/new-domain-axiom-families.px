  # =================================================================
  # === 7. ML =======================================================
  # =================================================================

  mlAxiomTree = bt.composeBranchTree "ml axiom" [
    {
      name = "data-preparation";
      cues = [ "dataset" "data prep" "feature engineering" "데이터 준비" ];
      sub_specs = [
        { name = "train-test-split"; cues = [ "split" ]; terminal = true; }
        { name = "feature-engineering"; cues = [ "feature" "특성 공학" ]; terminal = true; }
        { name = "data-augmentation"; cues = [ "augmentation" "증강" ]; terminal = true; }
      ];
    }
    {
      name = "model-architecture";
      cues = [ "architecture" "neural net" "transformer" "CNN" "RNN" "모델 아키텍처" ];
      sub_specs = [
        { name = "transformer"; cues = [ "transformer" "attention" ]; terminal = true; }
        { name = "cnn"; cues = [ "CNN" "convolutional" ]; terminal = true; }
        { name = "rnn-lstm"; cues = [ "RNN" "LSTM" "GRU" ]; terminal = true; }
        { name = "tree-ensemble"; cues = [ "xgboost" "random forest" "GBM" ]; terminal = true; }
      ];
    }
    {
      name = "training";
      cues = [ "training" "optimizer" "SGD" "Adam" "훈련" ];
      sub_specs = [
        { name = "optimizer-choice"; cues = [ "optimizer" "Adam" "SGD" ]; terminal = true; }
        { name = "learning-rate-schedule"; cues = [ "learning rate" "schedule" ]; terminal = true; }
        { name = "regularization"; cues = [ "dropout" "L2" "정규화" ]; terminal = true; }
      ];
    }
    {
      name = "evaluation";
      cues = [ "evaluation" "metrics" "accuracy" "precision" "recall" "평가" ];
      sub_specs = [
        { name = "classification-metrics"; cues = [ "precision" "recall" "F1" ]; terminal = true; }
        { name = "regression-metrics"; cues = [ "MSE" "MAE" "R2" ]; terminal = true; }
        { name = "ranking-metrics"; cues = [ "NDCG" "MAP" "MRR" ]; terminal = true; }
        { name = "cross-validation"; cues = [ "cross validation" "k-fold" ]; terminal = true; }
      ];
    }
    {
      name = "deployment-and-monitoring";
      cues = [ "model serving" "inference" "model registry" "모델 배포" ];
      sub_specs = [
        { name = "online-inference"; cues = [ "online" "real time" ]; terminal = true; }
        { name = "batch-inference"; cues = [ "batch inference" ]; terminal = true; }
        { name = "drift-detection"; cues = [ "drift" "data drift" "model drift" ]; terminal = true; }
        { name = "a-b-experimentation"; cues = [ "A/B" "experiment" ]; terminal = true; }
      ];
    }
    # === sub-tree 정밀화 (#150) ─────────────────────────────────
    {
      name = "mlops";
      cues = [ "MLOps" "model registry" "model versioning" ];
      sub_specs = [
        { name = "model-versioning"; cues = [ "model version" ]; terminal = true; }
        { name = "ci-for-models"; cues = [ "CI/CD for models" "ml pipeline" ]; terminal = true; }
        { name = "auto-retraining"; cues = [ "retrain" "auto-retrain" ]; terminal = true; }
      ];
    }
    {
      name = "feature-store";
      cues = [ "feature store" "feast" "tecton" "피처 스토어" ];
      sub_specs = [
        { name = "online-store"; cues = [ "online store" ]; terminal = true; }
        { name = "offline-store"; cues = [ "offline store" ]; terminal = true; }
        { name = "feature-versioning"; cues = [ "feature version" ]; terminal = true; }
      ];
    }
    {
      name = "explainability";
      cues = [ "explainable" "interpretability" "SHAP" "LIME" "설명 가능" ];
      sub_specs = [
        { name = "shap-values"; cues = [ "SHAP" ]; terminal = true; }
        { name = "lime-explanation"; cues = [ "LIME" ]; terminal = true; }
        { name = "attention-visualization"; cues = [ "attention viz" ]; terminal = true; }
      ];
    }
    {
      name = "responsible-ai";
      cues = [ "responsible AI" "fairness" "bias" "공정성" ];
      sub_specs = [
        { name = "fairness-metrics"; cues = [ "fairness" "demographic parity" ]; terminal = true; }
        { name = "bias-audit"; cues = [ "bias audit" "편향 감사" ]; terminal = true; }
        { name = "privacy-preserving"; cues = [ "differential privacy" "federated learning" ]; terminal = true; }
      ];
    }
  ];

  # =================================================================
  # === Registry of 7 new-domain families ==========================
  # =================================================================

  knownAxioms = [
    {
      axiom_id = "axiom-security-001"; name = "security"; domain = "new-domain";
      activation_cues = [ "security" "auth" "OAuth" "encryption" "XSS" "SQL injection" "audit" "vault" "GDPR" "STRIDE" "threat model" "SBOM" "supply chain" "보안" "인증" "암호화" "감사" "권한" "위협 모델" "공급망" ];
      tree = securityAxiomTree;
      sub_count = builtins.length securityAxiomTree.branches;
      tool_role = "보안 + auth + crypto + audit";
    }
    {
      axiom_id = "axiom-database-001"; name = "database"; domain = "new-domain";
      activation_cues = [ "database" "schema" "migration" "index" "transaction" "sharding" "ACID" "MVCC" "replication" "failover" "backup" "restore" "PITR" "CDC" "change data capture" "debezium" "데이터베이스" "스키마" "마이그레이션" "트랜잭션" "샤딩" "복제" "백업" ];
      tree = databaseAxiomTree;
      sub_count = builtins.length databaseAxiomTree.branches;
      tool_role = "DB schema + index + tx + scaling";
    }
    {
      axiom_id = "axiom-api-design-001"; name = "api-design"; domain = "new-domain";
      activation_cues = [ "REST" "gRPC" "GraphQL" "API version" "pagination" "rate limit" "HATEOAS" "API key" "bearer token" "mTLS" "RFC 7807" "problem json" "idempotency key" "API 버전" "API 디자인" "RPC" ];
      tree = apiDesignAxiomTree;
      sub_count = builtins.length apiDesignAxiomTree.branches;
      tool_role = "API surface design";
    }
    {
      axiom_id = "axiom-frontend-001"; name = "frontend"; domain = "new-domain";
      activation_cues = [ "frontend" "component" "react" "vue" "svelte" "state management" "a11y" "aria" "i18n" "rendering" "CSS" "tailwind" "styled-components" "webpack" "vite" "tree shaking" "code splitting" "playwright" "cypress" "storybook" "프론트엔드" "컴포넌트" "접근성" "스타일링" "번들링" ];
      tree = frontendAxiomTree;
      sub_count = builtins.length frontendAxiomTree.branches;
      tool_role = "UI component + state + a11y + i18n";
    }
    {
      axiom_id = "axiom-data-pipeline-001"; name = "data-pipeline"; domain = "new-domain";
      activation_cues = [ "ETL" "ELT" "data pipeline" "CDC" "Airflow" "Dagster" "Prefect" "data quality" "lineage" "DAG" "backfill" "Kafka" "Kinesis" "Flink" "exactly once" "watermark" "data contract" "data catalog" "schema registry" "partition" "데이터 파이프라인" "데이터 품질" "계보" "스트리밍" "거버넌스" "파티션" ];
      tree = dataPipelineAxiomTree;
      sub_count = builtins.length dataPipelineAxiomTree.branches;
      tool_role = "extract + transform + load + orchestrate";
    }
    {
      axiom_id = "axiom-devops-001"; name = "devops"; domain = "new-domain";
      activation_cues = [ "docker" "kubernetes" "terraform" "helm" "CI" "CD" "monitoring" "alert" "prometheus" "service mesh" "istio" "linkerd" "envoy" "incident" "postmortem" "runbook" "oncall" "sidecar" "도커" "쿠버네티스" "테라폼" "모니터링" "서비스 메시" "사후 분석" ];
      tree = devopsAxiomTree;
      sub_count = builtins.length devopsAxiomTree.branches;
      tool_role = "container + k8s + IaC + CI/CD + monitoring";
    }
    {
      axiom_id = "axiom-ml-001"; name = "ml"; domain = "new-domain";
      activation_cues = [ "ML" "machine learning" "model" "training" "inference" "feature" "transformer" "CNN" "LSTM" "drift" "cross validation" "k-fold" "MLOps" "model registry" "model versioning" "feature store" "feast" "tecton" "SHAP" "LIME" "interpretability" "explainable" "fairness" "bias" "differential privacy" "데이터셋" "모델" "훈련" "공정성" "설명 가능" "피처 스토어" ];
      tree = mlAxiomTree;
      sub_count = builtins.length mlAxiomTree.branches;
      tool_role = "data + model + training + eval + serve";
    }
  ];

  # === Activation ==================================================

  axiomsActivatedBy = utterance:
    if !(builtins.isString utterance) then []
    else
      builtins.filter (ax:
        decomposer.containsAny utterance ax.activation_cues
      ) knownAxioms;

  compositeTreeFromActivations = activations:
    if activations == [] then null
    else if builtins.length activations == 1 then
      (builtins.head activations).tree
    else
      bt.mkTree {
        node_label = "multiple new-domain axioms activated";
        branches = builtins.map (ax: bt.mkBranch {
          name = ax.name;
          hypothesis = "apply " + ax.name + " axiom";
          cues = ax.activation_cues;
          sub_branches = ax.tree.branches;
        }) activations;
      };

  applyNewDomainAxiomPlate = request:
    if !(builtins.isAttrs request) then { outcome = "held-non-attrs-request"; }
    else if builtins.hasAttr "list_axioms" request then {
      outcome = "axioms-listed";
      public = {
        axiom_count = builtins.length knownAxioms;
        axiom_names = builtins.map (ax: ax.name) knownAxioms;
        total_branches = builtins.foldl' (acc: ax:
          acc + ax.sub_count) 0 knownAxioms;
      };
      carry = { axioms = knownAxioms; };
    }
    else if builtins.hasAttr "activate_for" request then
      let
        activations = axiomsActivatedBy request.activate_for;
        composite = compositeTreeFromActivations activations;
      in {
        outcome =
          if activations == [] then "no-axiom-activated"
          else if builtins.length activations == 1 then "single-axiom-activated"
          else "multiple-axioms-activated";
        public = {
          utterance = request.activate_for;
          activated_count = builtins.length activations;
          activated_names = builtins.map (ax: ax.name) activations;
        };
        carry = {
          activations = activations;
          composite_tree = composite;
        };
      }
    else { outcome = "held-missing-input-field"; };

  inventorySummary = _: {
    owner = ownerName;
    axiom_class = "nl-new-domain-axiom-families-126";
    composes = "axiom-98-tree (data on generic substrate)";
    inherit framework_step;
    step_kind = stepKind;
    bilingual = true;
    family_count = 7;
    families = [
      "security (authn-authz / input-validation / injection-prevention / crypto / audit)"
      "database (schema / index / transaction / scalability / query-opt)"
      "api-design (REST / versioning / RPC / rate-limit / pagination)"
      "frontend (component / state / rendering / a11y / i18n)"
      "data-pipeline (extract / transform / load / quality / orchestration)"
      "devops (container / k8s / IaC / CI/CD / monitoring)"
      "ml (data-prep / architecture / training / evaluation / deployment)"
    ];
    total_axioms = builtins.length knownAxioms;
    total_top_branches = builtins.foldl' (acc: ax:
      acc + ax.sub_count) 0 knownAxioms;
  };

in {
  inherit ownerName
    securityAxiomTree databaseAxiomTree apiDesignAxiomTree
    frontendAxiomTree dataPipelineAxiomTree devopsAxiomTree mlAxiomTree
    knownAxioms axiomsActivatedBy compositeTreeFromActivations
    applyNewDomainAxiomPlate
    stepKind framework_step inventorySummary;
  meta = {
    source = "stdlib NL new-domain axiom families (agent-NL-142..148)";
    owner = ownerName;
  };
}
