      cues = [ "API auth" "API key" "bearer token" "API 인증" ];
      sub_specs = [
        { name = "api-key"; cues = [ "API key" ]; terminal = true; }
        { name = "bearer-token"; cues = [ "bearer" ]; terminal = true; }
        { name = "mtls"; cues = [ "mTLS" "mutual TLS" ]; terminal = true; }
        { name = "oauth-flows"; cues = [ "OAuth" ]; terminal = true; }
