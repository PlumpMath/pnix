    }
    {
      name = "api-error-handling";
      cues = [ "error response" "problem details" "RFC 7807" ];
      sub_specs = [
        { name = "http-status-codes"; cues = [ "status code" "4xx" "5xx" ]; terminal = true; }
        { name = "problem-json"; cues = [ "problem json" "RFC 7807" ]; terminal = true; }
        { name = "idempotency-keys"; cues = [ "idempotency key" ]; terminal = true; }
      ];
    }
  ];

