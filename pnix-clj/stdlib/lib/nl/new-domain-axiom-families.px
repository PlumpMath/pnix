    {
      name = "pagination-and-filtering";
      cues = [ "pagination" "cursor" "offset" "filter" "페이지네이션" ];
      sub_specs = [
        { name = "cursor-based"; cues = [ "cursor" ]; terminal = true; }
        { name = "offset-based"; cues = [ "offset" "page" ]; terminal = true; }
        { name = "keyset-pagination"; cues = [ "keyset" ]; terminal = true; }
      ];
    }
    # === sub-tree 정밀화 (#150) ─────────────────────────────────
    {
