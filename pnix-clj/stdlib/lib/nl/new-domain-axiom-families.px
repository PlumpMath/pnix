    {
      name = "rpc-styles";
      cues = [ "gRPC" "GraphQL" "JSON-RPC" "RPC" ];
      sub_specs = [
        { name = "grpc-proto"; cues = [ "gRPC" "protobuf" ]; terminal = true; }
        { name = "graphql-schema"; cues = [ "GraphQL" "SDL" ]; terminal = true; }
