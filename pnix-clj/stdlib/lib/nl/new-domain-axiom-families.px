let
  ownerName = "stdlib.nl.new-domain-axiom-families";

  bt = import nl/branch-tree-substrate.px;
  decomposer = import nl/sentence-decomposition-substrate.px;

  # === 7 New-Domain Axiom Families (agent-NL-142..148) ===========
  #
  # 박힌 14 axiom family 의 패턴 그대로 — 5 sub-family × ~4 top
  # branches per family. 통합 owner 로 효율.
  #
  # Families:
  #   1. security
  #   2. database
  #   3. api-design
  #   4. frontend
  #   5. data-pipeline
  #   6. devops
  #   7. ml

  stepKind = "new-domain-axiom-data";
  framework_step = "axiom content — 7 미박힘 도메인 family";

  # =================================================================
  # === 1. Security =================================================
  # =================================================================

  securityAxiomTree = bt.composeBranchTree "security axiom" [
    {
      name = "authn-authz";
      cues = [ "authentication" "authorization" "auth" "OAuth" "JWT" "인증" "권한" ];
      sub_specs = [
        { name = "oauth-flow"; cues = [ "OAuth" "OIDC" ]; terminal = true; }
        { name = "jwt-tokens"; cues = [ "JWT" "token" ]; terminal = true; }
        { name = "rbac"; cues = [ "RBAC" "role" "역할" ]; terminal = true; }
        { name = "abac"; cues = [ "ABAC" "attribute" ]; terminal = true; }
      ];
    }
    {
      name = "input-validation";
      cues = [ "sanitize" "validate input" "input validation" "입력 검증" ];
      sub_specs = [
        { name = "whitelist-pattern"; cues = [ "whitelist" "allowlist" ]; terminal = true; }
        { name = "blacklist-pattern"; cues = [ "blacklist" "denylist" ]; terminal = true; }
        { name = "schema-based"; cues = [ "schema" "스키마" ]; terminal = true; }
      ];
    }
    {
      name = "injection-prevention";
      cues = [ "XSS" "SQL injection" "command injection" "주입" ];
      sub_specs = [
        { name = "xss-output-escape"; cues = [ "XSS" "escape" ]; terminal = true; }
        { name = "sqli-parameterized"; cues = [ "SQL injection" "parameterize" ]; terminal = true; }
        { name = "csrf-token"; cues = [ "CSRF" ]; terminal = true; }
      ];
    }
    {
      name = "crypto-and-secrets";
      cues = [ "encryption" "crypto" "secrets" "vault" "암호화" "비밀" ];
      sub_specs = [
        { name = "at-rest"; cues = [ "at rest" ]; terminal = true; }
        { name = "in-transit"; cues = [ "TLS" "in transit" ]; terminal = true; }
        { name = "key-rotation"; cues = [ "rotate" "rotation" ]; terminal = true; }
        { name = "secret-vault"; cues = [ "vault" "HSM" ]; terminal = true; }
      ];
    }
    {
      name = "audit-and-compliance";
      cues = [ "audit log" "compliance" "GDPR" "SOC2" "감사 로그" ];
      sub_specs = [
        { name = "tamper-evident"; cues = [ "tamper" ]; terminal = true; }
        { name = "retention-policy"; cues = [ "retention" "보존" ]; terminal = true; }
        { name = "privacy-policy"; cues = [ "PII" "GDPR" "개인정보" ]; terminal = true; }
      ];
    }
    # === sub-tree 정밀화 (#150) ─────────────────────────────────
    {
      name = "threat-modeling";
      cues = [ "threat model" "STRIDE" "attack tree" "위협 모델" ];
      sub_specs = [
        { name = "spoofing"; cues = [ "spoof" ]; terminal = true; }
        { name = "tampering"; cues = [ "tampering" ]; terminal = true; }
        { name = "repudiation"; cues = [ "repudiation" ]; terminal = true; }
        { name = "info-disclosure"; cues = [ "info disclosure" "information leak" ]; terminal = true; }
        { name = "denial-of-service"; cues = [ "DoS" "denial of service" ]; terminal = true; }
        { name = "elevation-of-privilege"; cues = [ "privilege escalation" ]; terminal = true; }
      ];
    }
    {
      name = "supply-chain";
      cues = [ "supply chain" "SBOM" "package signing" "공급망" ];
      sub_specs = [
        { name = "dep-pinning"; cues = [ "pin" ]; terminal = true; }
        { name = "package-signing"; cues = [ "sign package" "sigstore" ]; terminal = true; }
        { name = "sbom-generation"; cues = [ "SBOM" ]; terminal = true; }
        { name = "vuln-scanning"; cues = [ "vuln scan" "snyk" "dependabot" ]; terminal = true; }
      ];
    }
  ];

  # =================================================================
  # === 2. Database =================================================
  # =================================================================

  databaseAxiomTree = bt.composeBranchTree "database axiom" [
    {
      name = "schema-management";
      cues = [ "schema" "migration" "DDL" "스키마" "마이그레이션" ];
      sub_specs = [
        { name = "forward-migration"; cues = [ "up" "forward" ]; terminal = true; }
        { name = "rollback-migration"; cues = [ "down" "rollback" ]; terminal = true; }
        { name = "online-schema-change"; cues = [ "online" "zero downtime" ]; terminal = true; }
      ];
    }
    {
      name = "indexing-strategy";
      cues = [ "index" "btree" "hash index" "인덱스" ];
      sub_specs = [
        { name = "btree-index"; cues = [ "btree" "b-tree" ]; terminal = true; }
        { name = "hash-index"; cues = [ "hash" ]; terminal = true; }
        { name = "gin-gist"; cues = [ "GIN" "GiST" "full text" ]; terminal = true; }
        { name = "composite-index"; cues = [ "composite" "multi-column" ]; terminal = true; }
      ];
    }
    {
      name = "transactional-semantics";
      cues = [ "transaction" "ACID" "isolation" "트랜잭션" ];
      sub_specs = [
        { name = "read-committed"; cues = [ "read committed" ]; terminal = true; }
        { name = "repeatable-read"; cues = [ "repeatable read" ]; terminal = true; }
        { name = "serializable"; cues = [ "serializable" ]; terminal = true; }
        { name = "mvcc"; cues = [ "MVCC" ]; terminal = true; }
      ];
    }
    {
      name = "scalability";
      cues = [ "sharding" "partition" "replication" "샤딩" "복제" ];
      sub_specs = [
        { name = "horizontal-shard"; cues = [ "shard" ]; terminal = true; }
        { name = "partition-by-range"; cues = [ "range partition" ]; terminal = true; }
        { name = "read-replicas"; cues = [ "read replica" "복제본" ]; terminal = true; }
      ];
    }
    {
      name = "query-optimization";
      cues = [ "EXPLAIN" "query plan" "denormalize" "쿼리 계획" ];
      sub_specs = [
        { name = "use-index"; cues = []; terminal = true; }
        { name = "join-order"; cues = [ "join" ]; terminal = true; }
        { name = "materialized-view"; cues = [ "materialized" ]; terminal = true; }
      ];
    }
    # === sub-tree 정밀화 (#150) ─────────────────────────────────
    {
      name = "replication-and-ha";
      cues = [ "replication" "high availability" "failover" "복제" "고가용성" ];
      sub_specs = [
        { name = "primary-replica"; cues = [ "primary" "leader" ]; terminal = true; }
        { name = "multi-master"; cues = [ "multi master" "multi-primary" ]; terminal = true; }
        { name = "synchronous-vs-async"; cues = [ "sync replication" "async replication" ]; terminal = true; }
        { name = "automatic-failover"; cues = [ "failover" "자동 failover" ]; terminal = true; }
      ];
    }
    {
      name = "backup-recovery";
      cues = [ "backup" "restore" "PITR" "point in time" "백업" "복구" ];
      sub_specs = [
        { name = "full-backup"; cues = [ "full backup" ]; terminal = true; }
        { name = "incremental-backup"; cues = [ "incremental" ]; terminal = true; }
        { name = "wal-archiving"; cues = [ "WAL" "transaction log" ]; terminal = true; }
        { name = "disaster-recovery"; cues = [ "DR" "disaster recovery" "재해 복구" ]; terminal = true; }
      ];
    }
    {
      name = "cdc-and-streaming";
      cues = [ "CDC" "change data capture" "debezium" "outbox" ];
      sub_specs = [
        { name = "log-based-cdc"; cues = [ "log-based" "WAL CDC" ]; terminal = true; }
        { name = "trigger-based-cdc"; cues = [ "trigger" ]; terminal = true; }
        { name = "outbox-pattern"; cues = [ "outbox" ]; terminal = true; }
      ];
    }
  ];

  # =================================================================
  # === 3. API Design ===============================================
  # =================================================================

  apiDesignAxiomTree = bt.composeBranchTree "api-design axiom" [
    {
      name = "rest-design";
      cues = [ "REST" "RESTful" "resource oriented" "리소스 지향" ];
      sub_specs = [
        { name = "resource-naming"; cues = []; terminal = true; }
        { name = "http-verbs"; cues = [ "GET" "POST" "PUT" "DELETE" ]; terminal = true; }
        { name = "hateoas"; cues = [ "HATEOAS" "hypermedia" ]; terminal = true; }
      ];
    }
    {
      name = "versioning";
      cues = [ "API version" "v1" "v2" "API 버전" ];
      sub_specs = [
        { name = "url-versioning"; cues = [ "/v1/" "/v2/" "url version" ]; terminal = true; }
        { name = "header-versioning"; cues = [ "Accept" "X-API-Version" ]; terminal = true; }
        { name = "media-type-versioning"; cues = [ "media type" ]; terminal = true; }
