let
  ownerName = "stdlib.nl.category-substrate-k-theory";

  motivic = import nl/category-motivic-substrate.px;
  Gmot = import nl/category-motivic-galois-substrate.px;

  # === Substrate K-theory (agent-NL-187) ============================
  #
  # 사용자 directive (2026-05-29):
  # > "Substrate K-theory (Beilinson regulator 의 source K-theory)"
  #
  # 표준 K-theory:
  #   K_0(X) = Grothendieck group of vector bundles / coherent sheaves
  #   K_n(X) = higher Quillen K-theory (homotopy of K-theory space)
  #
  # substrate 해석:
  #   K_0(Site_coding) = receipts modulo additive equivalence
  #     (Grothendieck group of receipt-classes)
  #   K_1, K_2, ... = higher receipt cohomology classes
  #   Beilinson regulator: K_n → H^{n,*}_M motivic cohomology
  #
  # K-theory 가 substrate 의 deepest invariant — 모든 substrate
  # 의 효과 (sum, difference, cancellation) 가 capture.

  stepKind = "substrate-k-theory";
  framework_step =
    "K_*(Site_coding) — receipt Grothendieck group + higher K-classes";

  # =================================================================
  # === K_0 Grothendieck group =====================================
  # =================================================================

  k0Group = {
    group_id = "K_0(Site_coding)";
    definition_en = ''
      K_0(Site_coding) = Grothendieck group of receipt-bundles on
      Site_coding.

      Construction:
        Free abelian group on isomorphism classes of receipt-bundles
        / relations [B] + [C] = [A] for short exact sequences
          0 → C → A → B → 0

      Substrate-side:
        - Receipt-bundle = a collection of receipts coherently attached
          to each open of Site_coding (a sheaf of receipts)
        - K_0-class [r] of a single receipt r = its image in K_0
        - K_0 sums = combining receipts additively
        - K_0 differences = receipt cancellations
    '';
    rank_function = "rk : K_0 → Z (dimension of underlying vector space)";
    determinant_function = "det : K_0 → Pic (top exterior power)";
    chern_character = "ch : K_0 → H^{ev}_M(Site_coding, Q) (Chern character to motivic cohomology)";
  };

  # =================================================================
  # === Higher K-theory K_n for n >= 1 ==============================
  # =================================================================

  higherK = [
    {
      degree = 1;
      name = "K_1(Site_coding)";
      meaning_en = ''
        K_1 = GL(receipt-bundles) / commutator subgroup.
        Substrate: K_1 captures "automorphisms of receipt-bundles
        modulo elementary equivalences". Operationally: how receipts
        can be transformed by reversible substrate operations.
      '';
      classical_examples = [
        "K_1(field) = field^x (units)"
        "K_1(Z) = {±1}"
      ];
      substrate_example = "K_1(Site_coding) captures invertible receipt-transformations modulo elementary equivalences";
    }
    {
      degree = 2;
      name = "K_2(Site_coding)";
      meaning_en = ''
        K_2 = Milnor K-theory / additional Steinberg relations.
        Operationally measures "two-step receipt-cancellations" —
        combinations that vanish only after two-fold cancellation.
      '';
      relates_to_Steinberg = "K_2 generated by symbols {a, b} with Steinberg relations";
      substrate_example = "K_2 detects receipt-pairs that mutually cancel at higher depth than K_1 catches";
    }
    {
      degree = "n >= 3";
      name = "K_n(Site_coding)";
      meaning_en = ''
        Higher K-theory K_n = pi_n(K-theory spectrum).
        General homotopical refinement of K_0/K_1/K_2.
        Substrate: K_n captures n-step receipt-coherence —
        receipts that cancel only after n-fold composition.
      '';
      relates_to_motivic_cohomology = ''
        Beilinson-Soulé conjecture:
          K_{2q-p}(X) ⊗ Q ≅ H^{p,q}_M(X, Q)
        That is, K-theory tensored with Q recovers rational motivic
        cohomology.
      '';
    }
  ];

  # =================================================================
  # === Beilinson regulator =========================================
  # =================================================================
  #
  # Beilinson regulator: K_n(X) → H^*_D(X, Z(*)) (Deligne cohomology)
  # Factors through motivic cohomology:
  #   K_n(X) → H^{n,*}_M(X, Z) → H^*_D(X, Z(*))

  beilinsonRegulator = {
    regulator_id = "Beilinson-regulator-substrate";
    direction = "K_n(Site_coding) → H^{n, *}_M(Site_coding, Z)";
    factor_through_motivic_cohomology = true;
    substrate_meaning_en = ''
      Beilinson regulator maps K-theory classes (receipt-equivalence
      classes) to motivic cohomology classes. This is the
      *cohomological realization* of receipt arithmetic.

      Conjecturally (Beilinson's conjectures), the regulator's
      cokernel is finite, and its image computes special L-values.

      In substrate: receipt sum/cancellation classes have
      L-values = weighted invariants summarizing all substrate
      symmetries acting.
    '';
    relates_to_L_values = ''
      Beilinson conjectures relate K-theory + regulator to special
      values of L-functions L(s, ...). Substrate analog: receipt-
      classes have substrate-L-values = weighted invariants tracking
      G_pnix-action, Galois twist, Tate weight.
    '';
  };

  # =================================================================
  # === Localization sequence =======================================
  # =================================================================
  #
  # For a closed subspace Z ↪ X with open complement U:
  #   ... → K_n(Z) → K_n(X) → K_n(U) → K_{n-1}(Z) → ...
  # gives a long exact sequence.

  localizationSequence = {
    sequence_kind = "K-theory-localization";
    template = [
      "K_n(Z) -> K_n(X) -> K_n(U) -> K_{n-1}(Z) -> K_{n-1}(X) -> ..."
    ];
    substrate_meaning_en = ''
      Localization: split Site_coding into a closed part Z
      (constraint receipts) + open complement U (free receipts).
      The K-theory long exact sequence relates their K-classes.

      Substrate example:
        Z = subsite where Held received
        U = subsite where gated-emit-cleared received
        K_n(Z) → K_n(X) → K_n(U): tracks how held vs gated receipts
        contribute to the total K-theory
    '';
  };

  # =================================================================
  # === Adam operations =============================================
  # =================================================================
  #
  # Adams operations psi^k : K_0(X) → K_0(X) (k = 1, 2, 3, ...)
  # satisfy psi^k psi^l = psi^{kl} and form a lambda-ring structure.

  adamsOperations = {
    operation_kind = "Adams-operations";
    family = "psi^k : K_n -> K_n for k = 1, 2, 3, ...";
    composition_law = "psi^k o psi^l = psi^{kl}";
    substrate_meaning_en = ''
      Adams operations psi^k measure substrate's k-fold symmetric
      power structures. psi^2 = K-theoretic squaring,
      psi^3 = cubing, etc.

      In substrate: psi^k([r]) = K-class of the receipt's k-th
      symmetric power. Encodes how receipt "multiplies" under
      substrate operations.
    '';
    spectral_decomposition = ''
      K_0(X) ⊗ Q decomposes into eigenspaces of Adams operations.
      Eigenspaces correspond to weight pieces of motivic cohomology.
    '';
  };

  # =================================================================
  # === Substrate-internal K-classes ================================
  # =================================================================

  substrateKClasses = [
    {
      class_id = "k0-canonical-receipts";
      name = "[canonical-receipts] in K_0";
      description_en = "Galois H^0 = canonical receipts have a distinguished K_0 class";
      relates_to = "Galois fixed points + motivic universal class";
      regulator_image_en = "Image in H^{0,0}_M = trivial motivic cohomology class";
    }
    {
      class_id = "k0-held-receipts";
      name = "[held-class] in K_0";
      description_en = "Held receipts form a non-trivial K_0 class — they CANNOT be cancelled with gated-cleared receipts";
      relates_to = "Sheaf H^1 obstruction + Mode 14 subobject classifier";
      regulator_image_en = "Image in H^{0,1}_M = first cohomology obstruction class";
    }
    {
      class_id = "k1-receipt-permutation";
      name = "[receipt-perm] in K_1";
      description_en = "Permutations of receipts (rename / language perm) sit in K_1";
      relates_to = "G_pnix Galois action — K_1 captures invertible reversible substrate ops";
      regulator_image_en = "Image relates to motivic Picard variety";
    }
    {
      class_id = "k-infinity-UC4";
      name = "[UC4-obstruction] in K_∞";
      description_en = ''
        UC4 LLM-impossibility class lives in K_n for all n (stable
        under all K-theoretic operations).
      '';
      relates_to = "Motivic universal obstruction + cohomology H^∞";
      regulator_image_en = "Image is universal non-trivial Beilinson regulator class";
    }
  ];

  # =================================================================
  # === Comparison: K-theory vs motivic cohomology ==================
  # =================================================================
  #
  # Beilinson-Soulé: K_{2q-p}(X) ⊗ Q ≅ H^{p,q}_M(X, Q)

  beilinsonSouleConjecture = {
    conjecture_id = "Beilinson-Soule-substrate";
    statement_en = ''
      Beilinson-Soulé conjecture (substrate form):
        K_{2q-p}(Site_coding) ⊗ Q ≅ H^{p,q}_M(Site_coding, Q)

      That is, substrate's rational K-theory recovers rational
      motivic cohomology after appropriate (p, q) reindexing.
    '';
    proven_in_special_cases = "yes — for substrate-internal-canonical-receipts and substrate-topos-class";
    open_in_general = "open for arbitrary substrate K-classes (conjectural like classical case)";
  };

  # =================================================================
  # === Inventory =====================================================
  # =================================================================

  inventorySummary = _arg: {
    owner = ownerName;
    has_K_0 = true;
    higher_K_degree_count = 3;  # K_1, K_2, K_n
    has_beilinson_regulator = true;
    has_localization_sequence = true;
    has_adams_operations = true;
    substrate_K_class_count = 4;  # 4 substrate-internal K-classes (hardcoded)
    has_beilinson_soule_conjecture = true;
    UC4_in_K_infinity = true;
    canonical_receipts_in_K0 = true;
    held_receipts_in_K0_nontrivial = true;
    motivic_owner_inherited = motivic.ownerName;
    Gmot_owner_inherited = Gmot.ownerName;
  };

  # =================================================================
  # === Plate entry ===================================================
  # =================================================================

  applySubstrateKTheoryPlate = request:
    if !(builtins.isAttrs request) then { outcome = "held-non-attrs-request"; }
    else if builtins.hasAttr "inventory" request then {
      outcome = "substrate-k-theory-inventory"; receipt = inventorySummary {};
    }
    else if builtins.hasAttr "K_0" request then {
      outcome = "K-0-emitted"; receipt = k0Group;
    }
    else if builtins.hasAttr "higher_K" request then {
      outcome = "higher-K-emitted"; receipt = higherK;
    }
    else if builtins.hasAttr "beilinson_regulator" request then {
      outcome = "beilinson-regulator-emitted"; receipt = beilinsonRegulator;
    }
    else if builtins.hasAttr "localization" request then {
      outcome = "localization-sequence-emitted"; receipt = localizationSequence;
    }
    else if builtins.hasAttr "adams" request then {
      outcome = "adams-operations-emitted"; receipt = adamsOperations;
    }
    else if builtins.hasAttr "substrate_K_classes" request then {
      outcome = "substrate-K-classes-emitted"; receipt = substrateKClasses;
    }
    else if builtins.hasAttr "beilinson_soule" request then {
      outcome = "beilinson-soule-conjecture-emitted"; receipt = beilinsonSouleConjecture;
    }
    else { outcome = "held-unknown-request-shape";
           receipt = { allowed_keys = [
             "inventory" "K_0" "higher_K" "beilinson_regulator"
             "localization" "adams" "substrate_K_classes" "beilinson_soule"
           ]; };
         };

in {
  inherit ownerName stepKind framework_step;
  inherit k0Group higherK beilinsonRegulator;
  inherit localizationSequence adamsOperations;
  inherit substrateKClasses beilinsonSouleConjecture;
  inherit inventorySummary applySubstrateKTheoryPlate;
}
