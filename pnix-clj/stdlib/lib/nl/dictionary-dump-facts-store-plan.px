# stdlib/lib/nl/dictionary-dump-facts-store-plan.px — 외부 사전 facts 를 redb dictionary_facts 에 rec{} 적재
#
# ★dictionary-dump-facts.generated.px (gitignored, host-생성 woorimalsaem facts-only)를 pnix attrset 소스로 적재.
#   먼저 `bash scripts/gen-dictionary-dump-facts.sh` 로 생성 모듈을 만든 뒤:
#     pnixc-meta --morph-rules-build stdlib/lib/nl/dictionary-dump-facts-store-plan.px   (generic CLI 재사용)
#   생성 모듈이 없으면(fresh clone) 이 파일 eval 은 실패 — 의도된 것(CC BY-SA 데이터는 로컬 빌드, 배포 X).
#   seed store-plan 과 동형. Rust rec{} 직렬화기 0(검증된 .px toPnixSource 재사용). content-hash 키 = sync.
let
  facts = import ./dictionary-dump-facts.generated.px;   # gitignored 생성 모듈
  ser = import ./pnix-value-literal.px;
  B = builtins;
  valueSrc = ser.toPnixSource facts;
  contentHash = B.hashString "sha256" valueSrc;
  key = facts.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "dictionary-dump-facts-load-v0";
      source_lens = "stdlib/lib/nl/dictionary-dump-facts-store-plan.px";
      source_verdict = "materialize-dictionary-dump-facts";
      operations = [
        { op_kind = "append"; table = "dictionary_facts"; key = key; value_bytes = valueSrc; }
      ];
      receipt_owner = "dictionary.dump-facts.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = facts.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };

  mkQuery = args: {
    plan = {
      plan_id = "dictionary-dump-facts-query-v0";
      source_lens = "stdlib/lib/nl/dictionary-dump-facts-store-plan.px";
      source_verdict = "query-dictionary-dump-facts";
      operations = [
        { op_kind = "scan-prefix"; table = "dictionary_facts"; key = ""; key_prefix = facts.schema + "/"; }
      ];
      receipt_owner = "dictionary.dump-facts.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
