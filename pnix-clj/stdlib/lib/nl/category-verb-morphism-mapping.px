  # =================================================================
  # === Verb detection =============================================
  # =================================================================
  #
  # Longest-cue-match priority — pick the verb whose matched cue
  # has the most characters. This avoids "extract" overshadowing
  # "extract type", "optimize" overshadowing "optimize query", etc.

  # Longest matching cue for one entry, or empty string if none match.
  longestMatchingCue = utterance: entry:
    let
      matched = builtins.filter (c:
        decomposer.containsAny utterance [ c ]
      ) entry.cues;
      step = best: c:
        if builtins.stringLength c > builtins.stringLength best
        then c else best;
    in
      builtins.foldl' step "" matched;

  detectVerb = utterance:
    let
      hits = builtins.filter (entry:
        decomposer.containsAny utterance entry.cues
      ) verbTable;
      scored = builtins.map (entry: {
        inherit entry;
        score = builtins.stringLength (longestMatchingCue utterance entry);
      }) hits;
      best = builtins.foldl' (acc: s:
        if acc == null then s
        else if s.score > acc.score then s
        else acc
      ) null scored;
    in
      if best == null then null else best.entry;

  # =================================================================
  # === Detect multiple verbs (multi-action utterance) ============
  # =================================================================

  detectAllVerbs = utterance:
    builtins.filter (entry:
      decomposer.containsAny utterance entry.cues
    ) verbTable;

  # =================================================================
  # === Build morphism list with unknowns ==========================
  # =================================================================

  unknownsFor = entry: stepName:
    if builtins.hasAttr stepName entry.unknowns
    then entry.unknowns.${stepName}
    else [];

  buildMorphismsFromVerb = entry: utterance:
    let
      mkMorph = idx: stepName: {
        morphism_kind = "decomposed-step";
        step_index = idx;
        source = {
          object_kind = "code-state";
          phase = "pre-step-" + builtins.toString idx;
        };
        target = {
          object_kind = "code-state";
          phase = "post-step-" + builtins.toString idx;
        };
        action = stepName;
        params = {};
        unknowns = unknownsFor entry stepName;
        verb_origin = entry.verb;
      };
      n = builtins.length entry.steps;
      # Local genList replacement (pnixc-meta inline genList unsupported)
      localRange = m:
        if m == 0 then []
        else (localRange (m - 1)) ++ [ (m - 1) ];
      indices = localRange n;
    in
      builtins.map (i: mkMorph i (builtins.elemAt entry.steps i))
        indices;

  # =================================================================
  # === Multi-verb morphism list (concatenate) =====================
  # =================================================================

  buildMorphismsFromAllVerbs = utterance:
    let
      entries = detectAllVerbs utterance;
      perVerb = builtins.map (e: buildMorphismsFromVerb e utterance) entries;
      flat = builtins.foldl' (acc: lst: acc ++ lst) [] perVerb;
      localRange = m:
        if m == 0 then []
        else (localRange (m - 1)) ++ [ (m - 1) ];
      reindexed = builtins.map (i:
        (builtins.elemAt flat i) // { step_index = i; }
      ) (localRange (builtins.length flat));
    in {
      detected_verbs = builtins.map (e: e.verb) entries;
      morphisms = reindexed;
      morphism_count = builtins.length reindexed;
    };

  # =================================================================
  # === Stats ======================================================
  # =================================================================

  verbStats = _: {
    total_verbs = builtins.length verbTable;
    verbs = builtins.map (e: e.verb) verbTable;
    total_step_kinds =
      builtins.length (
        builtins.foldl' (acc: e: acc ++ e.steps) [] verbTable
      );
    verbs_with_unknowns = builtins.length (
      builtins.filter (e: e.unknowns != {}) verbTable
    );
  };

  # =================================================================
  # === Plate entry ================================================
  # =================================================================

  applyVerbMorphismPlate = request:
    if !(builtins.isAttrs request) then { outcome = "held-non-attrs-request"; }
    else if builtins.hasAttr "detect_verb" request then {
      outcome =
        let e = detectVerb request.detect_verb; in
        if e == null then "no-verb-detected" else "verb-detected";
      result = detectVerb request.detect_verb;
    }
    else if builtins.hasAttr "detect_all_verbs" request then {
      outcome = "all-verbs-detected";
      result = builtins.map (e: e.verb)
        (detectAllVerbs request.detect_all_verbs);
    }
    else if builtins.hasAttr "decompose_utterance" request then {
      outcome = "utterance-decomposed";
      result = buildMorphismsFromAllVerbs request.decompose_utterance;
    }
    else if builtins.hasAttr "stats" request then {
      outcome = "stats-emitted";
      result = verbStats {};
    }
    else { outcome = "held-missing-input-field"; };

  inventorySummary = _: {
    owner = ownerName;
    axiom_class = "nl-category-verb-morphism-mapping-axiom-125";
    composes =
      "axiom-119-nl-flow-category + 박힌 14 axiom family 어휘 (vocabulary source)";
    inherit framework_step;
    step_kind = stepKind;
    bilingual = true;
    total_verbs = builtins.length verbTable;
    primary_outcomes = [
      "verb-detected"
      "no-verb-detected"
      "all-verbs-detected"
      "utterance-decomposed"
      "stats-emitted"
    ];
  };

in {
  inherit ownerName verbTable
    detectVerb detectAllVerbs unknownsFor
    buildMorphismsFromVerb buildMorphismsFromAllVerbs
    verbStats applyVerbMorphismPlate
    stepKind framework_step inventorySummary;
  meta = {
    source = "stdlib NL category verb-morphism mapping (agent-NL-139)";
    owner = ownerName;
  };
}
