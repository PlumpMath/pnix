  # === Verb → Morphism Mapping (agent-NL-139) ======================
  #
  # #133 의 intentVerbToMorphismKinds 가 6 verb 만. 이번에 30+ verb +
  # 박힌 axiom 700 sub-branch 의 *어휘* 깊이 활용.
  #
  # Strategy:
  #   1. detect verb via cue match (박힌 axiom activation_cues 재사용)
  #   2. lookup verb → morphism decomposition rule
  #   3. emit step list with proper unknowns (universal property slots)

  stepKind = "verb-morphism-mapping";
  framework_step =
    "categorical body — NL verb → categorical morphism decomposition (700+ axiom 어휘 source)";

  # =================================================================
