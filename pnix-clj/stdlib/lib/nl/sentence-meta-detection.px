let
  ownerName = "stdlib.nl.sentence-meta-detection";

  containsAny = haystack: needles:
    let hl = builtins.stringLength haystack;
    in builtins.any (n:
      let nl = builtins.stringLength n;
          scan = pos:
            if pos + nl > hl then false
            else if (builtins.substring pos nl haystack) == n then true
            else scan (pos + 1);
      in if nl == 0 then false else scan 0
    ) needles;

  # === Sentence Meta Detection (agent-NL-104, hold/elevate step) ==
  #
  # 사용자 directive chain (2026-05-29):
  # - "분해된 sentence 의 명확한 의미 결정 + 수렴 (4-piece) →
  #    substrate 매핑"
  # - "마디 axis: inspect → resolve → propose → hold/elevate"
  #
  # 본 owner = algorithm-sentence-sequence 의 `hold` (또는 `elevate`)
  # step. 사용자가 자기 발화에 대해 *메타* 발화 ("내 진짜 뜻은 X 다",
  # "사실 인수분해만 보고 싶었어") 를 했을 때, 그 메타 atom 을 식별하고
  # *진짜 user intent* 를 elevate.
  #
  # # 4-piece (#4 second-order-lift) 의 NL 도메인 lift
  #
  #   math second-order  = 명제 (subj-pred-obj) 가 다른 명제의 subject
  #   NL second-order    = atom 이 다른 atom 에 대한 메타 발화
  #
  # # 다섯 meta kind
  #
  #   direct-meta        — "내 뜻은 X" / "what I mean is X"
  #   goal-meta          — "내 진짜 목표는 X" / "my real goal is X"
  #   scope-meta         — "더 정확히는 X" (refinement morphism + 메타)
  #   correction-meta    — "사실 X 가 아니라 Y" (contradiction + 메타)
  #   dialog-meta        — "다시 말하면" / "let me rephrase"
  #
  # # 진짜 user intent 추출 규칙 (사용자 강조)
  #
  # 1. correction-override invariant (#103) 가 잡혔으면 → 마지막 atom 이
  #    진짜 의도 (이전 atoms 는 superseded)
  # 2. 마지막 atom 의 ambient 가 intent-meta 면 → 그 메타 atom 이 진짜
  #    의도 (elevated, 이전 atoms 는 frame).
  # 3. 둘 다 아니면 → 모든 atom 이 동등 (no elevation, hold for caller)
  #
  # # public/carry envelope 헌법 보존

  stepKind = "hold-or-elevate";
  framework_step = "4 of 4 (second-order meta detection — 진짜 user intent elevate)";

  # === Meta kind registry ========================================

  knownMetaKinds = [
    {
      id = "direct-meta";
      family = "self-reference";
      description_en = "User explicitly states what they mean.";
      description_ko = "사용자가 자기 발화의 의미를 명시.";
      detect_en = [
        "what i mean" "What I mean" "i mean" "I mean"
        "let me be clear" "Let me be clear" "to be clear" "To be clear"
      ];
      detect_ko = [
        "내 뜻은" "제 뜻은" "내가 말하는 건"
        "쉽게 말해" "쉽게 말하면"
      ];
    }
    {
      id = "goal-meta";
      family = "intention";
      description_en = "User states their underlying goal.";
      description_ko = "사용자가 진짜 목표를 진술.";
      detect_en = [
        "my real goal" "My real goal" "what i really want"
        "What I really want" "actually i want" "Actually I want"
        "my goal is" "My goal is"
      ];
      detect_ko = [
        "진짜 원하는 건" "사실 원하는 건" "진짜 목표는"
        "원래 하고 싶은 건" "내가 진짜 원하는 건"
      ];
    }
    {
      id = "scope-meta";
      family = "scope-restriction";
      description_en = "User narrows / restricts the scope of the previous atom.";
      description_ko = "사용자가 이전 atom 의 범위를 좁힘.";
      detect_en = [
        "more precisely" "More precisely" "to be precise" "To be precise"
        "specifically i mean" "Specifically I mean" "only the"
      ];
      detect_ko = [
        "더 정확히는" "정확히 말하면" "구체적으로는"
        "딱 정확히" "특히"
      ];
    }
    {
      id = "correction-meta";
      family = "override";
      description_en = "User corrects a previous atom (its meaning is overridden).";
      description_ko = "사용자가 이전 atom 을 정정 (의미 override).";
      detect_en = [
        "actually" "Actually" "scratch that" "Scratch that"
        "wait, " "Wait, " "no, i meant" "No, I meant"
      ];
      detect_ko = [
        "사실은" "실은" "다시 말하면" "잠시" "그게 아니라"
        "아니라 내 말은" "정정"
      ];
    }
    {
      id = "dialog-meta";
      family = "rephrase";
      description_en = "User rephrases for clarity.";
      description_ko = "사용자가 명확화를 위해 재진술.";
      detect_en = [
        "let me rephrase" "Let me rephrase" "in other words"
        "In other words" "to put it differently"
      ];
      detect_ko = [
        "다시 말해" "다시 말하면" "바꿔 말하면"
      ];
    }
  ];

  metaKindCount = builtins.length knownMetaKinds;
  metaKindIds = builtins.map (m: m.id) knownMetaKinds;

  matchesMetaKind = sentence: m:
    containsAny sentence m.detect_en
    || containsAny sentence m.detect_ko;

  classifyMetaKind = sentence:
    let
      matches = builtins.filter (m: matchesMetaKind sentence m) knownMetaKinds;
    in
      if matches == [] then null
      else builtins.head matches;

  # === Detect meta atoms ============================================
  #
  # 두 signal:
  #   (1) ambient_id == "intent-meta"
  #   (2) sentence contains a known meta kind keyword
  # 둘 중 하나만 있어도 meta-flagged. 둘 다 있으면 confidence 높음.

  detectMetaAtomAtIndex = atoms: i:
    let
      atom = builtins.elemAt atoms i;
      sent = atom.sentence;
      isMetaAmbient =
        builtins.hasAttr "ambient_id" atom
        && atom.ambient_id == "intent-meta";
      kind = classifyMetaKind sent;
      hasKindKeyword = kind != null;
    in
      if isMetaAmbient || hasKindKeyword then {
        atom_index = i;
        sentence = sent;
        ambient_id =
          if builtins.hasAttr "ambient_id" atom then atom.ambient_id else "?";
        meta_kind = if kind == null then "untyped-meta" else kind.id;
        meta_family = if kind == null then "self-reference" else kind.family;
        signal_strength =
          if isMetaAmbient && hasKindKeyword then "high"
          else if isMetaAmbient then "ambient-only"
          else "keyword-only";
      } else null;

  scanMetaAtoms = atoms:
    let
      n = builtins.length atoms;
      indices = builtins.genList (i: i) n;
      hits = builtins.map (i: detectMetaAtomAtIndex atoms i) indices;
    in
      builtins.filter (h: h != null) hits;

  # === Elevation rules ===============================================
  #
  # Rule order:
  #   (R1) If invariant `correction-override` was detected → the LAST
  #        atom is the true intent (others superseded).
  #   (R2) Else if the LAST atom is a meta atom → that meta atom IS
  #        the user's elevated intent (prior atoms are frame).
  #   (R3) Else if there are meta atoms but not last → hold the meta
  #        observation but don't elevate any single atom.
  #   (R4) Else if no meta signal → all atoms equal, no elevation.

  hasInvariant = convergenceReceipt: invariant_id:
    builtins.isAttrs convergenceReceipt
    && builtins.hasAttr "carry" convergenceReceipt
    && builtins.hasAttr "held_invariants" convergenceReceipt.carry
    && builtins.any
       (h: builtins.hasAttr "id" h && h.id == invariant_id)
       convergenceReceipt.carry.held_invariants;

  elevateIntent = decompReceipt: convergenceReceipt:
    if !(builtins.isAttrs decompReceipt) then {
      outcome = "held-non-attrs-decomp";
    }
    else if !(builtins.hasAttr "carry" decompReceipt) then {
      outcome = "held-missing-decomp-carry";
    }
    else
      let
        atoms = decompReceipt.carry.per_atom_ambient;
        n = builtins.length atoms;
      in
        if n == 0 then {
          outcome = "held-no-atoms";
        }
        else
          let
            metas = scanMetaAtoms atoms;
            lastIndex = n - 1;
            lastAtom = builtins.elemAt atoms lastIndex;
            lastIsMeta = builtins.any (m: m.atom_index == lastIndex) metas;
            correctionInv = hasInvariant convergenceReceipt "correction-override";
            # Pick the elevated atom + rule applied
            chosen =
              if correctionInv then {
                rule = "R1-correction-override";
                elevated_index = lastIndex;
                elevated_sentence = lastAtom.sentence;
                elevation = "superseded-by-correction";
              }
              else if lastIsMeta then {
                rule = "R2-trailing-meta";
                elevated_index = lastIndex;
                elevated_sentence = lastAtom.sentence;
                elevation = "meta-is-true-intent";
              }
              else if metas != [] then {
                rule = "R3-mid-meta-no-elevation";
                elevated_index = null;
                elevated_sentence = null;
                elevation = "meta-observed-no-elevation";
              }
              else {
                rule = "R4-no-meta";
                elevated_index = null;
                elevated_sentence = null;
                elevation = "no-elevation-required";
              };
          in {
            outcome = "meta-resolved";
            atom_count = n;
            meta_atom_count = builtins.length metas;
            public = {
              meta_atoms = builtins.map (m: {
                sentence = m.sentence;
                kind_en = (
                  let k = classifyMetaKind m.sentence; in
                  if k == null then "general meta-reference"
                  else k.description_en
                );
                kind_ko = (
                  let k = classifyMetaKind m.sentence; in
                  if k == null then "일반적인 메타 참조"
                  else k.description_ko
                );
              }) metas;
              elevation_summary_en =
                if chosen.elevation == "superseded-by-correction" then
                  "User correction detected — earlier atoms are superseded; only the final atom carries true intent."
                else if chosen.elevation == "meta-is-true-intent" then
                  "User's final meta statement carries the true intent — prior atoms are framing."
                else if chosen.elevation == "meta-observed-no-elevation" then
                  "Meta atom observed mid-utterance but no single atom is elevated; caller may need to ask for confirmation."
                else
                  "No meta signal — all atoms contribute equally.";
              elevation_summary_ko =
                if chosen.elevation == "superseded-by-correction" then
                  "사용자 정정 — 이전 atom 폐기, 마지막 atom 이 진짜 의도."
                else if chosen.elevation == "meta-is-true-intent" then
                  "마지막 메타 발화가 진짜 의도 — 이전 atom 은 frame."
                else if chosen.elevation == "meta-observed-no-elevation" then
                  "중간 메타 atom 감지, 단일 atom 으로 elevation 안 됨 — 사용자에게 확인 필요."
                else
                  "메타 신호 없음 — 모든 atom 동등.";
              elevated_text = chosen.elevated_sentence;
            };
            carry = {
              meta_detail = metas;
              elevation_rule = chosen.rule;
              elevated_index = chosen.elevated_index;
              elevation_kind = chosen.elevation;
              axiom_origin =
                "axiom-93-nl-sentence-meta (lifts axiom-4-second-order-lift)";
              composes = [
                "axiom-90-nl-sentence-decomposition"
                "axiom-91-nl-sentence-morphism"
                "axiom-92-nl-sentence-invariant"
                "axiom-4-second-order-lift (math source)"
              ];
            };
          };

  # Convenience: derive full chain from a single utterance.
  elevateFromUtterance = utterance:
    let
      decomposer = import ./sentence-decomposition-substrate.px;
      detector = import ./sentence-morphism-detector.px;
      convergence = import ./sentence-invariant-convergence.px;
      dec = decomposer.decomposeUtterance utterance;
      mor = detector.resolveMorphisms dec;
      inv = convergence.convergeInvariants dec mor;
    in elevateIntent dec inv;

  applyNlSentenceMetaPlate = request:
    if !(builtins.isAttrs request) then {
      outcome = "held-non-attrs-request";
    }
    else if builtins.hasAttr "utterance" request then
      elevateFromUtterance request.utterance
    else if (builtins.hasAttr "decomp_receipt" request)
            && (builtins.hasAttr "convergence_receipt" request) then
      elevateIntent request.decomp_receipt request.convergence_receipt
    else {
      outcome = "held-missing-input-field";
      reason = "Provide either { utterance } or { decomp_receipt, convergence_receipt }.";
    };

  inventorySummary = _: {
    owner = ownerName;
    axiom_class = "nl-meta-axiom-93";
    meta_kind_count = metaKindCount;
    meta_kind_ids = metaKindIds;
    composes = "axiom-4-second-order-lift (math/geometric → NL lift)";
    inherit framework_step;
    step_kind = stepKind;
    elevation_rules = [
      "R1-correction-override"
      "R2-trailing-meta"
      "R3-mid-meta-no-elevation"
      "R4-no-meta"
    ];
    next_step_owners = [
      "stdlib/lib/nl/sentence-substrate-mapping.px # chain end-to-end (agent-NL-105)"
    ];
    new_decision_count = 0;
    bilingual = true;
    held_outcomes = [
      "held-non-attrs-decomp"
      "held-missing-decomp-carry"
      "held-no-atoms"
      "held-non-attrs-request"
      "held-missing-input-field"
    ];
  };

in {
  inherit
    ownerName knownMetaKinds metaKindCount metaKindIds
    matchesMetaKind classifyMetaKind
    detectMetaAtomAtIndex scanMetaAtoms
    hasInvariant elevateIntent elevateFromUtterance
    applyNlSentenceMetaPlate
    stepKind framework_step
    inventorySummary;
  meta = {
    source = "stdlib NL sentence meta detector (agent-NL-104)";
    owner = ownerName;
    base = "nl-sentence-meta-detection-v0";
    rev_note = "4-piece (#1-#4) NL lift step 4. second-order-lift 의 "
      + "NL 도메인 응용. 5 meta kind × en+ko bilingual. 4 elevation "
      + "rule (R1 correction-override / R2 trailing-meta / R3 mid-meta "
      + "/ R4 none). chain 의 마지막 inspection step — 다음 슬라이스 "
      + "(#105) 가 elevated intent 를 substrate mapping → code gen 으로.";
  };
}
