      start_line = 193;
      code_preview = "def equivFinTwo [DecidableEq (Ideal K)] : Ideal K ≃ Fin 2 where   toFun := fun I ↦ if I = ⊥ then 0 else 1   invFun := ![⊥, ⊤]   left_inv := fun I ↦ by rcases eq_bot_or_top I with rfl | rfl <;> simp   right_inv := fun i ↦ by fin_cases i <;> simp";
