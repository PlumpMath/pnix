      code_preview = "@[simps! hom_left hom_right inv_left inv_right] def dZeroArrowIso : Arrow.mk ((inhomogeneousCochains A).d 0 1) ≅     Arrow.mk (ModuleCat.ofHom (dZero A)) :=   Arrow.isoMk (zeroCochainsLequiv A).toModuleIso     (oneCochainsLequiv A).toModuleIso (ModuleCat.hom_ext (dZero_comp_eq A))";
