      start_line = 108;
      code_preview = "lemma dZero_comp_subtype : dZero A ∘ₗ A.ρ.invariants.subtype = 0 := by   ext ⟨x, hx⟩ g   replace hx := hx g   rw [← sub_eq_zero] at hx   exact hx";
    }
