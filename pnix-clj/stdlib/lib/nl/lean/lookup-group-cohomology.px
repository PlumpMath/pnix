      start_line = 114;
      code_preview = "@[simps] def dOne : (G → A) →ₗ[k] G × G → A where   toFun f g := A.ρ g.1 (f g.2) - f (g.1 * g.2) + f g.1   map_add' x y := funext fun g => by dsimp; rw [map_add, add_add_add_comm, add_sub_add_comm]   map_smul' r x := funext fun g => by dsimp; rw [map_smul, smul_add, smul_sub]";
    }
    {
