      code_preview = "lemma shortComplexH0_exact : (shortComplexH0 A).Exact := by   rw [ShortComplex.moduleCat_exact_iff]   intro (x : A) (hx : dZero _ x = 0)   refine ⟨⟨x, fun g => ?_⟩, rfl⟩   rw [← sub_eq_zero]   exact congr_fun hx g";
    }
