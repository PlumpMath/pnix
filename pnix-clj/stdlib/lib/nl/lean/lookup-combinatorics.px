      code_preview = "instance sdiff : SDiff (SimpleGraph V) where   sdiff x y :=     { Adj := x.Adj \\ y.Adj       symm := fun v w h => by change x.Adj w v ∧ ¬y.Adj w v; rwa [x.adj_comm, y.adj_comm] }";
