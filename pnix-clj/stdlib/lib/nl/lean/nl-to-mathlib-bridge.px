    { ko = "상계"; en = "UpperBound"; category = "order-theory"; concept = "upper bound"; }
    { ko = "하계"; en = "LowerBound"; category = "order-theory"; concept = "lower bound"; }
    { ko = "그래프"; en = "SimpleGraph"; category = "combinatorics"; concept = "simple graph"; }
    { ko = "조합"; en = "Choose"; category = "combinatorics"; concept = "binomial coefficient"; }
    { ko = "이항계수"; en = "Choose"; category = "combinatorics"; concept = "binomial coefficient"; }
    { ko = "카탈란"; en = "Catalan"; category = "combinatorics"; concept = "Catalan number"; }
    { ko = "집합"; en = "Set"; category = "data-foundation"; concept = "set"; }
    { ko = "유한집합"; en = "Finset"; category = "data-foundation"; concept = "finite set"; }
    { ko = "자연수"; en = "Nat"; category = "data-foundation"; concept = "natural number"; }
    { ko = "정수"; en = "Int"; category = "data-foundation"; concept = "integer"; }
  ];

  # =================================================================
  # === 한글 조사 strip (deterministic) ==============================
  # =================================================================
  #
  # 자주 등장하는 조사 강제 제거.

  koreanParticles = [
    "이란" "이라는" "이라고" "이라" "이가" "이가" "이의" "이는" "이를" "이에" "이에서"
    "가" "이" "는" "은" "을" "를" "의" "에" "에서" "으로" "로"
    "와" "과" "와의" "과의" "이란" "라는" "라고"
  ];

  stripParticle = word:
    let
      tryStrip = particle: rest:
        let
          wLen = builtins.stringLength word;
          pLen = builtins.stringLength particle;
        in
          if wLen > pLen
            && builtins.substring (wLen - pLen) pLen word == particle
          then builtins.substring 0 (wLen - pLen) word
          else rest;
      go = particles:
        if particles == [] then word
        else
          let stripped = tryStrip (builtins.head particles) null;
          in if stripped != null then stripped
             else go (builtins.tail particles);
    in go koreanParticles;

  # =================================================================
  # === 한글 utterance → Mathlib keyword 매핑 ========================
  # =================================================================

  matchKoreanWord = word:
    let stripped = stripParticle word;
        matches = builtins.filter
          (entry: entry.ko == stripped || entry.ko == word)
          koreanMathDictionary;
    in if matches == [] then null else builtins.head matches;

  # tokenize: 공백 split
  tokenize = utterance:
    builtins.filter
      (s: builtins.isString s && builtins.stringLength s > 0)
      (builtins.split " " utterance);

  # =================================================================
  # === Bridge query primitive =======================================
  # =================================================================
  #
  # 한글 utterance → matched dictionary entries → Mathlib lookup
  # → envelope.

  bridgeQuery = utterance:
    let
      tokens = tokenize utterance;
      tokenMatches = builtins.filter (m: m != null)
        (builtins.map matchKoreanWord tokens);
    in
      if tokenMatches == [] then {
        outcome = "held-no-korean-dictionary-match";
        utterance = utterance;
        tokens = tokens;
        held_reason = "한글 발화에 등록된 수학 vocabulary 가 없음";
      }
      else
        let
          firstMatch = builtins.head tokenMatches;
          categoryHits = lookup.byCategory firstMatch.category;
          keywordHits = lookup.searchByKeyword firstMatch.en;
          # 같은 카테고리 + keyword 매칭 = best
          # 단순화: keywordHits 우선
          bestHits =
            if builtins.length keywordHits > 0
            then keywordHits
            else categoryHits;
        in {
          outcome =
            if bestHits == []
            then "held-no-mathlib-match-for-keyword"
            else "mathlib-search-from-korean";
          utterance = utterance;
          matched_korean_word = firstMatch.ko;
          english_keyword = firstMatch.en;
          inferred_category = firstMatch.category;
          concept = firstMatch.concept;
          match_count = builtins.length bestHits;
          # 첫 5 entries 만 surface (envelope size 제어)
          top_matches =
            let
              take = n: lst:
                if n == 0 || lst == [] then []
                else [(builtins.head lst)] ++ take (n - 1) (builtins.tail lst);
            in take 5 bestHits;
          korean_response =
            if bestHits == []
            then "'" + firstMatch.ko + "' (" + firstMatch.en + ") 는 Mathlib 에 직접 매칭 없음"
            else "'" + firstMatch.ko + "' → Mathlib '" + firstMatch.en + "' (" +
                 builtins.toString (builtins.length bestHits) + " 개 매칭)";
        };

  # =================================================================
  # === Inventory =====================================================
  # =================================================================

  inventorySummary = _arg: {
    owner = ownerName;
    dictionary_entry_count = 216;  # hardcoded; Round 30 expansion (+ Order/Combinatorics/Data)
    particle_count = 23;  # hardcoded
    has_bridgeQuery = true;
    has_matchKoreanWord = true;
    has_stripParticle = true;
    has_tokenize = true;
    lookup_owner_inherited = lookup.ownerName;
    deterministic = true;  # LLM 없음
  };

  # =================================================================
  # === Plate entry ===================================================
  # =================================================================

  applyKoreanToMathlibBridgePlate = request:
    if !(builtins.isAttrs request) then { outcome = "held-non-attrs-request"; }
    else if builtins.hasAttr "inventory" request then {
      outcome = "korean-bridge-inventory"; receipt = inventorySummary {};
    }
    else if builtins.hasAttr "dictionary" request then {
      outcome = "korean-dictionary-emitted"; receipt = koreanMathDictionary;
    }
    else if builtins.hasAttr "query" request then
      bridgeQuery request.query
    else if builtins.hasAttr "match_word" request then
      let m = matchKoreanWord request.match_word;
      in if m == null
         then { outcome = "held-no-dictionary-entry"; receipt = { word = request.match_word; }; }
         else { outcome = "korean-word-matched"; receipt = m; }
    else if builtins.hasAttr "strip_particle" request then {
      outcome = "particle-stripped";
      receipt = { input = request.strip_particle; stripped = stripParticle request.strip_particle; };
    }
    else { outcome = "held-unknown-request-shape";
           receipt = { allowed_keys = [
             "inventory" "dictionary" "query" "match_word" "strip_particle"
           ]; };
         };

in {
  inherit ownerName stepKind framework_step;
  inherit koreanMathDictionary koreanParticles;
  inherit stripParticle matchKoreanWord tokenize bridgeQuery;
  inherit inventorySummary applyKoreanToMathlibBridgePlate;
}
