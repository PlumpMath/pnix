let
  ownerName = "stdlib.nl.lean.nl-to-mathlib-bridge";

  lookup = import nl/lean/lookup-aggregate.px;

  # === Korean NL → Mathlib lookup bridge (agent-NL-195) =============
  #
  # 사용자 vision 의 핵심:
  # > "한글 query 로 Mathlib 정리 직접 조회"
  #
  # Chain:
  #   한글 utterance
  #     → 조사 strip / 키워드 추출
  #     → 한국어 ↔ Mathlib keyword 매핑 (deterministic dictionary)
  #     → category hint emit (어느 lookup category 가 가장 likely 인지)
  #     → lookup.searchByKeyword / byCategory dispatch
  #     → 한글 응답 envelope
  #
  # 모든 단계 *deterministic + byte-stable*. LLM 0.

  stepKind = "korean-nl-to-mathlib-bridge";
  framework_step =
    "한글 utterance → Mathlib lookup envelope (deterministic dictionary)";

  # =================================================================
  # === 한글 ↔ Mathlib keyword 매핑 ===================================
  # =================================================================
  #
  # 한글 수학 vocabulary → Mathlib 영어 keyword + category hint.

  koreanMathDictionary = [
    # === Sheaf cohomology ===
