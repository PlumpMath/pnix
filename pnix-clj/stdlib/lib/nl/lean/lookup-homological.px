      code_preview = "def mkHomAux :     ∀ n,       Σ' (f : P.X n ⟶ Q.X n) (f' : P.X (n + 1) ⟶ Q.X (n + 1)),         f ≫ Q.d n (n + 1) = P.d n (n + 1) ≫ f'   | 0 => ⟨zero, one, one_zero_comm⟩   | n + 1 => ⟨(mkHomAux n).2.1, (succ n (mkHomAux n)).1, (succ n (mkHomAux n)).2⟩";
