let
  ownerName = "stdlib.nl.lean.substrate-axiom-dependency-chain";

  lookup = import nl/lean/lookup-aggregate.px;
  graph = import nl/lean/substrate-mathlib-graph.px;

  # === Substrate axiom dependency chain (agent-NL-199) ==============
  #
  # Round 10 사용자 vision 의 가장 깊은 form (proof axis):
  # > "substrate 의 axiom 자체가 Mathlib 정리 chain 에 어떻게 의존하는가"
  #
  # 우리 substrate 의 *핵심 axiom* 들:
  #   - Composability QED (#178)
  #   - Uniqueness QED (#181)
  #   - UC4 LLM-substitution impossibility (#175)
  #   - AC3 Kan extension closure
  #   - SC4 substrate topos elementary
  #   - UC4 의 7-fold characterization (cohomological / Galois / motivic /
  #     K-theoretic / homotopical / Hodge-Tate / p-adic Galois)
  #
  # 각 axiom 이 Mathlib 의 어떤 정리 chain 에 의존하는지 박음.
  #
  # 이게 paper-QED draft 의 *external verification proxy network*.
  # substrate-internal claim 의 "외부 fixed point" 가 *어떤 정리들의 union*
  # 인지 mechanical 표현.

  stepKind = "substrate-axiom-dependency-chain";
  framework_step =
    "substrate axiom → Mathlib dependency chain (proof axis network)";

  # =================================================================
  # === Substrate axiom dependency declarations ======================
  # =================================================================
  #
  # 각 axiom row 의 mathlib_dependency_chain 은 *수학적 의존 관계*
  # — substrate axiom 의 *외부 fixed point* 가 어느 Mathlib 정리들의
  # *concrete chain* 으로 backed 되는지.

  axiomDependencyChain = [
    # ===== Composability QED (#178) =====
    {
      axiom_id = "composability-qed";
      axiom_name = "Composability QED";
      axiom_source = "stdlib substrate, paper-qed Lemma 1";
      mathlib_dependency_chain = [
        { name = "CategoryTheory.Pretriangulated"; layer = "foundation"; reason = "two-plate composition = triangulated composition"; }
        { name = "HomologicalComplex"; layer = "structure"; reason = "verdict envelope = homological complex"; }
        { name = "CategoryTheory.MonoidalCategory"; layer = "tensor"; reason = "plate compose = monoidal tensor"; }
        { name = "Group"; layer = "algebraic-foundation"; reason = "plate composition as group operation"; }
        { name = "Ring"; layer = "algebraic-foundation"; reason = "plate algebra structure"; }
      ];
      external_anchor_claim_form = ''
        substrate composability QED 는 *categorical composition* 에 의존.
        Mathlib 의 triangulated + monoidal + homological complex 정리들이
        그 foundation 의 외부 verification proxy.
      '';
    }

    # ===== Uniqueness QED (#181) =====
    {
      axiom_id = "uniqueness-qed";
      axiom_name = "Uniqueness QED (receipt byte-determinism)";
      axiom_source = "stdlib substrate, paper-qed Lemma 2";
      mathlib_dependency_chain = [
        { name = "FiniteDimensional"; layer = "foundation"; reason = "receipt finite-dim → unique value"; }
        { name = "IsGalois"; layer = "structure"; reason = "Galois fixed point = unique receipt"; }
        { name = "Group"; layer = "algebraic-foundation"; reason = "receipt as group element"; }
      ];
      external_anchor_claim_form = ''
        substrate Uniqueness QED 는 *deterministic function* 성질에 의존.
        Mathlib 의 finite-dim + Galois fixed point 정리들이 그 foundation.
      '';
    }

    # ===== UC4 LLM-substitution impossibility (#175) =====
    {
      axiom_id = "uc4-llm-impossibility";
      axiom_name = "UC4 LLM-substitution impossibility";
      axiom_source = "stdlib substrate, paper-qed Lemma 3 + main theorem";
      mathlib_dependency_chain = [
        # Cohomological characterization
        { name = "groupCohomology"; layer = "cohomological-1"; reason = "UC4 ∈ H^0(G, M)^G"; }
        { name = "groupCohomology.H0"; layer = "cohomological-2"; reason = "UC4 = invariants in degree 0"; }
        # Galois characterization
        { name = "IsGalois"; layer = "galois-1"; reason = "UC4 G_pnix-invariant"; }
        # Motivic characterization (foundation only)
        { name = "CategoryTheory.MonoidalCategory"; layer = "motivic-1"; reason = "UC4 motivic tensor invariant"; }
        # Hodge-Tate characterization (foundation)
        { name = "HomologicalComplex"; layer = "hodge-tate-1"; reason = "UC4 Hodge weight-0"; }
        # p-adic Galois characterization (foundation)
        { name = "Padic"; layer = "p-adic-1"; reason = "UC4 crystalline"; }
        # K-theoretic characterization (foundation)
        { name = "FiniteDimensional"; layer = "k-theoretic-1"; reason = "UC4 K_∞-stable"; }
        # Homotopical characterization (foundation)
        { name = "CategoryTheory.Pretriangulated"; layer = "homotopical-1"; reason = "UC4 pi_{*,*}(SH)"; }
      ];
      external_anchor_claim_form = ''
        UC4 의 7-fold characterization 의 *각* framework 가 Mathlib 의
        *최소 1개 정리* 에 의존. 7 framework × 외부 Lean kernel verified
        정리 union = UC4 의 *외부 verification proxy network*.

        주의: substrate 의 motivic / Hodge / crystalline / K-theory / SH
        자체는 Mathlib 에 *없음*. 우리는 *foundation 정리* (Monoidal /
        HomologicalComplex / Padic / FiniteDimensional / Pretriangulated)
        와의 의존만 박음. 진짜 *advanced 영역 의 정리* 와의 의존은 future
        formalize 후.
      '';
    }

    # ===== AC3 Kan extension closure =====
    {
      axiom_id = "ac3-kan-extension";
      axiom_name = "AC3 Kan extension closure";
      axiom_source = "stdlib substrate, paper-qed Lemma 4";
      mathlib_dependency_chain = [
        { name = "CategoryTheory.MonoidalCategory"; layer = "categorical-1"; reason = "Kan extension = colim"; }
        { name = "CategoryTheory.Abelian"; layer = "categorical-2"; reason = "Kan extension exists in abelian categories"; }
      ];
      external_anchor_claim_form = ''
        substrate AC3 는 *Kan extension* universal property 에 의존.
        Mathlib 의 monoidal + abelian category 정리들이 그 foundation.
      '';
    }

    # ===== SC4 substrate topos elementary =====
    {
      axiom_id = "sc4-substrate-topos";
      axiom_name = "SC4 substrate topos elementary";
      axiom_source = "stdlib substrate, paper-qed Lemma 5";
      mathlib_dependency_chain = [
        { name = "CategoryTheory.Presheaf.IsSheaf"; layer = "topos-1"; reason = "sheaves form a topos"; }
        { name = "CategoryTheory.Abelian"; layer = "topos-2"; reason = "abelian topos structure"; }
        { name = "HomologicalComplex"; layer = "topos-3"; reason = "subobject classifier 의 chain complex"; }
      ];
      external_anchor_claim_form = ''
        substrate SC4 는 *elementary topos* 의 axiom 들에 의존.
        Mathlib 의 sheaf + abelian + homological complex 정리들이 foundation.
      '';
    }

    # ===== Round 23: Mode 11 Yoneda categorical canonicalization =====
    {
      axiom_id = "mode-11-yoneda-canonicalization";
      axiom_name = "Mode 11 Yoneda categorical canonicalization";
      axiom_source = "stdlib substrate, additional axiom (post paper-qed)";
      mathlib_dependency_chain = [
        { name = "CategoryTheory.MonoidalCategory"; layer = "yoneda-1"; reason = "Yoneda lemma in monoidal categories"; }
        { name = "FDRep"; layer = "yoneda-2"; reason = "Yoneda → representable functors"; }
        { name = "Module"; layer = "categorical-foundation"; reason = "Yoneda over modules"; }
        { name = "Lattice"; layer = "order-foundation"; reason = "Yoneda preserves limits/colimits in lattice"; }
      ];
      external_anchor_claim_form = ''
        substrate Mode 11 = receipt canonicalization via Yoneda embedding.
        Mathlib 의 categorical Yoneda + monoidal + representations 정리들이
        그 foundation 의 외부 verification proxy.
      '';
    }

    # ===== Round 23: Mode 14 Substrate subobject classifier =====
    {
      axiom_id = "mode-14-subobject-classifier";
      axiom_name = "Mode 14 substrate subobject classifier (topos Omega)";
      axiom_source = "stdlib substrate, additional axiom";
      mathlib_dependency_chain = [
        { name = "CategoryTheory.Presheaf.IsSheaf"; layer = "topos-1"; reason = "Omega = sheaf of held envelopes"; }
        { name = "CategoryTheory.Abelian"; layer = "topos-2"; reason = "subobject classifier in abelian topos"; }
        { name = "TopologicalSpace"; layer = "site-foundation"; reason = "topos = sheaves on site"; }
        { name = "Set"; layer = "data-foundation"; reason = "subobject = element of power set"; }
        { name = "Finset"; layer = "data-foundation"; reason = "finite subobject classifier"; }
      ];
      external_anchor_claim_form = ''
        substrate Mode 14 = subobject classifier Omega 의 mechanical 형식.
        substrate 의 Held envelope 들이 그 classifier 의 instance.
        Mathlib sheaf + abelian + topology 정리들이 foundation.
      '';
    }

    # ===== Round 35: Mode 12 Substrate temporal consistency =====
    {
      axiom_id = "mode-12-temporal-consistency";
      axiom_name = "Mode 12 substrate temporal consistency (append-only log)";
      axiom_source = "stdlib substrate, additional axiom";
      mathlib_dependency_chain = [
        { name = "Lattice"; layer = "order-1"; reason = "timestamp lattice + sup/inf"; }
        { name = "Nat.succ_injective"; layer = "order-2"; reason = "monotonic counter"; }
        { name = "Finset"; layer = "data-foundation"; reason = "finite log slice"; }
      ];
      external_anchor_claim_form = ''
        substrate Mode 12 = append-only judgement log 의 temporal
        consistency. Mathlib 의 Lattice + Nat + Finset 정리들이 그
        foundation 의 외부 verification proxy.
      '';
    }

    # ===== Round 35: Mode 13 Substrate context flow =====
    {
      axiom_id = "mode-13-context-flow";
      axiom_name = "Mode 13 substrate context-flow (multi-turn state)";
      axiom_source = "stdlib substrate, additional axiom";
      mathlib_dependency_chain = [
        { name = "CategoryTheory.MonoidalCategory"; layer = "categorical-state"; reason = "state monad → monoidal product"; }
        { name = "Module"; layer = "linear-state"; reason = "context = module element"; }
        { name = "Set"; layer = "data-foundation"; reason = "context history = set of past states"; }
      ];
      external_anchor_claim_form = ''
        substrate Mode 13 = multi-turn conversation 의 context flow.
        state monad 의 categorical foundation 위에 박힘.
      '';
    }

    # ===== UC4 의 motivic Galois invariance (#186) =====
    {
      axiom_id = "uc4-motivic-galois-invariance";
      axiom_name = "UC4 motivic Galois invariance (Lemma 6)";
      axiom_source = "stdlib substrate, paper-qed Lemma 6";
      mathlib_dependency_chain = [
        { name = "FDRep"; layer = "tannakian-1"; reason = "G_mot ≅ Aut^⊗(ω) on FdRep"; }
        { name = "TannakaDuality.FiniteGroup.forget"; layer = "tannakian-2"; reason = "Tannaka duality fiber functor"; }
        { name = "IsGalois"; layer = "galois-baseline"; reason = "G_pnix → G_mot surjection 의 baseline"; }
      ];
      external_anchor_claim_form = ''
        substrate UC4 의 motivic Galois invariance Lemma 6 은 Tannakian
        formalism 에 의존. Mathlib 의 FDRep + Tannaka.lean + IsGalois
        가 그 foundation 의 외부 verification proxy.
      '';
    }
  ];

  # =================================================================
  # === Coverage verification ========================================
  # =================================================================

  verifyAxiomDependencies = axiomRow:
    let
      deps = axiomRow.mathlib_dependency_chain;
      verifyDep = dep:
        let entry = lookup.lookupByName dep.name;
        in {
          inherit (dep) name layer reason;
          exists_in_lookup = entry != null;
          lean_file = if entry == null then null else entry.file_path;
        };
      verifications = builtins.map verifyDep deps;
      verifiedCount =
        builtins.length (builtins.filter (v: v.exists_in_lookup) verifications);
      totalCount = builtins.length deps;
    in {
      axiom_id = axiomRow.axiom_id;
      axiom_name = axiomRow.axiom_name;
      total_dependencies = totalCount;
      verified_dependencies = verifiedCount;
      coverage_percent =
        if totalCount == 0 then 0
        else (verifiedCount * 100) / totalCount;
      dependency_verifications = verifications;
      # 어느 layer 의 dependency 가 verified 인지 layer-별 count
      layer_distribution =
        let
          uniqueLayers =
            let
              addLayer = acc: v: if builtins.elem v.layer acc then acc else acc ++ [v.layer];
            in builtins.foldl' addLayer [] verifications;
          layerCount = layer:
            builtins.length (builtins.filter
              (v: v.layer == layer && v.exists_in_lookup) verifications);
        in builtins.map
             (l: { layer = l; verified_count = layerCount l; })
             uniqueLayers;
    };

  allAxiomCoverages = builtins.map verifyAxiomDependencies axiomDependencyChain;

  # =================================================================
  # === Aggregate stats ===============================================
  # =================================================================

  totalAxioms = builtins.length axiomDependencyChain;
  totalDependencies =
    builtins.foldl'
      (acc: e: acc + builtins.length e.mathlib_dependency_chain)
      0 axiomDependencyChain;
  totalVerifiedDependencies =
    builtins.foldl' (acc: c: acc + c.verified_dependencies) 0 allAxiomCoverages;
  overallCoveragePercent =
    if totalDependencies == 0 then 0
    else (totalVerifiedDependencies * 100) / totalDependencies;

  fullyVerifiedAxiomCount =
    builtins.length
      (builtins.filter (c: c.coverage_percent == 100) allAxiomCoverages);

  # =================================================================
  # === Paper-QED Lemma 외부 verification index ======================
  # =================================================================
  #
  # paper-qed-aggregate.md 의 6 lemma + main theorem 의 external proxy
  # verification index.

  paperQedExternalProxyIndex = {
    paper_lemma_1_composability = "axiom: composability-qed";
    paper_lemma_2_uniqueness = "axiom: uniqueness-qed";
    paper_lemma_3_uc4_llm_impossibility = "axiom: uc4-llm-impossibility";
    paper_lemma_4_ac3_kan = "axiom: ac3-kan-extension";
    paper_lemma_5_sc4_topos = "axiom: sc4-substrate-topos";
    paper_lemma_6_uc4_motivic_galois = "axiom: uc4-motivic-galois-invariance";
    main_theorem_uc4_7_fold = "covered_by: uc4-llm-impossibility (7 layer chain)";
    paper_lemma_count = 6;
    main_theorem_count = 1;
    total_paper_artifacts = 7;
  };

  # =================================================================
  # === Inventory =====================================================
  # =================================================================

  inventorySummary = _arg: {
    owner = ownerName;
    has_axiomDependencyChain = true;
    has_verifyAxiomDependencies = true;
    total_substrate_axioms = totalAxioms;
    total_mathlib_dependencies = totalDependencies;
    total_verified_dependencies = totalVerifiedDependencies;
    overall_coverage_percent = overallCoveragePercent;
    fully_verified_axiom_count = fullyVerifiedAxiomCount;
    paper_lemma_count = paperQedExternalProxyIndex.paper_lemma_count;
    main_theorem_count = paperQedExternalProxyIndex.main_theorem_count;
    total_paper_artifacts = paperQedExternalProxyIndex.total_paper_artifacts;
    lookup_owner_inherited = lookup.ownerName;
    graph_owner_inherited = graph.ownerName;
    proof_axis_dependency_network = true;
  };

  # =================================================================
  # === Plate entry ===================================================
  # =================================================================

  applySubstrateAxiomDependencyPlate = request:
    if !(builtins.isAttrs request) then { outcome = "held-non-attrs-request"; }
    else if builtins.hasAttr "inventory" request then {
      outcome = "substrate-axiom-dependency-inventory"; receipt = inventorySummary {};
    }
    else if builtins.hasAttr "chain" request then {
      outcome = "axiom-dependency-chain-emitted"; receipt = axiomDependencyChain;
    }
    else if builtins.hasAttr "coverages" request then {
      outcome = "all-axiom-coverages-emitted"; receipt = allAxiomCoverages;
    }
    else if builtins.hasAttr "verify_axiom" request then
      let
        target = request.verify_axiom;
        matches = builtins.filter
          (a: a.axiom_id == target) axiomDependencyChain;
      in
        if matches == []
        then { outcome = "held-no-such-axiom"; receipt = { queried = target; }; }
        else {
          outcome = "single-axiom-coverage-emitted";
          receipt = verifyAxiomDependencies (builtins.head matches);
        }
    else if builtins.hasAttr "paper_index" request then {
      outcome = "paper-qed-external-proxy-index-emitted";
      receipt = paperQedExternalProxyIndex;
    }
    else { outcome = "held-unknown-request-shape";
           receipt = { allowed_keys = [
             "inventory" "chain" "coverages" "verify_axiom" "paper_index"
           ]; };
         };

in {
  inherit ownerName stepKind framework_step;
  inherit axiomDependencyChain verifyAxiomDependencies allAxiomCoverages;
  inherit totalAxioms totalDependencies totalVerifiedDependencies;
  inherit overallCoveragePercent fullyVerifiedAxiomCount;
  inherit paperQedExternalProxyIndex;
  inherit inventorySummary applySubstrateAxiomDependencyPlate;
}
