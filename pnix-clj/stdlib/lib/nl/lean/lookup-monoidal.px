      code_preview = "def tensorClosed {X Y : C} (hX : Closed X) (hY : Closed Y) : Closed (X ⊗ Y) where   rightAdj := Closed.rightAdj X ⋙ Closed.rightAdj Y   adj := (hY.adj.comp hX.adj).ofNatIsoLeft (MonoidalCategory.tensorLeftTensor X Y).symm";
    }
