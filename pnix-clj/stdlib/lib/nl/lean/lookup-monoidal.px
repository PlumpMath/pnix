      code_preview = "@[reassoc] lemma whiskerLeft_app_tensor_app {X' Y' : J} (f : X' ⟶ Y') (X : J) :     F.obj X ◁ G.map f ≫ (α.app X ⊗ β.app Y') =       (α.app X ⊗ β.app X') ≫ F'.obj X ◁ G'.map f := by   simpa using tensor_naturality α β (𝟙 X) f";
    }
    {
