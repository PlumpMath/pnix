      start_line = 134;
      code_preview = "def Pentagon {C : Type u} [Category.{v} C] [MonoidalCategoryStruct C]     (Y₁ Y₂ Y₃ Y₄ : C) : Prop :=   (α_ Y₁ Y₂ Y₃).hom ▷ Y₄ ≫ (α_ Y₁ (Y₂ ⊗ Y₃) Y₄).hom ≫ Y₁ ◁ (α_ Y₂ Y₃ Y₄).hom =     (α_ (Y₁ ⊗ Y₂) Y₃ Y₄).hom ≫ (α_ Y₁ Y₂ (Y₃ ⊗ Y₄)).hom";
    }
