      start_line = 96;
      code_preview = "@[reassoc (attr := simp)] theorem ev_naturality {X Y : C} (f : X ⟶ Y) :     A ◁ (ihom A).map f ≫ (ev A).app Y = (ev A).app X ≫ f";
