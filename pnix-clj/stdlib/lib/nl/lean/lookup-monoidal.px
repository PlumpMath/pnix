    {
      full_name = "CategoryTheory.NatTrans.tensor_naturality";
      kind = "lemma";
      file_path = "Mathlib/CategoryTheory/Monoidal/Category.lean";
      start_line = 984;
      code_preview = "@[reassoc] lemma tensor_naturality {X Y X' Y' : J} (f : X ⟶ Y) (g : X' ⟶ Y') :     (F.map f ⊗ G.map g) ≫ (α.app Y ⊗ β.app Y') =       (α.app X ⊗ β.app X') ≫ (F'.map f ⊗ G'.map g) := by   simp only [← tensor_comp, naturality]";
    }
    {
      full_name = "CategoryTheory.NatTrans.whiskerRight_app_tensor_app";
      kind = "lemma";
      file_path = "Mathlib/CategoryTheory/Monoidal/Category.lean";
      start_line = 990;
      code_preview = "@[reassoc] lemma whiskerRight_app_tensor_app {X Y : J} (f : X ⟶ Y) (X' : J) :     F.map f ▷ G.obj X' ≫ (α.app Y ⊗ β.app X') =       (α.app X ⊗ β.app X') ≫ F'.map f ▷ (G'.obj X') := by   simpa using tensor_naturality α β f (𝟙 X')";
    }
    {
      full_name = "CategoryTheory.NatTrans.whiskerLeft_app_tensor_app";
      kind = "lemma";
