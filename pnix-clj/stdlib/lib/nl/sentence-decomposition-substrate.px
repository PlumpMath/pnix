let
  ownerName = "stdlib.nl.sentence-decomposition-substrate";

  # === 마디 axis: algorithm-sentence-sequence 의 step 매핑 ==========
  #
  # 본 owner = algorithm-sentence-sequence.px 의 `inspect` step 의
  # NL 응용. atom 의 ambient 분류 = 한 마디. 이후 `resolve`
  # (morphism), `propose` (invariant 후보), `hold` (수렴 미흡 시
  # 명확화 요청) 의 step 들은 미래 piece (#102~) 가 박는다.

  stepKind = "inspect";
  framework_step = "1 of 4 (decomposition + ambient classification)";
  next_step_owners = [
    "stdlib/lib/nl/sentence-morphism-detector.px      # resolve step (agent-NL-102)"
    "stdlib/lib/nl/sentence-invariant-convergence.px  # propose step (agent-NL-103)"
    "stdlib/lib/nl/sentence-meta-detection.px         # hold/elevate step (agent-NL-104)"
  ];

  # === NL Sentence Decomposition Substrate (Axiom #90) ============
  #
  # 사용자 directive (2026-05-28 밤):
  # > "의미를 인식할때 분해/수렴 인식. 4peace 다문장의 여러의미
  # > 수렴에서 빛을 바랄거다."
  #
  # 4-piece axiom (#1-#4, math/geometric 도메인) 의 NL 도메인 lift.
  # 이 owner 는 step 1 of 4 — **sentence decomposition + ambient
  # classification**. multi-sentence 발화를 sentence atoms 로 분해 +
  # 각 atom 의 NL ambient (의도 모드) 추론.
  #
  # # 4-piece NL application 매핑
  #
  #   Axiom #1 ambient-space  → 본 owner: sentence atom 의 NL ambient
  #   Axiom #2 morphism       → 미래 #91: sentence 간 paraphrase/인과
  #   Axiom #3 invariant      → 미래 #92: 여러 sentence 가 공유하는 핵심
  #   Axiom #4 second-order   → 미래 #93: meta-statement 식별
  #
  # # 의미 분해/수렴 framework 의 step 1
  #
  # 발화 (한 문장 또는 다문장)
  #   → 본 owner: sentence atoms + 각 atom 의 ambient classification
  #   → #91 morphism: atom 간 semantic transform 탐지
  #   → #92 invariant: 모든 atom 이 보존하는 의미 수렴
  #   → #93 second-order: "사용자가 X 를 의미함" meta-statement
  #   → generic response surface (도메인 무관)
  #
  # # 헌법
  #
  # - utterance ambient 미명시 → Hold (default 절대 금지)
  # - 분해 결과 빈 atom list → Hold (empty utterance)
  # - 사용자에게 보이는 response 는 substrate-internal 이름 가린다.
  #   public/carry envelope 분리.

  # === Known NL ambients ==========================================
  #
  # NL ambient = sentence atom 이 *어떤 모드* 로 발화됐는가.
  # math 도메인의 ambient-space (R²/S²/H²) 와 평행한 NL axis.
  #
  # 동일 surface 문자열이 다른 ambient 에서 다른 의미:
  #   "do X"  in intent-instruction → 사용자가 행동 요청
  #   "do X"  in intent-question    → 사용자가 가능성 묻기
  #   "do X"  in intent-conditional → 조건절 (if user does X)

  knownNLAmbients = [
    {
      id = "intent-instruction";
      family = "directive";
      description_en = "User asks the system to do something.";
      description_ko = "사용자가 시스템에게 어떤 동작을 요청.";
      end_marker_en = [ "." "!" ];
      end_marker_ko = [ "다." "해." "해주." "줘." "줘!" "해!" ];
      keyword_en = [ " do " "make " "rename " "add " "remove " "delete " "create " "fix " "change " "update " ];
      keyword_ko = [ "해줘" "해라" "만들어" "바꿔" "추가해" "지워" "만들" "고쳐" "변경" ];
    }
    {
      id = "intent-question";
      family = "interrogative";
      description_en = "User asks a question, expecting an answer.";
      description_ko = "사용자가 질문 — 답변 기대.";
      end_marker_en = [ "?" ];
      end_marker_ko = [ "?" "까." "까?" "니." "니?" "나." "나?" ];
      keyword_en = [ "what " "why " "how " "where " "when " "who " "which " "is " "are " "does " "do " ];
      keyword_ko = [ "뭐" "무엇" "왜" "어떻게" "어디" "언제" "누가" "어느" "인가" "인지" "인지요" "뭐야" ];
    }
    {
      id = "intent-confirmation";
      family = "responsive";
      description_en = "User confirms or denies a previous statement.";
      description_ko = "사용자가 이전 발화에 대한 확인/부정.";
      end_marker_en = [ "." "!" ];
      end_marker_ko = [ "." "!" "다." ];
      keyword_en = [
        "yes" "Yes" "YES" "no" "No" "NO"
        "correct" "right" "wrong" "exactly" "agreed"
        "that's it" "not really" "absolutely"
      ];
      keyword_ko = [
        "네" "예" "맞아" "맞다" "그래" "아니" "틀려"
        "정확" "동의" "그렇다" "그렇지" "맞아요" "맞습니다"
      ];
    }
    {
      id = "intent-clarification";
      family = "elaborative";
      description_en = "User clarifies / refines a previous statement.";
      description_ko = "사용자가 앞선 발화 명확화 / 세부.";
      end_marker_en = [ "." "!" ];
      end_marker_ko = [ "다." "해." "이야." "이다." ];
      keyword_en = [ "i mean" "actually" "to be specific" "more precisely" "that is" "namely" ];
      keyword_ko = [ "정확히" "다시 말해" "사실" "구체적으로" "즉" ];
    }
    {
      id = "intent-statement";
      family = "declarative";
      description_en = "User makes a factual or opinion statement.";
      description_ko = "사용자가 사실/의견 진술.";
      end_marker_en = [ "." ];
      end_marker_ko = [ "다." "이다." "있다." "없다." "이야." ];
      keyword_en = [ "this is" "there is" "the " "i think" "we have" ];
      keyword_ko = [ "이것은" "있다" "이다" "라고" "같다" ];
    }
    {
      id = "intent-meta";
      family = "reflexive";
      description_en = "User talks about their own intention or the conversation.";
      description_ko = "사용자가 자기 의도/대화 자체에 대해 발화 (메타).";
      end_marker_en = [ "." ];
      end_marker_ko = [ "다." "이야." ];
      keyword_en = [ "what i mean is" "my real goal is" "actually i want" "let me rephrase" ];
      keyword_ko = [ "내 뜻은" "진짜 의도는" "원래" "다시 말하면" "사실 원하는 건" ];
    }
    {
      id = "intent-conditional";
      family = "hypothetical";
      description_en = "User describes a conditional or hypothetical case.";
      description_ko = "사용자가 조건절/가설 진술.";
      end_marker_en = [ "." ];
      end_marker_ko = [ "다." "이다." "면." "면," ];
      keyword_en = [
        "if " "If " "when " "When " "suppose " "Suppose "
        "assuming " "Assuming " "in case " "In case " "given " "Given "
      ];
      keyword_ko = [ "만약" "만일" "라면" "이면" "한다면" "이라면" ];
    }
    # === math sub-domain ambients (2026-05-29 사용자 directive) =====
    #
    # 사용자: "알고리즘 마디 마디 문장들이 들여올때, 수학적인 배경과
    # 그 문장들이 우선 처리되는지 봐야할거라 본다."
    #
    # 본 ambient 들은 axiom #2 (timeless-vs-ordered) 와 align 된 NL
    # axis. sentence atom 이 math 발화로 분류되면 carry 에 substrate
    # routing hint 도 함께 propagate — 다음 step (resolve / propose)
    # 이 직접 호출할 owner 명시.
    {
      id = "math-procedure";
      family = "math";
      description_en = "User asks for an ordered mathematical procedure (solve / compute / prove).";
      description_ko = "사용자가 시간순 수학 절차 요청 (풀이 / 계산 / 증명).";
      end_marker_en = [ "." "!" "?" ];
      end_marker_ko = [ "." "?" "다." "줘." ];
      keyword_en = [
        "solve " "Solve " "compute " "Compute " "calculate " "Calculate "
        "find the root" "find the roots" "find x" "differentiate"
        "Differentiate" "integrate" "Integrate" "prove " "Prove "
        "factor " "Factor " "simplify" "Simplify"
      ];
      keyword_ko = [
        "풀어" "풀이" "풀어줘" "구해" "계산해" "계산하"
        "미분해" "미분 해" "적분해" "적분 해" "증명해" "증명하"
        "인수분해" "단순화" "전개해"
      ];
      math_substrate_route = "stdlib/lib/math/equation-solving-procedure.px";
      math_object_kind = "procedure";
      timeless_or_ordered = "ordered";
    }
    {
      id = "math-verification";
      family = "math";
      description_en = "User asks for verification or a counterexample of a mathematical claim.";
      description_ko = "사용자가 수학 명제의 검증 / 반례 요청.";
      end_marker_en = [ "." "?" ];
      end_marker_ko = [ "?" "까." "까?" "다." ];
      keyword_en = [
        "verify " "Verify " "check that" "Check that" "is this correct"
        "Is this correct" "counterexample" "find counterexample"
        "does it hold" "Does it hold"
      ];
      keyword_ko = [
        "검증해" "검증하" "확인해" "맞는지 확인" "맞나" "성립하는지"
        "반례" "반례 찾" "옳은가"
      ];
      math_substrate_route = "stdlib/lib/math/problem-kernel-substrate.px";
      math_object_kind = "verification-request";
      timeless_or_ordered = "ordered";
    }
    {
      id = "math-timeless";
      family = "math";
      description_en = "User states a timeless mathematical definition, theorem, or equation.";
      description_ko = "사용자가 시간 무관 수학 정의 / 정리 / 등식 진술.";
      end_marker_en = [ "." ];
      end_marker_ko = [ "다." "이다." ];
      keyword_en = [
        "definition" "Definition" "theorem" "Theorem" "axiom"
        "Axiom" "lemma" "Lemma" "by definition" "is defined as"
        "let " "Let "
        # math operator / expression hints — sentences carrying these
        # are mathematical statements even without a definition keyword.
        " = " "+ " "- " "^2" "^3"
      ];
      keyword_ko = [
        "정의" "정리" "공리" "보조정리"
        "정의는" "이라고 정의" "에 의하면" "라 하자" "라고 하자"
        # 수학 statement 의 한국어 종결 패턴
        "이다." "와 같다" "는 같다"
      ];
      math_substrate_route = "stdlib/lib/math/ambient-space.px";
      math_object_kind = "definition-or-theorem";
      timeless_or_ordered = "timeless";
    }
  ];

  ambientCount = builtins.length knownNLAmbients;
  ambientIds = builtins.map (a: a.id) knownNLAmbients;

  # === Sentence decomposition ====================================
  #
  # Strategy:
  #   1. Split on strong terminators: "." "?" "!" (en) + "다." "까." 등 (ko).
  #      Mixed en/ko 발화도 모두 잡힘.
  #   2. Each piece trimmed of trailing whitespace.
  #   3. Empty pieces (consecutive terminators) dropped.
  #
  # 이건 NL parser 가 아니라 *first-pass* 분해. 미세한 의미 단위는
  # 미래 piece 들이 (morphism / invariant) 가 다룬다.

  isWhitespace = c: c == " " || c == "\t" || c == "\n" || c == "\r";

  trim = s:
    let
      ll = builtins.stringLength s;
      lstrip = pos:
        if pos >= ll then ""
        else if isWhitespace (builtins.substring pos 1 s) then lstrip (pos + 1)
        else builtins.substring pos (ll - pos) s;
      rstrip = str:
        let
          n = builtins.stringLength str;
          last = if n == 0 then "" else builtins.substring (n - 1) 1 str;
        in
          if n == 0 then ""
          else if isWhitespace last then rstrip (builtins.substring 0 (n - 1) str)
          else str;
    in rstrip (lstrip 0);

  # UTF-8 char-boundary detection (2026-05-29 fix).
  # pnix-eval substring is byte-indexed: substring 0 1 "함" → ""
  # (partial UTF-8) but substring 0 3 "함" → "함" (complete char).
  # So char length is found by trying lengths 1..4 from a byte
  # position until a non-empty result. This way the walk advances
  # one *character* at a time, preserving multi-byte Korean / CJK
  # text correctly while still detecting ASCII terminators.
  nextCharLenAt = utterance: pos:
    let
      try1 = builtins.substring pos 1 utterance;
      try2 = builtins.substring pos 2 utterance;
      try3 = builtins.substring pos 3 utterance;
      try4 = builtins.substring pos 4 utterance;
    in
      if try1 != "" then 1
      else if try2 != "" then 2
      else if try3 != "" then 3
      else if try4 != "" then 4
      else 1;

  # Single-pass scan: collect runs delimited by ".", "?", "!".
  # Korean ending markers like "다." or "까?" carry one of the 3
  # ASCII terminators as their last byte — they split correctly.
  splitSentences = utterance:
    let
      ll = builtins.stringLength utterance;
      isTerminator = c: c == "." || c == "?" || c == "!";
      # Walk char-by-char (UTF-8 aware). Accumulate current
      # sentence string. On terminator, push (current + terminator),
      # reset, continue.
      walk = pos: cur: acc:
        if pos >= ll then
          if cur == "" then acc
          else acc ++ [ cur ]
        else
          let
            n = nextCharLenAt utterance pos;
            c = builtins.substring pos n utterance;
          in
            if isTerminator c then
              walk (pos + n) "" (acc ++ [ (cur + c) ])
            else
              walk (pos + n) (cur + c) acc;
      raw = walk 0 "" [];
      trimmed = builtins.map trim raw;
    in
      builtins.filter (s: s != "") trimmed;

  containsAny = haystack: needles:
    let
      hl = builtins.stringLength haystack;
    in
      builtins.any (n:
        let
          nl = builtins.stringLength n;
          scan = pos:
            if pos + nl > hl then false
            else if (builtins.substring pos nl haystack) == n then true
            else scan (pos + 1);
        in
          if nl == 0 then false else scan 0
      ) needles;

  # === Ambient classification per sentence atom ==================
  #
  # Each ambient row has end_marker_en/ko + keyword_en/ko hints.
  # A sentence is tagged with an ambient if EITHER its trailing
  # marker matches OR a keyword anywhere in the sentence matches.
  # Multiple matches → ambiguous (Held).

  # 2026-05-29 fix: end_marker "." is too generic — every declarative
  # ambient lists it. So matching purely on end_marker triggers all
  # statement-like ambients at once → ambiguous → unclassified.
  # New scheme:
  #   - keyword match is the *primary* signal
  #   - "?" trailing char specifically promotes intent-question
  #   - "!" trailing char specifically promotes instruction|confirmation
  #   - generic "." doesn't pick anyone — leaves it for keyword to decide
  #   - if nothing matches, default to intent-statement (the broad
  #     declarative bucket) so we don't held everything trivially.
  matchesAmbient = sentence: amb:
    let
      sl = builtins.stringLength sentence;
      last = if sl == 0 then "" else builtins.substring (sl - 1) 1 sentence;
      kwMatch =
        containsAny sentence amb.keyword_en
        || containsAny sentence amb.keyword_ko;
      qPromote = last == "?" && amb.id == "intent-question";
      ePromote = last == "!"
        && (amb.id == "intent-instruction" || amb.id == "intent-confirmation");
    in
      kwMatch || qPromote || ePromote;

  # Priority order — when multiple ambients match (e.g. an instruction
  # that also contains a quantifier keyword), pick the one with the
  # narrowest semantic intent. Order matters: more specific first.
  # Priority order, narrowest semantic intent first.
  #   - confirmation / meta / clarification are session-local responses
  #   - math-* sub-domain ambients (2026-05-29) are domain-specific
  #     and take precedence over generic instruction/statement so
  #     "x²-1=0 을 풀어" lands on math-procedure, not intent-instruction
  #   - conditional placed above question for "if … is …" parsing
  ambientPriority = [
    "intent-confirmation"
    "intent-meta"
    "intent-clarification"
    "math-procedure"
    "math-verification"
    "math-timeless"
    "intent-conditional"
    "intent-question"
    "intent-instruction"
    "intent-statement"
  ];

  pickFirstByPriority = matches:
    let
      idsMatched = builtins.map (m: m.id) matches;
      pick = pri:
        if pri == [] then null
        else
          let h = builtins.head pri; t = builtins.tail pri; in
          if builtins.elem h idsMatched then h else pick t;
    in
      pick ambientPriority;

  findAmbient = id:
    let
      found = builtins.filter (a: a.id == id) knownNLAmbients;
    in
      if found == [] then null else builtins.head found;

  # When the picked ambient is a math sub-domain, expose substrate
  # routing hints so downstream (resolve / propose / propose-final)
  # can dispatch directly into the existing math owners. These hints
  # live in carry, NEVER in public — substrate-internal name protection
  # (사용자 directive 2026-05-28).
  mathHints = amb:
    if amb.family == "math" then {
      math_substrate_route = amb.math_substrate_route;
      math_object_kind = amb.math_object_kind;
      timeless_or_ordered = amb.timeless_or_ordered;
    } else {};

  classifyAmbient = sentence:
    let
      matches = builtins.filter (a: matchesAmbient sentence a) knownNLAmbients;
      n = builtins.length matches;
    in
      if n == 0 then
        # No keyword / specific end-marker match. Default to the
        # declarative statement bucket — operator can still inspect
        # carry to see we had no strong signal.
        let amb = findAmbient "intent-statement"; in {
          outcome = "ambient-classified-default";
          sentence = sentence;
          ambient_id = amb.id;
          family = amb.family;
        }
      else
        let
          pickedId = pickFirstByPriority matches;
          amb = findAmbient pickedId;
        in
          ({
            outcome = "ambient-classified";
            sentence = sentence;
            ambient_id = amb.id;
            family = amb.family;
            alternates = builtins.filter (id: id != pickedId)
              (builtins.map (m: m.id) matches);
          }) // (mathHints amb);

  # === Decomposition + classification plate ======================
  #
  # Public-vs-carry envelope per user directive: response that goes
  # to the operator hides substrate-internal axiom ids, while a
  # nested `carry` field keeps the wiring for downstream plates.

  decomposeUtterance = utterance:
    if !(builtins.isString utterance) then {
      outcome = "held-non-string-utterance";
    }
    else
      let
        trimmed = trim utterance;
      in
        if trimmed == "" then {
          outcome = "held-empty-utterance";
        }
        else
          let
            sents = splitSentences trimmed;
            sentCount = builtins.length sents;
          in
            if sentCount == 0 then {
              outcome = "held-no-sentence-extracted";
              utterance = trimmed;
              reason_en = "Utterance has no terminating punctuation (./?/!).";
              reason_ko = "발화에 문장 종결 표시 (./?/!) 가 없음.";
            }
            else
              let
                classified = builtins.map (s: classifyAmbient s) sents;
                isClassified = c:
                  c.outcome == "ambient-classified"
                  || c.outcome == "ambient-classified-default";
                successful = builtins.filter isClassified classified;
                held = builtins.filter (c: !(isClassified c)) classified;
              in {
                outcome = "utterance-decomposed";
                sentence_count = sentCount;
                successful_count = builtins.length successful;
                held_count = builtins.length held;
                public = {
                  sentences = builtins.map (c:
                    if isClassified c then
                      let
                        amb = builtins.head (
                          builtins.filter (a: a.id == c.ambient_id) knownNLAmbients
                        );
                        defaulted = c.outcome == "ambient-classified-default";
                      in {
                        text = c.sentence;
                        mode_en = amb.description_en
                          + (if defaulted then " (defaulted)" else "");
                        mode_ko = amb.description_ko
                          + (if defaulted then " (기본값)" else "");
                      }
                    else {
                      text = c.sentence;
                      mode_en = "unclassified — needs clarification";
                      mode_ko = "분류 불가 — 명확화 필요";
                    }
                  ) classified;
                  sentence_count = sentCount;
                };
                carry = {
                  sentence_atoms = sents;
                  per_atom_ambient = classified;
                  axiom_origin = "axiom-90-nl-sentence-decomposition (lifts axiom-1-ambient-space)";
                  next_step_owners = [
                    "stdlib/lib/nl/sentence-morphism-detector.px  # future #91"
                    "stdlib/lib/nl/sentence-invariant-convergence.px # future #92"
                    "stdlib/lib/nl/sentence-meta-detection.px      # future #93"
                  ];
                };
              };

  applyNlSentenceDecompositionPlate = request:
    if !(builtins.isAttrs request) then {
      outcome = "held-non-attrs-request";
    }
    else if !(builtins.hasAttr "utterance" request) then {
      outcome = "held-missing-utterance-field";
    }
    else decomposeUtterance request.utterance;

  inventorySummary = _: {
    owner = ownerName;
    axiom_class = "nl-decomposition-axiom-90";
    nl_ambient_count = ambientCount;
    nl_ambient_ids = ambientIds;
    composes = "axiom-1-ambient-space (math/geometric → NL lift)";
    inherit framework_step;
    step_kind = stepKind;
    next_pieces = [
      "axiom-91-sentence-morphism (paraphrase / 인과)"
      "axiom-92-sentence-invariant-convergence (의미 수렴 핵심)"
      "axiom-93-sentence-second-order-meta (사용자 메타 발화)"
    ];
    new_decision_count = 0;
    bilingual = true;
    held_outcomes = [
      "held-non-string-utterance"
      "held-empty-utterance"
      "held-no-sentence-extracted"
      "held-no-ambient-matched"
      "held-ambiguous-ambient"
      "held-non-attrs-request"
      "held-missing-utterance-field"
    ];
  };

in {
  inherit
    ownerName knownNLAmbients ambientCount ambientIds
    trim isWhitespace splitSentences containsAny
    matchesAmbient classifyAmbient findAmbient
