let
  ownerName = "stdlib.nl.category-3-cells-multi-proof-substrate";

  twoCat = import nl/category-2-category-substrate-instance.px;

  # === 3-Cells: Multi-Proof Equivalence Substrate (agent-NL-178) =====
  #
  # 사용자 directive (2026-05-29):
  # > "3-cells: multi-proof equivalence comparisons (현재 implicit)"
  #
  # 2-category 안의 2-cells 사이의 *equivalence* 를 3-cells 로 표현.
  # In substrate: same lemma proved by DIFFERENT strategies yields
  # the same 2-cell (up to equivalence). 3-cell witnesses that
  # equivalence.

  stepKind = "3-cell-multi-proof-equivalence";
  framework_step =
    "3-cell substrate — equivalences between 2-cells via alternative proofs";

  # =================================================================
  # === Alternative proof strategies for paper-QED lemmas ===========
  # =================================================================
  #
  # For each lemma, list the strategies (both implemented and
  # candidate) that yield the same 2-cell.

  alternativeProofStrategies = {
    composability = {
      lemma_id = "theorem-NL-mode-chain-composability";
      original_strategy = {
        id = "case-analysis-15-pairs";
        description_en = "Direct verification of 15 consecutive output_kind == input_kind equalities.";
        proof_step_count = 15;
        implemented = true;
        location = "stdlib/lib/nl/category-composability-lemma.px";
      };
      alternative_strategies = [
        {
          id = "induction-on-chain-length";
          description_en = "Inductive argument: base k=0 (m_1 well-typed), step k→k+1 (m_{k+1} matches output of chain so far).";
          proof_step_count = "2 (base + step)";
          implemented = false;
          implementation_status = "candidate — same conclusion, more abstract";
        }
        {
          id = "type-checker-witness";
          description_en = "Treat composability as type-checking: the chain is well-typed iff each consecutive pair type-checks.";
          proof_step_count = "1 (delegated to Nix attribute access)";
          implemented = false;
          implementation_status = "candidate — appeals to host type system";
        }
      ];
      three_cell_witnesses_equivalence = true;
    };

    uniqueness = {
      lemma_id = "theorem-NL-mode-chain-uniqueness-of-factorization";
      original_strategy = {
        id = "extensionality-via-determinism";
        description_en = "Determinism of each m_i + induction + function extensionality.";
        proof_step_count = 6;
        implemented = true;
        location = "stdlib/lib/nl/category-uniqueness-factorization-lemma.px";
      };
      alternative_strategies = [
        {
          id = "category-theoretic-via-iso-classes";
          description_en = "Any two functors that factor identically through M are equal as objects in the slice category C/M.";
          proof_step_count = "3 (define slice, show single object, hence equal)";
          implemented = false;
          implementation_status = "candidate — more abstract categorical approach";
        }
      ];
      three_cell_witnesses_equivalence = true;
    };

    yoneda = {
      lemma_id = "theorem-yoneda-instance-for-verb-representability";
      original_strategy = {
        id = "Phi-Psi-mutual-inverse";
        description_en = "Construct Φ and Ψ explicitly, verify Φ∘Ψ = id and Ψ∘Φ = id.";
        proof_step_count = 7;
        implemented = true;
        location = "stdlib/lib/nl/category-yoneda-lemma-instance.px";
      };
      alternative_strategies = [
        {
          id = "via-end-formula";
          description_en = "Nat(y(v), F) = ∫_w Set(Hom(w,v), F(w)) = F(v) by end calculus.";
          proof_step_count = "1 (cite end calculus theorem)";
          implemented = false;
          implementation_status = "candidate — uses higher categorical machinery";
        }
        {
          id = "via-representable-density";
          description_en = "y is dense in presheaves; Yoneda is the universal property of representability.";
          proof_step_count = "2 (density + universal property)";
          implemented = false;
          implementation_status = "candidate — abstract density argument";
        }
      ];
      three_cell_witnesses_equivalence = true;
    };

    sheaf_condition = {
      lemma_id = "theorem-mode-14-15-16-sheaf-condition";
      original_strategy = {
        id = "site-check-plus-mode-classification";
        description_en = "Verify site axioms + classify each mode (Ω / direct image / forgetful) + sheaf gluing.";
        proof_step_count = 7;
        implemented = true;
        location = "stdlib/lib/nl/category-mode-14-15-16-sheaf-lemma.px";
      };
      alternative_strategies = [
        {
          id = "via-grothendieck-pretopology";
          description_en = "Show Site_coding admits a pretopology generating the topology, then F sheaf iff F sheaf on pretopology.";
          proof_step_count = "3 (pretopology + cover + descent)";
          implemented = false;
          implementation_status = "candidate — uses Grothendieck's original construction";
        }
      ];
      three_cell_witnesses_equivalence = true;
    };
  };

  # =================================================================
  # === 3-cells construction =======================================
  # =================================================================

  threeCells = builtins.map (lemma_key:
    let lemmaData = alternativeProofStrategies.${lemma_key}; in {
      id = "three-cell-" + lemma_key;
      kind = "proof-equivalence-3-cell";
      lemma_id = lemmaData.lemma_id;
      original_proof = lemmaData.original_strategy.id;
      alternative_proof_count = builtins.length lemmaData.alternative_strategies;
      alternative_proofs = builtins.map (alt: alt.id) lemmaData.alternative_strategies;
      equivalence_witness = lemmaData.three_cell_witnesses_equivalence;
      description_en =
        "3-cell witnessing that the "
        + builtins.toString (1 + builtins.length lemmaData.alternative_strategies)
        + " proof strategies for " + lemmaData.lemma_id + " yield the same 2-cell up to equivalence.";
    }
  ) (builtins.attrNames alternativeProofStrategies);

  threeCellCount = builtins.length threeCells;

  # =================================================================
  # === Identity 3-cell on a 2-cell =================================
  # =================================================================

  identityThreeCellOn = twoCell: {
    id = "id3_" + twoCell.id;
    kind = "identity-3-cell";
    on_2cell = twoCell.id;
    is_identity = true;
  };

  # =================================================================
  # === 3-cell composition laws =====================================
  # =================================================================

  threeCellLaws = [
    {
      law_id = "three-cell-vertical-composition";
      statement = "Given 3-cells Γ : α ⇛ β and Δ : β ⇛ γ between 2-cells α, β, γ : f ⇒ g, vertical composition Δ ⋅ Γ : α ⇛ γ exists.";
      enforced_by = "categorical-definition";
    }
    {
      law_id = "three-cell-horizontal-composition";
      statement = "Given 3-cells Γ : α ⇛ β (between 2-cells in plane 1) and Δ : α' ⇛ β' (in plane 2), horizontal composition Δ ∗ Γ exists.";
      enforced_by = "categorical-definition";
    }
    {
      law_id = "three-cell-whiskering-left";
      statement = "A 3-cell Γ : α ⇛ β can be whiskered on the left by a 2-cell γ to yield γ ∗ Γ : γ ∗ α ⇛ γ ∗ β.";
      enforced_by = "categorical-definition";
    }
    {
      law_id = "three-cell-whiskering-right";
      statement = "A 3-cell Γ : α ⇛ β can be whiskered on the right by a 2-cell δ to yield Γ ∗ δ : α ∗ δ ⇛ β ∗ δ.";
      enforced_by = "categorical-definition";
    }
    {
      law_id = "three-cell-pentagon-coherence";
      statement = "Higher coherence: the pentagon-style coherence for 3-cell associativity holds.";
      enforced_by = "categorical-definition (Gray-tensor or strict 3-category)";
    }
  ];

  # =================================================================
  # === Multi-proof equivalence registry ============================
  # =================================================================
  #
  # Each entry: a proof and its "yields the same 2-cell" guarantee.

  multiProofEquivalenceRegistry = builtins.map (lemma_key:
    let
      lemmaData = alternativeProofStrategies.${lemma_key};
      all_strategies = [ lemmaData.original_strategy ] ++ lemmaData.alternative_strategies;
    in {
      lemma_id = lemmaData.lemma_id;
      total_proof_strategies = builtins.length all_strategies;
      implemented_count = builtins.length (builtins.filter (s:
        if builtins.hasAttr "implemented" s then s.implemented else false
      ) all_strategies);
      candidate_count = builtins.length (builtins.filter (s:
        if builtins.hasAttr "implementation_status" s then true else false
      ) all_strategies);
      strategies = builtins.map (s: s.id) all_strategies;
      yields_same_2cell = true;  # by definition of "alternative proof of same theorem"
      witnessed_by_3_cell = "three-cell-" + lemma_key;
    }
  ) (builtins.attrNames alternativeProofStrategies);

  # =================================================================
  # === 3-category laws ==============================================
  # =================================================================

  threeCategoryLaws = {
    # Inherits 2-category laws (now between 2-cells), plus:
    inherited_from_2_category = (twoCat.twoCategoryLaws);
    new_laws_at_3_level = threeCellLaws;
    coherence_required = "Gray-tensor or strict-3-category coherence (pentagon-like)";
  };

  # =================================================================
  # === Inventory ====================================================
  # =================================================================

  inventorySummary = _: {
    owner = ownerName;
    category_level = 3;
    zero_cell_count = twoCat.zeroCellCount;
    one_cell_count = twoCat.oneCellCount;
    two_cell_count = twoCat.twoCellCount;
    three_cell_count = threeCellCount;
    alternative_proof_strategies = builtins.length (builtins.attrNames alternativeProofStrategies);
    three_cell_law_count = builtins.length threeCellLaws;
    has_3cell_vertical_composition = true;
    has_3cell_horizontal_composition = true;
    has_3cell_whiskering = true;
    has_identity_3_cells = true;
    multi_proof_lemma_count = builtins.length multiProofEquivalenceRegistry;
    infinity_category_current_level = 3;
    infinity_category_roadmap_open_at_level = 4;
  };

  # =================================================================
  # === Plate entry =================================================
  # =================================================================

  applyThreeCellsPlate = request:
    if !(builtins.isAttrs request) then { outcome = "held-non-attrs-request"; }
    else if builtins.hasAttr "inventory" request then {
      outcome = "three-cells-inventory"; receipt = inventorySummary {};
    }
    else if builtins.hasAttr "three_cells" request then {
      outcome = "three-cells-emitted"; receipt = threeCells;
    }
    else if builtins.hasAttr "multi_proof_registry" request then {
      outcome = "three-cells-multi-proof-registry-emitted";
      receipt = multiProofEquivalenceRegistry;
    }
    else if builtins.hasAttr "laws" request then {
      outcome = "three-cells-laws-emitted"; receipt = threeCategoryLaws;
    }
    else if builtins.hasAttr "alternative_strategies" request then
      let r = request.alternative_strategies;
      in if builtins.hasAttr r alternativeProofStrategies
         then { outcome = "three-cells-strategies-for-lemma";
                receipt = alternativeProofStrategies.${r}; }
         else { outcome = "held-unknown-lemma-key";
                receipt = { queried = r; available = builtins.attrNames alternativeProofStrategies; }; }
    else { outcome = "held-unknown-request-shape";
           receipt = { allowed_keys = [ "inventory" "three_cells" "multi_proof_registry" "laws" "alternative_strategies" ]; };
         };

in {
  inherit ownerName stepKind framework_step;
  inherit alternativeProofStrategies threeCells threeCellCount;
  inherit identityThreeCellOn threeCellLaws multiProofEquivalenceRegistry;
  inherit threeCategoryLaws inventorySummary applyThreeCellsPlate;
}
