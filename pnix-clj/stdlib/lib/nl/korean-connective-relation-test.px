# stdlib/lib/nl/korean-connective-relation-test.px
#
# F2/H1 lock: 연결어미 → discourse 관계 lift (connectiveToRelation).
#   korean-morphology clause-connectors(21쌍) 재사용(재구현 0). 명확=determinate, 모호(고/는데/아서/어서)=candidate,
#   미등록=unresolved(fail-closed). "표면 마커가 edge를 준다"의 L2(담화관계) 적용 — 결정론 owner는 .px.
let
  lift = import ./korean-taxonomy-lift.px;
  c = lift.connectiveToRelation;
  rNikka = c "니까"; rMyeon = c "면"; rJiman = c "지만"; rRyeogo = c "려고";
  rDorok = c "도록"; rAdo = c "아도"; rDaga = c "다가";
  rGo = c "고"; rNeunde = c "는데"; rAseo = c "아서"; rEoseo = c "어서";
  rUnknown = c "xyz";
in {
  cause = rNikka.relation;
  cond = rMyeon.relation;
  go_status = rGo.status;
  unknown_status = rUnknown.status;
  all_ok =
    # ★명확 연결어미 → determinate relation
       (rNikka.relation == "cause") && (rNikka.status == "determinate")
    && (rMyeon.relation == "conditional") && (rMyeon.status == "determinate")
    && (rJiman.relation == "contrast") && (rJiman.status == "determinate")
    && (rRyeogo.relation == "purpose") && (rDorok.relation == "purpose")
    && (rAdo.relation == "concession") && (rDaga.relation == "transition")
    # ★모호 연결어미 → candidate (fail-closed, C′/concept 패턴: 단일 표면이 둘+ relation)
    && (rGo.relation == "sequential") && (rGo.status == "candidate")
    && (rNeunde.status == "candidate")
    && (rAseo.relation == "cause") && (rAseo.status == "candidate")
    && (rEoseo.status == "candidate")
    # ★미등록 → unresolved (fail-closed, 추측 0)
    && (rUnknown.relation == null) && (rUnknown.status == "unresolved")
    # ko 라벨 동반(clause-relation-labels 정합)
    && (rNikka.ko == "원인") && (rMyeon.ko == "조건");
}
