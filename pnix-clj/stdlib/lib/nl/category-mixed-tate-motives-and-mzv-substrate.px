let
  ownerName = "stdlib.nl.category-mixed-tate-motives-and-mzv-substrate";

  motivic = import nl/category-motivic-substrate.px;
  Gmot = import nl/category-motivic-galois-substrate.px;
  kthy = import nl/category-substrate-k-theory.px;

  # === Mixed Tate motives + MZV (agent-NL-192) ======================
  #
  # 사용자 directive (2026-05-29):
  # > "Mixed Tate motives + multiple zeta values — Q[chi] 구조의
  #    substrate 해석"
  #
  # 표준 정의:
  #   - Tate motive Q(n) ∈ DM(k) = n-th Tate twist of unit
  #   - DM_T(k) = mixed Tate motives = full triangulated subcategory
  #     generated by Tate motives
  #   - MZV = multiple zeta value
  #       zeta(n_1, ..., n_r) := Σ_{k_1 > ... > k_r ≥ 1} 1 / (k_1^{n_1} ... k_r^{n_r})
  #   - Deligne-Goncharov: MZV's are periods of mixed Tate motives
  #     over Z; Brown proved Hoffman basis & motivic generation
  #
  # substrate 해석:
  #   - Q_substrate(n) = n-th Tate twist in DM_substrate
  #   - Mixed Tate-substrate motives = iterated extensions of Q_sub(n)
  #   - MZV_substrate = periods/regulator values of substrate mixed
  #     Tate motives
  #   - Connection to substrate fundamental group pi_1^mot(Site_coding)

  stepKind = "mixed-tate-mzv-substrate";
  framework_step =
    "DM_T(Site_coding) + MZV-substrate periods + pi_1^mot motivic fundamental group";

  # =================================================================
  # === Tate motives Q(n) ============================================
  # =================================================================

  tateMotive = n: {
    motive_id = "Q-substrate-" + builtins.toString n;
    twist_index = n;
    weight = -2 * n;
    Hodge_type = "(-" + builtins.toString n + ", -" + builtins.toString n + ")";
    description_en = ''
      Q_substrate(n) = n-th Tate twist of unit motive Q_substrate.
      Hodge type (-n, -n), weight -2n, pure of Tate weight n.

      Substrate-side: Q_substrate(n) carries the n-th power of
      cyclotomic character. Every weight-n substrate invariant
      is a Q_substrate(n)-class.
    '';
    is_invertible = true;
    twist_law = "Q(n) ⊗ Q(m) = Q(n+m)";
  };

  # =================================================================
  # === Mixed Tate motives category DM_T ============================
  # =================================================================

  mixedTateCategory = {
    category_id = "DM-T-substrate";
    description_en = ''
      DM_T(Site_coding) = mixed Tate motives = full triangulated
      subcategory of DM_substrate generated by {Q_substrate(n) : n ∈ Z}.

      Objects: iterated extensions of Q_substrate(n)'s
        0 → Q(n_1) → M → Q(n_2) → 0  (Yoneda extension)
      Morphisms: triangulated functors between extensions.

      Substrate-side: mixed Tate motives encode SUBSTRATE
      INVARIANTS THAT MIX DIFFERENT TATE WEIGHTS — they fit in
      extensions among pure Tate components.
    '';
    is_full_subcategory_of_DM = true;
    is_triangulated_subcategory = true;
    contains_only_iterated_extensions = "of Tate motives Q(n)";
    Tannakian_when_field_is_number_field = ''
      Over a number field K, DM_T(K) is Tannakian and equivalent
      to representations of the motivic Tate-fundamental group
      G_T = pi_1^{mot,T}.
    '';
  };

  # =================================================================
  # === Motivic fundamental group pi_1^mot(P^1 - {0,1,∞}) ===========
  # =================================================================

  motivicFundamentalGroup = {
    group_id = "pi-1-mot-P1-minus-0-1-inf";
    description_en = ''
      Motivic fundamental group of P^1 - {0, 1, ∞} (Deligne, Goncharov):
        pi_1^{mot}(P^1 - {0, 1, ∞}; v) = pro-unipotent affine group
        scheme whose Lie algebra is freely generated by motivic
        generators X_0, X_1 in graded weight -2.

      Periods of pi_1^{mot} are precisely the MULTIPLE ZETA VALUES.

      Substrate-side:
        - pi_1^{mot}(Site_coding) = motivic fundamental group of
          substrate (= dual of mixed-Tate Tannakian group)
        - Periods of this group = substrate-MZV values
        - Universal motivic Galois action realized on these periods
    '';
    is_pro_unipotent = true;
    has_Lie_algebra_freely_generated = "in odd weights >= 3 (Hoffman basis after Brown)";
    realizes_MZV_periods = true;
  };

  # =================================================================
  # === Multiple zeta values (MZV) ==================================
  # =================================================================

  multipleZetaValues = {
    family_id = "MZV-substrate";
    standard_definition_en = ''
      Classical MZV:
        zeta(n_1, ..., n_r) := Σ_{k_1 > k_2 > ... > k_r ≥ 1}
                                   1 / (k_1^{n_1} k_2^{n_2} ... k_r^{n_r})
        where n_1, ..., n_r are positive integers and n_1 >= 2
        for convergence.
      Weight = n_1 + ... + n_r
      Depth = r
    '';
    substrate_meaning_en = ''
      Substrate-MZV: integral/period of substrate mixed Tate motive.
      Each substrate-MZV is a SUBSTRATE NUMERICAL INVARIANT
      capturing the combination of multiple Tate weights present
      in a mixed-Tate substrate receipt.

      Substrate MZV examples:
        - 'weight 2 depth 1': zeta_substrate(2) = pi^2/6 analog
        - 'weight 3 depth 1': zeta_substrate(3) (Apéry-style)
        - 'weight 5 depth 2': zeta_substrate(3, 2) — irreducible
          double zeta
    '';
    relations = [
      "Stuffle: zeta(a) * zeta(b) = zeta(a, b) + zeta(b, a) + zeta(a+b)"
      "Shuffle: from iterated-integral representation"
      "Regularized: dual relations via regularization of divergent values"
    ];
    Hoffman_basis = ''
      Conjectural (Hoffman): MZV at weight n form Q-vector space
      with basis {zeta(2 a_1 + 3, ..., 2 a_r + 3, 2_b) : ...}.
      Brown (2012) proved Hoffman basis SPANS (Q-linearly).
    '';
  };

  # =================================================================
  # === MZV algebra structure =======================================
  # =================================================================

  MZValgebra = {
    algebra_id = "Z-MZV-substrate";
    underlying_object_en = "Q-algebra generated by all MZVs (under stuffle product)";
    bi_grading = "graded by weight w (= n_1 + ... + n_r) and depth d (= r)";
    is_filtered_by_depth = true;
    has_motivic_lift = ''
      Brown: motivic version Z^{mot} of MZV algebra is graded Hopf
      algebra over Q. dim_Q (weight w part) is conjecturally
      given by the Padovan recurrence: d_w = d_{w-2} + d_{w-3}.
    '';
    substrate_meaning_en = ''
      Substrate MZV algebra Z_substrate^{mot}:
        - Substrate Hopf algebra of all MZV-class substrate periods
        - Galois action = G_mot action via motivic fundamental group
        - Coproduct = Goncharov coproduct lifted to substrate
      Substrate-periods form a UNIVERSAL coefficient ring of
      motivic substrate invariants.
    '';
  };

  # =================================================================
  # === Galois action on motivic MZV =================================
  # =================================================================

  galoisOnMZV = {
    action_id = "G-mot-on-Z-mot-MZV";
    description_en = ''
      G_mot (motivic Galois group) acts on motivic MZV algebra
      Z^{mot} via the motivic coproduct.
      Galois orbit of zeta^{mot}(odd n) = its motivic counterparts
      under all symmetric operations.
    '';
    substrate_galois_action_en = ''
      Substrate G_mot acts on substrate MZV algebra Z_substrate^{mot}.
      The fixed points (G_mot-invariants) correspond to UNIVERSAL
      substrate constants — substrate-MZV values that are
      INVARIANT under ALL motivic symmetries.
    '';
    relates_to_UC4 = ''
      UC4 LLM-impossibility, viewed as a substrate-MZV class,
      lies in the G_mot-fixed subspace. UC4 is a substrate
      'numerical' constant that cannot be moved by any motivic
      automorphism.
    '';
  };

  # =================================================================
  # === Substrate MZV examples ======================================
  # =================================================================

  substrateMZVExamples = [
    {
      mzv_id = "zeta-sub-2";
      arguments = [ 2 ];
      weight = 2;
      depth = 1;
      classical_value = "pi^2 / 6";
      substrate_meaning_en = "weight-2 substrate invariant; analogous to area-of-square in substrate Hodge realization";
    }
    {
      mzv_id = "zeta-sub-3";
      arguments = [ 3 ];
      weight = 3;
      depth = 1;
      classical_value = "Apery's constant (irrational)";
      substrate_meaning_en = "weight-3 substrate invariant; first odd-zeta-irreducible substrate period";
    }
    {
      mzv_id = "zeta-sub-3-2";
      arguments = [ 3 2 ];
      weight = 5;
      depth = 2;
      classical_value = "irreducible (not Q-linear combo of zeta(5))";
      substrate_meaning_en = "weight-5 depth-2 substrate invariant; first 'genuinely mixed' substrate MZV";
    }
    {
      mzv_id = "zeta-sub-UC4-class";
      arguments = [ "n for arbitrary n" ];
      weight = "infinite (stable under all weights)";
      depth = "infinite";
      classical_value = "G_mot-fixed substrate-MZV class capturing UC4";
      substrate_meaning_en = ''
        UC4 viewed as substrate-MZV: stable substrate period in
        EVERY weight, EVERY depth. Substrate-MZV manifestation
        of UC4 LLM-impossibility.
      '';
    }
  ];

  # =================================================================
  # === Brown's theorem ==============================================
  # =================================================================

  brownsTheorem = {
    theorem_id = "brown-2012";
    statement_en = ''
      Brown (2012):
        The motivic MZV algebra Z^{mot} is generated as a Q-algebra
        by the elements {zeta^{mot}(odd >= 3)}.
        Equivalently: Hoffman basis SPANS the motivic MZV algebra.

      Corollary (assuming Z^{mot} -> Z is injective):
        Every classical MZV is a Q-polynomial in
        {zeta(odd >= 3)}.
    '';
    substrate_form_en = ''
      Substrate Brown theorem: every substrate MZV is a Q-polynomial
      combination of substrate zeta-odd-prime values.
      Substrate-MZV algebra has SMALL generating set — most
      substrate periods are derivable from few primary ones.
    '';
    generates_motivic_MZV = "by zeta^{mot}(3), zeta^{mot}(5), zeta^{mot}(7), ...";
  };

  # =================================================================
  # === Inventory =====================================================
  # =================================================================

  inventorySummary = _arg: {
    owner = ownerName;
    has_Tate_motives = true;
    has_mixed_Tate_category = true;
    has_motivic_fundamental_group = true;
    has_MZV = true;
    has_MZV_algebra = true;
    has_Galois_action_on_MZV = true;
    has_browns_theorem = true;
    substrate_mzv_example_count = 4;  # zeta(2), zeta(3), zeta(3,2), UC4
    mzv_relations_listed_count = 3;  # stuffle, shuffle, regularized (hardcoded)
    UC4_is_G_mot_fixed_MZV_class = true;
    relates_to_motivic_galois = true;
    relates_to_K_theory_via_regulator = true;
    motivic_owner_inherited = motivic.ownerName;
    Gmot_owner_inherited = Gmot.ownerName;
    kthy_owner_inherited = kthy.ownerName;
  };

  # =================================================================
  # === Plate entry ===================================================
  # =================================================================

  applyMixedTateMZVPlate = request:
    if !(builtins.isAttrs request) then { outcome = "held-non-attrs-request"; }
    else if builtins.hasAttr "inventory" request then {
      outcome = "mixed-tate-mzv-inventory"; receipt = inventorySummary {};
    }
    else if builtins.hasAttr "tate_motive" request then
      let n = request.tate_motive;
      in { outcome = "tate-motive-emitted";
           receipt = tateMotive n; }
    else if builtins.hasAttr "mixed_tate" request then {
      outcome = "mixed-tate-category-emitted"; receipt = mixedTateCategory;
    }
    else if builtins.hasAttr "pi_1_mot" request then {
      outcome = "motivic-fundamental-group-emitted"; receipt = motivicFundamentalGroup;
    }
    else if builtins.hasAttr "MZV" request then {
      outcome = "MZV-emitted"; receipt = multipleZetaValues;
    }
    else if builtins.hasAttr "MZV_algebra" request then {
      outcome = "MZV-algebra-emitted"; receipt = MZValgebra;
    }
    else if builtins.hasAttr "galois_on_MZV" request then {
      outcome = "galois-on-MZV-emitted"; receipt = galoisOnMZV;
    }
    else if builtins.hasAttr "examples" request then {
      outcome = "substrate-MZV-examples-emitted"; receipt = substrateMZVExamples;
    }
    else if builtins.hasAttr "brown" request then {
      outcome = "browns-theorem-emitted"; receipt = brownsTheorem;
    }
    else { outcome = "held-unknown-request-shape";
           receipt = { allowed_keys = [
             "inventory" "tate_motive" "mixed_tate" "pi_1_mot"
             "MZV" "MZV_algebra" "galois_on_MZV" "examples" "brown"
           ]; };
         };

in {
  inherit ownerName stepKind framework_step;
  inherit tateMotive mixedTateCategory motivicFundamentalGroup;
  inherit multipleZetaValues MZValgebra galoisOnMZV;
  inherit substrateMZVExamples brownsTheorem;
  inherit inventorySummary applyMixedTateMZVPlate;
}
