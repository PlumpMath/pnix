  calendarTopicCues = [
    "회의" "일정" "캘린더" "약속" "calendar" "Calendar" "meeting" "Meeting" "agenda" "Agenda"
  ];
  calendarScopeCues = [
    "오늘" "내일" "어제" "이번 주" "다음 주" "몇 시" "몇시" "언제" "정리"
    "알려줘" "알려 줘" "요약" "schedule" "Schedule" "today" "tomorrow" "when"
  ];
  liveCalendarQuestionOf = sentence:
