    in if liveWeather != null then null
       else if liveFinance != null then null
       else if liveSports != null then null
       else if liveTime != null then null
       else if liveCalendar != null then null
       else if liveLogistics != null then null
       else if secureMemory != null then null
       else if conversationControl != null then null
       else if deicticQuestion != null then null
       else if topic == null || topic == "" then null else {
      topic = topic;
      source_sentence = sentence;
      grounding_required = true;
      durable_truth = false;
      accepted_as_truth = false;
    };

  chatRespond = sentence:
    let rj = realizeJudgment sentence;
        routeFields = serviceRouteProjection sentence;
        parts = lift.splitClauseRelations sentence;
        # ★aux 구분: splitClauseRelations가 고/려고 connective를 쪼개므로 보조용언 단문(먹고 있다·가고 싶다·가려고 한다)도 splitN>1이 됨.
        #   마지막 절이 *bare 보조용언*(있/싶/하/되…)이면 복합문 아님=단문 aux 경로(과분리 회귀 방지). 진성복합(집에 간다·가게 된다)은 본동사라 통과.
        complexAuxVerbs = [ "있" "싶" "하" "되" "없" "않" "못하" "주" "보" "말" "계시" ];
        lastClauseAct = if (len parts) <= 1 then "" else (liftToProposition (elemAt parts ((len parts) - 1)).clause).action;
        isComplex = ((len parts) > 1) && ((builtins.elem lastClauseAct complexAuxVerbs) == false);
    in if (rj.verdict or "") == "weather-tool-needed"
       then ({ route = "weather_tool_needed"; verdict = "held-live-tool"; understood = true;
               held_kind = rj.held_kind;
               required_evidence = rj.required_evidence;
               speech_act = rj.speech_act; next_move = rj.next_move;
               route_eligible = true; answer = rj.response;
               service_route_proposed = false; })
       else if (rj.verdict or "") == "finance-tool-needed"
       then ({ route = "finance_tool_needed"; verdict = "held-live-tool"; understood = true;
               held_kind = rj.held_kind;
               required_evidence = rj.required_evidence;
