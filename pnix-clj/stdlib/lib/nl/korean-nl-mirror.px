               route_eligible = true; answer = rj.response;
               service_route_proposed = false; })
       else if (rj.verdict or "") == "sports-tool-needed"
       then ({ route = "sports_tool_needed"; verdict = "held-live-tool"; understood = true;
               held_kind = rj.held_kind;
               required_evidence = rj.required_evidence;
               speech_act = rj.speech_act; next_move = rj.next_move;
               route_eligible = true; answer = rj.response;
               service_route_proposed = false; })
       else if (rj.verdict or "") == "time-tool-needed"
       then ({ route = "time_tool_needed"; verdict = "held-live-tool"; understood = true;
               held_kind = rj.held_kind;
               required_evidence = rj.required_evidence;
               speech_act = rj.speech_act; next_move = rj.next_move;
               route_eligible = true; answer = rj.response;
               service_route_proposed = false; })
       else if (rj.verdict or "") == "calendar-tool-needed"
       then ({ route = "calendar_tool_needed"; verdict = "held-live-tool"; understood = true;
               held_kind = rj.held_kind;
               required_evidence = rj.required_evidence;
               speech_act = rj.speech_act; next_move = rj.next_move;
               route_eligible = true; answer = rj.response;
               service_route_proposed = false; })
       else if (rj.verdict or "") == "logistics-tool-needed"
       then ({ route = "logistics_tool_needed"; verdict = "held-live-tool"; understood = true;
               held_kind = rj.held_kind;
               required_evidence = rj.required_evidence;
               speech_act = rj.speech_act; next_move = rj.next_move;
               route_eligible = true; answer = rj.response;
               service_route_proposed = false; })
       else if (rj.verdict or "") == "secure-memory-needed"
       then ({ route = "secure_memory_needed"; verdict = "held-sensitive"; understood = true;
               held_kind = rj.held_kind;
               required_evidence = rj.required_evidence;
               speech_act = rj.speech_act; next_move = rj.next_move;
               route_eligible = true; answer = rj.response;
               service_route_proposed = false; })
       else if (rj.verdict or "") == "conversation-control"
       then ({ route = "conversation_control"; verdict = "conversation-control"; understood = true;
               speech_act = rj.speech_act; next_move = rj.next_move;
               route_eligible = true; answer = rj.response;
               service_route_proposed = false; })
       else if (rj.verdict or "") == "context-reference-needed"
       then ({ route = "context_reference_needed"; verdict = "held-context"; understood = true;
               held_kind = rj.held_kind;
               speech_act = rj.speech_act; next_move = rj.next_move;
               route_eligible = true; answer = rj.response;
               service_route_proposed = false; })
       else if (rj.verdict or "") == "concept-question"
       then ({ route = "concept_question"; verdict = "concept-question"; understood = true;
               concept_topic = rj.concept_topic;
               speech_act = rj.speech_act; next_move = rj.next_move;
               route_eligible = true; answer = rj.response;
               service_route_proposed = false; })
       else if isComplex
       # ★복합문: 단문 flatten 대신 다절 완전 이해(liftComplexSentence)+round-trip 검증(convergeComplexGate). 단문 경로(else) 무변=기존 테스트 무영향.
       then let cg = convergeComplexGate sentence;
                cgr = liftComplexSentence sentence;
                nn = cgr.clause_count;
                finalP = (elemAt cgr.clauses (nn - 1)).prop;
                ok = cg.verdict == "math-keep-complex";
            in ({ route = "korean_sentence_codec";
                  verdict = if ok then "math-keep" else "held-nl";   # compat: Rust consumer는 math-keep 읽음
                  understood = ok; complex = true; clause_count = nn; clauses = cgr.clauses;
                  action = finalP.action; tense = finalP.tense; mood = finalP.mood; roles = finalP.roles;
                  regenerated = if cg ? recovered then cg.recovered else "";
                  speech_act = rj.speech_act; next_move = rj.next_move;
                  route_eligible = ok; answer = rj.response; }
                // routeFields)
       # ★중첩 관형절(단문 안 관형절이 논항 수식): convergeGate가 adnominal-clause로 held하던 걸 완전 이해.
       #   relProp non-null + round-trip math-keep-rel 일 때만 관형 응답(additive=일반/복합문 무영향). 아니면 기존 단문 경로.
       else let relProp = liftRelativeClauseSentence sentence;
                relG = if relProp == null then null else convergeRelativeGate sentence;
            in if (relProp != null) && (relG.verdict == "math-keep-rel")
       then ({ route = "korean_sentence_codec"; verdict = "math-keep"; understood = true;
               relative = true; relative_head = relProp.relative_head;
               action = relProp.action; tense = relProp.tense; mood = relProp.mood; roles = relProp.roles;
               regenerated = if relG ? recovered then relG.recovered else "";
               speech_act = rj.speech_act; next_move = rj.next_move;
               route_eligible = true; answer = rj.response; }
             // routeFields)
       else let g = convergeGate sentence;
       in if (g.verdict or "") == "math-keep"
       then let p = liftToProposition sentence;
                regen = realizeSentence p;
            in ({ route = "korean_sentence_codec"; verdict = "math-keep"; understood = true;
                  action = p.action; tense = p.tense; mood = p.mood; roles = p.roles; regenerated = regen;
                  speech_act = rj.speech_act; next_move = rj.next_move;
                  route_eligible = true;   # ★Rust route 게이트: 거울이 판정, Rust는 이 boolean만 읽고 ferry/통과 결정
                  answer = rj.response; }
                // routeFields)
       else let reason = if g ? held_reason then g.held_reason
                         else if g ? scope_gap_reason then g.scope_gap_reason else g.verdict;
            in ({ route = "korean_sentence_codec"; verdict = (g.verdict or "held-nl"); understood = false;
                  held_reason = reason; speech_act = rj.speech_act; next_move = rj.next_move;
                  # ★held 중 *구조적으로 in-scope*(지시어 미해소·복문·작용소)만 routable=clarification 응답이 route에 닿음.
                  #   ill-formed/unparsed/held-empty(코딩요청·인사 포함)는 NOT routable → 기존 경로로 fall-through(코딩=code route).
                  route_eligible = builtins.elem reason [ "dangling-reference" "scope-out-of-codec" "operator-not-pure" ];
                  answer = rj.response; }
                // routeFields);

  # ★§25 judgment layer (Part F): convergeGate("무슨 구조") 다음을 닫음 = judgeUtterance("그래서 다음에 뭘").
  #   NL=제안자(구조신호=mood/held_reason에서 dialogue move *후보* propose, non-load-bearing), pure가 결정.
  #   입력별 하드코딩 답변 0 — speech_act/next_move 전부 *구조에서 파생*. 이게 "대화 이음"의 빠진 층.
  #   math-keep: mood→request/question/statement. held: held_reason→clarify/out-of-scope/unparsed.
  judgeUtterance = sentence:
    let wq = liveWeatherQuestionOf sentence;
        fq = liveFinanceQuestionOf sentence;
        sq = liveSportsQuestionOf sentence;
        tq = liveTimeQuestionOf sentence;
        calq = liveCalendarQuestionOf sentence;
        logq = liveLogisticsQuestionOf sentence;
        secq = secureMemoryQuestionOf sentence;
        ccq = conversationControlRequestOf sentence;
        dq = deicticQuestionOf sentence;
        cq = conceptQuestionOf sentence;
        routeFields = serviceRouteProjection sentence;
    in if wq != null
       then ({ verdict = "weather-tool-needed"; understood = true;
               speech_act = "question"; next_move = "answer-with-live-tool";
               response_kind = "held-explain";
               held_kind = wq.held_kind;
               grounding_required = true;
               durable_truth = false;
               accepted_as_truth = false;
               required_evidence = wq.required_evidence; }
             // routeFields)
       else if fq != null
       then ({ verdict = "finance-tool-needed"; understood = true;
               speech_act = "question"; next_move = "answer-with-live-tool";
               response_kind = "held-explain";
               held_kind = fq.held_kind;
               grounding_required = true;
               durable_truth = false;
               accepted_as_truth = false;
               required_evidence = fq.required_evidence; }
             // routeFields)
       else if sq != null
       then ({ verdict = "sports-tool-needed"; understood = true;
               speech_act = "question"; next_move = "answer-with-live-tool";
               response_kind = "held-explain";
               held_kind = sq.held_kind;
               grounding_required = true;
               durable_truth = false;
               accepted_as_truth = false;
               required_evidence = sq.required_evidence; }
             // routeFields)
       else if tq != null
       then ({ verdict = "time-tool-needed"; understood = true;
               speech_act = "question"; next_move = "answer-with-live-tool";
               response_kind = "held-explain";
               held_kind = tq.held_kind;
               grounding_required = true;
               durable_truth = false;
               accepted_as_truth = false;
               required_evidence = tq.required_evidence; }
             // routeFields)
       else if calq != null
       then ({ verdict = "calendar-tool-needed"; understood = true;
               speech_act = "question"; next_move = "answer-with-live-tool";
               response_kind = "held-explain";
               held_kind = calq.held_kind;
               grounding_required = true;
               durable_truth = false;
               accepted_as_truth = false;
               required_evidence = calq.required_evidence; }
             // routeFields)
       else if logq != null
       then ({ verdict = "logistics-tool-needed"; understood = true;
               speech_act = "question"; next_move = "answer-with-live-tool";
               response_kind = "held-explain";
               held_kind = logq.held_kind;
               grounding_required = true;
               durable_truth = false;
               accepted_as_truth = false;
               required_evidence = logq.required_evidence; }
             // routeFields)
       else if secq != null
       then ({ verdict = "secure-memory-needed"; understood = true;
               speech_act = "question"; next_move = "answer-with-secure-memory";
               response_kind = "held-explain";
               held_kind = secq.held_kind;
               grounding_required = true;
               durable_truth = false;
               accepted_as_truth = false;
               required_evidence = secq.required_evidence; }
             // routeFields)
       else if ccq != null
       then ({ verdict = "conversation-control"; understood = true;
               speech_act = ccq.speech_act; next_move = ccq.next_move;
               response_kind = ccq.response_kind;
               durable_truth = false;
               accepted_as_truth = false; }
             // routeFields)
       else if dq != null
       then ({ verdict = "context-reference-needed"; understood = true;
               speech_act = "clarify-reference"; next_move = "ask-referent";
               response_kind = "question";
               held_kind = dq.held_kind;
               grounding_required = true;
               durable_truth = false;
               accepted_as_truth = false; }
             // routeFields)
       else if cq != null
       then ({ verdict = "concept-question"; understood = true;
               speech_act = "question"; next_move = "answer-grounded";
               response_kind = "answer";
               concept_topic = cq.topic;
               grounding_required = true;
               durable_truth = false;
               accepted_as_truth = false; }
             // routeFields)
       else let g = convergeGate sentence;
                v = g.verdict;
            in if v == "math-keep"
       then let p = liftToProposition sentence;
                act = if p.mood == "imperative" then "request"
                      else if p.mood == "interrogative" then "question"
                      else "statement";
                move = if act == "request" then "acknowledge-assess-capability"
                       else if act == "question" then "answer-or-analyze"
                       else "acknowledge-or-record";
            in ({ verdict = "math-keep"; understood = true;
                  speech_act = act; next_move = move;
                  response_kind = (if act == "question" then "answer" else "inform");
                  action = p.action; mood = p.mood; tense = p.tense; roles = p.roles; }
                // routeFields)
       else let reason = if g ? held_reason then g.held_reason
                         else if g ? scope_gap_reason then g.scope_gap_reason else v;
                act = if reason == "dangling-reference" then "clarify-reference"
                      else if reason == "operator-not-pure" then "out-of-scope-operator"
                      else if reason == "scope-out-of-codec" then "out-of-scope-structure"
                      else "unparsed";
                move = if act == "clarify-reference" then "ask-referent"
                       else if act == "unparsed" then "ask-rephrase"
                       else "explain-limit";
            in ({ verdict = v; understood = false;
                  speech_act = act; next_move = move;
                  response_kind = (if (act == "clarify-reference") || (act == "unparsed") then "question" else "held-explain");
                  held_reason = reason; }
                // routeFields);

  # ★§25/Part F: judgment → 한국어 대화응답 realize. *대본 아님*: 입력별 분기 0.
  #   응답 = 닫힌 dialogue-move(speech_act) grammar + 명제 entity 파생(realizeSentence가 role/어미로 문장 만들듯,
  #   여기선 move로 응답 만듦=닫힌 grammatical class=owner 저작 구조출력, 헌법 OK). understood=구조분석 동반(입력마다 변함).
  realizeJudgment = sentence:
    let jd = judgeUtterance sentence;
    in if (jd.verdict or "") == "weather-tool-needed"
       then jd // {
         response = "현재/미래 날씨 질문은 live weather tool provenance 없이는 답을 단정할 수 없습니다. (held_kind=weather-tool-needed)";
       }
      else if (jd.verdict or "") == "finance-tool-needed"
       then jd // {
         response = "현재 시세·주가 질문은 live finance tool provenance 없이는 답을 단정할 수 없습니다. (held_kind=finance-tool-needed)";
       }
      else if (jd.verdict or "") == "sports-tool-needed"
       then jd // {
         response = "스포츠 경기 결과·일정 질문은 live sports tool provenance 없이는 답을 단정할 수 없습니다. (held_kind=sports-tool-needed)";
       }
      else if (jd.verdict or "") == "time-tool-needed"
       then jd // {
         response = "현재 시각 질문은 live time tool provenance 없이는 답을 단정할 수 없습니다. (held_kind=time-tool-needed)";
       }
      else if (jd.verdict or "") == "calendar-tool-needed"
       then jd // {
         response = "회의·일정 질문은 live calendar provenance 없이는 답을 단정할 수 없습니다. (held_kind=calendar-tool-needed)";
       }
      else if (jd.verdict or "") == "logistics-tool-needed"
       then jd // {
         response = "택배·배송 상태 질문은 live logistics provenance 없이는 답을 단정할 수 없습니다. (held_kind=logistics-tool-needed)";
       }
      else if (jd.verdict or "") == "secure-memory-needed"
       then jd // {
         response = "민감한 비밀값은 인증된 secret memory provenance 없이는 답할 수 없습니다. (held_kind=secure-memory-needed)";
       }
      else if (jd.verdict or "") == "conversation-control"
       then jd // {
         response = "응답 방식을 조정하겠습니다.";
       }
      else if (jd.verdict or "") == "context-reference-needed"
       then jd // {
         response = "지시 대상이 무엇인지 알려 주세요. (held_kind=context-reference-needed)";
       }
      else if (jd.verdict or "") == "concept-question"
       then jd // {
         response = "개념 질문으로 이해했습니다: " + jd.concept_topic + ". 그 질문에 답할 근거 데이터가 아직 없습니다.";
       }
      else if jd.understood
       then let roleStr = builtins.concatStringsSep ", " (map (r: r.role + "=" + r.entity) jd.roles);
                analysis = "[" + roleStr + "] 동작=" + jd.action + " (" + jd.tense + "/" + jd.mood + ")";
                prefix = if jd.speech_act == "request" then "요청으로 이해했습니다 — 수행 가능 여부 확인이 필요합니다. 분석: "
                         else if jd.speech_act == "question" then "질문으로 이해했습니다. 분석: "
                         else "서술로 이해했습니다. 분석: ";
            in jd // { response = prefix + analysis; }
      else let body = if jd.speech_act == "clarify-reference" then "지시 대상이 무엇을 가리키는지 알려 주세요."
                       else if jd.speech_act == "out-of-scope-structure" then "복문·내포 구조가 섞여 있습니다. 핵심 절부터 단문으로 나눠 주시겠어요?"
                       else if jd.speech_act == "out-of-scope-operator" then "부정·상·양상 같은 작용소가 있어 아직 순수 명제로 처리하지 못합니다. 작용소를 빼고 다시 말씀해 주시겠어요?"
                       else "문장 구조를 아직 이해하지 못했습니다. 다시 말씀해 주세요.";
            in jd // { response = body; };

  # ★§25 dispose의 multi-turn 확장 = B의 대화 정책(respondToMove). ★generic·data-driven(하드코딩 분기 0):
  #   정책 = adjacency-pair 표(언어학 닫힌 구조: question→answer·request→assess·statement→ack)…
  #   표면 = move→한글 grammar 표. *둘 다 DATA* — 새 move = row 추가, 엔진 코드 변경 0. 엔진 = generic lookup.
  #   typed-event relay 입력: respondToMove(move)는 incoming *move struct*(speech_act 보유)를 받음=재파싱 X.
  #   anti-parrot 구조보장: 응답 move 어휘(acknowledge/answer-…)≠incoming 어휘(statement/question/…)라 항상 다름.
  #   ★answer는 grounding(retrieval gap5) 전이라 정직히 "근거 없음"(가짜 답 금지).
  responsePolicy = {                          # incoming speech_act → 응답 move (adjacency pair, DATA)
    statement                = "acknowledge";
    question                 = "answer-grounded";
    request                  = "assess-capability";
    "clarify-reference"      = "referent-unknown";
    "out-of-scope-structure" = "request-rephrase";
    "out-of-scope-operator"  = "request-rephrase";
    unparsed                 = "request-rephrase";
  };
  responseSurface = {                         # 응답 move → 한글 표면 (DATA grammar; move 추가=row 추가)
    acknowledge          = "이해한 내용을 받았습니다.";
    "answer-grounded"    = "그 질문에 답할 근거 데이터가 아직 없습니다.";
    "assess-capability"  = "요청으로 받았습니다. 수행 가능 여부를 확인해야 합니다.";
    "referent-unknown"   = "지시 대상을 아직 알 수 없습니다.";
    "acknowledge-limit"  = "아직 처리 범위 밖임을 확인했습니다.";
    "request-rephrase"   = "다시 말씀해 주세요.";
  };
  # ★P4 non-breaking wrapper: chatRespond(불변) 위에 symbol-memory read-back evidence를 *공개안전 projection만* 부착.
  #   recognition ≠ truth — durable_truth/accepted_as_truth/ontology_assert_allowed = false (recEv가 보장).
  #   인식 대상 proposition = math-keep(이해된 문장)일 때만; held는 인식할 것 없음(빈 clue).
  #   memory_keys 없으면(=[]) 전부 missing = base 동작 byte-stable + 빈 memory_evidence(비파괴).
  #   args = 문자열(=memory 없음) 또는 { sentence, memory_keys, abstraction_statuses? }. chatRespond 시그니처는 *건드리지 않음*.
  #   ★P5-b call-site 합성: memory_evidence(P4)와 abstraction_status_evidence(P5)를 *병치*(한 함수에 머지 X — 다른 evidence_kind).
  #     abstraction_status_evidence = "내가 *아직 검증 못 한* abstraction"(held-pending-utility) — 현재 발화 인식 concept에 관한 것만.
  #     ★status ≠ truth(verified여도 false) · publicProjection만(internal/raw 비노출) · abstraction_statuses 없으면 빈 evidence(비파괴).
  chatRespondWithMemory = args:
    let sentence = if builtins.isAttrs args
                   then (if args ? sentence then args.sentence else "")
                   else args;
        memKeys = if builtins.isAttrs args && (args ? memory_keys) then args.memory_keys else [ ];
        absStatuses = if builtins.isAttrs args && (args ? abstraction_statuses) then args.abstraction_statuses else [ ];
        base = chatRespond sentence;
        prop = if (base.verdict or "") == "math-keep" then liftToProposition sentence else null;
        ev = recEv.mkMemoryEvidence { prop = prop; memory_keys = memKeys; };
        # recognized_concepts = 현재 발화의 *concept* symbol(술어 개념-축약, concept!=null)의 canonical_key(s:n:ingest)
        symsForConcept = if prop == null then [ ] else (propose.proposeSymbols prop).symbols;
        recogConcepts = builtins.map (s: s.canonical_key) (builtins.filter (s: s.concept != null) symsForConcept);
        absE = absEv.mkAbstractionStatusEvidence { abstraction_statuses = absStatuses; recognized_concepts = recogConcepts; };
        memPub = recEv.publicProjection ev;       # ★internal_results/recovered/store_key는 .px 밖으로 안 나감
        absPub = absEv.publicProjection absE;      # ★internal_entries/key/owner 비노출
        # ★C: catalog evidence(출처) + math derivation(도출)을 *병치*(distinct kind, 머지 X — DR anti-post-rationalization).
        #   domain hint(catalog_terms/math_query) 있을 때만 부착 → 없으면 byte-stable(비파괴).
        # ★Fix #6(적대검증): 키 *값* 검사(존재만으론 catalog_terms=[]·math_query=null도 attach 트리거 → byte-stable 깨짐).
        domArgs = builtins.isAttrs args &&
          ( ((args ? catalog_terms) && (builtins.isList args.catalog_terms) && ((builtins.length args.catalog_terms) > 0))
            || ((args ? math_query) && (args.math_query != null)) );
        domHint = if domArgs == false then null
                  else de.mkDomainEvidence {
                         catalog_terms = if args ? catalog_terms then args.catalog_terms else [ ];
                         math_query = if args ? math_query then args.math_query else null;
                       };
        # ★P6→D 보고면: 공개 evidence만 입력 → "왜 그렇게 이해했는가" 4-face(기억/증거/도출/보류). leak-safe.
        #   domain evidence 있으면 증거/도출 face도 채움(없으면 기존 P6 2-face).
        report = ur.mkUnderstandingReport (
          { memory_evidence = memPub; abstraction_status_evidence = absPub; }
          // (if domHint == null then { }
              else { catalog_readback_evidence = domHint.catalog_readback_evidence;
                     math_evidence = domHint.math_evidence; }));
        # ★receipt→evidence 재배치(H3/F11): 무게중심=의미노드(base의 action/roles), receipt/회상/도출=그 노드에 붙는
        #   *단일 evidence envelope*. flat sibling 키(memory_evidence 등)는 Rust consumer 호환용 잠정 유지(ratchet→evidence.*).
        evidence = {
          memory = memPub;                  # P4 회상(durable_truth=false)
          abstraction_status = absPub;      # P5 추상화 지위
          understanding_report = report;    # P6 "왜 그렇게 이해" (설명일 뿐 truth 아님)
        } // (if domHint == null then { }
              else { catalog_readback = domHint.catalog_readback_evidence;   # C: 출처-attributed
                     math = domHint.math_evidence; });                       # C: derivation(회상과 구별)
        res0 = base // {
                 evidence = evidence;                      # ★node-attached evidence(재배치 정본)
                 memory_evidence = memPub;                 # (compat: flat sibling — ratchet)
                 abstraction_status_evidence = absPub;     # (compat)
                 understanding_report = report;            # (compat)
               };
    in if domHint == null then res0
       else res0 // {
              catalog_readback_evidence = domHint.catalog_readback_evidence;  # (compat: flat sibling — ratchet)
              math_evidence = domHint.math_evidence;                          # (compat)
            };

  respondToMove = move:                        # move(=judgeUtterance/chatRespond 결과) → B의 응답 move + 한글
    let act = move.speech_act or "unparsed";
        respKind = responsePolicy.${act} or "request-rephrase";
        surface = responseSurface.${respKind} or "다시 말씀해 주세요.";
    in { in_response_to = act; response_move = respKind; response = surface; };
  respondToUtterance = sentence: respondToMove (judgeUtterance sentence);  # 1-hop 편의(B가 A 발화 자체를 받을 때)

  # ★§24 ②연결의 multi-turn fold = dialogueFold. 발화 리스트를 *대화*로 접음(SDRT LAST식 event-fold).
  #   각 턴: judgeUtterance → respondToMove + **context graph 누적**(discourse-context-mirror 재사용=새 거울 X).
  #   ★핵심: 지시어(그것을…)가 단문선 dangling held지만 *앞 턴 entity*가 context에 있으면 *결속*(DRT/Right Frontier)
  #     → "대화가 이어진다"의 본질(2-hop이 *의미 있게* 닫힘). pure .px=typed-event relay 설계 증명·de-risk.
  splitWords = u: builtins.filter builtins.isString (builtins.split " " u);
  dialogueFold = utterances:
    let n = builtins.length utterances;
        go = i: ctx: acc:
          if i >= n then acc
          else let u = builtins.elemAt utterances i;
                   move = judgeUtterance u;
                   moveRoles = if (move ? roles) then move.roles else [ ];
                   deictics = builtins.filter dc.isReference (splitWords u);
                   ante = if (deictics != [ ]) && (ctx != [ ]) then dc.resolveReference ctx else null;
                   boundRef = if ante == null then null else ante.name;
                   resp = if boundRef != null
                          then { response_move = "reference-resolved";
                                 response = resolveJosaMarkers ("지시 대상을 " + boundRef + "{josa:으로|로} 이해했습니다."); }
                          else respondToMove move;
                   newEnts = if (move.understood or false) && (moveRoles != [ ])
                             then builtins.map (r: dc.mkEntity { name = r.entity; kind = "thing"; at = i; }) moveRoles
                             else [ ];
                   turnRec = { turn = i; utterance = u; speech_act = move.speech_act;
                               bound_reference = boundRef;
                               response_move = resp.response_move; response = resp.response; };
               in go (i + 1) (ctx ++ newEnts) (acc ++ [ turnRec ]);
    in go 0 [ ] [ ];

  inventorySummary = _: {
    owner = "stdlib.nl.korean-nl-mirror";
    consumes = "korean-taxonomy-lift(lift) + hangul-mirror(받침) + meta-mirror-primitive (data-only; 비수정)";
    role = "한국어 NL 거울: proposition ⟷ 한글 문장. diverge(realizeSentence 받침-aware 조사)+converge(liftSentence)+roundTrip=id. NL 자체가 meta-mirror instance";
    note = "운영자: 한국어=primary semantic surface. canonical proposition 왕복 깨끗(counit iso); 표면 다의어/생략/문맥은 disambiguate(held+후보). hangul-mirror 받침 재사용.";
  };

in {
  inherit
	    hasBatchim finalKindOf lensRole attachParticle tenseMoodEnding realizeVerb realizeVerbLevel
	    realizeVerbLevelHonorific realizeVerbLevelKind realizeVerbLevelKindHonorific
    finalSound selectJosa resolveJosaMarkers
    propToTerm termToProp termRoundTrip convergeGate serviceRouteProjection chatRespond chatRespondWithMemory judgeUtterance realizeJudgment respondToMove respondToUtterance dialogueFold
    realizeSentence liftToProposition liftDiscourse propEq mkProposition roundTrip
    relationConnector realizeClauseConnective realizeClause realizeComplex realizeQuantityPhrase
    realizeAdnominal realizeRelativeNP realizeQuotation parseQuotation
    interSentenceConnectorOf discourseGraph liftComplexSentence convergeComplexGate liftRelativeClauseSentence convergeRelativeGate
    inventorySummary;
  ownerName = "stdlib.nl.korean-nl-mirror";
  meta = {
    source = "stdlib nl korean-nl-mirror (ontology proposition <-> Korean sentence; NL as reflection)";
    owner = "stdlib.nl.korean-nl-mirror";
    base = "korean-nl-mirror-v0";
    rev_note = "idea.md (2026-06-14) 한국어 NL 거울 = ontology proposition(정본) ⟷ 한글 문장(표면). diverge=realizeSentence(역할→조사 받침규칙 이/가·을/를·은/는·와/과 교체[hangul-mirror decompose 종성 재사용]+동사 tense/mood 어미), converge=korean-taxonomy-lift.liftSentence, roundTrip=propEq 항등(canonical proposition 위; counit iso). 운영자: 한글문장은 바로 그래프, 한국어=LLM-free NL→code/math primary semantic surface, MEta-mirror-primitive 로. 표면 다의어/생략/문맥=under-determined=disambiguate(held+후보). korean-taxonomy-lift/hangul-mirror/meta-mirror-primitive 비수정 조립.";
  };
}
