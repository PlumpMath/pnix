  ];
  sportsTemporalCues = [ "오늘" "내일" "어제" "today" "Today" "tomorrow" "Tomorrow" "yesterday" "Yesterday" ];
  sportsRequestCues = [ "알려줘" "알려 줘" "뭐야" "어때" "결과" "일정" "score today" ];
