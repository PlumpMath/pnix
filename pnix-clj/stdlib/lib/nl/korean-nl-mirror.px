  timeTopicCues = [ "몇 시" "몇시" "현재 시간" "지금 시간" "what time" "What time" "current time" "Current time" "time in " ];
  timeLiveCues = [ "지금" "현재" "now" "Now" "Seoul" "seoul" "서울" "UTC" "timezone" "time zone" ];
  liveTimeQuestionOf = sentence:
