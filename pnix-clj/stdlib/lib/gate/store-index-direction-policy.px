# stdlib.lib.gate.store-index-direction-policy
#
# OWNER-LAW (2026-05-31): store secondary index direction (write/remove) policy.
#
# # What this is for
#
# secondary index 의 2 방향 — record/fact 가 추가될 때 push (index entry
# 생성) / 제거될 때 remove (index entry 정리). lll lens (fact store index
# registry) 의 보충 direction lens.

let
  ownerName = "stdlib/lib/gate/store-index-direction-policy.px";

  mkDirection = id: opName: triggerEvent: comment:
    { direction_id = id; op_name = opName;
      trigger_event = triggerEvent;
      semantic = comment; };

  directions = [
    (mkDirection "Write" "push_pending_index" "record/fact added"
      "secondary index entry 추가 (lll lens 의 9 indices)")
    (mkDirection "Remove" "remove_pending_index" "record/fact removed"
      "secondary index entry 제거 (대칭 cleanup)")
  ];

  validRequestKinds = [
    "list-directions"
    "lookup-direction"
  ];

  validVerdicts = [
    "directions-listed"
    "direction-resolved"
    "direction-unknown"
    "held-unknown-request-kind"
  ];

  asString = v: if builtins.isString v then v else "";

  lookupDirection = id:
    builtins.foldl' (acc: d: if acc != null then acc
      else if d.direction_id == id then d else null) null directions;

  applyStoreIndexDirectionPolicy = request:
    let
      reqKind = asString (request.request_kind or "");
    in
      if reqKind == "list-directions" then {
        verdict = "directions-listed";
        directions = directions;
        composed_lens_ref = "lll (fact-store-index-policy: 9 fact indices + 1 knowledge index)";
        lens_owner = ownerName;
        candidate_only = true;
      }
      else if reqKind == "lookup-direction" then
        let
          id = asString (request.direction_id or "");
          hit = lookupDirection id;
        in
          if hit != null then {
            verdict = "direction-resolved";
            inherit (hit) direction_id op_name trigger_event semantic;
            lens_owner = ownerName;
            candidate_only = true;
          }
          else {
            verdict = "direction-unknown";
            direction_id = id;
            valid_directions = builtins.map (d: d.direction_id) directions;
            lens_owner = ownerName;
            candidate_only = true;
          }
      else {
        verdict = "held-unknown-request-kind";
        request_kind = reqKind;
        valid_request_kinds = validRequestKinds;
        lens_owner = ownerName;
        candidate_only = true;
      };

in {
  inherit ownerName directions validRequestKinds validVerdicts
          applyStoreIndexDirectionPolicy;
}
