# KIGAM Geo Big Data catalog metadata -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No GIS/SHP/map payloads/geohazard advice/graph wiring.
let
  B = builtins;
  genPath = ./kigam-geodata-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "science.kigam_geodata.catalog.v1";
    source = "KIGAM Geo Big Data Open Platform geodata catalog metadata";
    license = "KIGAM public catalog metadata; GIS payload licenses not ingested";
    summary = { pages = 0; coarse_datasets = 0; files = 0; };
    policy = "KIGAM public catalog/search/detail/OpenAPI guide metadata only";
    manifest = { };
    pages = [ ]; coarse_datasets = [ ]; files = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "kigam-geodata-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/kigam-geodata-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "science.kigam_geodata.catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "kigam-geodata-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/kigam-geodata-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "science.kigam_geodata.catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
