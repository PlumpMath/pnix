# Cucumber Gherkin grammar/dialect metadata -> redb corpus_source_records lane.
# Stores pnix attrset source, not JSON. No parser/test execution or graph wiring.
let
  B = builtins;
  genPath = ./cucumber-gherkin.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "code.cucumber_gherkin.grammar.v1";
    source = "cucumber/gherkin root grammar and dialect keywords";
    license = "MIT";
    source_files = [ ]; grammar_rules = [ ]; grammar_tokens = [ ]; dialects = [ ]; keywords = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "cucumber-gherkin-load-v0";
      source_lens = "stdlib/lib/corpus/cucumber-gherkin-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "code.cucumber_gherkin.grammar.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "cucumber-gherkin-query-v0";
      source_lens = "stdlib/lib/corpus/cucumber-gherkin-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "code.cucumber_gherkin.grammar.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
