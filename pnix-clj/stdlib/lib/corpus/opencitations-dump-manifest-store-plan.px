# stdlib/lib/corpus/opencitations-dump-manifest-store-plan.px — OpenCitations dump manifest metadata.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# RDF/CSV payloads/citation edges/API-SPARQL harvest/bibliographic values/profiling/graph wiring 없음.
let
  B = builtins;
  genPath = ./opencitations-dump-manifest.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "scholarly.opencitations.dump_manifest.v1";
    source = { name = "OpenCitations dump manifests"; license = "CC0-1.0"; scope = "empty seed fallback"; };
    summary = { article_count = 0; dump_payloads_downloaded = false; mirror_graph_wiring = false; };
    source_files = [ ]; articles = [ ]; archive_files = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "opencitations-dump-manifest-load-v0";
      source_lens = "stdlib/lib/corpus/opencitations-dump-manifest-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "scholarly.opencitations.dump_manifest.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "opencitations-dump-manifest-query-v0";
      source_lens = "stdlib/lib/corpus/opencitations-dump-manifest-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "scholarly.opencitations.dump_manifest.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
