# NCBI Gene reference catalog -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No sequences/phenotypes/design payloads/graph wiring.
let
  B = builtins;
  genPath = ./ncbi-gene-reference-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "genome.ncbi_gene.reference_catalog.v1";
    source = "NCBI Gene reference catalog";
    license = "US-PD / NCBI public data caveats";
    policy = "bounded gene identifier metadata only";
    summary = { species_files = 0; rows = 0; };
    manifest = { }; species = [ ]; genes = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "ncbi-gene-reference-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/ncbi-gene-reference-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "genome.ncbi_gene.reference_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "ncbi-gene-reference-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/ncbi-gene-reference-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "genome.ncbi_gene.reference_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
