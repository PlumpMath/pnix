# NASA DONKI API metadata -> redb corpus_source_records lane.
# Stores pnix attrset source, not JSON. No event fetch/execution/graph wiring.
let
  B = builtins;
  genPath = ./nasa-donki-api-metadata.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "space_weather.nasa_donki.api_metadata.v1";
    source = "NASA CCMC DONKI public documentation endpoint metadata";
    license = "USGOV-PUBLIC-METADATA";
    source_files = [ ]; catalogs = [ ]; endpoints = [ ]; parameters = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "nasa-donki-api-metadata-load-v0";
      source_lens = "stdlib/lib/corpus/nasa-donki-api-metadata-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "space_weather.nasa_donki.api_metadata.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "nasa-donki-api-metadata-query-v0";
      source_lens = "stdlib/lib/corpus/nasa-donki-api-metadata-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "space_weather.nasa_donki.api_metadata.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
