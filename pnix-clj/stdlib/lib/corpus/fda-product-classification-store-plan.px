# stdlib/lib/corpus/fda-product-classification-store-plan.px — FDA device product classification metadata.
# redb corpus_source_records에 pnix attrset source(JSON 아님)로 append한다.
# openfda id arrays, definition prose, adverse events, recalls, medical advice, graph wiring 없음.
let
  B = builtins;
  genPath = ./fda-product-classification.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "device.fda_product_classification.v1";
    source = { name = "openFDA Device Classification"; license = "CC0-1.0 / FDA public domain unless otherwise noted"; scope = "empty seed fallback"; };
    summary = { last_updated = ""; api_total = 0; stored_count = 0; openfda_identifier_arrays_ingested = false; definition_prose_ingested = false; adverse_event_reports_ingested = false; recall_narratives_ingested = false; medical_advice_ingested = false; mirror_graph_wiring = false; };
    classifications = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "fda-product-classification-load-v0";
      source_lens = "stdlib/lib/corpus/fda-product-classification-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "device.fda_product_classification.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "fda-product-classification-query-v0";
      source_lens = "stdlib/lib/corpus/fda-product-classification-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "device.fda_product_classification.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
