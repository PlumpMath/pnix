# stdlib/lib/corpus/kr-public-units-catalog-store-plan.px — Korean public units catalog metadata.
# redb corpus_source_records에 pnix attrset source(JSON 아님)로 append한다.
# 법령/표준 전문, PDF/HWP, API payload, advice, graph wiring 없음.
let
  B = builtins;
  genPath = ./kr-public-units-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "units.kr_public_units_catalog.v1";
    source = "Korean official public units catalog metadata and legal-unit facts";
    license = "KR official public metadata / legal facts where applicable";
    policy = "empty seed fallback";
    summary = { legal_base_unit_count = 0; legal_unit_class_count = 0; source_count = 0; payload_rows_ingested = false; mirror_graph_wiring = false; };
    legal_base_units = [ ]; legal_unit_classes = [ ]; unit_related_dataset_fields = [ ]; sources = [ ]; files = [ ]; manifest = { };
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "kr-public-units-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/kr-public-units-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "units.kr_public_units_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "kr-public-units-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/kr-public-units-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "units.kr_public_units_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
