# Public service guidance catalog -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No prose/PDF bodies/templates/source code/graph wiring.
let
  B = builtins;
  genPath = ./service-guidance-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "service.guidance_catalog.v1";
    source = "public service guidance catalog";
    license = "Mixed US-PD/CC0/OGL-3.0";
    policy = "page heading/link/path metadata only";
    summary = { pages = 0; links = 0; paths = 0; };
    manifest = { }; pages = [ ]; links = [ ]; paths = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "service-guidance-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/service-guidance-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "service.guidance_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "service-guidance-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/service-guidance-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "service.guidance_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
