# Credential Engine CTDL schema metadata -> redb corpus_source_records lane.
# Stores pnix attrset source, not JSON. No registry records or graph wiring.
let
  B = builtins;
  genPath = ./credential-engine-ctdl.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "education.credential_engine.ctdl_schema.v1";
    source = "Credential Engine CTDL context/encoding schema metadata";
    license = "CC-BY-4.0";
    source_files = [ ]; context_terms = [ ]; terms = [ ]; type_counts = [ ]; summary = { };
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "credential-engine-ctdl-load-v0";
      source_lens = "stdlib/lib/corpus/credential-engine-ctdl-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "education.credential_engine.ctdl_schema.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "credential-engine-ctdl-query-v0";
      source_lens = "stdlib/lib/corpus/credential-engine-ctdl-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "education.credential_engine.ctdl_schema.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
