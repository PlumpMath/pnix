# WHATWG URL/MIME Sniffing structural metadata -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No prose/examples/runtime execution/graph wiring.
let
  B = builtins;
  genPath = ./whatwg-mime-url.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "web.whatwg.mime_url_metadata.v1";
    source = "WHATWG URL and MIME Sniffing structural metadata";
    license = "CC-BY-4.0 / BSD-3-Clause";
    summary = { documents = 0; headings = 0; dfns = 0; idl_blocks = 0; code_markers = 0; };
    policy = "Bikeshed structural identifiers only";
    manifest = { };
    documents = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "whatwg-mime-url-load-v0";
      source_lens = "stdlib/lib/corpus/whatwg-mime-url-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "web.whatwg.mime_url_metadata.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "whatwg-mime-url-query-v0";
      source_lens = "stdlib/lib/corpus/whatwg-mime-url-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "web.whatwg.mime_url_metadata.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
