# package-url spec metadata -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No registry payload/prose/graph wiring.
let
  B = builtins;
  genPath = ./purl-spec.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "license.purl_spec.v1";
    source = "package-url specification machine-readable metadata";
    license = "MIT";
    summary = { types = 0; schemas = 0; repository_backed_types = 0; };
    policy = "purl type/schema structural metadata only";
    manifest = { };
    files = [ ]; types = [ ]; schemas = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "purl-spec-load-v0";
      source_lens = "stdlib/lib/corpus/purl-spec-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "license.purl_spec.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "purl-spec-query-v0";
      source_lens = "stdlib/lib/corpus/purl-spec-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "license.purl_spec.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
