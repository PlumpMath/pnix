# stdlib/lib/corpus/prometheus-data-model-store-plan.px — Prometheus data model structural metadata.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# Go/prose bodies, real telemetry, alert routing, execution, graph wiring 없음.
let
  B = builtins;
  genPath = ./prometheus-data-model.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "telemetry.prometheus.data_model.v1";
    source = { name = "Prometheus data model structural metadata"; license = "Apache-2.0"; scope = "empty seed fallback"; };
    summary = { source_file_count = 0; go_type_count = 0; go_const_count = 0; };
    source_files = [ ]; go_types = [ ]; go_consts = [ ]; go_funcs = [ ]; section_headings = [ ]; tokens = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "prometheus-data-model-load-v0";
      source_lens = "stdlib/lib/corpus/prometheus-data-model-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "telemetry.prometheus.data_model.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "prometheus-data-model-query-v0";
      source_lens = "stdlib/lib/corpus/prometheus-data-model-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "telemetry.prometheus.data_model.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
