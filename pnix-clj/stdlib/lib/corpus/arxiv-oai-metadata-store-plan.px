# stdlib/lib/corpus/arxiv-oai-metadata-store-plan.px — arXiv OAI-PMH metadata snapshot.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# PDF/TeX/fulltext/abstract-title-author values/bulk payloads/graph wiring 없음.
let
  B = builtins;
  genPath = ./arxiv-oai-metadata.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "scholarly.arxiv.oai_metadata.v1";
    source = { name = "arXiv OAI-PMH metadata"; license = "CC0-1.0 for descriptive metadata"; scope = "empty seed fallback"; };
    summary = { record_count = 0; fulltext_payloads_downloaded = false; mirror_graph_wiring = false; };
    source_files = [ ]; identity = { }; metadata_formats = [ ]; sets = [ ]; records = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "arxiv-oai-metadata-load-v0";
      source_lens = "stdlib/lib/corpus/arxiv-oai-metadata-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "scholarly.arxiv.oai_metadata.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "arxiv-oai-metadata-query-v0";
      source_lens = "stdlib/lib/corpus/arxiv-oai-metadata-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "scholarly.arxiv.oai_metadata.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
