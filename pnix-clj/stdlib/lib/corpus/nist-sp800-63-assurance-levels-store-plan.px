# stdlib/lib/corpus/nist-sp800-63-assurance-levels-store-plan.px — NIST SP800-63 assurance-level metadata.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# requirement prose, compliance advice, auth policy, graph wiring 없음.
let
  B = builtins;
  genPath = ./nist-sp800-63-assurance-levels.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "security.nist_sp800_63_assurance_levels.v1";
    source = { name = "NIST SP800-63 assurance-level metadata"; license = "US-PD"; scope = "empty seed fallback"; };
    summary = { assurance_level_count = 0; requirement_prose_ingested = false; mirror_graph_wiring = false; };
    assurance_levels = [ ]; documents = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "nist-sp800-63-assurance-levels-load-v0";
      source_lens = "stdlib/lib/corpus/nist-sp800-63-assurance-levels-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "security.nist_sp800_63_assurance_levels.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "nist-sp800-63-assurance-levels-query-v0";
      source_lens = "stdlib/lib/corpus/nist-sp800-63-assurance-levels-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "security.nist_sp800_63_assurance_levels.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
