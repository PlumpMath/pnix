# OpenML API bounded schema inventory -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No dataset/run values/execution/graph wiring.
let
  B = builtins;
  genPath = ./openml-api-schema.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "ml.openml.api_schema.v1";
    source = "OpenML API bounded schema inventory";
    license = "CC-BY / OpenML public metadata";
    summary = { endpoints = 0; key_paths = 0; limit = 0; };
    policy = "API schema key/type inventory only";
    manifest = { };
    files = [ ]; endpoints = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "openml-api-schema-load-v0";
      source_lens = "stdlib/lib/corpus/openml-api-schema-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "ml.openml.api_schema.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "openml-api-schema-query-v0";
      source_lens = "stdlib/lib/corpus/openml-api-schema-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "ml.openml.api_schema.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
