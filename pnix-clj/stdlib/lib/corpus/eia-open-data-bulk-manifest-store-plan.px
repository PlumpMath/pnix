# stdlib/lib/corpus/eia-open-data-bulk-manifest-store-plan.px — EIA Open Data bulk manifest metadata.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# bulk zip/time-series values/dispatch/security/forecast payloads는 포함하지 않는다. graph/mirror 연결도 하지 않는다.
let
  B = builtins;
  genPath = ./eia-open-data-bulk-manifest.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "energy.eia_open_data_bulk_manifest.v1";
    source = { name = "EIA Open Data bulk manifest"; license = "EIA public domain / acknowledgment requested"; scope = "empty seed fallback"; };
    summary = { dataset_count = 0; };
    datasets = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "eia-open-data-bulk-manifest-load-v0";
      source_lens = "stdlib/lib/corpus/eia-open-data-bulk-manifest-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "energy.eia_open_data_bulk_manifest.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "eia-open-data-bulk-manifest-query-v0";
      source_lens = "stdlib/lib/corpus/eia-open-data-bulk-manifest-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "energy.eia_open_data_bulk_manifest.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
