# stdlib/lib/corpus/opentelemetry-semconv-store-plan.px — OpenTelemetry Semantic Conventions structural metadata.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# prose/real telemetry/credentials/alert routing/execution/graph wiring 없음.
let
  B = builtins;
  genPath = ./opentelemetry-semconv.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "telemetry.opentelemetry.semantic_conventions.v1";
    source = { name = "OpenTelemetry Semantic Conventions model YAML"; license = "Apache-2.0"; scope = "empty seed fallback"; };
    summary = { source_file_count = 0; group_count = 0; attribute_count = 0; };
    source_files = [ ]; groups = [ ]; attributes = [ ]; enum_members = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "opentelemetry-semconv-load-v0";
      source_lens = "stdlib/lib/corpus/opentelemetry-semconv-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "telemetry.opentelemetry.semantic_conventions.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "opentelemetry-semconv-query-v0";
      source_lens = "stdlib/lib/corpus/opentelemetry-semconv-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "telemetry.opentelemetry.semantic_conventions.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
