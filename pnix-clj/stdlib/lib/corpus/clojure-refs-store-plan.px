# Clojure/ClojureScript refs redb store-plan. 구조 데이터만 적재, graph/mirror/math 연결 없음.
let
  B = builtins;
  genPath = ./clojure-refs.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "code.clojure.forms.v1";
    source = { project = "Clojure/ClojureScript language refs"; };
    source_files = [ ]; clojure = { compiler_specials = [ ]; repl_specials = [ ]; reader_macros = [ ]; reader_symbolic_values = [ ]; core_defs = [ ]; }; clojurescript = { analyzer_specials = [ ]; parse_methods = [ ]; core_defs = [ ]; };
    counts = { source_files = 0; compiler_specials = 0; repl_specials = 0; reader_macros = 0; reader_symbolic_values = 0; clojure_core_defs = 0; cljs_analyzer_specials = 0; cljs_parse_methods = 0; cljs_core_defs = 0; };
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "code-clojure-refs-load-v0";
      source_lens = "stdlib/lib/corpus/clojure-refs-store-plan.px";
      source_verdict = "materialize-code-clojure-refs";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "code.clojure.forms.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "code-clojure-refs-query-v0";
      source_lens = "stdlib/lib/corpus/clojure-refs-store-plan.px";
      source_verdict = "query-code-clojure-refs";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "code.clojure.forms.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
