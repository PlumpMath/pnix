# USAspending API contract catalog -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No API payload/prose/graph wiring.
let
  B = builtins;
  genPath = ./usaspending-api-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "budget.usaspending.api_catalog.v1";
    source = "USAspending API contract catalog metadata";
    license = "CC0-1.0 / US federal public spending API documentation metadata";
    policy = "contract/catalog metadata only";
    summary = { contracts = 0; endpoints = 0; schema_key_refs = 0; };
    manifest = { }; contracts = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "usaspending-api-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/usaspending-api-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "budget.usaspending.api_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "usaspending-api-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/usaspending-api-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "budget.usaspending.api_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
