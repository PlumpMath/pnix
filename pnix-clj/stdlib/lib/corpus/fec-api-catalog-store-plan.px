# stdlib/lib/corpus/fec-api-catalog-store-plan.px — FEC OpenFEC API swagger catalog metadata.
# redb corpus_source_records에 pnix attrset source(JSON 아님)로 append한다.
# live records, person-level rows, transaction payloads, API keys, graph wiring 없음.
let
  B = builtins;
  genPath = ./fec-api-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "legal.fec_api_catalog.v1";
    source = { name = "FEC OpenFEC API swagger catalog metadata"; license = "U.S. government public API documentation metadata"; scope = "empty seed fallback"; };
    summary = { paths_stored = 0; paths_available_candidate_scope = 0; definitions_stored = 0; definitions_available_candidate_scope = 0; live_api_records_ingested = false; person_level_rows_ingested = false; transaction_payloads_ingested = false; api_keys_ingested = false; mirror_graph_wiring = false; };
    paths = [ ];
    definitions = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "fec-api-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/fec-api-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "legal.fec_api_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "fec-api-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/fec-api-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "legal.fec_api_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
