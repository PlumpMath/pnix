# Open Skills RSD documentation catalog metadata -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No skill payloads/OSMT source/prose/graph wiring.
let
  B = builtins;
  genPath = ./open-skills-rsd-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "workforce.open_skills_rsd.catalog.v1";
    source = "Open Skills Network Rich Skill Descriptor recommendations catalog metadata";
    license = "CC-BY-4.0 documentation metadata; OSMT code/data excluded";
    summary = { headings = 0; field_tokens = 0; license_links = 0; files = 0; osmt_repo_license = ""; };
    policy = "RSD documentation metadata only";
    manifest = { }; files = [ ]; rsd_doc = { }; osmt = { };
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "open-skills-rsd-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/open-skills-rsd-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "workforce.open_skills_rsd_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "open-skills-rsd-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/open-skills-rsd-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "workforce.open_skills_rsd_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
