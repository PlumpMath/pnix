# stdlib/lib/corpus/nist-si-store-plan.px — NIST SP 330/SP 811 SI structural metadata snapshot.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# PDF/prose/body text와 graph/math/mirror wiring 없음.
let
  B = builtins;
  genPath = ./nist-si.generated.px;
  seed =
    if B.pathExists genPath
    then import genPath
    else { schema = "units.nist.si_style.v1"; source = "NIST SP 330/SP 811 SI publications"; records = [ ]; };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "nist-si-load-v0";
      source_lens = "stdlib/lib/corpus/nist-si-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [
        { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; }
      ];
      receipt_owner = "units.nist.si_style.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };

  mkQuery = args: {
    plan = {
      plan_id = "nist-si-query-v0";
      source_lens = "stdlib/lib/corpus/nist-si-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [
        { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; }
      ];
      receipt_owner = "units.nist.si_style.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
