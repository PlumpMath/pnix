# stdlib/lib/corpus/niosh-osha-ref-catalog-store-plan.px — NIOSH/OSHA occupational reference catalog metadata.
# redb corpus_source_records에 pnix attrset source(JSON 아님)로 append한다.
# numeric exposure values, chemical entry bodies, procedures/advice, graph wiring 없음.
let
  B = builtins;
  genPath = ./niosh-osha-ref-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "tox.niosh_osha_ref_catalog.v1";
    source = { name = "NIOSH and OSHA occupational chemical reference catalog metadata"; license = "U.S. government public information"; scope = "empty seed fallback"; };
    summary = { page_count = 0; link_ref_count = 0; html_bodies_persisted = false; chemical_entry_bodies_ingested = false; numeric_exposure_values_ingested = false; toxicology_prose_ingested = false; procedure_or_mixing_guidance_ingested = false; medical_or_legal_advice_ingested = false; compliance_decisions_ingested = false; mirror_graph_wiring = false; };
    pages = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "niosh-osha-ref-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/niosh-osha-ref-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "tox.niosh_osha_ref_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "niosh-osha-ref-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/niosh-osha-ref-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "tox.niosh_osha_ref_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
