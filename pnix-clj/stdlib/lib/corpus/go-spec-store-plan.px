# Go Language Specification structural metadata -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No prose/examples/execution/graph wiring.
let
  B = builtins;
  genPath = ./go-spec.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "code.go.specification.v1";
    source = "Go Language Specification";
    license = "BSD-3-Clause-style Go license";
    summary = { headings = 0; productions = 0; ebnf_blocks = 0; };
    policy = "official spec headings and EBNF grammar productions only";
    manifest = { };
    files = [ ]; headings = [ ]; productions = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "go-spec-load-v0";
      source_lens = "stdlib/lib/corpus/go-spec-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "code.go.specification.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "go-spec-query-v0";
      source_lens = "stdlib/lib/corpus/go-spec-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "code.go.specification.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
