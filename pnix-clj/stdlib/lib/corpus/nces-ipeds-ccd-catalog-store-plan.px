# NCES IPEDS/CCD catalog metadata -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No institution/school/student payload/advice/graph wiring.
let
  B = builtins;
  genPath = ./nces-ipeds-ccd-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "education.nces_ipeds_ccd.catalog.v1";
    source = "NCES IPEDS/CCD catalog/download-page metadata";
    license = "US-PD / US federal public information";
    summary = { pages = 0; links = 0; files = 0; };
    policy = "official NCES catalog/download-page metadata only";
    manifest = { };
    files = [ ]; pages = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "nces-ipeds-ccd-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/nces-ipeds-ccd-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "education.nces_ipeds_ccd.catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "nces-ipeds-ccd-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/nces-ipeds-ccd-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "education.nces_ipeds_ccd.catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
