let
  B = builtins;
  genPath = ./nasa-jpl-ssd-naif-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else { schema = "space.nasa_jpl.ssd_naif_catalog.v1"; source = { name = "NASA/JPL SSD and NAIF catalog"; license = "NASA/JPL public metadata"; }; summary = { page_count = 0; }; pages = [ ]; ssd_endpoint_tokens = [ ]; naif_directory_refs = [ ]; };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: { plan = { plan_id = "nasa-jpl-ssd-naif-catalog-load-v0"; source_lens = "stdlib/lib/corpus/nasa-jpl-ssd-naif-catalog-store-plan.px"; source_verdict = "materialize-corpus-source"; operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ]; receipt_owner = "space.nasa_jpl.ssd_naif_catalog.v0"; plan_built_at_ms = args.built_at_ms or 0; }; schema = seed.schema; content_hash = contentHash; value_bytes_len = B.stringLength valueSrc; };
  mkQuery = args: { plan = { plan_id = "nasa-jpl-ssd-naif-catalog-query-v0"; source_lens = "stdlib/lib/corpus/nasa-jpl-ssd-naif-catalog-store-plan.px"; source_verdict = "query-corpus-source"; operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ]; receipt_owner = "space.nasa_jpl.ssd_naif_catalog.v0"; plan_built_at_ms = args.built_at_ms or 0; }; expected_key = key; expected_hash = contentHash; };
}
