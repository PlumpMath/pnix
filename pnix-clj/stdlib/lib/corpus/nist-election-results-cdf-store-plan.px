# stdlib/lib/corpus/nist-election-results-cdf-store-plan.px — NIST Election Results CDF schema metadata.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# election payloads/voter records/CVR/spec prose/graph wiring 없음.
let
  B = builtins;
  genPath = ./nist-election-results-cdf.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "election.nist_results_cdf.schema_metadata.v1";
    source = { name = "NIST Election Results CDF schema metadata"; license = "US-PD"; scope = "empty seed fallback"; };
    summary = { schema_file_count = 0; election_results_ingested = false; mirror_graph_wiring = false; };
    schema_files = [ ]; xsd_terms = [ ]; json_terms = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "nist-election-results-cdf-load-v0";
      source_lens = "stdlib/lib/corpus/nist-election-results-cdf-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "election.nist_results_cdf.schema_metadata.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "nist-election-results-cdf-query-v0";
      source_lens = "stdlib/lib/corpus/nist-election-results-cdf-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "election.nist_results_cdf.schema_metadata.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
