# MathML 4 schema structural metadata -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No spec prose/examples or graph wiring.
let
  B = builtins;
  genPath = ./mathml4-schema.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "math.mathml4_schema.v1";
    source = "W3C MathML 4 XSD schema files";
    license = "W3C-Software-Document-License-2023";
    summary = { files = 0; rows = 0; };
    policy = "XSD structural metadata only";
    files = [ ]; schema_rows = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "mathml4-schema-load-v0";
      source_lens = "stdlib/lib/corpus/mathml4-schema-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "math.mathml4_schema.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "mathml4-schema-query-v0";
      source_lens = "stdlib/lib/corpus/mathml4-schema-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "math.mathml4_schema.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
