# PRImA PAGE-XML schema catalog -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No OCR payload/prose/graph wiring.
let
  B = builtins;
  genPath = ./page-xml-schema-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "doc.page_xml.schema_catalog.v1";
    source = "PRImA PAGE-XML XSD structural metadata";
    license = "Apache-2.0";
    policy = "schema structure only";
    summary = { xsd_files = 0; total_bytes = 0; parse_errors = 0; };
    manifest = { };
    files = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "page-xml-schema-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/page-xml-schema-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "doc.page_xml.schema_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "page-xml-schema-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/page-xml-schema-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "doc.page_xml.schema_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
