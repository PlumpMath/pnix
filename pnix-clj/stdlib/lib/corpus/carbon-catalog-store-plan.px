# Carbon Design System component/token catalog -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No prose/assets/code bodies/runtime/graph wiring.
let
  B = builtins;
  genPath = ./carbon-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "ui.carbon.catalog.v1";
    source = "Carbon Design System repository tree catalog";
    license = "Apache-2.0";
    summary = { components = 0; components_total_seen = 0; token_files = 0; token_files_total_seen = 0; packages = 0; limit = 0; };
    policy = "path/name/count catalog metadata only";
    manifest = { };
    files = [ ]; packages = [ ]; components = [ ]; token_files = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "carbon-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/carbon-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "ui.carbon.catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "carbon-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/carbon-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "ui.carbon.catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
