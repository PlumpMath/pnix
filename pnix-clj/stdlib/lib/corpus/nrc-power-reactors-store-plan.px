# stdlib/lib/corpus/nrc-power-reactors-store-plan.px — NRC operating power reactor identifiers.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# raw location/capacity/current-status/security/emergency/operational payloads는 포함하지 않는다.
let
  B = builtins;
  genPath = ./nrc-power-reactors.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "science.nrc_power_reactors.v1";
    source = { name = "NRC Commercial Nuclear Power Reactors – Operating Reactors dataset"; license = "NRC U.S. Government Work public-domain"; scope = "empty seed fallback"; };
    summary = { reactor_unit_count = 0; };
    reactor_units = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "nrc-power-reactors-load-v0";
      source_lens = "stdlib/lib/corpus/nrc-power-reactors-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "science.nrc_power_reactors.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "nrc-power-reactors-query-v0";
      source_lens = "stdlib/lib/corpus/nrc-power-reactors-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "science.nrc_power_reactors.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
