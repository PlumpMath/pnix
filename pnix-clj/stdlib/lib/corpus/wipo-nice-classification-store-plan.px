# stdlib/lib/corpus/wipo-nice-classification-store-plan.px — WIPO Nice Classification class headings.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# Alphabetical terms/explanatory notes/legal guidance/application payloads/graph wiring 없음.
let
  B = builtins;
  genPath = ./wipo-nice-classification.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "trademark.wipo_nice.classification.v1";
    source = { name = "WIPO Nice Classification class headings"; license = "WIPO official downloadable classification data / WIPO attribution family"; scope = "empty seed fallback"; };
    summary = { class_count = 0; legal_guidance_ingested = false; mirror_graph_wiring = false; };
    source_files = [ ]; classes = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "wipo-nice-classification-load-v0";
      source_lens = "stdlib/lib/corpus/wipo-nice-classification-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "trademark.wipo_nice.classification.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "wipo-nice-classification-query-v0";
      source_lens = "stdlib/lib/corpus/wipo-nice-classification-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "trademark.wipo_nice.classification.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
