# NAEP Data Service API metadata -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No item body, student response, result rows, or graph wiring.
let
  B = builtins;
  genPath = ./naep-api-metadata.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "education.naep_api_metadata.v1";
    source = "NAEP Data Service API metadata";
    license = "US-PD";
    endpoint = "";
    summary = { request_types = 0; parameters = 0; subjects = 0; stat_types = 0; independent_variables = 0; };
    policy = "metadata/code vocabulary only";
    request_types = [ ]; parameters = [ ]; subjects = [ ]; grades = [ ]; cohorts = [ ]; year_tokens = [ ]; stack_types = [ ]; stat_types = [ ]; common_variables = [ ]; independent_variables = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "naep-api-metadata-load-v0";
      source_lens = "stdlib/lib/corpus/naep-api-metadata-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "education.naep_api_metadata.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "naep-api-metadata-query-v0";
      source_lens = "stdlib/lib/corpus/naep-api-metadata-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "education.naep_api_metadata.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
