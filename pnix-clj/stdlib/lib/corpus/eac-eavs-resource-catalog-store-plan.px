# EAC EAVS resource catalog -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No EAVS data rows/report bodies/graph wiring.
let
  B = builtins;
  genPath = ./eac-eavs-resource-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "election.eac_eavs.resource_catalog.v1";
    source = "EAC EAVS resource catalog";
    license = "US-PD / US federal public information";
    policy = "resource-link catalog metadata only";
    summary = { resources = 0; years = [ ]; };
    manifest = { }; resources = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "eac-eavs-resource-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/eac-eavs-resource-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "election.eac_eavs.resource_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "eac-eavs-resource-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/eac-eavs-resource-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "election.eac_eavs.resource_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
