# MDN browser-compat-data structural compatibility catalog -> repo-local redb corpus_source_records.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다. graph/math wiring 없음.
let
  B = builtins;
  genPath = ./mdn-browser-compat-data.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "web.mdn_browser_compat_data.v1";
    source = { name = "MDN browser-compat-data"; license = "CC0-1.0"; scope = "empty seed fallback"; };
    summary = { feature_count_total = 0; feature_count_stored = 0; browser_count = 0; };
    browsers = [ ];
    features = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "mdn-browser-compat-data-load-v0";
      source_lens = "stdlib/lib/corpus/mdn-browser-compat-data-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "web.mdn_browser_compat_data.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "mdn-browser-compat-data-query-v0";
      source_lens = "stdlib/lib/corpus/mdn-browser-compat-data-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "web.mdn_browser_compat_data.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
