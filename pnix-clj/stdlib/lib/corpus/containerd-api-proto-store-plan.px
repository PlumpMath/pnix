# containerd API protobuf structural metadata -> redb corpus_source_records lane.
# Stores pnix attrset source, not JSON. No graph/mirror/runtime wiring.
let
  B = builtins;
  genPath = ./containerd-api-proto.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "runtime.containerd.api_proto.v1";
    source = "containerd/containerd api/**/*.proto";
    license = "Apache-2.0";
    source_files = [ ]; packages = [ ]; imports = [ ]; messages = [ ]; enums = [ ];
    enum_values = [ ]; fields = [ ]; services = [ ]; rpcs = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "containerd-api-proto-load-v0";
      source_lens = "stdlib/lib/corpus/containerd-api-proto-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "runtime.containerd.api_proto.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "containerd-api-proto-query-v0";
      source_lens = "stdlib/lib/corpus/containerd-api-proto-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "runtime.containerd.api_proto.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
