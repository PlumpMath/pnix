# KASA/KSWC Open API catalog metadata -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No observation/forecast/warning payloads/life-safety decisions/graph wiring.
let
  B = builtins;
  genPath = ./kasa-spaceweather-api-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "science.kasa_spaceweather.api_catalog.v1";
    source = "KASA Korea Space Weather Center Open API catalog metadata";
    license = "KASA public Open API catalog metadata; payload licenses not ingested";
    summary = { apis = 0; list_items = 0; files = 0; };
    policy = "KASA/KSWC Open API list/detail metadata only";
    manifest = { };
    list_page = { }; api_pages = [ ]; files = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "kasa-spaceweather-api-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/kasa-spaceweather-api-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "science.kasa_spaceweather.api_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "kasa-spaceweather-api-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/kasa-spaceweather-api-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "science.kasa_spaceweather.api_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
