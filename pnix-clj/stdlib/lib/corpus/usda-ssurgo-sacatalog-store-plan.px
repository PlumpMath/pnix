# stdlib/lib/corpus/usda-ssurgo-sacatalog-store-plan.px — USDA NRCS SSURGO sacatalog survey-area metadata.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# FGDC XML/prose, soil property tables, geometry, interpretations/ratings, suitability judgments는 포함하지 않는다. graph/mirror 연결도 하지 않는다.
let
  B = builtins;
  genPath = ./usda-ssurgo-sacatalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "science.usda.ssurgo_sacatalog.v1";
    source = { name = "USDA NRCS SSURGO sacatalog survey-area catalog"; license = "US Government public domain"; scope = "empty seed fallback"; };
    summary = { survey_area_count = 0; };
    fields = [ ];
    survey_areas = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "usda-ssurgo-sacatalog-load-v0";
      source_lens = "stdlib/lib/corpus/usda-ssurgo-sacatalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "science.usda.ssurgo_sacatalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "usda-ssurgo-sacatalog-query-v0";
      source_lens = "stdlib/lib/corpus/usda-ssurgo-sacatalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "science.usda.ssurgo_sacatalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
