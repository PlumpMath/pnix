# NIST CMVP/CAVP catalog metadata -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No cert rows/security judgment/graph wiring.
let
  B = builtins;
  genPath = ./nist-cmvp-cavp-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "security.nist_cmvp_cavp.catalog.v1";
    source = "NIST CMVP/CAVP catalog metadata";
    license = "US-PD / NIST public information";
    summary = { pages = 0; links = 0; form_fields = 0; endpoint_hints = 0; };
    policy = "official CSRC catalog metadata only";
    manifest = { };
    pages = [ ]; accepted_truth = false;
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "nist-cmvp-cavp-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/nist-cmvp-cavp-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "security.nist_cmvp_cavp.catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "nist-cmvp-cavp-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/nist-cmvp-cavp-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "security.nist_cmvp_cavp.catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
