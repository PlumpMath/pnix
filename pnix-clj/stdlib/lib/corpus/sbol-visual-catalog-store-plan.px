# stdlib/lib/corpus/sbol-visual-catalog-store-plan.px — SBOL Visual glyph/ontology catalog.
# redb corpus_source_records에 pnix attrset source(JSON 아님)로 append한다.
# artwork payload/spec prose/examples/scripts/design payloads/graph wiring 없음.
let
  B = builtins;
  genPath = ./sbol-visual-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "bio.sbol_visual_catalog.v1";
    source = { name = "SynBioDex SBOL Visual catalog"; license = "CC0/CC-BY-4.0"; scope = "empty seed fallback"; };
    summary = { glyph_path_count = 0; rdf_subject_count = 0; artwork_payloads_ingested = false; specification_prose_ingested = false; examples_ingested = false; scripts_ingested = false; mirror_graph_wiring = false; };
    glyph_paths = [ ]; rdf_subjects = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "sbol-visual-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/sbol-visual-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "bio.sbol_visual_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "sbol-visual-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/sbol-visual-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "bio.sbol_visual_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
