# SCIM schema/protocol token metadata -> redb corpus_source_records lane.
# Stores pnix attrset source, not JSON. No RFC body/IAM dump/provisioning execution.
let
  B = builtins;
  genPath = ./scim-schema-tokens.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "code.scim.schema_tokens.v1";
    source = "SCIM RFC 7643/7644 schema/protocol token metadata";
    license = "IETF Trust Legal Provisions / token-only metadata";
    rfcs = [ ]; source_receipt = { }; resource_types = [ ]; attributes = [ ]; endpoints = [ ]; methods = [ ]; query_parameters = [ ]; patch_operations = [ ]; exclusions = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "scim-schema-tokens-load-v0";
      source_lens = "stdlib/lib/corpus/scim-schema-tokens-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "code.scim.schema_tokens.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "scim-schema-tokens-query-v0";
      source_lens = "stdlib/lib/corpus/scim-schema-tokens-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "code.scim.schema_tokens.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
