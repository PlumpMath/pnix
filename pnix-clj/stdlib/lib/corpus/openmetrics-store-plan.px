# stdlib/lib/corpus/openmetrics-store-plan.px — OpenMetrics specification structural metadata.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# prose/real metrics/scrape logs/alert routing/execution/graph wiring 없음.
let
  B = builtins;
  genPath = ./openmetrics.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "telemetry.openmetrics.specification.v1";
    source = { name = "OpenMetrics official specification structural metadata"; license = "Apache-2.0"; scope = "empty seed fallback"; };
    summary = { source_file_count = 0; proto_message_count = 0; proto_field_count = 0; };
    source_files = [ ]; proto_messages = [ ]; proto_enums = [ ]; proto_fields = [ ]; format_code_lines = [ ]; table_rows = [ ]; section_headings = [ ]; tokens = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "openmetrics-load-v0";
      source_lens = "stdlib/lib/corpus/openmetrics-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "telemetry.openmetrics.specification.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "openmetrics-query-v0";
      source_lens = "stdlib/lib/corpus/openmetrics-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "telemetry.openmetrics.specification.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
