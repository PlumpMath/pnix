# stdlib/lib/corpus/cellosaurus-catalog-store-plan.px — Cellosaurus structural catalog.
# redb corpus_source_records에 pnix attrset source(JSON 아님)로 append한다.
# comments/profile/disease/donor/culture guidance/graph wiring 없음.
let
  B = builtins;
  genPath = ./cellosaurus-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "bio.cellosaurus.catalog.v1";
    source = { name = "Cellosaurus"; license = "CC-BY-4.0"; scope = "empty seed fallback"; };
    summary = { total_entries_seen = 0; entries_stored = 0; entry_limit = 0; comments_ingested = false; profile_data_ingested = false; disease_rows_ingested = false; donor_fields_ingested = false; culture_guidance_ingested = false; mirror_graph_wiring = false; };
    entries = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "cellosaurus-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/cellosaurus-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "bio.cellosaurus_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "cellosaurus-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/cellosaurus-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "bio.cellosaurus_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
