# NAL Agricultural Thesaurus SKOS concept structure -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No mirror/graph wiring.
let
  B = builtins;
  genPath = ./agriculture-nal-nalt.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "agriculture.nal_nalt.skos_concepts.v1";
    source = "NAL Agricultural Thesaurus Full";
    license = "CC-BY-4.0";
    attribution = "NAL Agricultural Thesaurus (NALT), USDA National Agricultural Library, CC BY 4.0.";
    source_digest_sha256 = "";
    summary = { concepts = 0; skipped_definition_blocks = 0; prose_fields_excluded = 0; max_concepts = 0; };
    concepts = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "agriculture-nal-nalt-load-v0";
      source_lens = "stdlib/lib/corpus/agriculture-nal-nalt-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "agriculture.nal_nalt.skos_concepts.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "agriculture-nal-nalt-query-v0";
      source_lens = "stdlib/lib/corpus/agriculture-nal-nalt-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "agriculture.nal_nalt.skos_concepts.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
