# OSI Approved License API metadata -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No legal advice/license text/graph wiring.
let
  B = builtins;
  genPath = ./osi-approved.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "license.osi_approved.v1";
    source = "OSI Approved License API metadata";
    license = "OSI public API metadata";
    summary = { licenses = 0; approved = 0; with_spdx_id = 0; };
    policy = "license identifier metadata only";
    manifest = { };
    files = [ ]; licenses = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "osi-approved-load-v0";
      source_lens = "stdlib/lib/corpus/osi-approved-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "license.osi_approved.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "osi-approved-query-v0";
      source_lens = "stdlib/lib/corpus/osi-approved-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "license.osi_approved.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
