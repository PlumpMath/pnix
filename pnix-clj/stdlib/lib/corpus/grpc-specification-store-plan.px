# stdlib/lib/corpus/grpc-specification-store-plan.px — gRPC core protocol specification metadata.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# server reflection/prod schema export/customer descriptors/payloads/live endpoints/invocation/graph wiring 없음.
let
  B = builtins;
  genPath = ./grpc-specification.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "api.grpc.specification.v1";
    source = { name = "gRPC official core protocol specification documents"; license = "Apache-2.0"; scope = "empty seed fallback"; };
    summary = { source_file_count = 0; table_row_count = 0; token_count = 0; stream_type_count = 0; };
    source_files = [ ]; stream_types = [ ]; table_rows = [ ]; tokens = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "grpc-specification-load-v0";
      source_lens = "stdlib/lib/corpus/grpc-specification-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "api.grpc.specification.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "grpc-specification-query-v0";
      source_lens = "stdlib/lib/corpus/grpc-specification-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "api.grpc.specification.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
