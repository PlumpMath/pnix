# TorchMetrics symbol catalog -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No source bodies/eval results/execution/graph wiring.
let
  B = builtins;
  genPath = ./torchmetrics-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "ml.torchmetrics.catalog.v1";
    source = "TorchMetrics metric symbol catalog";
    license = "Apache-2.0";
    summary = { categories = 0; modules = 0; symbols = 0; };
    policy = "symbol names only";
    manifest = { };
    files = [ ]; categories = [ ]; symbols = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "torchmetrics-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/torchmetrics-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "ml.torchmetrics.catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "torchmetrics-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/torchmetrics-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "ml.torchmetrics.catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
