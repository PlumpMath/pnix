# Apache Arrow/Parquet/Avro structural schema metadata -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No data files/customer schemas/execution/graph wiring.
let
  B = builtins;
  genPath = ./arrow-parquet-avro-specification.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "db.arrow_parquet_avro.specification.v1";
    source = "Apache Arrow / Parquet / Avro structural schemas";
    license = "Apache-2.0";
    summary = { files = 0; arrow_types = 0; arrow_fields = 0; parquet_types = 0; parquet_fields = 0; avro_grammar_rules = 0; avro_records = 0; avro_fields = 0; avro_protocols = 0; };
    policy = "schema metadata only";
    manifest = { };
    files = [ ]; arrow_types = [ ]; arrow_fields = [ ]; parquet_types = [ ]; parquet_fields = [ ]; avro_grammar_rules = [ ]; avro_records = [ ]; avro_fields = [ ]; avro_protocols = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "arrow-parquet-avro-specification-load-v0";
      source_lens = "stdlib/lib/corpus/arrow-parquet-avro-specification-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "db.arrow_parquet_avro.specification.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "arrow-parquet-avro-specification-query-v0";
      source_lens = "stdlib/lib/corpus/arrow-parquet-avro-specification-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "db.arrow_parquet_avro.specification.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
