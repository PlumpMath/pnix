# NASA FIRMS API catalog metadata -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No fire payloads/MAP_KEY/life-safety decisions/graph wiring.
let
  B = builtins;
  genPath = ./nasa-firms-api-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "climate.nasa_firms.api_catalog.v1";
    source = "NASA FIRMS API documentation/catalog metadata";
    license = "NASA public documentation/catalog metadata; FIRMS fire/hotspot payloads excluded";
    summary = { pages = 0; links = 0; endpoints = 0; source_tokens = 0; files = 0; };
    policy = "NASA FIRMS public API documentation/catalog page metadata and endpoint tokens only";
    manifest = { };
    files = [ ]; pages = [ ]; endpoints = [ ]; source_tokens = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "nasa-firms-api-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/nasa-firms-api-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "climate.nasa_firms.api_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "nasa-firms-api-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/nasa-firms-api-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "climate.nasa_firms.api_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
