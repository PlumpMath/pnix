# IOF ontology structural catalog -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No RDF bodies/prose/examples/reasoning/graph wiring.
let
  B = builtins;
  genPath = ./iof-ontology-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "industry.iof.ontology_catalog.v1";
    source = "Industrial Ontologies Foundry ontology repository structural catalog";
    license = "MIT";
    summary = { tree_files = 0; ontology_file_records = 0; raw_rdf_files = 0; terms_stored = 0; term_limit = 0; imports = 0; };
    policy = "Repository/tree metadata and RDF structural IRI tokens only";
    repository = { }; manifest = { }; files = [ ]; raw_files = [ ]; imports = [ ]; terms = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "iof-ontology-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/iof-ontology-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "industry.iof_ontology_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "iof-ontology-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/iof-ontology-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "industry.iof_ontology_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
