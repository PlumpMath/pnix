# Scheme/Racket/Common Lisp refs redb store-plan. 구조 데이터만 적재, graph/mirror/math 연결 없음.
let
  B = builtins;
  genPath = ./lisp-family-refs.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "code.lisp_family.forms.v1";
    source = { project = "Scheme/Racket/Common Lisp structural refs"; };
    source_files = [ ]; common_lisp = { symbols = [ ]; reader_names = [ ]; }; racket = { forms = [ ]; reader_tokens = [ ]; }; chez_scheme = { primitives = [ ]; syntax_bindings = [ ]; };
    counts = { source_files = 0; common_lisp_symbols = 0; common_lisp_reader_names = 0; racket_forms = 0; racket_reader_tokens = 0; chez_primitives = 0; chez_syntax_bindings = 0; };
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "code-lisp-family-refs-load-v0";
      source_lens = "stdlib/lib/corpus/lisp-family-refs-store-plan.px";
      source_verdict = "materialize-code-lisp-family-refs";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "code.lisp_family.forms.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "code-lisp-family-refs-query-v0";
      source_lens = "stdlib/lib/corpus/lisp-family-refs-store-plan.px";
      source_verdict = "query-code-lisp-family-refs";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "code.lisp_family.forms.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
