# stdlib/lib/corpus/ror-authority-store-plan.px — ROR authority metadata.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# coordinates/address lines/domains/URL payloads/email/IP/live API harvest/graph wiring 없음.
let
  B = builtins;
  genPath = ./ror-authority.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "scholarly.ror.authority.v1";
    source = { name = "ROR official organization authority records"; license = "MIT repository license / open ROR authority data"; scope = "empty seed fallback"; };
    summary = { record_file_count = 0; org_count = 0; name_row_count = 0; };
    source_files = [ ]; organizations = [ ]; names = [ ]; relationships = [ ]; external_ids = [ ]; countries = [ ]; type_counts = [ ]; status_counts = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "ror-authority-load-v0";
      source_lens = "stdlib/lib/corpus/ror-authority-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "scholarly.ror.authority.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "ror-authority-query-v0";
      source_lens = "stdlib/lib/corpus/ror-authority-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "scholarly.ror.authority.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
