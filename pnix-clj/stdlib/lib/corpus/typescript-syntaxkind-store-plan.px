# TypeScript SyntaxKind redb store-plan.
# redb 적재까지만 수행한다. graph/mirror/math 연결 없음.
let
  B = builtins;
  genPath = ./typescript-syntaxkind.generated.px;
  seed =
    if B.pathExists genPath
    then import genPath
    else { schema = "code.typescript.syntaxkind.v1"; source = { name = "TypeScript SyntaxKind"; }; members = [ ]; member_count = 0; };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "code-typescript-syntaxkind-load-v0";
      source_lens = "stdlib/lib/corpus/typescript-syntaxkind-store-plan.px";
      source_verdict = "materialize-code-typescript-syntaxkind";
      operations = [
        { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; }
      ];
      receipt_owner = "code.typescript.syntaxkind.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "code-typescript-syntaxkind-query-v0";
      source_lens = "stdlib/lib/corpus/typescript-syntaxkind-store-plan.px";
      source_verdict = "query-code-typescript-syntaxkind";
      operations = [
        { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; }
      ];
      receipt_owner = "code.typescript.syntaxkind.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
