let
  B = builtins;
  genPath = ./hl7-fhir-schema-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else { schema = "health.hl7_fhir.schema_catalog.v1"; source = { name = "HL7 FHIR JSON Schema catalog"; license = "HL7 FHIR specification terms"; }; summary = { definition_count_total = 0; }; definitions = [ ]; properties = [ ]; refs = [ ]; required = [ ]; };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: { plan = { plan_id = "hl7-fhir-schema-catalog-load-v0"; source_lens = "stdlib/lib/corpus/hl7-fhir-schema-catalog-store-plan.px"; source_verdict = "materialize-corpus-source"; operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ]; receipt_owner = "health.hl7_fhir.schema_catalog.v0"; plan_built_at_ms = args.built_at_ms or 0; }; schema = seed.schema; content_hash = contentHash; value_bytes_len = B.stringLength valueSrc; };
  mkQuery = args: { plan = { plan_id = "hl7-fhir-schema-catalog-query-v0"; source_lens = "stdlib/lib/corpus/hl7-fhir-schema-catalog-store-plan.px"; source_verdict = "query-corpus-source"; operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ]; receipt_owner = "health.hl7_fhir.schema_catalog.v0"; plan_built_at_ms = args.built_at_ms or 0; }; expected_key = key; expected_hash = contentHash; };
}
