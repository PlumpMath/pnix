# IANA HTTP Field Name Registry redb store-plan. 적재까지만, graph/mirror/math 연결 없음.
let
  B = builtins;
  genPath = ./iana-http-fields.generated.px;
  seed = if B.pathExists genPath then import genPath else { schema = "registry.iana.http_fields.v1"; source = { project = "IANA HTTP Field Name Registry"; }; registry = { id = "field-names"; records = [ ]; }; registry_count = 1; record_count = 0; };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "registry-iana-http-fields-load-v0";
      source_lens = "stdlib/lib/corpus/iana-http-fields-store-plan.px";
      source_verdict = "materialize-registry-iana-http-fields";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "registry.iana.http_fields.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "registry-iana-http-fields-query-v0";
      source_lens = "stdlib/lib/corpus/iana-http-fields-store-plan.px";
      source_verdict = "query-registry-iana-http-fields";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "registry.iana.http_fields.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
