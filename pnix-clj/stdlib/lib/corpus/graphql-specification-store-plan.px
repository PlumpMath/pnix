# stdlib/lib/corpus/graphql-specification-store-plan.px — GraphQL specification metadata.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# introspection export/prod schemas/request logs/endpoints/execution/graph wiring 없음.
let
  B = builtins;
  genPath = ./graphql-specification.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "api.graphql.specification.v1";
    source = { name = "GraphQL official specification documents"; license = "OWFa-1.0 for specifications"; scope = "empty seed fallback"; };
    summary = { source_file_count = 0; grammar_production_count = 0; token_count = 0; };
    source_files = [ ]; grammar_productions = [ ]; operation_types = [ ]; type_system_kinds = [ ]; tokens = [ ]; table_rows = [ ]; section_headings = [ ]; metadata_keys = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "graphql-specification-load-v0";
      source_lens = "stdlib/lib/corpus/graphql-specification-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "api.graphql.specification.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "graphql-specification-query-v0";
      source_lens = "stdlib/lib/corpus/graphql-specification-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "api.graphql.specification.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
