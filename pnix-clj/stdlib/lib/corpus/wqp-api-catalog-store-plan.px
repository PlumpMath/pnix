# Water Quality Portal API catalog metadata -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No monitoring payload/safety/legal judgment/graph wiring.
let
  B = builtins;
  genPath = ./wqp-api-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "water.wqp.api_catalog.v1";
    source = "Water Quality Portal API catalog metadata";
    license = "US-PD / official public documentation metadata";
    summary = { pages = 0; links = 0; endpoint_hints = 0; endpoints = 0; };
    policy = "official WQP web-service catalog metadata only";
    manifest = { };
    pages = [ ]; endpoints = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "wqp-api-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/wqp-api-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "water.wqp.api_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "wqp-api-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/wqp-api-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "water.wqp.api_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
