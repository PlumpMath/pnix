# Catalogue of Life / ChecklistBank API catalog metadata -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No taxon payloads/full dumps/prose/graph wiring.
let
  B = builtins;
  genPath = ./catalogue-of-life-api-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "bio.catalogue_of_life.api_catalog.v1";
    source = "Catalogue of Life / ChecklistBank API catalog metadata";
    license = "COL/ChecklistBank API catalog metadata; dataset payload licenses not ingested";
    summary = { dataset_records = 0; col_dataset_records = 0; rank_records = 0; openapi_paths = 0; openapi_schemas = 0; openapi_schema_limit = 0; openapi_path_limit = 0; };
    policy = "API/dataset/rank/OpenAPI catalog metadata only";
    manifest = { };
    files = [ ]; datasets = [ ]; col_datasets = [ ]; ranks = [ ]; openapi = { };
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "catalogue-of-life-api-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/catalogue-of-life-api-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "bio.catalogue_of_life.api_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "catalogue-of-life-api-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/catalogue-of-life-api-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "bio.catalogue_of_life.api_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
