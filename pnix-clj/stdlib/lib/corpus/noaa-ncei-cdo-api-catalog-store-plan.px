# NOAA NCEI CDO API catalog metadata -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No observations/time-series/life-safety decisions/graph wiring.
let
  B = builtins;
  genPath = ./noaa-ncei-cdo-api-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "climate.noaa_ncei_cdo.api_catalog.v1";
    source = "NOAA NCEI Climate Data Online API catalog metadata";
    license = "US-PD / US federal public information";
    summary = { endpoints = 0; links = 0; tokens = 0; files = 0; requires_token = true; };
    policy = "public webservices documentation and endpoint catalog tokens only";
    manifest = { };
    files = [ ]; page = { }; endpoints = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "noaa-ncei-cdo-api-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/noaa-ncei-cdo-api-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "climate.noaa_ncei_cdo.api_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "noaa-ncei-cdo-api-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/noaa-ncei-cdo-api-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "climate.noaa_ncei_cdo.api_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
