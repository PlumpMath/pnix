# stdlib/lib/corpus/ecfr-49-172-101-hazmat-identifiers-store-plan.px — eCFR 49 CFR 172.101 Hazmat Table identifier rows.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# packaging/quantity/stowage/special provisions/RQ/emergency/compliance advice는 포함하지 않는다. graph/mirror 연결도 하지 않는다.
let
  B = builtins;
  genPath = ./ecfr-49-172-101-hazmat-identifiers.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "regulatory.ecfr_49_172_101_hazmat_identifiers.v1";
    source = { name = "eCFR 49 CFR 172.101 hazmat identifier rows"; license = "US Government public domain"; scope = "empty seed fallback"; };
    summary = { stored_row_count = 0; chunk_index = 0; chunk_count_total = 0; };
    fields = [ ];
    rows = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/chunk-" + (B.toString seed.summary.chunk_index) + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "ecfr-49-172-101-hazmat-identifiers-load-v0";
      source_lens = "stdlib/lib/corpus/ecfr-49-172-101-hazmat-identifiers-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "regulatory.ecfr_49_172_101_hazmat_identifiers.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "ecfr-49-172-101-hazmat-identifiers-query-v0";
      source_lens = "stdlib/lib/corpus/ecfr-49-172-101-hazmat-identifiers-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "regulatory.ecfr_49_172_101_hazmat_identifiers.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
