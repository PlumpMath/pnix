# stdlib/lib/corpus/tekton-pipeline-api-store-plan.px — Tekton Pipeline API CRD structural metadata snapshot.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# 실제 Pipeline/Task YAML instance, secret, log, artifact, execution/deploy behavior, prose/examples, graph/mirror 연결은 포함하지 않는다.
let
  B = builtins;
  genPath = ./tekton-pipeline-api.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "devops.tekton.pipeline_api.v1";
    source = { name = "Tekton Pipeline API CRD structural metadata"; license = "Apache-2.0"; scope = "empty seed fallback"; };
    summary = { crd_count = 0; version_count = 0; schema_path_count = 0; };
    crds = [ ]; schema_paths = [ ]; excluded = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "tekton-pipeline-api-load-v0";
      source_lens = "stdlib/lib/corpus/tekton-pipeline-api-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "devops.tekton.pipeline_api.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "tekton-pipeline-api-query-v0";
      source_lens = "stdlib/lib/corpus/tekton-pipeline-api-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "devops.tekton.pipeline_api.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
