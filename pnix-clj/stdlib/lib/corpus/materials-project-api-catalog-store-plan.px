# stdlib/lib/corpus/materials-project-api-catalog-store-plan.px — Materials Project API schema catalog metadata.
# redb corpus_source_records에 pnix attrset source(JSON 아님)로 append한다.
# material payloads, computed properties, descriptions/examples, credentials, graph wiring 없음.
let
  B = builtins;
  genPath = ./materials-project-api-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "materials.materials_project_api_catalog.v1";
    source = { name = "Materials Project API OpenAPI catalog metadata"; license = "public API documentation metadata"; scope = "empty seed fallback"; };
    summary = { paths_stored = 0; paths_available = 0; schemas_stored = 0; schemas_available = 0; database_rows_ingested = false; material_structures_ingested = false; composition_values_ingested = false; computed_properties_ingested = false; contrib_payloads_ingested = false; descriptions_or_examples_ingested = false; credentials_ingested = false; mirror_graph_wiring = false; };
    paths = [ ];
    schemas = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "materials-project-api-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/materials-project-api-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "materials.materials_project_api_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "materials-project-api-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/materials-project-api-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "materials.materials_project_api_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
