# O*NET Database bounded structural rows -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No career advice, no mirror/graph wiring.
let
  B = builtins;
  genPath = ./onet-database.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "workforce.onet_database.structure.v1";
    source = "O*NET 30.3 Database";
    license = "CC-BY-4.0";
    attribution = "O*NET 30.3 Database by USDOL/ETA, used under CC BY 4.0; pnix has modified selected bounded structural rows.";
    summary = { occupations = 0; rating_rows = 0; software_rows = 0; occupation_limit = 0; row_limit_per_rating_file = 0; software_limit = 0; };
    source_files = [ ]; occupations = [ ]; ratings = [ ]; software_skills = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "onet-database-load-v0";
      source_lens = "stdlib/lib/corpus/onet-database-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "workforce.onet_database.structure.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "onet-database-query-v0";
      source_lens = "stdlib/lib/corpus/onet-database-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "workforce.onet_database.structure.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
