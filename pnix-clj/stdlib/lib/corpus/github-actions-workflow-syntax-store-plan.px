# stdlib/lib/corpus/github-actions-workflow-syntax-store-plan.px — GitHub Actions workflow syntax metadata snapshot.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# prose/examples/real workflows/secrets/logs/artifacts/deployments는 포함하지 않는다. graph/mirror 연결도 하지 않는다.
let
  B = builtins;
  genPath = ./github-actions-workflow-syntax.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "devops.github_actions.workflow_syntax.v1";
    source = { name = "GitHub Actions workflow syntax reference"; license = "CC-BY-4.0"; scope = "empty seed fallback"; };
    summary = { heading_count = 0; token_count = 0; };
    headings = [ ]; tokens = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "github-actions-workflow-syntax-load-v0";
      source_lens = "stdlib/lib/corpus/github-actions-workflow-syntax-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "devops.github_actions.workflow_syntax.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "github-actions-workflow-syntax-query-v0";
      source_lens = "stdlib/lib/corpus/github-actions-workflow-syntax-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "devops.github_actions.workflow_syntax.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
