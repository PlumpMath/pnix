# stdlib/lib/corpus/protobuf-specification-store-plan.px — Protobuf official core .proto metadata.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# test protos/generated code/runtime/customer descriptor sets/payloads/execution/graph wiring 없음.
let
  B = builtins;
  genPath = ./protobuf-specification.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "code.protobuf.specification.v1";
    source = { name = "Protocol Buffers core .proto schema files"; license = "BSD-style"; scope = "empty seed fallback"; };
    summary = { proto_file_count = 0; message_count = 0; field_count = 0; };
    proto_files = [ ]; imports = [ ]; messages = [ ]; enums = [ ]; services = [ ]; rpcs = [ ]; fields = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "protobuf-specification-load-v0";
      source_lens = "stdlib/lib/corpus/protobuf-specification-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "code.protobuf.specification.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "protobuf-specification-query-v0";
      source_lens = "stdlib/lib/corpus/protobuf-specification-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "code.protobuf.specification.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
