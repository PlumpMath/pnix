# coverage.py report/data shape metadata -> redb corpus_source_records lane.
# Stores pnix attrset source, not JSON. No coverage output ingestion or execution.
let
  B = builtins;
  genPath = ./coveragepy-shape.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "code.coveragepy.shape.v1";
    source = "coverage.py report/data module structural identifiers";
    license = "Apache-2.0";
    source_files = [ ]; classes = [ ]; functions = [ ]; constants = [ ]; typed_dicts = [ ]; report_formats = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "coveragepy-shape-load-v0";
      source_lens = "stdlib/lib/corpus/coveragepy-shape-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "code.coveragepy.shape.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "coveragepy-shape-query-v0";
      source_lens = "stdlib/lib/corpus/coveragepy-shape-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "code.coveragepy.shape.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
