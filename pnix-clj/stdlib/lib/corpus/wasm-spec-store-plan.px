# WebAssembly specification/interpreter redb store-plan. 구조 데이터만 적재, graph/mirror/math 연결 없음.
let
  B = builtins;
  genPath = ./wasm-spec.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "code.wasm.spec.v1";
    source = { project = "WebAssembly specification"; };
    source_files = [ ];
    type_definitions = [ ];
    variant_constructors = [ ];
    mnemonic_bindings = [ ];
    opcode_literals = [ ];
    module_sections = [ ];
    counts = { source_files = 0; type_definitions = 0; variant_constructors = 0; mnemonic_bindings = 0; opcode_literals = 0; module_sections = 0; };
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "code-wasm-spec-load-v0";
      source_lens = "stdlib/lib/corpus/wasm-spec-store-plan.px";
      source_verdict = "materialize-code-wasm-spec";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "code.wasm.spec.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "code-wasm-spec-query-v0";
      source_lens = "stdlib/lib/corpus/wasm-spec-store-plan.px";
      source_verdict = "query-code-wasm-spec";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "code.wasm.spec.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
