# stdlib/lib/corpus/tdwg-darwin-core-store-plan.px — TDWG Darwin Core term metadata snapshot.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# definitions/comments/examples/occurrence rows/coordinates/media/personal data는 포함하지 않는다. graph/mirror 연결도 하지 않는다.
let
  B = builtins;
  genPath = ./tdwg-darwin-core.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "biodiversity.tdwg_darwin_core.v1";
    source = { name = "TDWG Darwin Core vocabulary term metadata"; license = "CC-BY-4.0"; scope = "empty seed fallback"; };
    summary = { term_count = 0; };
    terms = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "tdwg-darwin-core-load-v0";
      source_lens = "stdlib/lib/corpus/tdwg-darwin-core-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "biodiversity.tdwg_darwin_core.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "tdwg-darwin-core-query-v0";
      source_lens = "stdlib/lib/corpus/tdwg-darwin-core-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "biodiversity.tdwg_darwin_core.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
