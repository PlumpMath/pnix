# OSLC RM vocabulary/shape metadata -> redb corpus_source_records lane.
# Stores pnix attrset source, not JSON. No requirements service data or graph wiring.
let
  B = builtins;
  genPath = ./oslc-rm-vocab.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "code.oslc_rm.vocab.v1";
    source = "OSLC RM 2.1 vocabulary/shapes TTL structural metadata";
    license = "Apache-2.0";
    source_files = [ ]; prefixes = [ ]; triples = [ ]; terms = [ ]; summary = { };
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "oslc-rm-vocab-load-v0";
      source_lens = "stdlib/lib/corpus/oslc-rm-vocab-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "code.oslc_rm.vocab.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "oslc-rm-vocab-query-v0";
      source_lens = "stdlib/lib/corpus/oslc-rm-vocab-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "code.oslc_rm.vocab.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
