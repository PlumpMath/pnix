# stdlib/lib/corpus/census-tiger-geocoder-catalog-store-plan.px — Census TIGERweb+Geocoder metadata catalog.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# geometry/coordinates/address query results/LUCA/microdata/graph wiring 없음.
let
  B = builtins;
  genPath = ./census-tiger-geocoder-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "place.census_tiger_geocoder_catalog.v1";
    source = { name = "U.S. Census TIGERweb + Geocoder public metadata catalog"; license = "US-PD"; scope = "empty seed fallback"; };
    summary = { service_count = 0; layer_count = 0; benchmark_count = 0; geometry_payloads_ingested = false; address_queries_ingested = false; mirror_graph_wiring = false; };
    tigerweb_services = [ ]; geocoder_benchmarks = [ ]; geocoder_vintages = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "census-tiger-geocoder-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/census-tiger-geocoder-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "place.census_tiger_geocoder_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "census-tiger-geocoder-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/census-tiger-geocoder-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "place.census_tiger_geocoder_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
