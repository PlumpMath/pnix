# stdlib/lib/corpus/oci-image-spec-store-plan.px — OCI Image Specification JSON Schema metadata.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# image blobs/registry payloads/credentials/signatures/validator execution/graph wiring 없음.
let
  B = builtins;
  genPath = ./oci-image-spec.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "container.oci.image_spec.v1";
    source = { name = "OCI Image Specification official JSON schemas"; license = "Apache-2.0"; scope = "empty seed fallback"; };
    summary = { schema_file_count = 0; definition_count = 0; property_count = 0; };
    schema_files = [ ]; definitions = [ ]; properties = [ ]; required_fields = [ ]; refs = [ ]; enums = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "oci-image-spec-load-v0";
      source_lens = "stdlib/lib/corpus/oci-image-spec-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "container.oci.image_spec.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "oci-image-spec-query-v0";
      source_lens = "stdlib/lib/corpus/oci-image-spec-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "container.oci.image_spec.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
