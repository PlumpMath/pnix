# stdlib/lib/corpus/om-store-plan.px — OM Ontology of units of Measure structural RDF/XML snapshot.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# graph/math/mirror wiring 없음: OM source predicates를 field rows로 저장만 한다.
let
  B = builtins;
  genPath = ./om.generated.px;
  seed =
    if B.pathExists genPath
    then import genPath
    else { schema = "units.om.v1"; source = "OM Ontology of units of Measure"; records = [ ]; };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "om-load-v0";
      source_lens = "stdlib/lib/corpus/om-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [
        { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; }
      ];
      receipt_owner = "units.om.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };

  mkQuery = args: {
    plan = {
      plan_id = "om-query-v0";
      source_lens = "stdlib/lib/corpus/om-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [
        { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; }
      ];
      receipt_owner = "units.om.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
