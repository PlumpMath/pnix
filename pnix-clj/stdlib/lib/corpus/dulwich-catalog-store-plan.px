# stdlib/lib/corpus/dulwich-catalog-store-plan.px — Dulwich release metadata catalog.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# package bodies, source bodies, Git operation execution, graph wiring 없음.
let
  B = builtins;
  genPath = ./dulwich-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "vcs.dulwich.catalog.v1";
    source = { name = "Dulwich PyPI/GitHub release catalog"; license = "Apache-2.0 OR GPL-2.0-or-later"; scope = "empty seed fallback"; };
    summary = { release_count = 0; package_archives_ingested = false; mirror_graph_wiring = false; };
    releases = [ ]; tags = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "dulwich-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/dulwich-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "vcs.dulwich.catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "dulwich-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/dulwich-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "vcs.dulwich.catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
