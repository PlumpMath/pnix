# stdlib/lib/corpus/accessgudid-api-catalog-store-plan.px — AccessGUDID API schema/catalog metadata.
# redb corpus_source_records에 pnix attrset source(JSON 아님)로 append한다.
# device records, UDI/DI payload values, full downloads, prose, medical advice, graph wiring 없음.
let
  B = builtins;
  genPath = ./accessgudid-api-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "device.accessgudid_api_catalog.v1";
    source = { name = "AccessGUDID developer API documentation"; license = "U.S. federal public information"; scope = "empty seed fallback"; };
    summary = { page_count = 0; endpoint_count = 0; field_count = 0; device_records_ingested = false; udi_di_values_ingested = false; full_downloads_ingested = false; documentation_prose_ingested = false; medical_advice_ingested = false; mirror_graph_wiring = false; };
    pages = [ ]; endpoints = [ ]; fields = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "accessgudid-api-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/accessgudid-api-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "device.accessgudid_api_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "accessgudid-api-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/accessgudid-api-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "device.accessgudid_api_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
