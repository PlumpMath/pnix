# LRMI terms/vocabulary structural metadata -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No resource payload/prose/graph wiring.
let
  B = builtins;
  genPath = ./lrmi-terms.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "learning.lrmi.terms.v1";
    source = "LRMI terms and vocabulary structural metadata";
    license = "CC-BY-4.0";
    policy = "TTL structural terms only";
    summary = { files = 0; prefixes = 0; terms = 0; triples = 0; raw_triples_seen = 0; prose_predicates_skipped = 0; };
    manifest = { }; files = [ ]; prefixes = [ ]; terms = [ ]; triples = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "lrmi-terms-load-v0";
      source_lens = "stdlib/lib/corpus/lrmi-terms-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "learning.lrmi.terms.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "lrmi-terms-query-v0";
      source_lens = "stdlib/lib/corpus/lrmi-terms-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "learning.lrmi.terms.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
