# stdlib/lib/corpus/cdc-wonder-places-catalog-store-plan.px — CDC WONDER/PLACES catalog metadata.
# redb corpus_source_records에 pnix attrset source(JSON 아님)로 append한다.
# observation rows, health values, small-cell/person-level data, graph wiring 없음.
let
  B = builtins;
  genPath = ./cdc-wonder-places-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "public_health.cdc_wonder_places_catalog.v1";
    source = { name = "CDC WONDER and PLACES public catalog metadata"; license = "U.S. government public information"; scope = "empty seed fallback"; };
    summary = { page_count = 0; places_column_count = 0; observation_rows_ingested = false; geography_time_measure_values_ingested = false; small_cell_data_ingested = false; person_level_records_ingested = false; health_advice_ingested = false; epidemiological_interpretation_ingested = false; mirror_graph_wiring = false; };
    pages = [ ];
    places_view = { id = ""; name = ""; license = ""; rows_updated_at = ""; columns = [ ]; };
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "cdc-wonder-places-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/cdc-wonder-places-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "public_health.cdc_wonder_places_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "cdc-wonder-places-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/cdc-wonder-places-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "public_health.cdc_wonder_places_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
