# eCFR section reference metadata -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No XML/full text or legal advice.
let
  B = builtins;
  genPath = ./ecfr-section-reference.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "regulatory.ecfr_section_reference.v1";
    source = "eCFR API title structure section references";
    license = "US-PD";
    summary = { titles = 0; sections = 0; limit_per_title = 0; };
    titles = [ ]; sections = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "ecfr-section-reference-load-v0";
      source_lens = "stdlib/lib/corpus/ecfr-section-reference-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "regulatory.ecfr_section_reference.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "ecfr-section-reference-query-v0";
      source_lens = "stdlib/lib/corpus/ecfr-section-reference-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "regulatory.ecfr_section_reference.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
