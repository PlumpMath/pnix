# stdlib/lib/corpus/ncbi-dbsnp-einfo-store-plan.px — NCBI dbSNP EInfo catalog metadata.
# redb corpus_source_records에 pnix attrset source(JSON 아님)로 append한다.
# variant records, genotype/sample data, sequence payloads, clinical interpretation, graph wiring 없음.
let
  B = builtins;
  genPath = ./ncbi-dbsnp-einfo.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "genome.ncbi_dbsnp_einfo.v1";
    source = { name = "NCBI dbSNP EInfo catalog metadata"; license = "U.S. government public information"; scope = "empty seed fallback"; };
    summary = { db_count = 0; variant_record_payloads_ingested = false; genotype_sample_payloads_ingested = false; sequence_payloads_ingested = false; linked_payloads_ingested = false; medical_interpretation_ingested = false; mirror_graph_wiring = false; };
    databases = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "ncbi-dbsnp-einfo-load-v0";
      source_lens = "stdlib/lib/corpus/ncbi-dbsnp-einfo-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "genome.ncbi_dbsnp_einfo.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "ncbi-dbsnp-einfo-query-v0";
      source_lens = "stdlib/lib/corpus/ncbi-dbsnp-einfo-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "genome.ncbi_dbsnp_einfo.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
