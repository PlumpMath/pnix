# Regulations.gov API documentation metadata -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No comment/docket payload/legal advice/graph wiring.
let
  B = builtins;
  genPath = ./regulationsgov-api-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "legal.regulationsgov.api_catalog.v1";
    source = "Regulations.gov API documentation metadata";
    license = "US-PD / GSA public API documentation metadata";
    summary = { pages = 0; links = 0; headings = 0; endpoint_hints = 0; static_endpoints = 0; };
    policy = "official docs metadata only";
    manifest = { }; api_root_status = { }; page = { }; endpoints = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "regulationsgov-api-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/regulationsgov-api-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "legal.regulationsgov.api_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "regulationsgov-api-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/regulationsgov-api-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "legal.regulationsgov.api_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
