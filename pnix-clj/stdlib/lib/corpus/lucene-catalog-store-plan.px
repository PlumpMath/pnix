# Apache Lucene release path/class catalog -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No source bodies/tests/execution/graph wiring.
let
  B = builtins;
  genPath = ./lucene-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "search.lucene.catalog.v1";
    source = "Apache Lucene release source catalog";
    license = "Apache-2.0";
    summary = { modules = 0; classes = 0; class_limit = 0; total_java_sources_seen = 0; };
    policy = "path/class metadata only";
    manifest = { }; release = { tag = ""; name = ""; };
    files = [ ]; modules = [ ]; classes = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "lucene-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/lucene-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "search.lucene.catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "lucene-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/lucene-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "search.lucene.catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
