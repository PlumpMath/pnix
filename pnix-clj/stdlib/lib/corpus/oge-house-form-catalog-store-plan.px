# stdlib/lib/corpus/oge-house-form-catalog-store-plan.px — OGE/House form catalog metadata.
# redb corpus_source_records에 pnix attrset source(JSON 아님)로 append한다.
# submitted records, person data, form bodies, legal/ethics advice, graph wiring 없음.
let
  B = builtins;
  genPath = ./oge-house-form-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "legal.oge_house_form_catalog.v1";
    source = { name = "OGE and House ethics form catalog metadata"; license = "U.S. government public information"; scope = "empty seed fallback"; };
    summary = { page_count = 0; form_link_ref_count = 0; html_bodies_persisted = false; form_bodies_ingested = false; submitted_report_records_ingested = false; person_or_filer_data_ingested = false; legal_or_ethics_advice_ingested = false; mirror_graph_wiring = false; };
    pages = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "oge-house-form-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/oge-house-form-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "legal.oge_house_form_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "oge-house-form-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/oge-house-form-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "legal.oge_house_form_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
