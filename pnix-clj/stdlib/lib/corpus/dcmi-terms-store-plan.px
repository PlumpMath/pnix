# stdlib/lib/corpus/dcmi-terms-store-plan.px — DCMI Metadata Terms vocabulary structure.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# rdfs:comment prose/specification prose/examples/graph wiring 없음.
let
  B = builtins;
  genPath = ./dcmi-terms.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "metadata.dcmi.terms.v1";
    source = { name = "DCMI Metadata Terms"; license = "CC-BY-4.0 / DCMI attribution license family"; scope = "empty seed fallback"; };
    summary = { term_count = 0; comment_prose_ingested = false; mirror_graph_wiring = false; };
    source_files = [ ]; terms = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "dcmi-terms-load-v0";
      source_lens = "stdlib/lib/corpus/dcmi-terms-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "metadata.dcmi.terms.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "dcmi-terms-query-v0";
      source_lens = "stdlib/lib/corpus/dcmi-terms-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "metadata.dcmi.terms.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
