# stdlib/lib/corpus/natural-earth-catalog-store-plan.px — Natural Earth vector catalog metadata.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# geometry/raster payloads, coordinates, graph wiring 없음.
let
  B = builtins;
  genPath = ./natural-earth-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "place.natural_earth_catalog.v1";
    source = { name = "Natural Earth vector catalog"; license = "Public Domain"; scope = "empty seed fallback"; };
    summary = { layer_count = 0; geometry_payloads_ingested = false; mirror_graph_wiring = false; };
    tags = [ ]; layers = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "natural-earth-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/natural-earth-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "place.natural_earth_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "natural-earth-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/natural-earth-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "place.natural_earth_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
