# stdlib/lib/corpus/eia-923-generation-fuel-store-plan.px — EIA-923 generation/fuel aggregate metadata.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# monthly vectors/dispatch/security/forecast payloads는 포함하지 않는다. graph/mirror 연결도 하지 않는다.
let
  B = builtins;
  genPath = ./eia-923-generation-fuel.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "energy.eia923_generation_fuel.v1";
    source = { name = "EIA Form EIA-923 generation and fuel data"; license = "EIA public domain / acknowledgment requested"; scope = "empty seed fallback"; };
    summary = { generation_fuel_rows_count = 0; };
    generation_fuel_rows = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "eia-923-generation-fuel-load-v0";
      source_lens = "stdlib/lib/corpus/eia-923-generation-fuel-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "energy.eia923_generation_fuel.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "eia-923-generation-fuel-query-v0";
      source_lens = "stdlib/lib/corpus/eia-923-generation-fuel-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "energy.eia923_generation_fuel.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
