# stdlib/lib/corpus/spdx-license-list-store-plan.px — SPDX License List identifier metadata.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# license texts/templates/legal judgments/customer SBOMs/graph wiring 없음.
let
  B = builtins;
  genPath = ./spdx-license-list.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "sbom.spdx_license_list.v1";
    source = { name = "SPDX License List identifier metadata"; license = "CC-BY"; scope = "empty seed fallback"; };
    summary = { license_count = 0; full_license_text_ingested = false; mirror_graph_wiring = false; };
    licenses = [ ]; exceptions = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "spdx-license-list-load-v0";
      source_lens = "stdlib/lib/corpus/spdx-license-list-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "sbom.spdx_license_list.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "spdx-license-list-query-v0";
      source_lens = "stdlib/lib/corpus/spdx-license-list-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "sbom.spdx_license_list.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
