# stdlib/lib/corpus/insdc-feature-table-store-plan.px — INSDC feature table vocabulary structure.
# redb corpus_source_records에 pnix attrset source(JSON 아님)로 append한다.
# prose/examples/sequence payloads/submissions/graph wiring 없음.
let
  B = builtins;
  genPath = ./insdc-feature-table.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "bio.insdc_feature_table.v1";
    source = { name = "DDBJ/ENA/GenBank Feature Table Definition"; license = "INSDC public submission standard / public vocabulary"; scope = "empty seed fallback"; };
    summary = { feature_key_count = 0; qualifier_key_count = 0; controlled_code_count = 0; definitions_ingested = false; comments_ingested = false; examples_ingested = false; sequence_payloads_ingested = false; mirror_graph_wiring = false; };
    feature_keys = [ ]; qualifier_keys = [ ]; controlled_codes = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "insdc-feature-table-load-v0";
      source_lens = "stdlib/lib/corpus/insdc-feature-table-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "bio.insdc_feature_table.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "insdc-feature-table-query-v0";
      source_lens = "stdlib/lib/corpus/insdc-feature-table-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "bio.insdc_feature_table.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
