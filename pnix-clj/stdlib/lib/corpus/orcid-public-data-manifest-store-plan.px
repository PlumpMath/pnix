# stdlib/lib/corpus/orcid-public-data-manifest-store-plan.px — ORCID public data file manifest metadata.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# Individual ORCID records/profile values/API harvest/linked payloads/profiling/graph wiring 없음.
let
  B = builtins;
  genPath = ./orcid-public-data-manifest.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "scholarly.orcid.public_data_manifest.v1";
    source = { name = "ORCID Public Data File manifest"; license = "CC0-1.0"; scope = "empty seed fallback"; };
    summary = { file_count = 0; individual_records_ingested = false; mirror_graph_wiring = false; };
    source_files = [ ]; archive_files = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "orcid-public-data-manifest-load-v0";
      source_lens = "stdlib/lib/corpus/orcid-public-data-manifest-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "scholarly.orcid.public_data_manifest.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "orcid-public-data-manifest-query-v0";
      source_lens = "stdlib/lib/corpus/orcid-public-data-manifest-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "scholarly.orcid.public_data_manifest.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
