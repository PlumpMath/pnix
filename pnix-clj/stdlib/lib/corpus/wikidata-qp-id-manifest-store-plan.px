# stdlib/lib/corpus/wikidata-qp-id-manifest-store-plan.px — Wikidata Q/P id authority manifest.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# claims/sitelinks/Wikipedia text/full dumps/SPARQL/mirror graph wiring 없음.
let
  B = builtins;
  genPath = ./wikidata-qp-id-manifest.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "authority.wikidata.qp_id_manifest.v1";
    source = { name = "Wikidata Q/P id manifest"; license = "CC0-1.0"; scope = "empty seed fallback"; };
    summary = { entity_count = 0; claims_ingested = false; sitelinks_ingested = false; mirror_graph_wiring = false; };
    siteinfo = { }; namespaces = [ ]; namespace_aliases = [ ]; entities = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "wikidata-qp-id-manifest-load-v0";
      source_lens = "stdlib/lib/corpus/wikidata-qp-id-manifest-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "authority.wikidata.qp_id_manifest.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "wikidata-qp-id-manifest-query-v0";
      source_lens = "stdlib/lib/corpus/wikidata-qp-id-manifest-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "authority.wikidata.qp_id_manifest.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
