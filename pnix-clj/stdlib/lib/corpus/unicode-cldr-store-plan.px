# Unicode CLDR Core chunk redb store-plan. scripts/load-text-unicode-cldr-redb.sh가 current chunk를 교체하며 호출한다.
# 적재까지만, graph/mirror/math 연결 없음.
let
  B = builtins;
  genPath = ./unicode-cldr-current-chunk.generated.px;
  seed = if B.pathExists genPath then import genPath else { schema = "text.unicode.cldr.v1"; source = { project = "Unicode CLDR Core"; }; chunk_id = "empty"; document_path = ""; records = [ ]; record_count = 0; };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + seed.chunk_id + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "text-unicode-cldr-load-v0";
      source_lens = "stdlib/lib/corpus/unicode-cldr-store-plan.px";
      source_verdict = "materialize-text-unicode-cldr-chunk";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "text.unicode.cldr.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    chunk_id = seed.chunk_id;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "text-unicode-cldr-query-v0";
      source_lens = "stdlib/lib/corpus/unicode-cldr-store-plan.px";
      source_verdict = "query-text-unicode-cldr-chunk";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/" + seed.chunk_id + "/"; } ];
      receipt_owner = "text.unicode.cldr.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
