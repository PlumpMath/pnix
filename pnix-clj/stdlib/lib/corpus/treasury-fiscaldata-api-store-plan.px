# U.S. Treasury Fiscal Data API metadata -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No fiscal values/time-series or advice.
let
  B = builtins;
  genPath = ./treasury-fiscaldata-api.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "accounting.treasury_fiscaldata_api_metadata.v1";
    source = "U.S. Treasury Fiscal Data API endpoint metadata";
    license = "US-PD";
    summary = { endpoints = 0; fields = 0; };
    endpoints = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "treasury-fiscaldata-api-load-v0";
      source_lens = "stdlib/lib/corpus/treasury-fiscaldata-api-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "accounting.treasury_fiscaldata_api_metadata.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "treasury-fiscaldata-api-query-v0";
      source_lens = "stdlib/lib/corpus/treasury-fiscaldata-api-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "accounting.treasury_fiscaldata_api_metadata.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
