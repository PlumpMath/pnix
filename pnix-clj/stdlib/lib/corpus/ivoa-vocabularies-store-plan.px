# stdlib/lib/corpus/ivoa-vocabularies-store-plan.px — IVOA vocabulary structural metadata snapshot.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# definitions/descriptions/comments/examples/observation payloads는 포함하지 않는다. graph/mirror 연결도 하지 않는다.
let
  B = builtins;
  genPath = ./ivoa-vocabularies.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "astro.ivoa_vocabularies.v1";
    source = { name = "IVOA Vocabularies"; license = "CC0-1.0"; scope = "empty seed fallback"; };
    summary = { vocabulary_count = 0; term_count = 0; };
    vocabularies = [ ];
    terms = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "ivoa-vocabularies-load-v0";
      source_lens = "stdlib/lib/corpus/ivoa-vocabularies-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "astro.ivoa_vocabularies.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "ivoa-vocabularies-query-v0";
      source_lens = "stdlib/lib/corpus/ivoa-vocabularies-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "astro.ivoa_vocabularies.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
