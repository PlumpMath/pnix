# stdlib/lib/corpus/geoboundaries-catalog-store-plan.px — geoBoundaries gbOpen metadata catalog.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# geometry payloads, coordinates, gbHumanitarian/gbAuthoritative, graph wiring 없음.
let
  B = builtins;
  genPath = ./geoboundaries-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "place.geoboundaries_catalog.v1";
    source = { name = "geoBoundaries gbOpen API catalog"; license = "CC-BY-4.0"; scope = "empty seed fallback"; };
    summary = { record_count = 0; geometry_payloads_ingested = false; mirror_graph_wiring = false; };
    records = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "geoboundaries-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/geoboundaries-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "place.geoboundaries_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "geoboundaries-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/geoboundaries-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "place.geoboundaries_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
