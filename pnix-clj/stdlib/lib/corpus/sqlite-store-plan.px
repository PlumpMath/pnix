# stdlib/lib/corpus/sqlite-store-plan.px — SQLite public-domain metadata snapshot.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다. customer DB/query logs 없음.
let
  B = builtins;
  genPath = ./sqlite.generated.px;
  seed = if B.pathExists genPath then import genPath else { schema = "code.sqlite.metadata.v1"; source = "SQLite"; keywords = [ ]; functions = [ ]; };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "sqlite-metadata-load-v0";
      source_lens = "stdlib/lib/corpus/sqlite-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "code.sqlite.metadata.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "sqlite-metadata-query-v0";
      source_lens = "stdlib/lib/corpus/sqlite-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "code.sqlite.metadata.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
