# Federal Reserve H.15 DDP series catalog -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No rate observations/advice/graph wiring.
let
  B = builtins;
  genPath = ./fed-h15-series-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "finance.federal_reserve.h15_series_catalog.v1";
    source = "Federal Reserve H.15 DDP series catalog metadata";
    license = "US-PD / Federal Reserve public statistical release metadata";
    policy = "series catalog only";
    summary = { packages = 0; unique_series = 0; };
    manifest = { }; packages = [ ]; unique_series = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "fed-h15-series-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/fed-h15-series-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "finance.federal_reserve.h15_series_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "fed-h15-series-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/fed-h15-series-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "finance.federal_reserve.h15_series_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
