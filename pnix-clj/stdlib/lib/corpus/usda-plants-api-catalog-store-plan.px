# USDA PLANTS app/API catalog metadata -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No plant payload/maps/guidance/graph wiring.
let
  B = builtins;
  genPath = ./usda-plants-api-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "agriculture.usda_plants.api_catalog.v1";
    source = "USDA PLANTS Database application/API catalog metadata";
    license = "US-PD / US federal public information";
    summary = { service_urls = 0; endpoint_tokens = 0; routes = 0; files = 0; };
    policy = "official application shell/config and endpoint token metadata only";
    manifest = { };
    files = [ ]; home_html_sig = { bytes = 0; sha256 = ""; }; env = { }; service_urls = [ ]; endpoint_tokens = [ ]; routes = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "usda-plants-api-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/usda-plants-api-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "agriculture.usda_plants.api_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "usda-plants-api-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/usda-plants-api-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "agriculture.usda_plants.api_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
