# CUE specification structural metadata -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No prose/examples/tool execution or graph wiring.
let
  B = builtins;
  genPath = ./cue-specification.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "config.cue.specification.v1";
    source = "cue-lang/cue language specification";
    license = "Apache-2.0";
    summary = { files = 0; headings = 0; productions = 0; };
    policy = "syntax metadata only";
    manifest = { };
    files = [ ]; headings = [ ]; productions = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "cue-specification-load-v0";
      source_lens = "stdlib/lib/corpus/cue-specification-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "config.cue.specification.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "cue-specification-query-v0";
      source_lens = "stdlib/lib/corpus/cue-specification-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "config.cue.specification.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
