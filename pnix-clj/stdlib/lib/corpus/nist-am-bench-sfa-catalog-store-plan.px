# stdlib/lib/corpus/nist-am-bench-sfa-catalog-store-plan.px — NIST AM-Bench/SFA project catalog metadata.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# source/data/CAD/STEP/toolpath/process payloads는 포함하지 않는다. graph/mirror 연결도 하지 않는다.
let
  B = builtins;
  genPath = ./nist-am-bench-sfa-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "cad.nist_am_bench_sfa_catalog.v1";
    source = { name = "NIST AM-Bench/SFA catalog metadata"; license = "NIST public metadata"; scope = "empty seed fallback"; };
    summary = { repository_count = 0; page_count = 0; };
    pages = [ ];
    repositories = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "nist-am-bench-sfa-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/nist-am-bench-sfa-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "cad.nist_am_bench_sfa_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "nist-am-bench-sfa-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/nist-am-bench-sfa-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "cad.nist_am_bench_sfa_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
