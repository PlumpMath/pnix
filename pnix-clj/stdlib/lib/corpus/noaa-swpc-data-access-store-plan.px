# NOAA SWPC Data Access directory metadata -> redb corpus_source_records lane.
# Stores pnix attrset source, not JSON. No product payload/execution/graph wiring.
let
  B = builtins;
  genPath = ./noaa-swpc-data-access.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "space_weather.noaa_swpc.data_access.v1";
    source = "NOAA SWPC public data service directory metadata";
    license = "USGOV-PUBLIC-METADATA";
    source_files = [ ]; service_roots = [ ]; entries = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "noaa-swpc-data-access-load-v0";
      source_lens = "stdlib/lib/corpus/noaa-swpc-data-access-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "space_weather.noaa_swpc.data_access.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "noaa-swpc-data-access-query-v0";
      source_lens = "stdlib/lib/corpus/noaa-swpc-data-access-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "space_weather.noaa_swpc.data_access.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
