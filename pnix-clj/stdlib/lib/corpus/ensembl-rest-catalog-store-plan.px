# Ensembl REST catalog -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No gene/transcript/sequence payloads/graph wiring.
let
  B = builtins;
  genPath = ./ensembl-rest-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "genome.ensembl.rest_catalog.v1";
    source = "Ensembl REST catalog";
    license = "Ensembl public data terms / API software Apache-2.0 where applicable";
    policy = "release/species catalog metadata only";
    summary = { species_stored = 0; species_available = 0; };
    manifest = { }; species = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "ensembl-rest-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/ensembl-rest-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "genome.ensembl.rest_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "ensembl-rest-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/ensembl-rest-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "genome.ensembl.rest_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
