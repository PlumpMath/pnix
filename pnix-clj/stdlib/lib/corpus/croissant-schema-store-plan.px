# stdlib/lib/corpus/croissant-schema-store-plan.px — Croissant implementation schema metadata.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# CC-BY-ND spec prose/docs/examples/dataset payloads/credentials/execution/graph wiring 없음.
let
  B = builtins;
  genPath = ./croissant-schema.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "ml.croissant.schema.v1";
    source = { name = "MLCommons Croissant mlcroissant implementation schema metadata"; license = "Apache-2.0 implementation; CC-BY-ND spec prose excluded"; scope = "empty seed fallback"; };
    summary = { source_file_count = 0; constant_count = 0; class_count = 0; dataclass_field_count = 0; };
    source_files = [ ]; constants = [ ]; classes = [ ]; dataclass_fields = [ ]; enum_members = [ ]; functions = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "croissant-schema-load-v0";
      source_lens = "stdlib/lib/corpus/croissant-schema-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "ml.croissant.schema.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "croissant-schema-query-v0";
      source_lens = "stdlib/lib/corpus/croissant-schema-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "ml.croissant.schema.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
