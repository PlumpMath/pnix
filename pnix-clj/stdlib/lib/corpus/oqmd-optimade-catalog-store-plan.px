# stdlib/lib/corpus/oqmd-optimade-catalog-store-plan.px — OQMD OPTIMADE provider catalog metadata.
# redb corpus_source_records에 pnix attrset source(JSON 아님)로 append한다.
# materials payloads, descriptions/prose, query execution, graph wiring 없음.
let
  B = builtins;
  genPath = ./oqmd-optimade-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "materials.oqmd_optimade_catalog.v1";
    source = { name = "OQMD OPTIMADE provider catalog metadata"; license = "public endpoint metadata"; scope = "empty seed fallback"; };
    summary = { link_count = 0; structure_rows_ingested = false; composition_values_ingested = false; property_values_ingested = false; calculation_payloads_ingested = false; descriptions_or_prose_ingested = false; query_execution = false; mirror_graph_wiring = false; };
    provider = { api_version = ""; schema_url = ""; provider_name = ""; provider_prefix = ""; };
    links = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "oqmd-optimade-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/oqmd-optimade-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "materials.oqmd_optimade_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "oqmd-optimade-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/oqmd-optimade-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "materials.oqmd_optimade_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
