# USLM schema catalog -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No statutory text/schema bodies/legal advice/graph wiring.
let
  B = builtins;
  genPath = ./uslm-schema-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "legal.uslm_schema_catalog.v1";
    source = "USGPO USLM schema catalog";
    license = "US-PD/public metadata; repo license NOASSERTION";
    policy = "repo/tree path metadata only";
    summary = { paths_stored = 0; tree_items = 0; };
    manifest = { }; repo = { }; paths = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "uslm-schema-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/uslm-schema-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "legal.uslm_schema_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "uslm-schema-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/uslm-schema-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "legal.uslm_schema_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
