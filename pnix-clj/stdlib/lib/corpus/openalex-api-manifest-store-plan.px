# stdlib/lib/corpus/openalex-api-manifest-store-plan.px — OpenAlex API endpoint count/schema-key manifest.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# API item values/abstract_inverted_index/citation edges/snapshot payloads/graph wiring 없음.
let
  B = builtins;
  genPath = ./openalex-api-manifest.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "scholarly.openalex.api_manifest.v1";
    source = { name = "OpenAlex API manifest"; license = "CC0-1.0"; scope = "empty seed fallback"; };
    summary = { endpoint_count = 0; record_payload_values_ingested = false; mirror_graph_wiring = false; };
    source_files = [ ]; endpoints = [ ]; excluded_source_fields_observed = [ ]; documentation_refs = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "openalex-api-manifest-load-v0";
      source_lens = "stdlib/lib/corpus/openalex-api-manifest-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "scholarly.openalex.api_manifest.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "openalex-api-manifest-query-v0";
      source_lens = "stdlib/lib/corpus/openalex-api-manifest-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "scholarly.openalex.api_manifest.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
