# stdlib/lib/corpus/conventional-commits-store-plan.px — Conventional Commits syntax metadata snapshot.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# 실제 repository commit log/user commit message/prose body는 포함하지 않는다. graph/mirror 연결도 하지 않는다.
let
  B = builtins;
  genPath = ./conventional-commits.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "code.conventional_commits.v2";
    source = { name = "Conventional Commits specification"; license = "MIT"; scope = "empty seed fallback"; };
    spec = { version = "1.0.0"; };
    grammar = { structural_fields = [ ]; footer_rules = [ ]; };
    types = { mandated = [ ]; recommended_or_common = [ ]; open_world = true; };
    semver_mapping = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "conventional-commits-load-v0";
      source_lens = "stdlib/lib/corpus/conventional-commits-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "code.conventional_commits.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "conventional-commits-query-v0";
      source_lens = "stdlib/lib/corpus/conventional-commits-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "code.conventional_commits.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
