# stdlib/lib/corpus/crossref-api-manifest-store-plan.px — Crossref REST API endpoint manifest.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# DOI records/titles/abstracts/person values/snapshots/API payloads/graph wiring 없음.
let
  B = builtins;
  genPath = ./crossref-api-manifest.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "scholarly.crossref.api_manifest.v1";
    source = { name = "Crossref REST API endpoint manifest"; license = "Crossref Free Services metadata rights / no ownership claims"; scope = "empty seed fallback"; };
    summary = { endpoint_count = 0; rows_zero_only = true; doi_record_payloads_ingested = false; mirror_graph_wiring = false; };
    source_files = [ ]; endpoints = [ ]; documentation_refs = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "crossref-api-manifest-load-v0";
      source_lens = "stdlib/lib/corpus/crossref-api-manifest-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "scholarly.crossref.api_manifest.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "crossref-api-manifest-query-v0";
      source_lens = "stdlib/lib/corpus/crossref-api-manifest-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "scholarly.crossref.api_manifest.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
