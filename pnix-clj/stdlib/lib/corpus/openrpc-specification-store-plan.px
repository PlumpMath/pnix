# stdlib/lib/corpus/openrpc-specification-store-plan.px — OpenRPC specification schema metadata.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# real OpenRPC documents/endpoints/credentials/logs/invocation/graph wiring 없음.
let
  B = builtins;
  genPath = ./openrpc-specification.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "api.openrpc.specification.v1";
    source = { name = "OpenRPC official specification schema"; license = "Apache-2.0"; scope = "empty seed fallback"; };
    summary = { source_file_count = 0; definition_count = 0; property_count = 0; };
    source_files = [ ]; definitions = [ ]; properties = [ ]; required = [ ]; refs = [ ]; enums = [ ]; table_rows = [ ]; tokens = [ ]; section_headings = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "openrpc-specification-load-v0";
      source_lens = "stdlib/lib/corpus/openrpc-specification-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "api.openrpc.specification.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "openrpc-specification-query-v0";
      source_lens = "stdlib/lib/corpus/openrpc-specification-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "api.openrpc.specification.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
