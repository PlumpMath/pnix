# stdlib/lib/corpus/qudt-ko-quantity-lexicon.px — CURATED (tracked, project-owned).
# Korean quantity term -> QUDT quantity-kind id. This is an EXACT, human-VERIFIED bridge
# (each pair is a deliberate curation), NOT fuzzy cross-lingual matching — so a hit is a
# CORE exact-key resolution (the curated-bridge form of memory C's exact-key concept),
# while any term NOT in this list stays HELD (never auto-matched). The QUDT id is the
# canonical exact key; whether its dimension is available depends on the qudt shard's
# extracted quantity-kind coverage (out-of-subset QKs resolve the kind but hold the
# dimension until the shard is expanded).
{ schema = "qudt.ko-quantity-lexicon.v1";
  note = "curated Korean quantity term -> QUDT quantity-kind id (exact verified bridge)";
  terms = [
    { ko = "속도"; qudt = "Velocity"; }
    { ko = "속력"; qudt = "Speed"; }
    { ko = "가속도"; qudt = "Acceleration"; }
    { ko = "거리"; qudt = "Length"; }
    { ko = "길이"; qudt = "Length"; }
    { ko = "시간"; qudt = "Time"; }
    { ko = "질량"; qudt = "Mass"; }
    { ko = "힘"; qudt = "Force"; }
    { ko = "에너지"; qudt = "Energy"; }
    { ko = "일"; qudt = "Energy"; }
    { ko = "넓이"; qudt = "Area"; }
    { ko = "면적"; qudt = "Area"; }
    { ko = "부피"; qudt = "Volume"; }
    { ko = "압력"; qudt = "Pressure"; }
    { ko = "밀도"; qudt = "Density"; }
    { ko = "온도"; qudt = "Temperature"; }
    { ko = "주파수"; qudt = "Frequency"; }
    { ko = "진동수"; qudt = "Frequency"; }
    { ko = "전류"; qudt = "ElectricCurrent"; }
    { ko = "전압"; qudt = "Voltage"; }
    { ko = "일률"; qudt = "Power"; }
    { ko = "전력"; qudt = "Power"; }
  ];
}
