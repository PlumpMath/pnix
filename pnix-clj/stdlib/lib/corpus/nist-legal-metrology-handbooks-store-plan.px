# stdlib/lib/corpus/nist-legal-metrology-handbooks-store-plan.px — NIST HB44/HB130 metadata catalog.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# PDF/DOCX body, legal advice, device compliance decisions, graph wiring 없음.
let
  B = builtins;
  genPath = ./nist-legal-metrology-handbooks.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "units.nist_legal_metrology_handbooks.v1";
    source = { name = "NIST legal metrology handbooks catalog"; license = "US-PD"; scope = "empty seed fallback"; };
    summary = { handbook_count = 0; pdf_body_ingested = false; mirror_graph_wiring = false; };
    handbooks = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "nist-legal-metrology-handbooks-load-v0";
      source_lens = "stdlib/lib/corpus/nist-legal-metrology-handbooks-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "units.nist_legal_metrology_handbooks.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "nist-legal-metrology-handbooks-query-v0";
      source_lens = "stdlib/lib/corpus/nist-legal-metrology-handbooks-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "units.nist_legal_metrology_handbooks.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
