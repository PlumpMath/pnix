# stdlib/lib/corpus/smithsonian-openaccess-store-plan.px — Smithsonian Open Access bounded index metadata.
# redb corpus_source_records에 pnix attrset source(JSON 아님)로 append한다.
# freetext/media/person/location details/rights interpretation/graph wiring 없음.
let
  B = builtins;
  genPath = ./smithsonian-openaccess.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "culture.smithsonian_openaccess.v1";
    source = { name = "Smithsonian Open Access API"; license = "Smithsonian Open Access / CC0-style public metadata"; scope = "empty seed fallback"; };
    summary = { status = 0; responseCode = 0; stored_count = 0; freetext_payloads_ingested = false; media_payloads_ingested = false; person_location_details_ingested = false; rights_interpretation_ingested = false; mirror_graph_wiring = false; };
    objects = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "smithsonian-openaccess-load-v0";
      source_lens = "stdlib/lib/corpus/smithsonian-openaccess-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "culture.smithsonian_openaccess.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "smithsonian-openaccess-query-v0";
      source_lens = "stdlib/lib/corpus/smithsonian-openaccess-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "culture.smithsonian_openaccess.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
