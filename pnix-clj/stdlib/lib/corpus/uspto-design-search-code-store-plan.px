# stdlib/lib/corpus/uspto-design-search-code-store-plan.px — USPTO Design Search Code taxonomy.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# guideline prose/images/trademark records/legal judgments/graph wiring 없음.
let
  B = builtins;
  genPath = ./uspto-design-search-code.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "trademark.uspto_design_search_code.v1";
    source = { name = "USPTO Design Search Code taxonomy"; license = "US-PD"; scope = "empty seed fallback"; };
    summary = { category_count = 0; trademark_records_ingested = false; mirror_graph_wiring = false; };
    categories = [ ]; divisions = [ ]; subdivisions = [ ]; equivalence_labels = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "uspto-design-search-code-load-v0";
      source_lens = "stdlib/lib/corpus/uspto-design-search-code-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "trademark.uspto_design_search_code.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "uspto-design-search-code-query-v0";
      source_lens = "stdlib/lib/corpus/uspto-design-search-code-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "trademark.uspto_design_search_code.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
