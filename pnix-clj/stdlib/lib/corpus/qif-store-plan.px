# stdlib/lib/corpus/qif-store-plan.px — QIF XSD schema metadata.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# sample instances/measurement values/process guidance/execution/graph wiring 없음.
let
  B = builtins;
  genPath = ./qif.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "quality.qif.xsd_schema.v1";
    source = { name = "Quality Information Framework qif-community XML schema metadata"; license = "BSL-1.0"; scope = "empty seed fallback"; };
    summary = { xsd_file_count = 0; complex_type_count = 0; simple_type_count = 0; };
    source_files = [ ]; schema_files = [ ]; includes = [ ]; elements = [ ]; complex_types = [ ]; simple_types = [ ]; attributes = [ ]; groups = [ ]; attribute_groups = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "qif-load-v0";
      source_lens = "stdlib/lib/corpus/qif-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "quality.qif.xsd_schema.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "qif-query-v0";
      source_lens = "stdlib/lib/corpus/qif-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "quality.qif.xsd_schema.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
