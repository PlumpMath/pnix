# Congress.gov API documentation metadata -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No API payload/legal advice/graph wiring.
let
  B = builtins;
  genPath = ./congressgov-api-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "legal.congressgov.api_catalog.v1";
    source = "Congress.gov API documentation metadata";
    license = "US-PD / Library of Congress public information metadata";
    summary = { paths = 0; schemas = 0; docs = 0; };
    policy = "official API documentation metadata only";
    manifest = { };
    api_info = { }; paths = [ ]; schemas = [ ]; documents = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "congressgov-api-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/congressgov-api-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "legal.congressgov.api_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "congressgov-api-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/congressgov-api-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "legal.congressgov.api_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
