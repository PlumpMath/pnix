# stdlib/lib/corpus/optimade-schema-catalog-store-plan.px — OPTIMADE schema tree metadata.
# redb corpus_source_records에 pnix attrset source(JSON 아님)로 append한다.
# material payloads, provider rows, computed properties, schema bodies, graph wiring 없음.
let
  B = builtins;
  genPath = ./optimade-schema-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "materials.optimade_schema_catalog.v1";
    source = { name = "OPTIMADE specification schema tree metadata"; license = "CC-BY-4.0"; scope = "empty seed fallback"; };
    summary = { files_stored = 0; files_available = 0; directories_available = 0; truncated = false; schema_file_limit = 0; provider_rows_ingested = false; material_structure_payloads_ingested = false; composition_values_ingested = false; computed_properties_ingested = false; account_or_embargoed_rows_ingested = false; schema_bodies_ingested = false; mirror_graph_wiring = false; };
    category_counts = [ ];
    files = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "optimade-schema-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/optimade-schema-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "materials.optimade_schema_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "optimade-schema-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/optimade-schema-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "materials.optimade_schema_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
