# stdlib/lib/corpus/keep-a-changelog-store-plan.px — Keep a Changelog taxonomy/structure metadata snapshot.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# project-specific change entries/prose body/release automation은 포함하지 않는다. graph/mirror 연결도 하지 않는다.
let
  B = builtins;
  genPath = ./keep-a-changelog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "code.keep_a_changelog.v2";
    source = { name = "Keep a Changelog"; license = "MIT"; scope = "empty seed fallback"; };
    taxonomy = { canonical_sections = [ ]; observed_sections = [ ]; };
    version_heading = { observed_headings = [ ]; };
    link_patterns = { observed_links = [ ]; };
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "keep-a-changelog-load-v0";
      source_lens = "stdlib/lib/corpus/keep-a-changelog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "code.keep_a_changelog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "keep-a-changelog-query-v0";
      source_lens = "stdlib/lib/corpus/keep-a-changelog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "code.keep_a_changelog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
