# DOJ FARA / Data.gov catalog metadata -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No filing/search/document payloads/legal advice/graph wiring.
let
  B = builtins;
  genPath = ./doj-fara-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "legal.doj_fara.catalog.v1";
    source = "DOJ FARA / Data.gov catalog metadata";
    license = "US federal public catalog metadata; FARA payloads excluded";
    summary = { pages = 0; links = 0; resources = 0; files = 0; };
    policy = "Catalog/page/resource metadata only";
    manifest = { }; files = [ ]; pages = [ ]; datagov_dataset = { };
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "doj-fara-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/doj-fara-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "legal.doj_fara_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "doj-fara-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/doj-fara-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "legal.doj_fara_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
