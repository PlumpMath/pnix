# stdlib/lib/corpus/obo-biomedical-ontologies-store-plan.px — OBO biomedical ontology term structure.
# redb corpus_source_records에 pnix attrset source(JSON 아님)로 append한다.
# definition/comment/synonym prose, patient/sample/sequence payloads, graph wiring 없음.
let
  B = builtins;
  genPath = ./obo-biomedical-ontologies.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "bio.obo_biomedical_ontologies.v1";
    source = { name = "OBO biomedical ontology term structure"; licenses = "CC0/CC-BY"; scope = "empty seed fallback"; };
    summary = { source_count = 0; term_count_stored = 0; definition_prose_ingested = false; synonym_prose_ingested = false; patient_payloads_ingested = false; sequence_payloads_ingested = false; mirror_graph_wiring = false; sources = [ ]; };
    terms = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "obo-biomedical-ontologies-load-v0";
      source_lens = "stdlib/lib/corpus/obo-biomedical-ontologies-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "bio.obo_biomedical_ontologies.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "obo-biomedical-ontologies-query-v0";
      source_lens = "stdlib/lib/corpus/obo-biomedical-ontologies-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "bio.obo_biomedical_ontologies.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
