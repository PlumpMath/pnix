# CWL v1.2 schema catalog -> repo-local redb corpus_source_records.
let
  B = builtins;
  genPath = ./cwl-schema-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else { schema = "workflow.cwl.schema_catalog.v1"; source = { name = "CWL schema catalog"; license = "Apache-2.0"; }; summary = { class_count = 0; }; schema_files = [ ]; classes = [ ]; field_tokens = [ ]; symbol_tokens = [ ]; imports = [ ]; };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: { plan = { plan_id = "cwl-schema-catalog-load-v0"; source_lens = "stdlib/lib/corpus/cwl-schema-catalog-store-plan.px"; source_verdict = "materialize-corpus-source"; operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ]; receipt_owner = "workflow.cwl.schema_catalog.v0"; plan_built_at_ms = args.built_at_ms or 0; }; schema = seed.schema; content_hash = contentHash; value_bytes_len = B.stringLength valueSrc; };
  mkQuery = args: { plan = { plan_id = "cwl-schema-catalog-query-v0"; source_lens = "stdlib/lib/corpus/cwl-schema-catalog-store-plan.px"; source_verdict = "query-corpus-source"; operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ]; receipt_owner = "workflow.cwl.schema_catalog.v0"; plan_built_at_ms = args.built_at_ms or 0; }; expected_key = key; expected_hash = contentHash; };
}
