# Tesseract OCR source catalog -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No source bodies/OCR outputs/runtime/graph wiring.
let
  B = builtins;
  genPath = ./tesseract-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "ocr.tesseract.catalog.v1";
    source = "Tesseract OCR repository tree source catalog";
    license = "Apache-2.0";
    summary = { modules = 0; extensions = 0; files = 0; files_total_seen = 0; limit = 0; };
    policy = "Git tree module/file path metadata only";
    manifest = { };
    files = [ ]; modules = [ ]; extensions = [ ]; source_files = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "tesseract-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/tesseract-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "ocr.tesseract.catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "tesseract-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/tesseract-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "ocr.tesseract.catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
