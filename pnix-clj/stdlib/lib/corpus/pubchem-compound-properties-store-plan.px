# stdlib/lib/corpus/pubchem-compound-properties-store-plan.px — PubChem PUG REST compound property rows.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# synonyms/SID depositor/AID BioAssay/PUG-View prose/hazard/synthesis guidance는 포함하지 않는다. graph/mirror 연결도 하지 않는다.
let
  B = builtins;
  genPath = ./pubchem-compound-properties.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "chem.pubchem_compound_properties.v1";
    source = { name = "PubChem PUG REST compound properties"; license = "NIH/NCBI public domain core data with caveat"; scope = "empty seed fallback"; };
    summary = { compound_count = 0; };
    compounds = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "pubchem-compound-properties-load-v0";
      source_lens = "stdlib/lib/corpus/pubchem-compound-properties-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "chem.pubchem_compound_properties.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "pubchem-compound-properties-query-v0";
      source_lens = "stdlib/lib/corpus/pubchem-compound-properties-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "chem.pubchem_compound_properties.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
