# stdlib/lib/corpus/clippy-store-plan.px — Clippy lint metadata snapshot.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# lint implementation/docs prose/user lint results/configs/autofix payloads는 포함하지 않는다. graph/mirror 연결도 하지 않는다.
let
  B = builtins;
  genPath = ./clippy.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "code.clippy.lints.v1";
    source = { name = "Clippy lint metadata"; license = "MIT OR Apache-2.0"; scope = "empty seed fallback"; };
    summary = { lint_count = 0; category_count = 0; renamed_count = 0; deprecated_count = 0; };
    categories = [ ];
    lints = [ ];
    renamed = [ ];
    deprecated = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "clippy-lints-load-v0";
      source_lens = "stdlib/lib/corpus/clippy-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "code.clippy.lints.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "clippy-lints-query-v0";
      source_lens = "stdlib/lib/corpus/clippy-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "code.clippy.lints.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
