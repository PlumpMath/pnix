# PSC + NAICS code tables -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No prose/manual body/contract rows/graph wiring.
let
  B = builtins;
  genPath = ./psc-naics-codes.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "procurement.psc_naics_codes.v1";
    source = "PSC/NAICS code tables";
    license = "US-PD / US federal public information";
    policy = "code-title metadata only";
    summary = { psc_rows = 0; naics_rows = 0; };
    manifest = { }; psc_codes = [ ]; naics_codes = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "psc-naics-codes-load-v0";
      source_lens = "stdlib/lib/corpus/psc-naics-codes-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "procurement.psc_naics_codes.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "psc-naics-codes-query-v0";
      source_lens = "stdlib/lib/corpus/psc-naics-codes-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "procurement.psc_naics_codes.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
