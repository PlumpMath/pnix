# ScanCode LicenseDB index metadata -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No license text/legal advice/graph wiring.
let
  B = builtins;
  genPath = ./scancode-licensedb.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "license.scancode_licensedb.v1";
    source = "ScanCode LicenseDB index metadata";
    license = "CC-BY-4.0 metadata / Apache-2.0 tooling";
    summary = { licenses = 0; licenses_total_seen = 0; categories = 0; exceptions = 0; deprecated = 0; limit = 0; };
    policy = "index metadata only";
    manifest = { };
    files = [ ]; categories = [ ]; licenses = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "scancode-licensedb-load-v0";
      source_lens = "stdlib/lib/corpus/scancode-licensedb-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "license.scancode_licensedb.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "scancode-licensedb-query-v0";
      source_lens = "stdlib/lib/corpus/scancode-licensedb-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "license.scancode_licensedb.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
