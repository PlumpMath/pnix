# stdlib/lib/corpus/pudl-metadata-resources-store-plan.px — PUDL metadata resources.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# 실제 PUDL DB/parquet rows, prose descriptions, dispatch/security/forecast payloads는 포함하지 않는다.
let
  B = builtins;
  genPath = ./pudl-metadata-resources.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "energy.pudl_metadata_resources.v1";
    source = { name = "PUDL metadata resources"; license = "MIT software + CC-BY-4.0 data/docs"; scope = "empty seed fallback"; };
    summary = { file_count = 0; resource_table_ref_count = 0; field_ref_count = 0; };
    files = [ ];
    resource_table_refs = [ ];
    field_refs = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "pudl-metadata-resources-load-v0";
      source_lens = "stdlib/lib/corpus/pudl-metadata-resources-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "energy.pudl_metadata_resources.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "pudl-metadata-resources-query-v0";
      source_lens = "stdlib/lib/corpus/pudl-metadata-resources-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "energy.pudl_metadata_resources.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
