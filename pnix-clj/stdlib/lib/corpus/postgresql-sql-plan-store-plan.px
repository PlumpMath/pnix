# PostgreSQL SQL grammar / plan-node metadata -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No source body/query-log/execution/graph wiring.
let
  B = builtins;
  genPath = ./postgresql-sql-plan.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "db.postgresql.sql_plan_metadata.v1";
    source = "PostgreSQL SQL grammar and plan-node metadata";
    license = "PostgreSQL";
    summary = { version_tags = 0; tokens = 0; productions = 0; node_tags = 0; structs = 0; };
    policy = "structural identifiers only";
    manifest = { };
    version_tags = [ ]; sql_tokens = [ ]; grammar_productions = [ ]; node_tags = [ ]; node_structs = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "postgresql-sql-plan-load-v0";
      source_lens = "stdlib/lib/corpus/postgresql-sql-plan-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "db.postgresql.sql_plan_metadata.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "postgresql-sql-plan-query-v0";
      source_lens = "stdlib/lib/corpus/postgresql-sql-plan-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "db.postgresql.sql_plan_metadata.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
