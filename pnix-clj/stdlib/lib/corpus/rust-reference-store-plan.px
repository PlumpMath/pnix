# Rust Reference structural metadata -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No prose/source/execution/graph wiring.
let
  B = builtins;
  genPath = ./rust-reference.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "code.rust.reference_metadata.v1";
    source = "Rust Reference structural metadata";
    license = "MIT OR Apache-2.0";
    summary = { reference_tags = 0; rust_release_tags = 0; documents = 0; headings = 0; codeblock_markers = 0; };
    policy = "structural reference metadata only";
    manifest = { };
    reference_tags = [ ]; rust_release_tags = [ ]; documents = [ ]; headings = [ ]; codeblock_markers = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "rust-reference-load-v0";
      source_lens = "stdlib/lib/corpus/rust-reference-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "code.rust.reference_metadata.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "rust-reference-query-v0";
      source_lens = "stdlib/lib/corpus/rust-reference-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "code.rust.reference_metadata.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
