# stdlib/lib/corpus/fda-ndc-directory-products-store-plan.px — openFDA NDC product/package metadata.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# label text/strength/package-description prose/prescribing/safety/adverse-event/enforcement payloads는 포함하지 않는다. graph/mirror 연결도 하지 않는다.
let
  B = builtins;
  genPath = ./fda-ndc-directory-products.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "pharma.fda_ndc_directory_products.v1";
    source = { name = "openFDA Drug NDC Directory product/package metadata"; license = "openFDA public domain / CC0 public data policy"; scope = "empty seed fallback"; };
    summary = { product_count = 0; package_count = 0; };
    products = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "fda-ndc-directory-products-load-v0";
      source_lens = "stdlib/lib/corpus/fda-ndc-directory-products-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "pharma.fda_ndc_directory_products.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "fda-ndc-directory-products-query-v0";
      source_lens = "stdlib/lib/corpus/fda-ndc-directory-products-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "pharma.fda_ndc_directory_products.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
