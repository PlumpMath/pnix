# stdlib/lib/corpus/sbom-format-schemas-store-plan.px — CycloneDX/SPDX schema metadata.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# actual SBOMs, customer inventory, compliance judgments, graph wiring 없음.
let
  B = builtins;
  genPath = ./sbom-format-schemas.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "sbom.format_schemas.v1";
    source = { name = "CycloneDX/SPDX SBOM format schemas"; license = "public schema metadata"; scope = "empty seed fallback"; };
    summary = { schema_file_count = 0; actual_sbom_documents_ingested = false; mirror_graph_wiring = false; };
    schema_files = [ ]; definitions = [ ]; properties = [ ]; enum_values = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "sbom-format-schemas-load-v0";
      source_lens = "stdlib/lib/corpus/sbom-format-schemas-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "sbom.format_schemas.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "sbom-format-schemas-query-v0";
      source_lens = "stdlib/lib/corpus/sbom-format-schemas-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "sbom.format_schemas.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
