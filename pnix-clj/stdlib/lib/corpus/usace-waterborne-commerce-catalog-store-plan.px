# USACE Waterborne Commerce catalog metadata -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No reports/statistics/security/operations/graph wiring.
let
  B = builtins;
  genPath = ./usace-waterborne-commerce-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "maritime.usace_waterborne_commerce.catalog.v1";
    source = "USACE Waterborne Commerce catalog metadata via CONTENTdm";
    license = "US-PD / US federal public information";
    summary = { total_results = 0; items = 0; sort_fields = 0; files = 0; };
    policy = "official catalog search result metadata only";
    manifest = { };
    files = [ ]; sample_page_sig = { bytes = 0; sha256 = ""; }; sort_fields = [ ]; items = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "usace-waterborne-commerce-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/usace-waterborne-commerce-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "maritime.usace_waterborne_commerce.catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "usace-waterborne-commerce-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/usace-waterborne-commerce-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "maritime.usace_waterborne_commerce.catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
