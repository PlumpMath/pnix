# Federal Register API schema metadata -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No rule/document body/legal advice/graph wiring.
let
  B = builtins;
  genPath = ./federal-register-api.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "regulatory.federal_register.api_schema.v1";
    source = "Federal Register API endpoint/schema metadata";
    license = "US-PD / US federal public information";
    summary = { endpoints = 0; document_schema_paths = 0; agencies = 0; files = 0; };
    policy = "endpoint catalog and response key/type inventory only";
    manifest = { };
    files = [ ]; endpoints = [ ]; document_response_schema = [ ]; agency_schema = [ ]; agencies_bounded = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "federal-register-api-load-v0";
      source_lens = "stdlib/lib/corpus/federal-register-api-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "regulatory.federal_register.api_schema.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "federal-register-api-query-v0";
      source_lens = "stdlib/lib/corpus/federal-register-api-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "regulatory.federal_register.api_schema.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
