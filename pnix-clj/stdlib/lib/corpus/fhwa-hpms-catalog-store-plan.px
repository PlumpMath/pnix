# FHWA HPMS catalog metadata -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No road segment payload/geometry/safety judgment/graph wiring.
let
  B = builtins;
  genPath = ./fhwa-hpms-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "transport.fhwa_hpms.catalog.v1";
    source = "FHWA HPMS catalog metadata via Data.gov CKAN API";
    license = "US-PD / US federal public information";
    summary = { datasets = 0; resources = 0; files = 0; };
    policy = "official catalog/API metadata only";
    manifest = { };
    files = [ ]; datasets = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "fhwa-hpms-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/fhwa-hpms-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "transport.fhwa_hpms.catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "fhwa-hpms-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/fhwa-hpms-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "transport.fhwa_hpms.catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
