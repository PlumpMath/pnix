# RCSB Search API schema catalog -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No structure/search payload rows/graph wiring.
let
  B = builtins;
  genPath = ./rcsb-search-schema-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "bio.rcsb.search_schema_catalog.v1";
    source = "RCSB Search API schema catalog";
    license = "CC0-1.0 / public metadata";
    policy = "schema/category/property metadata only";
    summary = { schema_files = 0; categories = 0; properties = 0; };
    manifest = { }; categories = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "rcsb-search-schema-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/rcsb-search-schema-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "bio.rcsb.search_schema_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "rcsb-search-schema-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/rcsb-search-schema-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "bio.rcsb.search_schema_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
