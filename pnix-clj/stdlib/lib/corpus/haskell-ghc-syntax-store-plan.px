# GHC Haskell syntax/parser redb store-plan. 구조 데이터만 적재, graph/mirror/math 연결 없음.
let
  B = builtins;
  genPath = ./haskell-ghc-syntax.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "code.haskell.ghc.syntax.v1";
    source = { project = "GHC exposed Haskell syntax/parser structures"; };
    source_files = [ ]; ast_declarations = [ ]; ast_constructors = [ ]; parser_entries = [ ]; parser_nonterminals = [ ]; parser_tokens = [ ]; lexer_macros = [ ]; language_extensions = [ ];
    counts = { source_files = 0; ast_declarations = 0; ast_constructors = 0; parser_entries = 0; parser_nonterminals = 0; parser_tokens = 0; lexer_macros = 0; language_extensions = 0; };
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "code-haskell-ghc-syntax-load-v0";
      source_lens = "stdlib/lib/corpus/haskell-ghc-syntax-store-plan.px";
      source_verdict = "materialize-code-haskell-ghc-syntax";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "code.haskell.ghc.syntax.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "code-haskell-ghc-syntax-query-v0";
      source_lens = "stdlib/lib/corpus/haskell-ghc-syntax-store-plan.px";
      source_verdict = "query-code-haskell-ghc-syntax";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "code.haskell.ghc.syntax.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
