# stdlib/lib/corpus/datacite-metadata-schema-store-plan.px — DataCite metadata schema metadata.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# DOI records/prose/person values/resource payloads/API harvest/graph wiring 없음.
let
  B = builtins;
  genPath = ./datacite-metadata-schema.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "scholarly.datacite.metadata_schema.v1";
    source = { name = "DataCite Metadata Schema XSD metadata"; license = "CC0-1.0 for DataCite metadata"; scope = "empty seed fallback"; };
    summary = { xsd_file_count = 0; element_count = 0; enumeration_count = 0; };
    source_files = [ ]; schema_files = [ ]; includes = [ ]; elements = [ ]; complex_types = [ ]; simple_types = [ ]; attributes = [ ]; enumerations = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "datacite-metadata-schema-load-v0";
      source_lens = "stdlib/lib/corpus/datacite-metadata-schema-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "scholarly.datacite.metadata_schema.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "datacite-metadata-schema-query-v0";
      source_lens = "stdlib/lib/corpus/datacite-metadata-schema-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "scholarly.datacite.metadata_schema.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
