# stdlib/lib/corpus/openapi-specification-store-plan.px — OpenAPI official schema metadata.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# spec prose/real API documents/secrets/execution/graph wiring 없음.
let
  B = builtins;
  genPath = ./openapi-specification.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "api.openapi.specification.v1";
    source = { name = "OpenAPI Specification schemas"; license = "Apache-2.0"; scope = "empty seed fallback"; };
    summary = { schema_file_count = 0; schema_term_count = 0; };
    schema_files = [ ];
    schema_terms = [ ];
    refs = [ ];
    required_fields = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "openapi-specification-load-v0";
      source_lens = "stdlib/lib/corpus/openapi-specification-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "api.openapi.specification.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "openapi-specification-query-v0";
      source_lens = "stdlib/lib/corpus/openapi-specification-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "api.openapi.specification.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
