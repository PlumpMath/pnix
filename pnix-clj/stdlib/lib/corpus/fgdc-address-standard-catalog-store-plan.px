# stdlib/lib/corpus/fgdc-address-standard-catalog-store-plan.px — FGDC address standard catalog.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# PDF prose/body text, address records, graph wiring 없음.
let
  B = builtins;
  genPath = ./fgdc-address-standard-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "place.fgdc_address_standard_catalog.v1";
    source = { name = "FGDC Address Standard catalog"; license = "US-PD"; scope = "empty seed fallback"; };
    summary = { zip_entry_count = 0; pdf_prose_ingested = false; mirror_graph_wiring = false; };
    zip_manifest = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "fgdc-address-standard-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/fgdc-address-standard-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "place.fgdc_address_standard_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "fgdc-address-standard-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/fgdc-address-standard-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "place.fgdc_address_standard_catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
