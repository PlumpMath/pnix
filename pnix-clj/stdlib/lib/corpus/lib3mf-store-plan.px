# stdlib/lib/corpus/lib3mf-store-plan.px — lib3mf schema metadata.
# redb `corpus_source_records`에 pnix attrset source(JSON 아님)로 append한다.
# model payloads/geometry values/printer params/generated bindings/execution/graph wiring 없음.
let
  B = builtins;
  genPath = ./lib3mf.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "cad.lib3mf.schema.v1";
    source = { name = "3MF Consortium lib3mf schema metadata"; license = "BSD-2-Clause"; scope = "empty seed fallback"; };
    summary = { source_file_count = 0; xsd_file_count = 0; interface_class_count = 0; };
    source_files = [ ]; xsd_files = [ ]; includes = [ ]; elements = [ ]; complex_types = [ ]; simple_types = [ ]; attributes = [ ]; parse_errors = [ ]; interface_packages = [ ]; interface_classes = [ ]; interface_methods = [ ]; interface_enums = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "lib3mf-load-v0";
      source_lens = "stdlib/lib/corpus/lib3mf-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "cad.lib3mf.schema.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "lib3mf-query-v0";
      source_lens = "stdlib/lib/corpus/lib3mf-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "cad.lib3mf.schema.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
