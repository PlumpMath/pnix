# USGS NGMDB catalog metadata -> repo-local redb corpus_source_records.
# Stores pnix attrset source, not JSON. No map payload/stability judgment/graph wiring.
let
  B = builtins;
  genPath = ./usgs-ngmdb-catalog.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "science.usgs_ngmdb.catalog.v1";
    source = "USGS National Geologic Map Database catalog metadata";
    license = "US-PD index/catalog metadata; map payloads per-publisher excluded";
    summary = { pages = 0; links = 0; files = 0; };
    policy = "official NGMDB index/catalog page metadata only";
    manifest = { };
    files = [ ]; pages = [ ];
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "usgs-ngmdb-catalog-load-v0";
      source_lens = "stdlib/lib/corpus/usgs-ngmdb-catalog-store-plan.px";
      source_verdict = "materialize-corpus-source";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "science.usgs_ngmdb.catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "usgs-ngmdb-catalog-query-v0";
      source_lens = "stdlib/lib/corpus/usgs-ngmdb-catalog-store-plan.px";
      source_verdict = "query-corpus-source";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "science.usgs_ngmdb.catalog.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
