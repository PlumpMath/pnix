# CPython Python.asdl redb store-plan. 적재까지만, graph/mirror/math 연결 없음.
let
  B = builtins;
  genPath = ./python-asdl.generated.px;
  seed = if B.pathExists genPath then import genPath else { schema = "code.python.asdl.v1"; source = { project = "python/cpython"; }; definitions = [ ]; definition_count = 0; };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "code-python-asdl-load-v0";
      source_lens = "stdlib/lib/corpus/python-asdl-store-plan.px";
      source_verdict = "materialize-code-python-asdl";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "code.python.asdl.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "code-python-asdl-query-v0";
      source_lens = "stdlib/lib/corpus/python-asdl-store-plan.px";
      source_verdict = "query-code-python-asdl";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "code.python.asdl.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
