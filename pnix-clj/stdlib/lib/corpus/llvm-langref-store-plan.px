# LLVM LangRef redb store-plan. 구조 데이터만 적재, graph/mirror/math 연결 없음.
let
  B = builtins;
  genPath = ./llvm-langref.generated.px;
  seed = if B.pathExists genPath then import genPath else {
    schema = "code.llvm.langref.v1";
    source = { project = "LLVM Language Reference Manual"; };
    source_files = [ ]; headings = [ ]; instructions = [ ]; instruction_syntax = [ ]; attributes = [ ]; types = [ ]; metadata = [ ];
    counts = { source_files = 0; headings = 0; instructions = 0; instruction_syntax = 0; attributes = 0; types = 0; metadata = 0; };
  };
  ser = import ../nl/pnix-value-literal.px;
  valueSrc = ser.toPnixSource seed;
  contentHash = B.hashString "sha256" valueSrc;
  key = seed.schema + "/" + contentHash;
in {
  mkPlan = args: {
    plan = {
      plan_id = "code-llvm-langref-load-v0";
      source_lens = "stdlib/lib/corpus/llvm-langref-store-plan.px";
      source_verdict = "materialize-code-llvm-langref";
      operations = [ { op_kind = "append"; table = "corpus_source_records"; key = key; value_bytes = valueSrc; } ];
      receipt_owner = "code.llvm.langref.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    schema = seed.schema;
    content_hash = contentHash;
    value_bytes_len = B.stringLength valueSrc;
  };
  mkQuery = args: {
    plan = {
      plan_id = "code-llvm-langref-query-v0";
      source_lens = "stdlib/lib/corpus/llvm-langref-store-plan.px";
      source_verdict = "query-code-llvm-langref";
      operations = [ { op_kind = "scan-prefix"; table = "corpus_source_records"; key = ""; key_prefix = seed.schema + "/"; } ];
      receipt_owner = "code.llvm.langref.v0";
      plan_built_at_ms = args.built_at_ms or 0;
    };
    expected_key = key;
    expected_hash = contentHash;
  };
}
