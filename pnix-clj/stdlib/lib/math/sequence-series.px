# stdlib.lib.math.sequence-series
#
# OWNER-LAW (v0.12-TT, div-math, 2026-05-21): exact arithmetic and
# geometric sequences and series, plus the classic figurate-number
# sums, all by closed-form formula.
#
# The math lane has scalar arithmetic, number theory, algebra, and
# linear algebra. It had no *sequence* owner -- the nth term of a
# progression, the sum of the first n terms. This owner adds it.
#
# # Closed form, not iteration
#
# Every result is a closed-form formula evaluated once:
#
#   arithmetic nth term   a + (n-1)*d
#   arithmetic sum        n*(2a + (n-1)*d) / 2
#   geometric  nth term   a * r^(n-1)
#   geometric  sum        a*(r^n - 1)/(r - 1)   (n*a when r = 1)
#   triangular number     n*(n+1)/2
#   sum of squares        n*(n+1)*(2n+1)/6
#   sum of cubes          (n*(n+1)/2)^2
#
# Each division above is exact -- the numerator is always a
# multiple of the denominator (a known elementary fact for each
# formula), so the result stays an integer with no rounding.
#
# # Standalone
#
# Imports nothing. Integer parameters, integer results, same input
# -> same receipt.
#
# # What this owner is NOT (honest scope)
#
#   - NOT an infinite-series / convergence engine -- finite n only.
#   - NOT a generating-function or recurrence solver.
#   - NOT rational-ratio geometric series (integer ratio only).
#   - NOT yet a registered mirror-plate lens.

let
  ownerName = "stdlib/lib/math/sequence-series.px";

  # Integer power base^exp by repeated multiply (exp >= 0).
  intPow = base: exp:
    if exp == 0 then 1 else base * (intPow base (exp - 1));

  # --- arithmetic progressions ----------------------------------

  # nth term (1-indexed) of the arithmetic progression a, a+d,
  # a+2d, ...  ->  a + (n-1)*d.
  arithmeticTerm = a: d: n: a + (n - 1) * d;

  # Sum of the first n terms: n*(2a + (n-1)*d) / 2. The product
  # n*(2a + (n-1)*d) is always even, so the division is exact.
  arithmeticSum = a: d: n:
    (n * (2 * a + (n - 1) * d)) / 2;

  # --- geometric progressions -----------------------------------

  # nth term (1-indexed) of the geometric progression a, a*r,
  # a*r^2, ...  ->  a * r^(n-1).
  geometricTerm = a: r: n: a * (intPow r (n - 1));

  # Sum of the first n terms. With ratio r = 1 every term is a, so
  # the sum is n*a. Otherwise a*(r^n - 1)/(r - 1); the factor
  # (r^n - 1)/(r - 1) = 1 + r + ... + r^(n-1) is an exact integer.
  geometricSum = a: r: n:
    if r == 1 then n * a
    else a * ((intPow r n) - 1) / (r - 1);

  # --- figurate-number sums -------------------------------------

  # The nth triangular number 1 + 2 + ... + n = n*(n+1)/2.
  triangular = n: (n * (n + 1)) / 2;

  # 1^2 + 2^2 + ... + n^2 = n*(n+1)*(2n+1)/6.
  sumOfSquares = n: (n * (n + 1) * (2 * n + 1)) / 6;

  # 1^3 + 2^3 + ... + n^3 = (n*(n+1)/2)^2 = (triangular n)^2.
  sumOfCubes = n:
    let t = triangular n;
    in t * t;

  # --- plate-shaped entry ---------------------------------------

  knownOperations = [
    "arithmetic-term"
    "arithmetic-sum"
    "geometric-term"
    "geometric-sum"
    "triangular"
    "sum-of-squares"
    "sum-of-cubes"
  ];

  # Operations that index a term and so need n >= 1.
  needsPositiveN = [
    "arithmetic-term" "arithmetic-sum"
    "geometric-term" "geometric-sum"
    "triangular" "sum-of-squares" "sum-of-cubes"
  ];

  applySequence = request:
    let
      op = request.operation;
      a  = if request ? a then request.a else 0;
      d  = if request ? d then request.d else 0;
      r  = if request ? r then request.r else 1;
      n  = request.n;
    in
      if !(builtins.elem op knownOperations) then {
        outcome = "held-unknown-operation";
        operation = op;
        known_operations = knownOperations;
      }
      else if (builtins.elem op needsPositiveN) && n < 1 then {
        outcome = "held-non-positive-index";
        operation = op;
        n = n;
        reason = "the term index / count n must be >= 1";
      }
      else if op == "arithmetic-term" then {
        outcome = "sequence-computed";
        operation = op; a = a; d = d; n = n;
        value = arithmeticTerm a d n;
      }
      else if op == "arithmetic-sum" then {
        outcome = "sequence-computed";
        operation = op; a = a; d = d; n = n;
        value = arithmeticSum a d n;
      }
      else if op == "geometric-term" then {
        outcome = "sequence-computed";
        operation = op; a = a; r = r; n = n;
        value = geometricTerm a r n;
      }
      else if op == "geometric-sum" then {
        outcome = "sequence-computed";
        operation = op; a = a; r = r; n = n;
        value = geometricSum a r n;
      }
      else if op == "triangular" then {
        outcome = "sequence-computed";
        operation = op; n = n;
        value = triangular n;
      }
      else if op == "sum-of-squares" then {
        outcome = "sequence-computed";
        operation = op; n = n;
        value = sumOfSquares n;
      }
      else {
        # op == "sum-of-cubes"
        outcome = "sequence-computed";
        operation = op; n = n;
        value = sumOfCubes n;
      };

in {
  inherit
    ownerName
    intPow
    arithmeticTerm
    arithmeticSum
    geometricTerm
    geometricSum
    triangular
    sumOfSquares
    sumOfCubes
    knownOperations
    applySequence;
  meta = {
    source = "stdlib math sequence series";
    owner = ownerName;
    base = "parametric-math-sequence-series-v0";
    rev_note = "v0.12-TT (div-math): exact arithmetic/geometric sequences and series owner. Closed-form nth term and partial sum for both progressions; the geometric sum special-cases ratio 1; classic figurate sums (triangular number, sum of squares, sum of cubes). Every formula's division is exact (the numerator is provably a multiple of the denominator). Standalone, integer parameters and results. NOT infinite-series convergence, NOT a recurrence solver, NOT rational-ratio, NOT yet a registered lens.";
  };
}
