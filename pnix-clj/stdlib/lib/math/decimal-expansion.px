# stdlib.lib.math.decimal-expansion
#
# OWNER-LAW (v0.12-AAP, div-math, 2026-05-21): the decimal
# expansion of a rational number, with exact cycle detection.
#
# rational.px represents p/q as a reduced pair. continued-fraction
# .px gives one alternative form. This owner gives another: the
# decimal expansion -- and crucially, it does so EXACTLY, because
# the expansion of a rational is either terminating or eventually
# periodic, and the period is found, not approximated.
#
# # Long division with remainder memory
#
# `expandDecimal` runs long division and remembers every
# remainder it has seen. The moment a remainder recurs, the digits
# emitted since that remainder are the repeating block; the digits
# before it are the non-repeating prefix. A remainder of 0 means a
# terminating expansion.
#
# So 1/4 -> 0.25, 1/3 -> 0.(3), 1/7 -> 0.(142857), 1/6 -> 0.1(6),
# all exact, with the repeating block named explicitly.
#
# # Kernel layering
#
# decimal-expansion -> rational. The input fraction is reduced by
# rational.px first so the period is the true period.
#
# # What this owner is NOT (honest scope)
#
#   - NOT irrational numbers -- a rational input only.
#   - NOT negative numbers (non-negative p, positive q).
#   - NOT a fixed-precision decimal -- it returns the EXACT
#     structure (prefix + period), not a truncated string.
#   - NOT yet a registered mirror-plate lens.

let
  ownerName = "stdlib/lib/math/decimal-expansion.px";

  rational = import ./rational.px;

  # Index of the first occurrence of x in xs, or -1 if absent.
  indexOf = x: xs:
    let
      n = builtins.length xs;
      go = i:
        if i >= n then (0 - 1)
        else if builtins.elemAt xs i == x then i
        else go (i + 1);
    in go 0;

  # The first `k` elements / the elements from index `k` on.
  takeN = k: xs:
    let
      go = i: acc:
        if i >= k then acc
        else go (i + 1) (acc ++ [ (builtins.elemAt xs i) ]);
    in go 0 [];
  dropN = k: xs:
    let
      n = builtins.length xs;
      go = i: acc:
        if i >= n then acc
        else go (i + 1) (acc ++ [ (builtins.elemAt xs i) ]);
    in go k [];

  # The decimal expansion of p/q (p >= 0, q > 0). The fraction is
  # reduced first. Returns
  #   { integer_part; non_repeating; repeating; }
  # where the digit lists are the non-repeating prefix and the
  # repeating block (empty when the expansion terminates).
  expandDecimal = p: q:
    let
      reduced = rational.mkRational p q;
      rp = reduced.num;
      rq = reduced.den;
      intPart = rp / rq;
      r0 = rp - intPart * rq;
      # long division: rem, the remainders seen, the digits so far
      go = rem: seen: digits:
        if rem == 0 then {
          non_repeating = digits;
          repeating = [];
        }
        else
          let idx = indexOf rem seen;
          in
            if idx >= 0 then {
              non_repeating = takeN idx digits;
              repeating = dropN idx digits;
            }
            else
              let
                rem10 = rem * 10;
                digit = rem10 / rq;
                newRem = rem10 - digit * rq;
              in go newRem (seen ++ [ rem ]) (digits ++ [ digit ]);
      frac = go r0 [] [];
    in {
      integer_part = intPart;
      non_repeating = frac.non_repeating;
      repeating = frac.repeating;
    };

  # Whether p/q has a terminating decimal expansion.
  isTerminating = p: q: (expandDecimal p q).repeating == [];

  # The length of the repeating period (0 when terminating).
  periodLength = p: q:
    builtins.length (expandDecimal p q).repeating;

  # --- plate-shaped entry ---------------------------------------

  knownOperations = [ "expand" "is-terminating" "period-length" ];

  applyDecimalExpansion = request:
    let
      op = request.operation;
      p  = if request ? p then request.p else 0;
      q  = if request ? q then request.q else 1;
    in
      if !(builtins.elem op knownOperations) then {
        outcome = "held-unknown-operation";
        operation = op;
        known_operations = knownOperations;
      }
      else if p < 0 || q <= 0 then {
        outcome = "held-out-of-domain";
        operation = op;
        reason = "expansion needs p >= 0 and q > 0";
      }
      else if op == "expand" then
        let e = expandDecimal p q;
        in {
          outcome = "decimal-expansion-computed";
          operation = op;
          integer_part = e.integer_part;
          non_repeating = e.non_repeating;
          repeating = e.repeating;
          terminating = e.repeating == [];
        }
      else if op == "is-terminating" then {
        outcome = "decimal-expansion-computed";
        operation = op;
        holds = isTerminating p q;
      }
      else {
        # op == "period-length"
        outcome = "decimal-expansion-computed";
        operation = op;
        value = periodLength p q;
      };

in {
  inherit
    ownerName
    indexOf
    takeN
    dropN
    expandDecimal
    isTerminating
    periodLength
    knownOperations
    applyDecimalExpansion;
  meta = {
    source = "stdlib math decimal expansion";
    owner = ownerName;
    base = "parametric-math-decimal-expansion-v0";
    rev_note = "v0.12-AAP (div-math): exact decimal expansion of a rational. expandDecimal runs long division remembering every remainder; a recurring remainder reveals the repeating block exactly (1/7 -> 0.(142857), 1/6 -> 0.1(6)), a zero remainder a terminating expansion. isTerminating and periodLength fall out. Kernel layering: decimal-expansion -> rational (the fraction is reduced first so the period is the true period). NOT irrational input, NOT negative numbers, NOT a truncated fixed-precision decimal, NOT yet a registered lens.";
  };
}
