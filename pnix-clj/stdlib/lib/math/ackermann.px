# stdlib.lib.math.ackermann
#
# OWNER-LAW (v0.12-ABC, div-math, 2026-05-22): the Ackermann
# function.
#
# Every other div-math owner computes something that grows at a
# manageable rate. The Ackermann function is the classic example
# of a total computable function that is NOT primitive recursive
# -- it grows faster than any primitive-recursive function. This
# owner makes it computable, exactly, within a safe bound.
#
# # The definition
#
#   A(0, n) = n + 1
#   A(m, 0) = A(m-1, 1)
#   A(m, n) = A(m-1, A(m, n-1))
#
# # The bound is the honest part
#
# A(4,2) has 19729 decimal digits; A(4,3) does not fit in any
# computer. The recursive `ackermann` is exposed, but the plate
# Held-guards (m,n) to a range that terminates quickly and stays
# in 64-bit range. For larger arguments at m <= 3 the owner offers
# the EXACT closed forms instead:
#
#   A(1,n) = n + 2,  A(2,n) = 2n + 3,  A(3,n) = 2^(n+3) - 3
#
# computed directly, no deep recursion.
#
# # Standalone, exact
#
# Imports nothing. Same input -> same receipt.
#
# # What this owner is NOT (honest scope)
#
#   - NOT A(m,n) for m >= 4 beyond A(4,1) -- the values do not fit.
#   - NOT memoised.
#   - NOT yet a registered mirror-plate lens.

let
  ownerName = "stdlib/lib/math/ackermann.px";

  intPow = base: exp:
    let go = e: acc: if e <= 0 then acc else go (e - 1) (acc * base);
    in go exp 1;

  # The Ackermann function by its three-case definition.
  ackermann = m: n:
    if m == 0 then n + 1
    else if n == 0 then ackermann (m - 1) 1
    else ackermann (m - 1) (ackermann m (n - 1));

  # The exact closed forms for the low rows -- no recursion, so
  # they handle far larger n than the recursive definition.
  closedA1 = n: n + 2;
  closedA2 = n: 2 * n + 3;
  closedA3 = n: intPow 2 (n + 3) - 3;

  # Whether (m,n) is inside the range the recursive form may be
  # called on. The Ackermann recursion DEPTH is roughly the value
  # A(m,n) itself, and each frame is heavy -- so the recursive
  # form is bounded very conservatively. A(3,3)=61 is the famous
  # tractable case; A(3,4)+ and any m>=4 (A(4,1) internally
  # recurses to A(3,13)=65533, far past any safe stack) are out of
  # the recursive range -- use the a1/a2/a3 closed forms instead.
  withinSafeBounds = m: n:
    (m >= 0 && n >= 0)
    && (
      if m <= 1 then n <= 1000
      else if m == 2 then n <= 50
      else if m == 3 then n <= 3
      else false
    );

  # --- plate-shaped entry ---------------------------------------

  knownOperations = [ "ackermann" "a1" "a2" "a3" ];

  a3Limit = 58;

  applyAckermann = request:
    let
      op = request.operation;
      m  = if request ? m then request.m else 0;
      n  = if request ? n then request.n else 0;
    in
      if !(builtins.elem op knownOperations) then {
        outcome = "held-unknown-operation";
        operation = op;
        known_operations = knownOperations;
      }
      else if op == "ackermann" then
        if m < 0 || n < 0 then {
          outcome = "held-negative-argument";
          operation = op; m = m; n = n;
        }
        else if !(withinSafeBounds m n) then {
          outcome = "held-arguments-too-large";
          operation = op; m = m; n = n;
          reason = "A(m,n) past this range does not terminate quickly or does not fit 64-bit; use a1/a2/a3 closed forms for m<=3";
        }
        else {
          outcome = "ackermann-computed";
          operation = op; m = m; n = n;
          value = ackermann m n;
        }
      else
        # closed-form operations a1 / a2 / a3
        if n < 0 then {
          outcome = "held-negative-argument";
          operation = op; n = n;
        }
        else if op == "a3" && n > a3Limit then {
          outcome = "held-arguments-too-large";
          operation = op; n = n; limit = a3Limit;
        }
        else if op == "a1" then {
          outcome = "ackermann-computed";
          operation = op; n = n;
          value = closedA1 n;
        }
        else if op == "a2" then {
          outcome = "ackermann-computed";
          operation = op; n = n;
          value = closedA2 n;
        }
        else {
          # op == "a3"
          outcome = "ackermann-computed";
          operation = op; n = n;
          value = closedA3 n;
        };

in {
  inherit
    ownerName
    ackermann
    closedA1
    closedA2
    closedA3
    withinSafeBounds
    knownOperations
    applyAckermann;
  meta = {
    source = "stdlib math ackermann";
    owner = ownerName;
    base = "parametric-math-ackermann-v0";
    rev_note = "v0.12-ABC (div-math): the Ackermann function owner -- the classic total computable function that is not primitive recursive. ackermann by the three-case definition A(0,n)=n+1, A(m,0)=A(m-1,1), A(m,n)=A(m-1,A(m,n-1)); the plate Held-guards (m,n) to a fast-terminating 64-bit-safe range. Exact closed forms closedA1/A2/A3 (A(1,n)=n+2, A(2,n)=2n+3, A(3,n)=2^(n+3)-3) handle far larger n with no recursion. Standalone, exact. NOT A(m,n) for m>=4 past A(4,1), NOT memoised, NOT yet a registered lens.";
  };
}
