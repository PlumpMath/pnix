      atom_kind = "number-abs";
      slot_roles = [
        { slot = "target"; role = "object"; }
      ];
    }
    {
      # §F Tier 5 round 97 (2026-05-23): number-sqrt — 128번째 atom kind.
      # target 은 제곱근을 취하는 숫자 (object).
      atom_kind = "number-sqrt";
      slot_roles = [
        { slot = "target"; role = "object"; }
      ];
    }
    {
      # §F Tier 5 round 98 (2026-05-23): number-round — 129번째 atom kind.
      # target 은 반올림하는 숫자 (object).
