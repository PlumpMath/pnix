let
  ownerName = "stdlib.coding.atom-slot-semantic-roles";

  # v0.16-BM: substrate-native atom slot semantic role registry.
  #
  # Each BehaviorAtom slot carries a value (string / int / bool /
  # float / list of atoms / variable name). v0.16-BM lifts that
  # slot a second-order property: the SEMANTIC ROLE the slot plays
  # in the algorithm the atom expresses. e.g. bind-variable's
  # `value` slot carries data of role "object" (동작 대상), while
  # `value_kind` carries metadata of role "manner" (방법).
  #
  # WHY this exists (owner thesis, v0.16-BL/BM commit dialogue):
  #
  # Korean postpositions (조사: 을/를/이/가/은/는/에/에게/에서/으로/
  # 와/과/의/보다/까지/부터 ...) are a TYPED SEMANTIC ROLE MARKER
  # ALGEBRA — King Sejong designed Hangul as a mathematical
  # ontology surface, not just script. Each postposition lifts a
  # noun phrase into a specific argument role:
  #
  #   을/를  → object        (동작 대상)
  #   이/가  → subject        (동작 주체)
  #   은/는  → topic          (담론 주제)
  #   에     → target/locative (위치 / 목표)
  #   에게   → recipient      (받는 대상)
  #   에서   → source         (출발지)
  #   으로   → instrument/manner (수단 / 방법 / 방향)
  #   와/과  → comitative     (함께)
  #   의     → genitive       (소유)
  #
  # This algebra is ISOMORPHIC to substrate atom slot algebra.
  # English uses word-order + prepositions to do the same job
  # IMPLICITLY; Korean carries the role EXPLICITLY at the
  # morphology layer. The substrate's atom slots are typed by
  # construction; lifting each slot's semantic role into a
  # first-class field makes the isomorphism explicit and lets
  # bidirectional NL composition (atom → POS-aware NL) and
  # forward decomposition (POS-aware NL → atom slot fill) BOTH
  # query the same role data without re-deriving it per scanner /
  # per emitter.
  #
  # The registry stays substrate-native (no mecab-ko / lindera /
  # external NLP dependency) per owner-law: substrate cognition
  # must come from atomic meaning units + internal composition
  # intelligence, not external morphology library.
  #
  # SCOPE (BM baseline): pin the dimension. Downstream slices
  # (BN+ candidates: Korean case marker lens, English preposition
  # lens, reverse NL composition lens) read this registry but are
  # NOT in BM. BM is the substrate self-shape extension that the
  # later lenses query.

  # Closed inventory of semantic roles the substrate atom slot
  # algebra currently uses. Each role is a typed argument
  # category that maps cleanly onto Korean postpositions and
  # English prepositions. Adding a new atom kind with a new role
  # = one row here (closed registry per CLAUDE.md mirror primitive
  # introspection convergence axiom).
  knownSemanticRoles = [
    # Action-object: the noun phrase the action operates ON.
    # Korean: 을/를. English: bare object / "of X".
    # Used by: print-line.text, comment.text, print-variable.variable,
    # bind-variable.value.
    "object"
    # Locative target: WHERE the action lands. Korean: 에 (also
    # serves dative for variable binding — "X에 Y를 할당"). English:
    # "to X" / "into X" / "at X". Used by: read-line.variable
    # (where the input goes), bind-variable.variable (where the
    # value is stored).
    "target"
    # Instrument / manner: HOW the action is performed (data type,
    # iteration count, exit code, etc). Korean: 으로. English:
    # "as X" / "with X" / "by X". Used by: bind-variable.value_kind,
    # exit-with-code.code, repeat-n-times.count.
    "manner"
    # Predicate condition: the boolean expression a control-flow
    # atom guards on. Korean: 이/가 + "면/이면/일 때". English:
    # "if X" / "while X". Used by: if-true-then.condition_variable,
    # loop-while-true.condition_variable.
    "predicate-condition"
    # Consequence body: the list of atoms executed when the
    # control-flow predicate fires. Korean: implicit (following
    # clause). English: "then ...", "do ...". Used by:
    # if-true-then.then_body, repeat-n-times.body,
    # loop-while-true.body.
    "consequence-body"
    # v0.16-DE (2026-05-21): outcome — function 의 return type 같이
    # *결과로 나오는* type/value 의 semantic role. parameters 가 입력
    # (manner) 이라면 outcome 은 출력 (결과). Korean: 결과로 / X 반환.
    # English: "returns X" / "result: X". Used by:
    # function-declare.return_type.
    #
    # 왜 새 role: parameters 와 return_type 둘 다 type metadata 지만
    # 의미가 다르다 — parameters 는 *진입* (HOW function 이 작동),
    # return_type 은 *진출* (WHAT comes back). substrate 가 두 방향을
    # 같은 role 로 collapse 하면 information loss. closed role family
    # 5 → 6 으로 확장.
    "outcome"
  ];

  # Per-atom-kind slot → role mapping. The substrate's atom slot
  # algebra (9 atom kinds at v0.16-BL) lifted into role-tagged form.
  # Slot names match behavior-atom.px's `slots = { ... }` field
  # names verbatim so a downstream caller can `atom.slots."${slot_name}"`
  # and know the role.
  knownAtomSlotRoles = [
    {
      atom_kind = "print-line";
      slot_roles = [
        { slot = "text"; role = "object"; }
      ];
    }
    {
      atom_kind = "comment";
      slot_roles = [
        # Comment text is the noun being said-about, not an action
        # operand at runtime — but its semantic role in the NL
        # representation is still "the thing the comment talks
        # about", which is object-like.
        { slot = "text"; role = "object"; }
      ];
    }
    {
      atom_kind = "exit-with-code";
      slot_roles = [
        # The exit code is the STATUS the runtime exits WITH —
        # instrument/manner ("으로 종료"). Korean would say
        # "0으로 종료", English "exit WITH code 0".
        { slot = "code"; role = "manner"; }
      ];
    }
    {
      atom_kind = "read-line";
      slot_roles = [
        # The variable name is the LOCATION the input lands AT.
        # Korean: "X에 입력을 받는다" (X is locative target).
        # English: "read into X".
        { slot = "variable"; role = "target"; }
      ];
    }
    {
      atom_kind = "bind-variable";
      slot_roles = [
        # bind-variable is the cleanest test case for the role
        # algebra — 3 slots with 3 distinct roles, each mapping
        # to a different Korean postposition. "X에 Y를 정수로
        # 할당" reads back: X=target(에), Y=object(를),
        # 정수=manner(으로).
        { slot = "variable"; role = "target"; }
        { slot = "value"; role = "object"; }
        { slot = "value_kind"; role = "manner"; }
      ];
    }
    {
      atom_kind = "print-variable";
      slot_roles = [
        # The variable is WHAT gets printed — object (을/를).
        # Korean: "X를 출력". English: "print X".
        { slot = "variable"; role = "object"; }
      ];
    }
    {
      atom_kind = "if-true-then";
      slot_roles = [
        # The condition is the predicate the if-statement guards
        # on (subject of the conditional clause). Korean: "X가/이
        # 참이면". English: "if X is true".
        { slot = "condition_variable"; role = "predicate-condition"; }
        # The then_body is the consequence — atoms executed when
        # the predicate fires.
        { slot = "then_body"; role = "consequence-body"; }
      ];
    }
    {
      atom_kind = "repeat-n-times";
      slot_roles = [
        # The count is the iteration manner — HOW MANY times
        # (instrument/manner). Korean: "N번 반복" (N as iteration
        # manner). English: "repeat N times".
        { slot = "count"; role = "manner"; }
        # The body is the consequence — atoms executed each
        # iteration.
        { slot = "body"; role = "consequence-body"; }
      ];
    }
    {
      atom_kind = "loop-while-true";
      slot_roles = [
        # Same shape as if-true-then but the predicate gates a
        # loop instead of a single-fire branch.
        { slot = "condition_variable"; role = "predicate-condition"; }
        { slot = "body"; role = "consequence-body"; }
      ];
    }
    {
      # v0.16-CY: function-declare — 10번째 atom kind, 첫 top-level
      # construct. name slot 은 declaration target (이름이 binding
      # 의 target — storage location 의미); body slot 은 consequence-
      # body (function 호출 시 실행되는 atom list, control-flow 의
      # consequence 와 같은 의미).
      # v0.16-DA (2026-05-21): parameters slot 추가 — parameter list
      # 가 함수 동작 방식 의 변수 binding (인자 → 함수 내부 값),
      # 의미적으로 manner (방식) — bind-variable.value_kind 와 같은
      # role family.
      # v0.16-DE (2026-05-21): return_type slot 추가 — 첫 outcome
      # slot. parameters (manner) 가 진입이라면 return_type (outcome)
      # 은 진출. Korean: "X를 반환하는 함수" — 반환은 outcome role.
      atom_kind = "function-declare";
      slot_roles = [
        { slot = "name"; role = "target"; }
        { slot = "parameters"; role = "manner"; }
        { slot = "return_type"; role = "outcome"; }
        { slot = "body"; role = "consequence-body"; }
      ];
    }
    {
      # v0.16-DU (2026-05-21): class-declare — 11번째 atom kind.
      # function-declare 와 같은 slot-role 패턴 — name 은 declaration
      # target, body 는 consequence-body (class 의 member declaration
      # list). 새 role 없음 — 기존 5 role 재사용.
      atom_kind = "class-declare";
      slot_roles = [
        { slot = "name"; role = "target"; }
        { slot = "body"; role = "consequence-body"; }
      ];
    }
    {
      # v0.16-DW (2026-05-21): import-statement — 12번째 atom kind.
      # module slot 은 가져오는 대상 — action object. Korean:
      # "os 를 가져온다" — os 가 object (을/를). 기존 role 재사용,
      # 새 role 0.
      atom_kind = "import-statement";
      slot_roles = [
        { slot = "module"; role = "object"; }
      ];
    }
    {
      # v0.16-DX (2026-05-21): module-declare — 13번째 atom kind.
      # module slot 은 선언 대상 — 이 파일이 *어떤 모듈인지* 를
      # 선언. function-declare.name / class-declare.name 과 같은
      # declaration target. 기존 role 재사용, 새 role 0.
      atom_kind = "module-declare";
      slot_roles = [
        { slot = "module"; role = "target"; }
      ];
    }
    {
      # v0.16-DY (2026-05-21): enum-declare — 14번째 atom kind.
      # name 은 declaration target; variants 는 열거되는 값들 —
      # action object (enum 이 담는 것). 기존 role 재사용, 새 role 0.
      atom_kind = "enum-declare";
      slot_roles = [
        { slot = "name"; role = "target"; }
        { slot = "variants"; role = "object"; }
      ];
    }
    {
      # v0.16-DZ (2026-05-21): struct-declare — 15번째 atom kind.
      # name 은 declaration target; fields 는 struct 의 typed data —
      # function-declare.parameters 와 같은 manner role (typed
      # 변수 binding). 기존 role 재사용, 새 role 0.
      atom_kind = "struct-declare";
      slot_roles = [
        { slot = "name"; role = "target"; }
        { slot = "fields"; role = "manner"; }
      ];
    }
    {
      # v0.16-EC (2026-05-21): interface-declare — 16번째 atom kind.
      # name 은 declaration target; methods 는 interface 가 약속하는
      # 동작들 — action object (enum-declare.variants 와 같은 role).
      atom_kind = "interface-declare";
      slot_roles = [
        { slot = "name"; role = "target"; }
        { slot = "methods"; role = "object"; }
      ];
    }
    {
      # v0.16-EE (2026-05-21): try-catch — 17번째 atom kind.
      # try_body / catch_body 둘 다 실행 경로 — consequence-body
      # role (if-true-then.then_body 와 같음). 첫 dual-body atom 이라
      # 한 atom 이 consequence-body role 을 2번 가진다.
      atom_kind = "try-catch";
      slot_roles = [
        { slot = "try_body"; role = "consequence-body"; }
        { slot = "catch_body"; role = "consequence-body"; }
      ];
    }
    {
      # v0.16-EG (2026-05-21): throw-error — 18번째 atom kind.
      # message 는 던져지는 에러 내용 — action object (print-line.text
      # 와 같은 role: 동작이 다루는 대상).
      atom_kind = "throw-error";
      slot_roles = [
        { slot = "message"; role = "object"; }
      ];
    }
    {
      # v0.16-EH (2026-05-21): return-value — 19번째 atom kind.
      # value 는 반환되는 대상 — action object (print-variable.variable
      # 와 같은 role: 동작이 다루는 대상).
      atom_kind = "return-value";
      slot_roles = [
        { slot = "value"; role = "object"; }
      ];
    }
    {
      # v0.16-EI (2026-05-21): assignment — 20번째 atom kind.
      # target 은 대입의 대상 변수 — target role; value 는 대입되는
      # 값 — object role (bind-variable.variable=target,
      # bind-variable.value=object 와 같은 패턴).
      atom_kind = "assignment";
      slot_roles = [
        { slot = "target"; role = "target"; }
        { slot = "value"; role = "object"; }
      ];
    }
    {
      # v0.16-EK (2026-05-21): function-call — 21번째 atom kind.
      # name 은 호출 대상 함수 — target role; arguments 는 호출에
      # 넘기는 값들 — object role.
      atom_kind = "function-call";
      slot_roles = [
        { slot = "name"; role = "target"; }
        { slot = "arguments"; role = "object"; }
      ];
    }
    {
      # v0.16-EM (2026-05-21): comparison — 22번째 atom kind, 첫
      # relation atom. left / right 는 비교되는 두 대상 — object
      # role; operator 는 두 대상 사이의 관계 — predicate-condition
      # role (comparison 전체가 boolean 조건을 형성).
      atom_kind = "comparison";
      slot_roles = [
        { slot = "left"; role = "object"; }
        { slot = "operator"; role = "predicate-condition"; }
        { slot = "right"; role = "object"; }
      ];
    }
    {
      # v0.16-EO (2026-05-21): arithmetic — 23번째 atom kind,
      # comparison 의 자매. left / right 는 산술 결합되는 두 대상 —
      # object role; operator 는 결합 방식 — manner role (comparison
      # 의 operator 가 predicate-condition 인 것과 달리, arithmetic
      # operator 는 boolean 조건이 아니라 numeric 결합 방식).
      atom_kind = "arithmetic";
      slot_roles = [
        { slot = "left"; role = "object"; }
        { slot = "operator"; role = "manner"; }
        { slot = "right"; role = "object"; }
      ];
    }
    {
      # v0.16-ER (2026-05-21): boolean-expression — 24번째 atom kind.
      # operands 는 logical 결합되는 boolean 식들 — object role;
      # operator 는 결합되는 논리 조건 — predicate-condition role
      # (comparison 의 operator 와 같음 — 둘 다 boolean 조건 형성).
      atom_kind = "boolean-expression";
      slot_roles = [
        { slot = "operator"; role = "predicate-condition"; }
        { slot = "operands"; role = "object"; }
      ];
    }
    {
      # §F Tier 1 (2026-05-22): for-each — 25번째 atom kind, 네 번째
      # nested 제어흐름 atom. item_var 는 각 원소가 bound 되는
      # 자리 — read-line.variable / bind-variable.variable 와 같은
      # target role (값이 들어가는 위치). collection 은 순회 대상 —
      # action 이 작동하는 noun, object role. body 는 매 iteration
      # 실행되는 consequence-body. 새 role 0 — 기존 닫힌 6 role 로
      # 전부 표현됨.
      atom_kind = "for-each";
      slot_roles = [
        { slot = "item_var"; role = "target"; }
        { slot = "collection"; role = "object"; }
        { slot = "body"; role = "consequence-body"; }
      ];
    }
    {
      # §F Tier 1 round 2 (2026-05-22): break — 26번째 atom kind.
      # loop-exit statement. slot 이 없는 flat atom (comment 처럼) —
      # slot_roles 가 빈 list. 새 role 0.
      atom_kind = "break";
      slot_roles = [ ];
    }
    {
      # §F Tier 1 round 3 (2026-05-22): continue — 27번째 atom kind.
      # skip-to-next-iteration statement. break 와 같은 zero-slot
      # flat atom — slot_roles 가 빈 list. 새 role 0.
      atom_kind = "continue";
      slot_roles = [ ];
    }
    {
      # §F Tier 1 round 4 (2026-05-22): for-range — 28번째 atom kind.
      # index_var 는 정수 index 가 bound 되는 target. start / end 는
      # 범위 경계값 (object). body 는 매 iteration consequence-body.
      atom_kind = "for-range";
      slot_roles = [
        { slot = "index_var"; role = "target"; }
        { slot = "start"; role = "object"; }
        { slot = "end"; role = "object"; }
        { slot = "body"; role = "consequence-body"; }
      ];
    }
    {
      # §F Tier 1 round 5 (2026-05-22): if-else — 29번째 atom kind.
      # condition_variable 은 predicate-condition. then_body /
      # else_body 둘 다 consequence-body (양 갈래 결과).
      atom_kind = "if-else";
      slot_roles = [
        { slot = "condition_variable"; role = "predicate-condition"; }
        { slot = "then_body"; role = "consequence-body"; }
        { slot = "else_body"; role = "consequence-body"; }
      ];
    }
    {
      # §F Tier 1 round 6 (2026-05-22): elif-chain — 30번째 atom
      # kind. clauses 는 condition+body record list — 분기 술어
      # 들을 carry → predicate-condition. else_body 는 마지막
      # 갈래 결과 → consequence-body.
      atom_kind = "elif-chain";
      slot_roles = [
        { slot = "clauses"; role = "predicate-condition"; }
        { slot = "else_body"; role = "consequence-body"; }
      ];
    }
    {
      # §F Tier 1 round 7 (2026-05-22): switch-match — 31번째 atom
      # kind. subject 는 분기 대상 값 (object). cases 는 pattern+
      # body record list — 분기 술어 (predicate-condition).
      # default_body 는 fallback 결과 (consequence-body).
      atom_kind = "switch-match";
      slot_roles = [
        { slot = "subject"; role = "object"; }
        { slot = "cases"; role = "predicate-condition"; }
        { slot = "default_body"; role = "consequence-body"; }
      ];
    }
    {
      # §F Tier 2 round 1 (2026-05-22): ternary — 32번째 atom kind,
      # §F Tier 2 (표현식 계층) 의 첫 atom. condition 은 분기 술어
      # → predicate-condition (comparison.operator 와 같은 role).
      # then_expr / else_expr 은 condition 에 따라 *값으로 나오는*
      # 두 결과 → outcome role (function-declare.return_type 과 같은
      # family — 결과로 나오는 값). 새 role 0 — 기존 닫힌 6 role 로
      # 전부 표현.
      atom_kind = "ternary";
      slot_roles = [
        { slot = "condition"; role = "predicate-condition"; }
        { slot = "then_expr"; role = "outcome"; }
        { slot = "else_expr"; role = "outcome"; }
      ];
    }
    {
      # §F Tier 2 round 2 (2026-05-22): array-literal — 33번째 atom
      # kind. elements 는 배열이 담는 값들 — action object (enum-
      # declare.variants / interface-declare.methods 와 같은 role:
      # construct 가 담는 대상). 새 role 0.
      atom_kind = "array-literal";
      slot_roles = [
        { slot = "elements"; role = "object"; }
      ];
    }
    {
      # §F Tier 2 round 3 (2026-05-22): map-literal — 34번째 atom
      # kind. entries 는 맵이 담는 key→value 쌍들 — action object
      # (array-literal.elements 와 같은 role: construct 가 담는 대상).
      # 새 role 0.
      atom_kind = "map-literal";
      slot_roles = [
        { slot = "entries"; role = "object"; }
      ];
    }
    {
      # §F Tier 2 round 4 (2026-05-22): tuple-literal — 35번째 atom
      # kind. elements 는 튜플이 담는 값들 — action object
      # (array-literal.elements 와 같은 role). 새 role 0.
      atom_kind = "tuple-literal";
      slot_roles = [
        { slot = "elements"; role = "object"; }
      ];
    }
    {
      # §F Tier 2 round 5 (2026-05-22): index-access — 36번째 atom
      # kind. target 은 인덱싱되는 컬렉션 (동작 대상 — object),
      # index 는 위치 선택자 (수치 metadata — repeat-n-times.count
      # 과 같은 manner). 새 role 0.
      atom_kind = "index-access";
      slot_roles = [
        { slot = "target"; role = "object"; }
        { slot = "index"; role = "manner"; }
      ];
    }
    {
      # §F Tier 2 round 6 (2026-05-22): slice-access — 37번째 atom
      # kind. target 은 부분범위를 뽑는 컬렉션 (object), start/end 는
      # 범위 경계 (수치 metadata — index-access.index 와 같은 manner).
      atom_kind = "slice-access";
      slot_roles = [
        { slot = "target"; role = "object"; }
        { slot = "start"; role = "manner"; }
        { slot = "end"; role = "manner"; }
      ];
    }
    {
      # §F Tier 2 round 7 (2026-05-22): member-access — 38번째 atom
      # kind. target 은 멤버를 가진 객체 (object), member 는 어느
      # 멤버인지 가리키는 이름 selector (index-access.index 와 같은
      # manner).
      atom_kind = "member-access";
      slot_roles = [
        { slot = "target"; role = "object"; }
