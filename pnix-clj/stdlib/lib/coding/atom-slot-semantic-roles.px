      ];
    }
    {
      # §F Tier 5 round 85 (2026-05-23): map-is-empty — 116번째 atom
      # kind. target 은 비움을 검사하는 맵 (object).
      atom_kind = "map-is-empty";
      slot_roles = [
        { slot = "target"; role = "object"; }
      ];
    }
    {
      # §F Tier 5 round 86 (2026-05-23): map-clear — 117번째 atom kind.
      # target 은 항목을 제거하는 맵 (object).
      atom_kind = "map-clear";
