      slot_roles = [
        { slot = "target"; role = "object"; }
      ];
    }
    {
      # §F Tier 5 round 99 (2026-05-23): number-floor — 130번째 atom kind.
      # target 은 내림하는 숫자 (object).
      atom_kind = "number-floor";
      slot_roles = [
        { slot = "target"; role = "object"; }
      ];
    }
    {
      # §F Tier 5 round 100 (2026-05-23): number-ceil — 131번째 atom kind.
      # target 은 올림하는 숫자 (object).
      atom_kind = "number-ceil";
      slot_roles = [
        { slot = "target"; role = "object"; }
      ];
    }
  ];

  # Helper: look up the semantic role of a specific (atom_kind,
  # slot) pair. Returns null if the pair is not in the registry
  # (substrate refuses to invent a role rather than guess).
  semanticRoleForSlot = atom_kind: slot_name:
    let
      matching =
        builtins.filter
          (entry: entry.atom_kind == atom_kind)
          knownAtomSlotRoles;
    in
      if matching == [] then null
      else
        let
          slotMatches =
            builtins.filter
              (sr: sr.slot == slot_name)
              (builtins.head matching).slot_roles;
        in
          if slotMatches == [] then null
          else (builtins.head slotMatches).role;

  # Sorted-deduped union of every role referenced across the
  # registry. Substrate self-shape — adding a new atom_kind with
  # a new role bumps this automatically.
  referencedRoleSet =
    let
      allRefs =
        builtins.concatMap
          (entry: builtins.map (sr: sr.role) entry.slot_roles)
          knownAtomSlotRoles;
      dedup = list:
        builtins.foldl'
          (acc: x: if builtins.elem x acc then acc else acc ++ [x])
          []
          list;
    in
      builtins.sort (a: b: a < b) (dedup allRefs);

  # Sorted-deduped list of every atom_kind covered by the registry.
  coveredAtomKindSet =
    let
      allKinds =
        builtins.map (entry: entry.atom_kind) knownAtomSlotRoles;
      dedup = list:
        builtins.foldl'
          (acc: x: if builtins.elem x acc then acc else acc ++ [x])
          []
          list;
    in
      builtins.sort (a: b: a < b) (dedup allKinds);

  # Substrate self-invariant: every role referenced in
  # knownAtomSlotRoles must be a member of knownSemanticRoles.
  # `unknown_role_count` MUST stay 0 — a referenced role outside
  # the closed inventory is a substrate-shape break.
  unknownReferencedRoles =
    builtins.filter
      (role: (builtins.elem role knownSemanticRoles) == false)
      referencedRoleSet;

  # Total slot-role assignment count (across all atom kinds).
  totalSlotRoleAssignmentCount =
    builtins.foldl'
      (acc: entry: acc + (builtins.length entry.slot_roles))
      0
      knownAtomSlotRoles;

  inventorySummary = _: {
    owner = ownerName;
    # Closed role inventory + count.
    known_semantic_role_count = builtins.length knownSemanticRoles;
    known_semantic_roles = knownSemanticRoles;
    # Atom-kind coverage view.
    covered_atom_kind_count = builtins.length coveredAtomKindSet;
    covered_atom_kinds = coveredAtomKindSet;
    # Total slot-role assignment cells (sum over atom kinds of
    # slot count). Substrate convergence axiom: adding a slot to
    # any atom kind bumps this automatically.
    total_slot_role_assignment_count = totalSlotRoleAssignmentCount;
    # Roles actually referenced. Subset of known_semantic_roles
    # by substrate-shape invariant.
    referenced_role_count = builtins.length referencedRoleSet;
    referenced_roles = referencedRoleSet;
    # Substrate self-invariant: 0 means every referenced role is
    # in the closed inventory. > 0 is a substrate-shape break.
    unknown_referenced_role_count =
      builtins.length unknownReferencedRoles;
    unknown_referenced_roles = unknownReferencedRoles;
    # Per-atom-kind echo (callers can introspect the full mapping
    # without re-traversing).
    atom_slot_role_assignments = knownAtomSlotRoles;
  };

in {
  inherit
    ownerName
    knownSemanticRoles
    knownAtomSlotRoles
    semanticRoleForSlot
    referencedRoleSet
    coveredAtomKindSet
    inventorySummary;
  meta = {
    source = "stdlib coding atom slot semantic roles";
    owner = ownerName;
    base = "atom-slot-semantic-roles-v0";
    rev_note = "v0.16-BM: first slice that lifts each BehaviorAtom slot's SEMANTIC ROLE (object / subject / target / instrument / manner / predicate-condition / consequence-body) into a first-class substrate-native registry. The role inventory is isomorphic to Korean postposition algebra (을/를=object, 에=target, 으로=manner/instrument, 이/가=predicate-subject) — King Sejong's mathematical ontology surface for natural language. Substrate-native (no mecab-ko / lindera / external NLP); downstream slices (Korean case marker lens, English preposition lens, bidirectional NL composition lens) query this registry. BM = pin the dimension only; lens implementations follow in later slices.";
  };
}
