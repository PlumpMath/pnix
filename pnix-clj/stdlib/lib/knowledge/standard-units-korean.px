# stdlib.knowledge.standard-units-korean
#
# 표준단위(SI) ↔ 한국어(english) *단일 source* (배포 로드맵 A — pnix 자작 국제표준 = 외부데이터 아님,
# license 게이트 위험 0). 운영자: 한국수학·미국수학 공통 → `한국어(english)`. math-symbol-korean.px 와 연속선.
# = 수치/측정 NL 이 붙을 grounding. 새 단위 추가 시 여기 한 곳만.
# ⚠ 사전(reference knowledge): SI 는 국제표준 사실(laws of nature 류, pnix wording 허용 — CLAUDE.md Runtime Boundary).
{
  # SI 기본단위 7 (base): sym · 한국어 · english · 측정량(quantity)
  base = [
    { sym = "m";   ko = "미터";      en = "meter";    quantity_ko = "길이";    quantity_en = "length"; }
    { sym = "s";   ko = "초";        en = "second";   quantity_ko = "시간";    quantity_en = "time"; }
    { sym = "kg";  ko = "킬로그램";  en = "kilogram"; quantity_ko = "질량";    quantity_en = "mass"; }
    { sym = "A";   ko = "암페어";    en = "ampere";   quantity_ko = "전류";    quantity_en = "electric current"; }
    { sym = "K";   ko = "켈빈";      en = "kelvin";   quantity_ko = "온도";    quantity_en = "thermodynamic temperature"; }
    { sym = "mol"; ko = "몰";        en = "mole";     quantity_ko = "물질량";  quantity_en = "amount of substance"; }
    { sym = "cd";  ko = "칸델라";    en = "candela";  quantity_ko = "광도";    quantity_en = "luminous intensity"; }
  ];
  # 유도단위(derived) — 자주 쓰는 것.
  derived = [
    { sym = "N";   ko = "뉴턴";      en = "newton";   quantity_ko = "힘";        quantity_en = "force"; }
    { sym = "J";   ko = "줄";        en = "joule";    quantity_ko = "에너지";    quantity_en = "energy"; }
    { sym = "W";   ko = "와트";      en = "watt";     quantity_ko = "일률";      quantity_en = "power"; }
    { sym = "Pa";  ko = "파스칼";    en = "pascal";   quantity_ko = "압력";      quantity_en = "pressure"; }
    { sym = "Hz";  ko = "헤르츠";    en = "hertz";    quantity_ko = "진동수";    quantity_en = "frequency"; }
    { sym = "V";   ko = "볼트";      en = "volt";     quantity_ko = "전압";      quantity_en = "voltage"; }
    { sym = "C";   ko = "쿨롱";      en = "coulomb";  quantity_ko = "전하량";    quantity_en = "electric charge"; }
    { sym = "Ohm"; ko = "옴";        en = "ohm";      quantity_ko = "전기저항";  quantity_en = "electric resistance"; }
    { sym = "Wb";  ko = "웨버";      en = "weber";    quantity_ko = "자기선속";  quantity_en = "magnetic flux"; }
    { sym = "T";   ko = "테슬라";    en = "tesla";    quantity_ko = "자기선속밀도"; quantity_en = "magnetic flux density"; }
    { sym = "lm";  ko = "루멘";      en = "lumen";    quantity_ko = "광선속";    quantity_en = "luminous flux"; }
    { sym = "rad"; ko = "라디안";    en = "radian";   quantity_ko = "평면각";    quantity_en = "plane angle"; }
  ];
}
