# stdlib.knowledge.genesis-tier-korean
#
# genesis tier ↔ 한국어(english) 라벨 *단일 source* (인라인 하드코딩 금지; pnix-lisp-ct.px 가 import).
# 한국 수학교육 표준 용어 + 국제 영어명(운영자: 한국수학·미국수학 공통 → `한국어(english)`). pnix tier =
# 교육과정 개념(2022 개정 "변화와 관계"): canonical=연역적 정당화·conditioned=귀납적 추측·...
#
# ⚠ 이건 *고정 인식론-지위 라벨* 레지스트리다(korean-morphology.px 의 intent-type-labels 패턴 = 단일 source).
#   도메인 math 의미 문장(x+0=x = 항등원)은 korean-nl-mirror 통과(절-NL, 별도). 새 tier 추가 시 여기 한 곳만.
{
  status = {
    axiom              = "공리(axiom, 운영자 단언)";
    canonical          = "연역적으로 정당화됨(deductively justified)";
    strong_conjecture  = "강한 귀납적 추측(strong inductive conjecture)";
    conditioned        = "귀납적 추측(inductive conjecture)";
    quarantined        = "반증됨(refuted)";
    rejected           = "기각됨(rejected, unsound)";
    trace              = "흔적(trace, no utility)";
    pattern            = "구조 패턴(structural pattern, guidance only)";
  };
  # 정당화 양태(공리/연역/귀납/n.a) — tier 가 어떤 종류의 정당화를 가졌는가.
  justification = {
    axiom              = "단언(asserted)";
    canonical          = "연역적(deductive)";
    strong_conjecture  = "귀납적(inductive)";
    conditioned        = "귀납적(inductive)";
  };
  # 규칙 종류 — ground 규칙 vs 일반화된 규칙성.
  kind = {
    rule           = "규칙(rule)";
    generalization = "일반화된 규칙성(generalized regularity)";
  };
}
