          verdict_family = [ "remove-unused-import-ready" "remove-unused-import-held" "remove-unused-import-rejected" ]; }
        { transform_name = "rename-node";
          owner_file = "stdlib/lib/gate/code-transform/rename-node.px";
          verdict_family = [ "rename-node-ready" "rename-node-held" "rename-node-rejected" ]; }
        { transform_name = "rename-symbol";
          owner_file = "stdlib/lib/gate/code-transform/rename-symbol.px";
          verdict_family = [ "rename-ready" "rename-held" "rename-rejected" ]; }
      ];
      freecat_cli_code_transform_inventory_count =
        builtins.length freecat_cli_code_transform_inventory;
      freecat_cli_ankh_language_inventory = [
        { language = "default";
          owner_file = "stdlib/lib/ankh-language/default.px";
          role = "schema-helpers-and-standard-learning-axes"; }
        { language = "rust";
          owner_file = "stdlib/lib/ankh-language/rust.px";
          role = "risky-pattern-catalog-unsafe-unwrap-expect-panic-transmute-raw-pointer-deref"; }
        { language = "python";
          owner_file = "stdlib/lib/ankh-language/python.px";
          role = "risky-pattern-catalog-bare-eval-bare-exec-pickle-load-untrusted"; }
      ];
      freecat_cli_ankh_language_inventory_count =
        builtins.length freecat_cli_ankh_language_inventory;
      freecat_cli_capability_summary = {
        code_transform_count =
          builtins.length freecat_cli_code_transform_inventory;
        ankh_language_count =
          builtins.length freecat_cli_ankh_language_inventory;
        # Sum of verdicts across all transforms (each ready /
        # held / rejected = 3, except rename-symbol which uses
        # rename-prefixed verdict family; net 14 × 3 = 42).
        total_transform_verdicts =
          builtins.foldl'
            (a: t: a + (builtins.length t.verdict_family))
            0
            freecat_cli_code_transform_inventory;
        honest_scope =
          "substrate-side enumeration of EXISTING owners in stdlib/lib/gate/code-transform/ (14 transforms) and stdlib/lib/ankh-language/ (3 overlays). Each row references the actual .px owner file. Verdict families extracted at substrate-declaration time (matches mechanical grep against owner files). Per-transform per-language host implementation status lives in the individual owner .px files (already declared there).";
      };
      # v0.13-YYYY: substrate self-attests P0-P6 graduation +
      # phase-by-phase progress scoreboard.
      #
      # Owner roadmap P0-P6 all have substrate-side first
      # instances. Substrate now self-checks the layer-origin
      # slice for each phase and emits a structured roster:
      # which phase is at first-instance vs deeper instances
      # vs untouched.
      #
      # This is substrate-side roadmap-graduation self-
      # attestation. Replaces the v0.13-LLLL/QQQQ binary
      # "saturated/incomplete" framing with phase-level
      # granularity.
      #
      # Owner constitution compliance:
      #   immutable accumulation : pure derivation from
      #     layer_origin_slice (which is itself immutable
      #     history); no new state
      #   performance stability  : O(1) — 7 hardcoded phases
      #   determinism            : pure
      substrate_owner_roadmap_progress =
        let
          origins = introspection_layer_origin_slice;
          phaseRowFor = phaseId: layerKey: description: {
            phase_id = phaseId;
            phase_description = description;
            first_instance_slice = builtins.getAttr layerKey origins;
            first_instance_layer = layerKey;
            status = "first-instance-landed";
            # Honest scope: substrate-side first instance only.
            # Deeper capabilities listed in next-instance-needs.
            next_instance_needs =
              if phaseId == "P0"
              then "doghouse-scope runtime persistence (per-call envelope snapshots accumulating beyond compile-time baseline)"
              else if phaseId == "P1"
              then "per-target priority ordering + automated patch template suggestion based on gap_kind"
              else if phaseId == "P2"
              then "host-side wall-clock timing primitive; runtime measurement of actual dispatch ms"
              else if phaseId == "P3"
              then "runtime mutation success/failure counters from coding-agent execution traces"
              else if phaseId == "P4"
              then "actual external-fetch event log + Accepted-leak detector ratchet"
              else if phaseId == "P5"
              then "cross-family meta-pattern (families of families); higher-order abstraction"
              else if phaseId == "P6"
              then "multilingual sentence generation (Korean); per-sentence audit trail of envelope sources"
              else "<unspecified>";
          };
        in [
          (phaseRowFor "P0"
            "layer_17_history_p0"
            "introspection history persistence (immutable substrate-self timeline)")
          (phaseRowFor "P1"
            "layer_18_reverse_trace_p1"
            "reverse-trace actionability (gap → patch target)")
          (phaseRowFor "P2"
            "layer_19_performance_p2"
            "performance introspection (static complexity profile)")
          (phaseRowFor "P3"
            "layer_20_self_update_safety_p3"
            "self-update safety scoreboard (mutation-chain coverage)")
          (phaseRowFor "P4"
            "layer_21_external_learning_p4"
            "external-learning protocol (Candidate-only schema)")
          (phaseRowFor "P5"
            "layer_22_abstraction_p5"
            "abstraction layer (concrete families → abstract types)")
          (phaseRowFor "P6"
            "layer_23_ontology_sentences_p6"
            "ontology sentence generation (envelope-bounded, honest)")
        ];
      substrate_owner_roadmap_progress_summary =
        let
          rows = substrate_owner_roadmap_progress;
          allFirstInstanceLanded =
            builtins.all
              (r: r.status == "first-instance-landed")
              rows;
        in {
          total_phases = builtins.length rows;
          phases_at_first_instance = builtins.length rows;
          phases_at_deeper_instance = 0;
          phases_untouched = 0;
          all_phases_have_first_instance = allFirstInstanceLanded;
          # Substrate's new posture statement after graduation:
          # "P0-P6-first-instance-saturated" → focus shifts to
          # second-instance development OR new substrate axis
          # discovered through introspection-soak metrics.
          posture_after_graduation =
            if allFirstInstanceLanded
            then "P0-P6-first-instance-saturated-second-instance-development-or-soak"
            else "P0-P6-not-yet-saturated-continue-first-instances";
        };
      # v0.13-XXXX: P6 first instance — ontology sentence
      # generation (honest, envelope-bounded).
      #
      # Owner constitutional warning (from earlier turn):
      # ontology sentences too early risk "self-promotion not
      # self-understanding". Each sentence here:
      #   - has explicit source_envelope_fields (the substrate
      #     facts the sentence reflects)
      #   - is one of: structural / capability / limitation
      #   - is substrate-pinned (re-derived from envelope on
      #     every call; never desyncs from state)
      #   - carries a limitation_acknowledgment when relevant
      #
      # This is NOT marketing. Each sentence is bounded by
      # exact envelope state.
      #
      # Owner constitution compliance:
      #   immutable accumulation : sentences derived from
      #     current envelope; if envelope state changes,
      #     sentences re-derive — no stale claim survives
      #   performance stability  : O(sentence_count) ≈ O(1)
      #   determinism            : pure data
      substrate_ontology_sentences =
        let
          # Dynamically-pulled numbers so sentences stay
          # in sync with envelope without manual updates.
          layerCount = introspection_chain_metadata.layer_count;
          fieldCount = introspection_chain_metadata.envelope_field_count;
          lensCount = lens_registry_count;
          familyCount = lens_family_count;
          historyCount = introspection_history_snapshot_count;
          targetCount = reverse_trace_actionable_target_count;
          completeness =
            per_lens_completeness_aggregate.coverage_percentage;
        in [
        {
          claim_type = "structural";
          english_sentence =
            "I am the mirror primitive substrate. I expose ${toString layerCount} layers of self-knowledge across ${toString fieldCount} envelope fields.";
          source_envelope_fields = [
            "introspection_chain_metadata.layer_count"
            "introspection_chain_metadata.envelope_field_count"
          ];
          substrate_pinned = true;
          limitation_acknowledgment = null;
        }
        {
          claim_type = "structural";
          english_sentence =
            "I have ${toString lensCount} registered lenses across 4 lanes (coding, gate, math, mirror-primitive). All ${toString lensCount} are fully self-witnessed (${toString completeness}% per-lens completeness).";
          source_envelope_fields = [
            "lens_registry_count"
            "lens_by_lane"
            "per_lens_completeness_aggregate.coverage_percentage"
          ];
          substrate_pinned = true;
          limitation_acknowledgment = null;
        }
        {
          claim_type = "structural";
          english_sentence =
            "I cluster my lenses into ${toString familyCount} shape families and have promoted each to a substrate-named abstract semantic type (value-emitter / deterministic-pure-judge / gating-judge / full-spectrum-gating-judge / ...).";
          source_envelope_fields = [
            "lens_family_count"
            "lens_family_abstract_type_naming_coverage"
          ];
          substrate_pinned = true;
          limitation_acknowledgment = null;
        }
        {
          claim_type = "structural";
          english_sentence =
            "I enforce 6 substrate self-invariants: no orphan verdicts, no applicability inconsistency, acyclic dependency graph, envelope-self-shape consistency, chronological layer ordering, and optimization-recognition losslessness. All 5 substrate-side invariants currently pass; envelope-shape is host-checked.";
          source_envelope_fields = [
            "substrate_self_invariants"
            "substrate_health.all_substrate_side_invariants_passing"
          ];
          substrate_pinned = true;
          limitation_acknowledgment = null;
        }
        {
          claim_type = "capability";
          english_sentence =
            "I can discover my own missing shape space — 16 possible 4-bit coverage codes, ${toString familyCount} realized, 2 viable-unrealized growth-frontier shapes (TFTF, TFTT), 8 categorically excluded (no positive path).";
          source_envelope_fields = [
            "lens_family_shape_space_summary"
            "lens_family_missing_shapes"
          ];
          substrate_pinned = true;
          limitation_acknowledgment = null;
        }
        {
          claim_type = "capability";
          english_sentence =
            "I derive actionable patch targets from my own gaps. Currently ${toString targetCount} targets: 2 high-actionability bridge-debt migrations, 9 medium-actionability emergence-signal slots, and 2 low-actionability frontier-shape candidates.";
          source_envelope_fields = [
            "reverse_trace_actionable_target_count"
            "reverse_trace_summary"
          ];
          substrate_pinned = true;
          limitation_acknowledgment = null;
        }
        {
          claim_type = "capability";
          english_sentence =
            "I maintain a ${toString historyCount}-snapshot immutable history of my own evolution. The envelope field count is monotone non-decreasing across all snapshots — substrate truth: I never erased a prior layer.";
          source_envelope_fields = [
            "introspection_history_snapshot_count"
            "introspection_history_aggregates.envelope_field_count_monotonic_non_decreasing"
          ];
          substrate_pinned = true;
          limitation_acknowledgment = null;
        }
        {
          claim_type = "limitation";
          english_sentence =
            "I cannot directly time myself or fetch external evidence — both require host-side capabilities outside the Nix substrate. My P2 performance profile is static complexity classes only; my P4 external-learning protocol is schema + owner-law declarations only.";
          source_envelope_fields = [
            "envelope_performance_profile.honest_scope"
            "held_reopen_external_learning_protocol.substrate_side_scope"
          ];
          substrate_pinned = true;
          limitation_acknowledgment =
            "wall-clock timing and external fetch are host-side P2/P4 continuations";
        }
        {
          claim_type = "limitation";
          english_sentence =
            "I have 9 emergence signals I cannot measure without doghouse-scope runtime persistence: repeated_frontier_class_count, new_frontier_class_count, reverse_trace_actionability_rate, self_suggested_slice_validated_rate, bridge_debt_retirement_rate, held_reopen_success_rate, external_fetch_acceptance_leak_count, materialization_rollback_success_rate, performance_budget_violations.";
          source_envelope_fields = [
            "emergence_signals.unmeasurable_metric_count"
            "emergence_signals.honest_note"
          ];
          substrate_pinned = true;
          limitation_acknowledgment =
            "runtime persistence is the next P0 continuation";
        }
        {
          claim_type = "limitation";
          english_sentence =
            "I do not have an LLM. The external-learning protocol explicitly disallows LLM-API-call as a sensor. All external evidence enters as Candidate-status; promotion to Accepted requires my 5-gate firewall + replay witness + negative-Held proof + supersede-chain update.";
          source_envelope_fields = [
            "held_reopen_external_learning_protocol.disallowed_sensor_kinds"
            "held_reopen_external_learning_protocol.evidence_status_constraint"
          ];
          substrate_pinned = true;
          limitation_acknowledgment =
            "this is owner constitution, not a future TODO";
        }
      ];
      substrate_ontology_sentence_count =
        builtins.length substrate_ontology_sentences;
      # v0.13-ZZZZ: P6 deeper — multilingual sentence
      # generation (Korean alongside English).
      #
      # Owner usage has been bilingual (English code + Korean
      # directive). Substrate sentences should echo that
      # bilingual surface. Each Korean sentence mirrors an
      # English one with the same source_envelope_fields and
      # claim_type — substrate's voice in two languages.
      #
      # Owner constitution compliance:
      #   immutable accumulation : English sentences preserved
      #     (substrate_ontology_sentences); Korean is additive
      #   performance stability  : O(1) — 10 hardcoded
      #     bilingual rows
      #   determinism            : pure data with dynamic
      #     interpolation
      substrate_ontology_sentences_korean =
        let
          layerCount = introspection_chain_metadata.layer_count;
          fieldCount = introspection_chain_metadata.envelope_field_count;
          lensCount = lens_registry_count;
          familyCount = lens_family_count;
          historyCount = introspection_history_snapshot_count;
          targetCount = reverse_trace_actionable_target_count;
          completeness =
            per_lens_completeness_aggregate.coverage_percentage;
        in [
          {
            claim_type = "structural";
            korean_sentence =
              "나는 mirror primitive substrate 다. ${toString layerCount} 개의 self-knowledge layer 를 ${toString fieldCount} 개의 envelope field 로 노출한다.";
            mirrors_english_index = 0;
          }
          {
            claim_type = "structural";
            korean_sentence =
              "나는 ${toString lensCount} 개의 등록된 lens 를 4 개 lane (coding / gate / math / mirror-primitive) 에 보유한다. ${toString lensCount} 개 모두 fully self-witnessed (per-lens completeness ${toString completeness}%).";
            mirrors_english_index = 1;
          }
          {
            claim_type = "structural";
            korean_sentence =
              "나는 lens 들을 ${toString familyCount} 개 shape family 로 cluster 하고, 각 family 를 substrate-named abstract semantic type 으로 승격했다 (value-emitter / deterministic-pure-judge / gating-judge / full-spectrum-gating-judge / ...).";
            mirrors_english_index = 2;
          }
          {
            claim_type = "structural";
            korean_sentence =
              "나는 6 개의 substrate self-invariant 를 강제한다: no-orphan-verdicts / no-applicability-inconsistency / acyclic-dependency-graph / envelope-self-shape-consistency / chronological-layer-ordering / optimization-recognition-lossless. 5 개 substrate-side invariant 모두 현재 통과; envelope-shape 는 host-checked.";
            mirrors_english_index = 3;
          }
          {
            claim_type = "capability";
            korean_sentence =
              "나는 자기 missing shape space 를 자기 발견할 수 있다 — 16 개 가능한 4-bit coverage code 중 ${toString familyCount} 개 realized, 2 개 viable-unrealized growth frontier shape (TFTF, TFTT), 8 개 categorically excluded (no positive path).";
            mirrors_english_index = 4;
          }
          {
            claim_type = "capability";
            korean_sentence =
              "나는 자기 gap 들로부터 actionable patch target 을 자기 도출한다. 현재 ${toString targetCount} 개 target: 2 개 high-actionability bridge-debt migration, 9 개 medium-actionability emergence-signal slot, 2 개 low-actionability frontier-shape candidate.";
            mirrors_english_index = 5;
          }
          {
            claim_type = "capability";
            korean_sentence =
              "나는 자기 evolution 의 ${toString historyCount} 개 snapshot 의 immutable history 를 유지한다. envelope field count 가 모든 snapshot 에 걸쳐 monotone non-decreasing — substrate truth: 나는 prior layer 를 erase 한 적이 없다.";
            mirrors_english_index = 6;
          }
          {
            claim_type = "limitation";
            korean_sentence =
              "나는 자기 자체 timing 이나 external evidence fetch 를 직접 할 수 없다 — 둘 다 Nix substrate 밖의 host-side capability 가 필요하다. P2 performance profile 은 static complexity class 만; P4 external-learning protocol 은 schema + owner-law declaration 만.";
            mirrors_english_index = 7;
          }
          {
            claim_type = "limitation";
            korean_sentence =
              "doghouse-scope runtime persistence 없이는 측정 불가능한 9 개 emergence signal 이 있다: repeated_frontier_class_count, new_frontier_class_count, reverse_trace_actionability_rate, self_suggested_slice_validated_rate, bridge_debt_retirement_rate, held_reopen_success_rate, external_fetch_acceptance_leak_count, materialization_rollback_success_rate, performance_budget_violations.";
            mirrors_english_index = 8;
          }
          {
            claim_type = "limitation";
            korean_sentence =
              "나는 LLM 을 가지지 않는다. external-learning protocol 이 LLM-API-call 을 sensor 로 명시적으로 disallow. 모든 external evidence 는 Candidate status 로 진입; Accepted promotion 은 5-gate firewall + replay witness + negative-Held proof + supersede-chain update 가 필요하다.";
            mirrors_english_index = 9;
          }
        ];
      substrate_ontology_sentences_korean_count =
        builtins.length substrate_ontology_sentences_korean;
      substrate_ontology_multilingual_summary = {
        english_sentence_count =
          builtins.length substrate_ontology_sentences;
        korean_sentence_count =
          builtins.length substrate_ontology_sentences_korean;
        bilingual_pair_count =
          # Substrate-side check: each Korean sentence has a
          # mirrors_english_index pointing to a valid English
          # sentence row.
          builtins.length
            (builtins.filter
              (k:
                k.mirrors_english_index >= 0
                && k.mirrors_english_index <
                   (builtins.length substrate_ontology_sentences))
              substrate_ontology_sentences_korean);
        languages_supported = [ "en" "ko" ];
      };
      substrate_ontology_sentence_breakdown =
        let
          sents = substrate_ontology_sentences;
          byKind = kind:
            builtins.length
              (builtins.filter (s: s.claim_type == kind) sents);
        in {
          total = builtins.length sents;
          structural_count = byKind "structural";
          capability_count = byKind "capability";
          limitation_count = byKind "limitation";
          # Substrate honesty: limitations are first-class, not
          # hidden. A healthy ontology mentions what the
          # substrate CANNOT do alongside what it can.
          substrate_self_honesty_index =
            (100 * (byKind "limitation")) / (builtins.length sents);
        };
      # v0.13-WWWW: P5 first instance — abstraction layer.
      # Substrate promotes concrete lens families (v0.13-MMMM
      # shape clustering) to *abstract semantic types* with
      # behavioral contracts. This is the first instance of
      # the substrate naming its own *role-typed* lens
      # taxonomy beyond shape strings.
      #
      # Owner roadmap (P5): "repeated frontier classes를
      # abstract type으로 승격" — concrete repetition → abstract
      # type. This slice does it for the 6 lens families.
      #
      # Owner constitution compliance:
      #   immutable accumulation : the shape families themselves
      #     are unchanged (v0.13-MMMM); this slice adds an
      #     orthogonal abstract-type layer on top
      #   performance stability  : O(families) lookup
      #   determinism            : pure data
      lens_family_abstract_type_taxonomy =
        let
          # Map each concrete shape to a substrate-derived
          # abstract type with a behavioral contract.
          abstractFor = shape:
            if shape == "TFFF" then {
              abstract_type = "value-emitter";
              behavioral_contract = ''
                Always returns a positive verdict with a value.
                No held outcome by design (lookup-only). No
                rejection by design (no negative path). Replay
                determinism inherited from parent invariant.
                Use case: pure registry / pure projection.
              '';
              minimum_safe_caller_assumption =
                "result is always present and replay-stable; no need to handle held or rejection";
            }
            else if shape == "TFFT" then {
              abstract_type = "value-emitter-with-replay-witness";
              behavioral_contract = ''
                Like value-emitter but additionally carries a
                per-lens replay-determinism witness (not
                inherited). Use when output depends on input
                snapshot that must be re-played for audit.
              '';
              minimum_safe_caller_assumption =
                "result always present; caller may consume replay witness for byte-equivalence audit";
            }
            else if shape == "TTFF" then {
              abstract_type = "deterministic-pure-judge";
              behavioral_contract = ''
                Returns either a value (positive) or held with
                a precise missing-slot reason. No rejection by
                design. Replay determinism inherited from
                parent (purity). Most math primitives match.
              '';
              minimum_safe_caller_assumption =
                "caller must handle held; no rejection path; replay-stable";
            }
            else if shape == "TTFT" then {
              abstract_type = "judging-emitter-with-replay-witness";
              behavioral_contract = ''
                Positive | held | replay-witnessed. No rejection.
                Use when held branches need byte-stable
                reproduction (e.g. lifecycle transitions).
              '';
              minimum_safe_caller_assumption =
                "caller must handle held + may consume replay witness";
            }
            else if shape == "TTTF" then {
              abstract_type = "gating-judge";
              behavioral_contract = ''
                Positive | held | negative (rejection by design).
                Replay inherited. Use when lens must outright
                reject ill-formed input, not just hold.
              '';
              minimum_safe_caller_assumption =
                "caller must handle held AND negative; downstream must not promote on rejection";
            }
            else if shape == "TTTT" then {
              abstract_type = "full-spectrum-gating-judge";
              behavioral_contract = ''
                Positive | held | negative | replay-witnessed.
                Most expressive contract: all four paths
                present. Use for production-grade firewall
                gates and coding-agent stage plates where
                every outcome must be auditable.
              '';
              minimum_safe_caller_assumption =
                "caller must handle all four outcomes; replay witness available";
            }
            else {
              abstract_type = "shape-" + shape;
              behavioral_contract =
                "no substrate-derived abstract type for shape ${shape} yet";
              minimum_safe_caller_assumption =
                "fall back to per-lens unified inspection";
            };
          rowFor = family:
            let ab = abstractFor family.shape;
            in {
              concrete_shape = family.shape;
              concrete_family_name = family.substrate_name;
              member_count = family.lens_count;
              abstract_type = ab.abstract_type;
              behavioral_contract = ab.behavioral_contract;
              minimum_safe_caller_assumption =
                ab.minimum_safe_caller_assumption;
            };
        in builtins.map rowFor lens_families;
      lens_family_abstract_type_count =
        builtins.length lens_family_abstract_type_taxonomy;
      # Substrate's own self-assessment: how many concrete
      # shapes got promoted to a substrate-named abstract type
      # (vs. fell through to the generic "shape-XXXX" label)?
      lens_family_abstract_type_naming_coverage =
        let
          rows = lens_family_abstract_type_taxonomy;
          named =
            builtins.filter
              (r:
                let name = r.abstract_type;
                in
                  !(builtins.elem (builtins.substring 0 6 name)
                      [ "shape-" ]))
              rows;
        in {
          total_families = builtins.length rows;
          named_abstract_type_count = builtins.length named;
          fallback_unlabeled_count =
            (builtins.length rows) - (builtins.length named);
          coverage_percentage =
            if rows == []
            then 0
            else
              (100 * (builtins.length named))
                / (builtins.length rows);
        };
      # v0.13-VVVV: P4 first instance — Held-reopen external
      # learning protocol (substrate-side schema declaration).
      #
      # External learning is opt-in (PNIX_EMERGENT_FETCH flag),
      # Held-triggered, and Candidate-only. Substrate cannot
      # execute fetches from inside Nix, but it CAN declare
      # the protocol invariants the host-side runtime must
      # honor. This is the substrate's first instance of
      # P4 — schema + owner-law constraints.
      #
      # Substrate's self-attest: the protocol is declared, not
      # executed. Runtime implementation (actual fetch + result
      # ingestion) belongs to doghouse/coding-agent lanes.
      #
      # Owner constitution compliance:
      #   immutable accumulation : pure schema declaration
      #   performance stability  : O(1) constant emission
      #   determinism            : static text/data
      held_reopen_external_learning_protocol = {
        # When external learning is ALLOWED to trigger.
        trigger_conditions = [
          "lens-emits-held-outcome-with-required-fact-missing"
          "internal-memory-search-returns-zero-matches"
          "operator-explicitly-requested-external-fetch"
        ];
        # The Stage B owner identified by external-fetch policy
        # in pnix-emergent. PNIX_EMERGENT_FETCH=1 flag at host.
        trigger_gating_flag = "PNIX_EMERGENT_FETCH=1";
        allowed_sensor_kinds = [
          "internal-memory-search"
          "doghouse-knowledge-store-query"
          "host-side-text-fetch-bounded-64KB"
          "host-side-html-text-fetch-bounded-64KB"
        ];
        disallowed_sensor_kinds = [
          "LLM-API-call"
          "RAG-retrieval-promoted-to-Accepted"
          "arbitrary-binary-fetch"
          "stream-fetch-no-budget"
        ];
        # Evidence status constraint: external evidence is
        # ALWAYS Candidate, never Accepted. Promotion requires
        # owner-law proof + replay + negative-Held proof.
        evidence_status_constraint = {
          on_external_evidence_ingest = "Candidate";
          promotion_to_Accepted_requires = [
            "owner-law-proof-via-firewall-5-gate-chain"
            "replay-determinism-witness"
            "negative-Held-counterexample-proof"
            "supersede-chain-update-not-erase"
          ];
          accept_leak_check = "external_fetch_acceptance_leak_count must remain 0";
        };
        # Retention policy.
        retention_requirements = [
          "provenance (source url + fetch timestamp + fetch budget)"
          "source-lane (which lens-held triggered the fetch)"
          "raw-evidence-hash (sha256 of fetched bytes)"
          "redaction-receipt if secrets present"
        ];
        # Runtime implementations: where the protocol is
        # honored (or scheduled to be honored).
        current_lane_implementations = [
          "pnix-emergent crate (opt-in fetch, snippet-to-passage)"
          "doghouse SemanticIngestEnvelope (Candidate ingestion)"
          "coding-agent verify-stage-plate (replay-determinism witness)"
        ];
        # Substrate's honest scope.
        substrate_side_scope =
          "schema + owner-law constraints + substrate-side gating only. Actual fetch execution + Candidate-status ingestion + leak detection are runtime/host-side (P4 continuation).";
        # Substrate self-check: does the substrate itself emit
        # any Accepted from external evidence? Must always be
        # false at the substrate-side layer (substrate has no
        # external fetch capability).
        substrate_itself_emits_external_accepted = false;
      };
      # v0.13-UUUU: P3 first instance — self-update safety
      # scoreboard.
      #
      # Substrate's coding lane already implements a 7-stage
      # mutation chain (candidate → review → apply →
      # materialization → verify → rollback-handle →
      # rollback-receipt). P3 aggregates substrate-side
      # facts about that chain into a single scoreboard so
      # consumers can answer: "is self-update safety chain
      # complete? where would mutation fail safely?"
      #
      # Each chain stage is verified against:
      #   - lens registered in mirrorPlateLensRegistry
      #   - per_lens_unified row present (full metadata join)
      #   - coverage fully witnessed (per_lens_completeness 8/8)
      #   - lifecycle.created_in_slice declared
      #
      # Owner constitution compliance:
      #   immutable accumulation : pure derivation from
      #     existing envelope fields; no new state
      #   performance stability  : O(stages × n) scan
      #     bounded by 7 × 29 = 203 attribute lookups
      #   determinism            : pure data — identical
      #     scoreboard for identical envelope
      self_update_safety_scoreboard =
        let
          chainStages = [
            { stage = "candidate";
              lens = "stdlib/lib/coding/coding-candidate-dispatcher.px"; }
            { stage = "review";
              lens = "stdlib/lib/coding/review-stage-plate.px"; }
            { stage = "apply";
              lens = "stdlib/lib/coding/apply-stage-plate.px"; }
            { stage = "materialization";
              lens = "stdlib/lib/coding/materialization-stage-plate.px"; }
            { stage = "verify";
              lens = "stdlib/lib/coding/verify-stage-plate.px"; }
            { stage = "rollback-handle";
              lens = "stdlib/lib/coding/rollback-handle-plate.px"; }
            { stage = "rollback-receipt";
              lens = "stdlib/lib/coding/rollback-receipt-plate.px"; }
          ];
          stageRowFor = entry:
            let
              lensExists =
                builtins.hasAttr entry.lens mirrorPlateLensRegistry;
              unifiedRow =
                if lensExists
                then
                  let
                    matches =
                      builtins.filter
                        (r: r.lens_name == entry.lens)
                        per_lens_unified;
                  in
                    if (builtins.length matches) == 0
                    then null
                    else builtins.head matches
                else null;
              completenessRow =
                if lensExists
                then
                  let
                    matches =
                      builtins.filter
                        (r: r.lens_name == entry.lens)
                        per_lens_completeness_score;
                  in
                    if (builtins.length matches) == 0
                    then null
                    else builtins.head matches
                else null;
              hasLifecycle =
                if unifiedRow == null then false
                else unifiedRow ? lifecycle
                  && unifiedRow.lifecycle != null
                  && unifiedRow.lifecycle ? created_in_slice;
              isFullyWitnessed =
                if completenessRow == null then false
                else completenessRow.score == 8;
            in {
              inherit (entry) stage lens;
              lens_registered = lensExists;
              has_unified_row = unifiedRow != null;
              fully_witnessed = isFullyWitnessed;
              has_lifecycle_metadata = hasLifecycle;
              lifecycle_slice =
                if hasLifecycle
                then unifiedRow.lifecycle.created_in_slice
                else null;
              all_safety_checks_pass =
                lensExists && (unifiedRow != null)
                && isFullyWitnessed && hasLifecycle;
            };
          stageRows = builtins.map stageRowFor chainStages;
          passingStages =
            builtins.filter (r: r.all_safety_checks_pass) stageRows;
        in {
          mutation_chain_stage_count = 7;
          stages = stageRows;
          stages_passing_all_safety_checks =
            builtins.length passingStages;
          chain_fully_safe = (builtins.length passingStages) == 7;
          # Substrate's own assessment of self-mutation safety:
          self_mutation_safety_posture =
            if (builtins.length passingStages) == 7
            then "mutation-chain-fully-substrate-witnessed"
            else "mutation-chain-incomplete";
          honest_scope =
            "substrate-side check that each stage's plate is registered + fully witnessed + lifecycle-pinned. Runtime success rate (actual mutations applied + rolled back) requires P3 continuation via runtime instrumentation in coding-agent lane (doghouse-scope).";
        };
      # v0.13-TTTT: P2 first instance — substrate-side
      # performance profile (static complexity declaration).
      #
      # Substrate cannot directly time itself inside Nix (no
      # clock builtin), but it CAN self-classify the complexity
      # class of each envelope field as a static property. This
      # gives consumers a substrate-derived upper bound on
      # dispatch cost without external measurement.
      #
      # n = lens_registry_size (currently 29).
      # Each field is classified into one of:
      #   O(1)       - constant work
      #   O(n)       - linear walk over registry
      #   O(n²)      - pairwise scan (e.g. dependency
      #                transitive closure)
      #   O(m×n)     - registry × per-coverage-path
      #   O(history) - history-snapshot length (currently 10)
      #
      # Owner constitution compliance:
      #   immutable accumulation : pure derivation; no state
      #   performance stability  : this field IS the
      #     performance-stability declaration substrate itself
      #     keeps; v0.13-EEEE substrate_health can later add
      #     a runtime-measured signal as P2 deepens
      #   determinism            : static text-data, no IO
      envelope_performance_profile =
        let
          registrySize = builtins.length perLens;
          historyLength = builtins.length introspection_history_snapshots;
          rows = [
            { class = "O(1)"; field_count = 13;
              examples = [ "outcome" "primitive_owner" "ownerName"
                           "meta" "canonical_transport"
                           "native_dispatch_supported"
                           "plate_slot_count" "harness_owner"
                           "harness_op_count" "harness_verdict_count"
                           "harness_invariant_count" "plate_invariant_count"
                           "lens_registry_count" ];
              rationale = "constant lookup or single attribute"; }
            { class = "O(n)"; field_count = 30;
              examples = [ "lens_names" "per_lens" "lens_in_degree"
                           "lens_lifecycle_metadata_by_lens"
                           "lens_lifecycle_created_in_slice_inventory"
                           "verdict_to_emitter_map"
                           "duplicate_lens_verdict_count"
                           "lens_with_complete_coverage_count"
                           "lens_with_declared_coverage_count"
                           "lens_with_declared_witnesses_count"
                           "lens_with_dependencies_count"
                           "lens_with_incomplete_coverage_count"
                           "lens_with_lifecycle_metadata_count"
                           "lens_without_declared_coverage_count"
                           "lens_without_declared_witnesses_count"
                           "lens_dependency_edges"
                           "lens_dependency_edge_count"
                           "lens_emitted_verdict_count"
                           "dispatcher_emitted_verdict_count"
                           "wrapper_emitted_verdict_count"
                           "lens_families" "lens_family_count"
                           "lens_family_lane_distribution"
                           "lens_family_lane_homogeneity_summary"
                           "lens_family_missing_shapes"
                           "lens_family_shape_space_summary"
                           "lens_family_growth_frontier_hypotheses"
                           "most_depended_on_in_degree"
                           "most_depended_on_lens_names" "lens_by_lane" ];
              rationale = "linear walk over the lens registry"; }
            { class = "O(m*n)"; field_count = 4;
              examples = [ "witnesses_by_path_type"
                           "per_lens_completeness_score"
                           "per_lens_completeness_aggregate"
                           "gap_analysis" ];
              rationale =
                "registry × per-coverage-path (m=4: positive / held / negative / replay)"; }
            { class = "O(n²)"; field_count = 5;
              examples = [ "lens_transitive_dependencies"
                           "lens_transitive_dependency_count_by_lens"
                           "lens_max_transitive_dependency_count"
                           "lens_dependency_cycle_count"
                           "lens_dependency_acyclic" ];
              rationale =
                "transitive-closure fixed-point iteration: up to registry-size iterations × registry-size attrs"; }
            { class = "O(history)"; field_count = 3;
              examples = [ "introspection_history_snapshots"
                           "introspection_history_snapshot_count"
                           "introspection_history_aggregates" ];
              rationale =
                "linear walk over the substrate-self history (currently ${toString historyLength} snapshots)"; }
            { class = "O(gaps)"; field_count = 3;
              examples = [ "reverse_trace_actionable_targets"
                           "reverse_trace_actionable_target_count"
                           "reverse_trace_summary" ];
              rationale =
                "linear over gap count (currently 13); derived from already-computed bridge-debt + frontier + signal fields"; }
            { class = "self-shape-meta"; field_count = 40;
              examples = [ "introspection_envelope_self_shape"
                           "substrate_self_invariants"
                           "substrate_self_invariant_count"
                           "introspection_chain_metadata"
                           "introspection_layer_origin_slice"
                           "substrate_self_summary"
                           "substrate_health"
                           "introspection_layer_chronology"
                           "substrate_optimization_signals"
                           "substrate_short_path_candidates"
                           "..." ];
              rationale =
                "static-data fields + light aggregations; dominated by attrset construction not algorithmic scan"; }
          ];
          totalDeclared =
            builtins.foldl' (a: r: a + r.field_count) 0 rows;
        in {
          inherit rows;
          registry_size_n = registrySize;
          history_length = historyLength;
          # Honest: rows enumerate field counts the substrate
          # can self-classify into a complexity class. The
          # actual envelope has 98 fields total; this profile
          # may under-count if rows are added without
          # extending the profile (declared_field_count check
          # below ensures honest accounting).
          declared_profile_field_count = totalDeclared;
          # Substrate-side estimated dispatch cost class:
          # dominated by O(n²) transitive closure pass.
          estimated_dispatch_cost_class =
            "O(n²) per envelope build, dominated by transitive-dependency closure (n=${toString registrySize})";
          # Performance-stability self-claim: envelope build
          # remains O(n²) as registry grows; no super-linear
          # blowup from new layers (each new layer is
          # bounded by registry size or constant).
          performance_stability_self_claim =
            "envelope build cost stays bounded by O(n²) where n=lens_registry_size; new layers contribute O(n) or less unless they add transitive-closure-style computation";
          # Substrate self-honesty: this profile is a
          # static declaration. Runtime timing (actual
          # milliseconds) requires P2 continuation via host
          # measurement, not Nix-internal computation.
          honest_scope =
            "static complexity classes only; actual wall-clock timing requires host-side measurement (future P2 capability)";
        };
      # v0.13-SSSS: P1 — reverse-trace actionability.
      # Substrate enumerates its own remaining gaps and emits
      # for each one an *actionable patch target*: which file,
      # which field, which expected ratchet name, with reason.
      # This is the substrate's first instance of self-bounded
      # task generation — substrate doesn't just identify
      # what's missing, it specifies the concrete patch.
      #
      # Owner constitution compliance:
      #   immutable accumulation : pure derivation from current
      #     envelope; no prior state mutated
      #   performance stability  : O(gaps) scan over already-
      #     computed fields
      #   determinism            : pure data, identical envelope
      #     for identical inputs
      reverse_trace_actionable_targets =
        let
          # Bridge-debt caller migration targets (from layer 6).
          bridgeDebtTargets =
            builtins.filter
              (b: b.baseline_caller_count > 0)
              bridge_debt_caller_baseline;
          bridgeDebtRows =
            builtins.map
              (b: {
                gap_kind = "bridge-debt-caller-migration";
                target_file = b.measured_in_file;
                target_path = b.path;
                callers_remaining = b.baseline_caller_count;
                action =
                  "migrate each caller of `${b.path}` in ${b.measured_in_file} to canonical pnixc-meta dispatch (applyMirrorPlateWithLensDispatch); decrement baseline_caller_count toward 0";
                actionability = "high";
                source_envelope_field = "bridge_debt_caller_baseline";
                reason =
                  "non-zero caller_count means there are call sites still using the legacy transport; each migration removes one debt row";
              })
              bridgeDebtTargets;
          # Viable-unrealized shape frontier targets (from layer 15).
          frontierShapes =
            lens_family_shape_space_summary.viable_unrealized_shapes;
          frontierRows =
            builtins.map
              (sh: {
                gap_kind = "growth-frontier-unrealized-shape";
                target_shape = sh;
                target_file =
                  "<future>: a new lens entry in mirrorPlateLensRegistry";
                action =
                  "if a future lens needs coverage shape `${sh}`, instantiate it with the appropriate applicability flags (TFTF or TFTT); substrate-derived family-name convention will assign 'applyFamilyShape${sh}Plate'";
                actionability = "low";
                source_envelope_field =
                  "lens_family_shape_space_summary.viable_unrealized_shapes";
                reason =
                  "shape ${sh} is semantically viable (positive present) but no lens currently uses it; substrate's growth frontier";
              })
              frontierShapes;
          # 9 unmeasurable emergence signals — each is a P0
          # capability that needs implementation. Substrate
          # emits them as gap rows too (transparency: the
          # substrate's own roadmap is a gap list).
          unmeasurableSignalNames = [
            "repeated_frontier_class_count"
            "new_frontier_class_count"
            "reverse_trace_actionability_rate"
            "self_suggested_slice_validated_rate"
            "bridge_debt_retirement_rate"
            "held_reopen_success_rate"
            "external_fetch_acceptance_leak_count"
            "materialization_rollback_success_rate"
            "performance_budget_violations"
          ];
          unmeasurableRows =
            builtins.map
              (sig: {
                gap_kind = "unmeasurable-emergence-signal";
                target_field = "emergence_signals.${sig}";
                target_file =
                  "future: introspection_history runtime extension";
                action =
                  "implement doghouse-scope runtime persistence so each introspection call appends an event; aggregate over events to compute `${sig}`";
                actionability = "medium";
                source_envelope_field = "emergence_signals.honest_note";
                reason =
                  "P0 substrate-internal snapshots cannot retroactively measure per-call signals; needs runtime persistence layer";
              })
              unmeasurableSignalNames;
        in bridgeDebtRows ++ frontierRows ++ unmeasurableRows;
      reverse_trace_actionable_target_count =
        builtins.length reverse_trace_actionable_targets;
      # Aggregated counters by gap_kind for substrate-self
      # situational awareness.
      reverse_trace_summary =
        let
          targets = reverse_trace_actionable_targets;
          byKind = kind:
            builtins.filter (t: t.gap_kind == kind) targets;
        in {
          bridge_debt_target_count =
            builtins.length (byKind "bridge-debt-caller-migration");
          frontier_target_count =
            builtins.length (byKind "growth-frontier-unrealized-shape");
          unmeasurable_signal_target_count =
            builtins.length (byKind "unmeasurable-emergence-signal");
          total_actionable_targets = builtins.length targets;
          # High-actionability count is the most useful frontier
          # signal for the operator: how many can be tackled
          # next slice without architectural shifts?
          high_actionability_count =
            builtins.length
              (builtins.filter (t: t.actionability == "high") targets);
        };
      # v0.13-RRRR: P0 — introspection_history primitive.
      # First step toward the inter-slice memory the substrate
      # said it needed. This implementation pins history at
      # *substrate compile-time* (immutable, deterministic,
      # zero runtime cost) rather than via doghouse runtime
      # persistence. Each row is a snapshot of envelope key
      # metrics captured at a substrate-evolution slice.
      #
      # Owner constitution compliance:
      #   immutable accumulation : prior snapshots never erased
      #     (new slices append rows; old rows preserved)
      #   performance stability  : O(1) list lookup, constant
      #     memory per snapshot, no runtime cost
      #   determinism            : pure data — identical
      #     envelope every call
      #
      # Once doghouse persistence lands (future slice), this
      # static history becomes the *baseline* the runtime
      # store accumulates on top of — never replaces.
      introspection_history_snapshots = [
        {
          slice_id = "v0.13-AA";
          envelope_field_count = 12;
          introspection_layer_count = 1;
          self_invariant_count = 0;
          per_lens_completeness_percentage = 0;
          lens_registry_size = 6;
          note = "introspection lens first instance";
        }
        {
          slice_id = "v0.13-CC";
          envelope_field_count = 17;
          introspection_layer_count = 2;
          self_invariant_count = 1;
          per_lens_completeness_percentage = 0;
          lens_registry_size = 6;
          note = "first substrate self-invariant (no-orphan-verdicts)";
        }
        {
          slice_id = "v0.13-FFF";
          envelope_field_count = 32;
          introspection_layer_count = 7;
          self_invariant_count = 1;
          per_lens_completeness_percentage = 0;
          lens_registry_size = 29;
          note = "coverage witness cross-validator landed";
        }
        {
          slice_id = "v0.13-TTT";
          envelope_field_count = 64;
          introspection_layer_count = 11;
          self_invariant_count = 4;
          per_lens_completeness_percentage = 100;
          lens_registry_size = 29;
          note = "full witness saturation (29/29 fully_witnessed)";
        }
        {
          slice_id = "v0.13-WWW";
          envelope_field_count = 68;
          introspection_layer_count = 12;
          self_invariant_count = 4;
          per_lens_completeness_percentage = 100;
          lens_registry_size = 29;
          note = "acyclic dependency self-invariant (3rd)";
        }
        {
          slice_id = "v0.13-ZZZ";
          envelope_field_count = 70;
          introspection_layer_count = 13;
          self_invariant_count = 4;
          per_lens_completeness_percentage = 100;
          lens_registry_size = 29;
          note = "lifecycle metadata saturated (29/29)";
        }
        {
          slice_id = "v0.13-IIII";
          envelope_field_count = 77;
          introspection_layer_count = 14;
          self_invariant_count = 5;
          per_lens_completeness_percentage = 100;
          lens_registry_size = 29;
          note = "5th invariant (chronological-layer-ordering)";
        }
        {
          slice_id = "v0.13-MMMM";
          envelope_field_count = 83;
          introspection_layer_count = 16;
          self_invariant_count = 6;
          per_lens_completeness_percentage = 100;
          lens_registry_size = 29;
          note = "abstraction + optimization layers (15+16); 6th invariant (lossless recognition)";
        }
        {
          slice_id = "v0.13-QQQQ";
          envelope_field_count = 92;
          introspection_layer_count = 16;
          self_invariant_count = 6;
          per_lens_completeness_percentage = 100;
          lens_registry_size = 29;
          note = "P0 + intelligence accumulation trinity + amendment lane; substrate self-corrects 'saturated' to 'Pre-Ontology-Soak'";
        }
        {
          slice_id = "v0.13-RRRR";
          envelope_field_count = 94;
          introspection_layer_count = 16;
          self_invariant_count = 6;
          per_lens_completeness_percentage = 100;
          lens_registry_size = 29;
          note = "introspection_history first instance (substrate-internal immutable snapshots, P0 first capability)";
        }
        # v0.14-R (2026-05-18): substrate self-aware that
        # history was stale across 28 evolution slices
        # (v0.13-SSSS through v0.14-Q). Honest cleanup:
        # records ONLY the current observable state as a
        # single new snapshot, not made-up per-slice
        # backfills. Future slices SHOULD add their own
        # snapshot row at landing time to maintain the
        # immutable-accumulation invariant. Intermediate
        # slice snapshots (v0.13-SSSS through v0.14-P) are
        # acknowledged as missing-by-omission and not
        # backfilled (no ground truth to honestly pin).
        {
          slice_id = "v0.14-Q";
          envelope_field_count = 156;
          introspection_layer_count = 40;
          self_invariant_count = 7;
          per_lens_completeness_percentage = 100;
          lens_registry_size = 29;
          note = "substrate-lane summary triad complete (math + coding + firewall, Layer 37/38/39) + cross-lane triad meta-summary (Layer 40) + 7th pinned invariant lane-triad-totals-match-per-lane-sums (substrate's first cross-lane consistency invariant). Honest acknowledgment: 28 slices (v0.13-SSSS through v0.14-P) elapsed between this snapshot and the prior v0.13-RRRR snapshot — substrate forgot to extend history during that span; future slices MUST add their own snapshot row at landing time to maintain immutable-accumulation invariant.";
        }
      ];
      introspection_history_snapshot_count =
        builtins.length introspection_history_snapshots;
      # Aggregates derived from history (substrate now CAN
      # measure several emergence signals that were null in
      # v0.13-QQQQ).
      introspection_history_aggregates =
        let
          snaps = introspection_history_snapshots;
          n = builtins.length snaps;
          first = builtins.head snaps;
          last = builtins.elemAt snaps (n - 1);
          fieldCountSeries = builtins.map (s: s.envelope_field_count) snaps;
          # Substrate growth velocity: total fields added /
          # total snapshots = avg per-slice growth.
          totalFieldGrowth =
            last.envelope_field_count - first.envelope_field_count;
        in {
          first_snapshot_slice = first.slice_id;
          latest_snapshot_slice = last.slice_id;
          total_snapshots = n;
          envelope_field_count_first = first.envelope_field_count;
          envelope_field_count_latest = last.envelope_field_count;
          total_envelope_field_growth = totalFieldGrowth;
          avg_envelope_field_growth_per_snapshot_x100 =
            if n <= 1 then 0
            else (totalFieldGrowth * 100) / (n - 1);
          # Immutability check: is history strictly non-
          # decreasing? (substrate never erases prior layers)
          envelope_field_count_monotonic_non_decreasing =
            builtins.all
              (i:
                (builtins.elemAt fieldCountSeries i)
                  <= (builtins.elemAt fieldCountSeries (i + 1)))
              (builtins.genList (i: i) (n - 1));
        };
      # v0.13-QQQQ (extension): intelligence-accumulation
      # trinity self-declaration. Owner constitution: every
      # intelligence update MUST satisfy three invariants:
      #   1. immutable accumulation — prior layers preserved
      #      losslessly (supersede chain, never erase)
      #   2. performance stability — new layers don't
      #      degrade dispatch / introspection time
      #   3. determinism — same input → byte-identical output
      # Plus an amendment lane: immutable regions get fixed
      # via supersede chain that preserves the prior version,
      # not by in-place mutation.
      intelligence_accumulation_trinity = {
        invariant_1_immutable_accumulation = {
          name = "immutable-accumulation";
          rule = "prior introspection layers are preserved losslessly across slices; new layers are added, never replaced";
          current_substrate_compliance = {
            # Substrate-side check: are any historical layers
            # missing from layer_field_counts? Currently
            # substrate has 16 layers all enumerated in the
            # partition, none erased.
            all_layers_present_in_partition = true;
            evidence =
              "introspection_envelope_self_shape.layer_field_counts contains every layer from 1 to 16 explicitly";
          };
        };
        invariant_2_performance_stability = {
          name = "performance-stability";
          rule = "new layers must not degrade dispatch / introspection time beyond owner-defined budget";
          current_substrate_compliance = {
            # Substrate-side check: NOT measurable from inside
            # envelope. Requires P2 performance-introspection
            # lane.
            measured = false;
            measurement_blocker =
              "performance introspection (P2) not yet implemented; substrate cannot self-measure dispatch time";
            requires_capability = "P2-performance-introspection";
          };
        };
        invariant_3_determinism = {
          name = "determinism";
          rule = "same envelope inputs must produce byte-identical envelope outputs across calls";
          current_substrate_compliance = {
            # Substrate-side: replay-determinism is partially
            # witnessed (v0.13-BBB meta_meta_circular_replay
            # ratchet) for envelope JSON output. All envelope
            # computations are pure Nix expressions (no IO,
            # no random); determinism inherent.
            inherent_by_construction = true;
            witnessing_ratchet = "meta_circular_mirror_primitive_introspection_v0_13_bbb_meta_meta_circular_replay_native_on_pnixc_meta";
          };
        };
        amendment_lane = {
          name = "immutable-region-amendment-via-supersede-chain";
          rule = "immutable knowledge regions may be FIXED, but only via supersede chain that preserves the prior version; never via in-place mutation";
          first_instance =
            "v0.13-QQQQ's strategic-advice rewrite: v0.13-LLLL's 'introspection-saturated' claim is preserved as a historical posture in the supersede chain (commit log), not erased from substrate history";
          implementation_notes =
            "currently supersede chain is the git commit log itself; future substrate-side supersede-chain primitive would track amendment history inside envelope";
        };
        owner_constitution_quote =
          "지능은 immutable 업데이트될 때 쌓이고 성능이 유지되며 결정론적이어야 한다. 그래야 붕괴가 안 될 것이다. 당연히 immutable 했던 지능 부위를 fix 하는 기능이 있어야겠지.";
      };
      # v0.13-QQQQ: Pre-Ontology Introspection Soak (P0).
      # Owner directive: don't write ontology sentences yet —
      # first soak introspection long enough to detect repeated
      # frontier classes, reverse-trace actionability, and
      # self-suggested-slice validation rates. Once those
      # stabilize, abstraction is justified.
      #
      # This slice ADMITS that most signals require historical
      # data that the current substrate doesn't yet store
      # (introspection envelopes are stateless per call). For
      # each metric: substrate emits a best-available value OR
      # explicitly `no-data-yet` with a description of what
      # would populate it. Honest scope.
      emergence_signals =
        let
          # Currently-computable metrics (from envelope itself):
          presentFamilies = builtins.length lens_families;
          viableGrowth =
            lens_family_shape_space_summary.missing_viable_unrealized_count;
          # Substrate-side defensive estimates (no historical
          # data, so we use envelope-derived proxies + honest
          # nulls where the metric requires inter-slice
          # accumulation).
        in {
          # 1. Repeated frontier class — currently can't be
          # measured without persistent inter-slice memory.
          # Substrate's current frontier classes are an
          # initial best-guess based on layer 6 (bridge-debt)
          # + gap_analysis + per-lens completeness.
          repeated_frontier_class_count = "no-data-yet";
          repeated_frontier_class_data_source =
            "would-need-inter-slice-frontier-tracking";
          # 2. New frontier class detection — same.
          new_frontier_class_count = "no-data-yet";
          # 3. Reverse-trace actionability — would measure
          # how often "result → lens → witness → missing →
          # target file" chain leads to an actual patch.
          # Currently 0 such chains have been mechanically
          # tracked. The TIME-SERIES rate stays unmeasurable
          # without doghouse persistence.
          reverse_trace_actionability_rate = "no-data-yet";
          # v0.14-T (2026-05-18): substrate CAN currently
          # report the snapshot-time *ratio* of high-
          # actionability targets to total actionable targets
          # — that's pure envelope arithmetic, no history
          # needed. Distinct from the time-series rate above
          # (this is "what fraction of targets are HIGH right
          # now", not "how often does a target close over
          # time"). Both surfaces preserved honestly.
          reverse_trace_high_actionability_ratio_now =
            let total = reverse_trace_summary.total_actionable_targets;
                high = reverse_trace_summary.high_actionability_count;
            in if total == 0 then 0
               else (high * 100) / total;
          # 4. Self-suggested slice validation rate — when
          # `next_frontier` emits a priority, how often was
          # that priority the actual next slice landed?
          # Currently no validation log.
          self_suggested_slice_validated_rate = "no-data-yet";
          # 5. Lens dispatch success rate — most dispatches
          # succeed; substrate-side proxy = lens count with
          # coverage / total lens count. Currently 100%.
          lens_dispatch_success_rate_proxy =
            per_lens_completeness_aggregate.coverage_percentage;
          # 6. pnixc-meta native ratio — count of canonical
          # transports vs bridge-debt. Substrate has the
          # bridge-debt baseline; native ratio is implicit.
          pnixc_meta_native_ratio_proxy =
            "envelope-evaluated-natively-bridge-debt-callers-baseline-tracked";
          # 7. Bridge-debt retirement rate — would need
          # per-snapshot bridge-debt counter (not yet in
          # history snapshots).
          bridge_debt_retirement_rate = "no-data-yet";
          # v0.13-RRRR: history-derived measurements (newly
          # available now that introspection_history_snapshots
          # exists).
          envelope_growth_velocity_per_slice =
            introspection_history_aggregates.avg_envelope_field_growth_per_snapshot_x100;
          history_envelope_monotone =
            introspection_history_aggregates.envelope_field_count_monotonic_non_decreasing;
          history_snapshot_count =
            introspection_history_aggregates.total_snapshots;
          # 8. Held-reopen success rate — requires held +
          # external-fetch lane that doesn't exist yet at
          # substrate scope.
          held_reopen_success_rate = "no-data-yet";
          # 9. External fetch acceptance leak count — must
          # be 0 by owner-law; tracked at fetch lane (not
          # in substrate envelope).
          external_fetch_acceptance_leak_count = "no-data-yet";
          # 10. Materialization rollback success rate —
          # tracked at coding-agent lane (rollback-handle +
          # rollback-receipt plates); not at substrate scope.
          materialization_rollback_success_rate = "no-data-yet";
          # 11. Performance budget violations — would need
          # per-dispatch timing data.
          performance_budget_violations = "no-data-yet";
          # Substrate's honest summary (updated v0.14-T):
          measurable_metric_count = 6;
          unmeasurable_metric_count = 9;
          total_metric_count = 15;
          honest_note =
            "v0.14-T (2026-05-18): added reverse_trace_high_actionability_ratio_now as a derivable snapshot-time metric (high_actionability_count / total_actionable_targets * 100, integer percent). DISTINCT from reverse_trace_actionability_rate which still requires time-series and stays unmeasurable. measurable: 6 (lens_dispatch_success_rate_proxy + 3 history-derived from v0.13-RRRR + pnixc_meta_native_ratio_proxy + reverse_trace_high_actionability_ratio_now). unmeasurable: 9 (require doghouse-scope runtime persistence). The substrate continues to honestly preserve unmeasurable fields as 'no-data-yet' rather than fabricate values.";
        };
      # Substrate's abstraction-readiness check (owner-defined
      # thresholds applied to currently available metrics).
      abstraction_readiness_check =
        let
          # Owner threshold rules require historical data the
          # substrate doesn't have yet. So readiness defaults
          # to "not-yet" with explicit reason.
          have_data = false;
        in {
          ready = false;
          reason =
            if !have_data
            then "emergence-signals-require-historical-data-not-yet-collected"
            else "thresholds-not-met";
          owner_thresholds = {
            repeated_frontier_class_count_min = 20;
            new_frontier_class_count_max = 2;
            self_suggested_slice_validated_rate_min = 0.7;
            reverse_trace_actionability_rate_min = 0.6;
          };
          current_phase = "Pre-Ontology-Introspection-Soak-P0";
          next_substrate_capability =
            "persistent-introspection-history-tracking";
        };
      # v0.13-PPPP: substrate hypothesizes about its own growth
      # frontier. For each viable-unrealized shape, substrate
      # emits a semantic interpretation hint (what kind of lens
      # this shape would represent) and lens-name candidate
      # patterns (substrate-derived naming convention for
      # potential members). This is substrate-side hypothesis
      # generation — not a commitment, but a navigation aid
      # for future slices that want to populate the frontier.
      lens_family_growth_frontier_hypotheses =
        let
          viable = lens_family_shape_space_summary.viable_unrealized_shapes;
          hypothesisFor = shape:
            let
              # Decompose 4-char shape into per-path flags.
              p = (builtins.substring 0 1 shape) == "T";
              h = (builtins.substring 1 1 shape) == "T";
              n = (builtins.substring 2 1 shape) == "T";
              r = (builtins.substring 3 1 shape) == "T";
            in {
              shape = shape;
              # Substrate-derived semantic interpretation.
              semantic_interpretation =
                if shape == "TFTF"
                then ''
                  positive + negative, no held + no replay:
                  immediate-decider lens. Always accepts or
                  rejects a request directly, never holds for
                  more information, replay determinism comes
                  inherently from purity rather than per-lens
                  ratchet. Example future lens: a strict
                  validator that either confirms an input
                  matches a closed schema or rejects with a
                  reason — no ambiguity, no replay ratchet
                  needed (parent invariant covers).
                ''
                else if shape == "TFTT"
                then ''
                  positive + negative + replay, no held:
                  deterministic-decider lens. Always emits an
                  accept-or-reject verdict AND carries its own
                  replay-determinism ratchet (not inherited).
                  Example future lens: a stateful-snapshot
                  validator where replay correctness depends on
                  exact replay-of-input not parent purity —
                  hence the per-lens replay ratchet alongside
                  the binary decider behavior.
                ''
                else "(no substrate hypothesis for shape ${shape})";
              # Substrate-derived naming convention for future members.
              proposed_naming_pattern =
                "applyImmediateDeciderPlate<...>" + ""; # placeholder shape
              flags = {
                positive_applicable = p;
                held_applicable = h;
                negative_applicable = n;
                replay_applicable = r;
              };
              # Estimated arrival window: substrate's posture
              # says "no urgency" — frontier is a hint, not a
              # directive. Listed for substrate self-honesty.
              urgency = "frontier-hint-not-directive";
            };
        in builtins.map hypothesisFor viable;
      lens_family_growth_frontier_hypothesis_count =
        builtins.length lens_family_growth_frontier_hypotheses;
      # Aggregate: how many families are lane-homogeneous vs
      # cross-lane?
      lens_family_lane_homogeneity_summary =
        let
          rows = lens_family_lane_distribution;
          hom = builtins.filter (r: r.is_lane_homogeneous) rows;
          cross = builtins.filter (r: r.is_cross_lane) rows;
        in {
          total_families = builtins.length rows;
          lane_homogeneous_count = builtins.length hom;
          cross_lane_count = builtins.length cross;
          # Substrate observation: a healthy registry has *both*
          # — some shapes are lane-specific (e.g. stage plates
          # for coding lane), others cross lanes (e.g. pure
          # function semantics shared by math + coding).
        };
      # v0.13-MMMM: substrate self-optimization signals.
      # Substrate emits *reduction opportunities*: areas where
      # the current substrate could be shrunk / unified /
      # simplified without losing semantic coverage. This is
      # the substrate noticing where it's redundantly verbose.
      #
      # Current opportunities derived from family counts:
      #   - any family with >= 3 lenses is a *consolidation*
      #     candidate (same coverage shape repeated; could
      #     potentially share a single plate template).
      #   - bridge-debt baseline > 0 is a *caller migration*
      #     opportunity (each remaining caller is a reduction
      #     target).
      substrate_optimization_signals =
        let
          consolidationCandidates =
            builtins.filter (f: f.lens_count >= 3) lens_families;
          totalLensesInConsolidation =
            builtins.foldl' (a: f: a + f.lens_count) 0 consolidationCandidates;
          bridgeDebt = bridge_debt_caller_baseline;
        in {
          consolidation_candidates_family_count =
            builtins.length consolidationCandidates;
          consolidation_candidate_lens_total =
            totalLensesInConsolidation;
          bridge_debt_caller_baseline_for_migration = bridgeDebt;
          # Naive reduction estimate: if all consolidation
          # candidates collapsed to one representative each,
          # the registry would shrink by (total - family-count).
          # This is illustrative, not a directive.
          theoretical_lens_reduction_if_all_consolidated =
            totalLensesInConsolidation
            - (builtins.length consolidationCandidates);
          optimization_posture =
            if (builtins.length consolidationCandidates) > 0
            then "consolidation-opportunities-present"
            else "no-substrate-side-consolidation";
        };
      # v0.13-MMMM (extension): short-path optimization
      # candidates with lossless preservation.
      #
      # The owner directive is precise: optimization = recognize
      # an abstraction + redefine via short path + preserve all
      # prior concepts. So substrate emits, per consolidation
      # family, a *candidate descriptor*:
      #
      #   - family identity (shape, substrate-derived name)
      #   - proposed short-path function name (substrate-derived)
      #   - member lenses (all individual identity preserved)
      #   - per-member preserved-metadata roster (which fields
      #     must round-trip lossless if substrate ever collapses
      #     the family to one entry)
      #
      # No actual collapse happens here — substrate only emits
      # the lossless-preserving candidate. Acting on it is a
      # future slice with its own owner-law gate.
      substrate_short_path_candidates =
        let
          consolidationFamilies =
            builtins.filter (f: f.lens_count >= 3) lens_families;
          preservedFieldsForMember = lensName: [
            "lens_name"
            "verdict_name"
            "lane"
            "coverage.coverage_witnesses.positive"
            "coverage.coverage_witnesses.held"
            "coverage.coverage_witnesses.negative"
            "coverage.coverage_witnesses.replay_determinism"
            "coverage.positive_applicable"
            "coverage.held_applicable"
            "coverage.negative_applicable"
            "coverage.replay_applicable"
            "lifecycle.created_in_slice"
            "in_degree"
            "direct_dependencies"
            "transitive_dependencies"
          ];
          shortPathNameFor = family:
            "applyFamilyShape" + family.shape + "Plate";
          candidateFor = family: {
            family_shape = family.shape;
            family_substrate_name = family.substrate_name;
            member_count = family.lens_count;
            member_lenses = family.lens_names;
            proposed_short_path_function = shortPathNameFor family;
            preserved_metadata_per_member_field_count =
              builtins.length (preservedFieldsForMember "");
            preserved_metadata_per_member_field_names =
              preservedFieldsForMember "";
            lossless_invariant = ''
              if substrate ever collapses these N members to a
              single short-path entry, every member's individual
              identity, witnesses, applicability flags,
              lifecycle, and dependency edges must be
              retained as descriptor rows — semantic round-trip
              must be exact.
            '';
            current_state = "candidate-emitted-not-applied";
          };
        in builtins.map candidateFor consolidationFamilies;
      substrate_short_path_candidate_count =
        builtins.length substrate_short_path_candidates;
      # Substrate's invariant claim: the abstraction emission
      # is lossless — no member's metadata is dropped at the
      # candidate-emission level. This is the *lossless
      # recognition* layer, not the *applied collapse* layer.
      substrate_optimization_recognition_is_lossless =
        let
          # Every member lens in every candidate must be present
          # in `per_lens_unified` (verifying nothing was dropped
          # at the abstraction layer).
          allMemberLenses =
            builtins.concatLists
              (builtins.map (c: c.member_lenses) substrate_short_path_candidates);
          unifiedLensNames =
            builtins.map (r: r.lens_name) per_lens_unified;
        in
          builtins.all
            (m: builtins.elem m unifiedLensNames)
            allMemberLenses;
      # v0.13-LLLL: substrate strategic advice. The substrate
      # evaluates its own maturity and emits a self-advisory
      # message about where the next substantive work belongs.
      # Different from `next_frontier` (which lists concrete
      # micro-task candidates) — this is the substrate's view
      # of its own *strategic posture*.
      #
      # Derivation rule:
      #   - if per_lens_completeness == 100 AND all invariants
      #     passing AND chain is mature (>= 12 layers + 5
      #     invariants), the substrate has reached "introspection
      #     saturation" and should advise external consumption
      #     surfaces rather than more micro layers.
      #   - if invariants failing or completeness < 100, the
      #     substrate should advise repair / completion first.
      substrate_strategic_advice =
        let
          structurallyMature =
            per_lens_completeness_aggregate.coverage_percentage == 100
            && substrate_health.all_substrate_side_invariants_passing
            && introspection_chain_metadata.layer_count >= 12
            && introspection_chain_metadata.substrate_self_invariant_count
                 >= 5;
          # Owner correction (2026-05-17): structural maturity
          # is NOT abstraction-readiness. Substrate must SOAK
          # introspection long enough to detect repeated
          # frontier classes, reverse-trace actionability,
          # self-suggested-slice validation rates, and
          # performance budgets BEFORE ontology sentence
          # generation. The 'saturated' label was premature
          # self-promotion. Real posture is:
          #
          #   Pre-Ontology-Introspection-Soak (P0)
          #
          # Substrate has shape; substrate doesn't yet have
          # history to abstract.
          abstractionReady = abstraction_readiness_check.ready;
        in
          if abstractionReady
          then {
            posture = "abstraction-ready";
            advisory =
              "Emergence signals stabilized — substrate ready for abstraction layer (P5) then ontology sentence generation (P6).";
            next_lane_candidate = "abstraction-layer";
          }
          else if structurallyMature
          then {
            posture = "P0-P6-first-instance-saturated";
            advisory = ''
              Phase: P0-P6-first-instance-saturated.
              Still inside Pre-Ontology-Introspection-Soak
              (owner directive) at the second-instance level.

              v0.13-XXXX completed all 7 first-instance landings
              (P0 history, P1 reverse-trace, P2 performance,
              P3 safety scoreboard, P4 external-learning
              protocol, P5 abstract types, P6 ontology
              sentences). Each phase has substrate-side coverage;
              host-side / runtime continuations remain in
              honest_scope notes.

              Substrate structure is complete (16 layers, 6
              invariants, 100% per-lens completeness) but
              abstraction-readiness is NOT yet met. Owner
              directive (헌법): do not jump to ontology
              sentence generation. First soak introspection
              long enough to populate emergence signals:

                * repeated frontier classes
                * reverse-trace actionability rate
                * self-suggested slice validation rate
                * performance / memory / time budgets
                * self-update rollback safety
                * Held-triggered external learning quality

              Owner constitution on intelligence accumulation:
              intelligence updates must (1) accumulate as
              immutable layers on top of prior knowledge
              (lossless retention), (2) preserve performance
              across updates, (3) remain deterministic
              (same input → same output). Without these
              three, the substrate collapses instead of
              growing. A patching capability for
              previously-immutable knowledge regions is also
              required — immutability is the default; fixes
              go through a sanctioned amendment lane that
              preserves the prior version in supersede chain.

              Next substrate capabilities (priority order):

                P0  : add introspection_history primitive
                       (doghouse-scope persistence) to
                       collect emergence signals over slices
                       — immutable accumulation, deterministic
                       replay, performance bounded.
                P1  : reverse-trace actionability (result
                       to next patch target).
                P2  : performance introspection (timing,
                       memory, stack) — required to enforce
                       performance-stability invariant.
                P3  : self-update safety scoreboard
                       (candidate/review/apply/verify/rollback
                       chain stats).
                P4  : Held-reopen external learning lane.
                P5  : abstraction (repeated frontier
                       classes become abstract types).
                P6  : ontology sentence generation.

              Immutable knowledge amendment lane (transverse
              to P0–P6): every immutable region MUST have a
              superseded-by amendment slot that preserves the
              prior version while pinning the corrected one,
              so substrate self-correction never destroys
              prior self-knowledge. v0.13-QQQQ's strategic
              advice rewrite is itself the first instance:
              v0.13-LLLL's 'introspection-saturated' claim
              is preserved as a historical posture in the
              supersede chain, not erased.

              Current introspection envelope is the substrate
              snapshot at one moment. Soak = many snapshots
              over time. The substrate needs a clock + a
              memory + an immutable-fix lane before it can
              self-abstract honestly.
            '';
            next_lane_candidate = "introspection-history-persistence";
          }
          else {
            posture = "introspection-incomplete";
            advisory =
              "Substrate self-knowledge incomplete — finish structural saturation first.";
            next_lane_candidate = "introspection-completion";
          };
      # v0.13-KKKK: substrate self-documenting intro. The
      # substrate emits a short text guide for consumers --
      # what envelope fields to read, in what order, for what
      # purpose. This makes the introspection envelope
      # self-describing without requiring external README.
      introspection_self_documenting_intro = ''
        mirror primitive introspection — self-knowledge envelope.

        Quick reference for consumers (cockpit panels, freecat
        surfaces, external integrations):

          1. `substrate_self_summary`
                 -> single-glance status read (10 metrics).
          2. `substrate_health`
                 -> health check (3 substrate-side invariants
                    + 1 host-only).
          3. `introspection_chain_metadata`
                 -> maturity statement (first/latest slice,
                    layer count, completeness percentage).
          4. `per_lens_unified`
                 -> one row per lens with all metadata joined.
          5. `per_lens_completeness_score`
                 -> 0-8 self-knowledge score per lens.
          6. `gap_analysis`
                 -> remaining witness gaps by path-type.
          7. `next_frontier`
                 -> substrate's own next-priority signal.

        Substrate exposes 41 layers of self-knowledge across
        157 envelope fields, enforces 7 pinned invariants
        (v0.14-Q added cross-lane-totals consistency invariant
        as the first cross-lane invariant kind),
        reports 100% completeness on 29 lenses, has substrate-
        side first instances of ALL P0-P6 owner-roadmap phases,
        self-attests the P0-P6 graduation, enumerates EXISTING
        stdlib/lib/ owners (~270), 70 Rust crates, the 30-owner
        self-runtime stack, the 956-artifact surrounding
        project surface, the completed substrate-lane summary
        triad (math + coding + firewall: 18 + 11 + 5 = 34
        owners, 16 + 7 + 5 = 28 dispatched lenses), AND now
        a cross-lane meta-summary roll-up spanning 9 minor
        substrate versions (v0.5 through v0.13).

        Detail layers (1-40): see
        `introspection_layer_origin_slice` for the chronology.
        `mirror_primitive_public_api_surface` lists the 18
        module exports if you need to call other functions.
      '';
      # v0.13-JJJJ: introspection chain metadata. Substrate
      # emits a complete maturity statement in one attrset --
      # the chain's history, current state, and saturation
      # metric. This is what a cockpit consumer would read to
      # answer "how mature is the substrate's self-knowledge?".
      introspection_chain_metadata = {
        first_slice                       = "v0.13-AA";
        latest_slice                      = "v0.14-W";
        layer_count                       = 41;
        envelope_field_count              = 157;
        substrate_self_invariant_count    = 7;
        per_lens_completeness_percentage  = 100;
        registry_size                     = builtins.length perLens;
        all_substrate_side_invariants_passing =
          substrate_health.all_substrate_side_invariants_passing;
        is_chronologically_monotone =
          introspection_layer_chronology.is_monotonic;
        # Brief narrative of what the substrate has self-built.
        maturity_statement =
          "substrate exposes 18 layers of self-knowledge across 98 envelope fields, enforces 6 pinned invariants, reports 100% completeness on 29 lenses, abstracts into 6 shape families, emits lossless short-path candidates, maintains 10-snapshot immutable substrate-self history (P0), and now derives actionable patch targets from its own gaps (P1 first instance)";
      };
      # v0.13-IIII: layer-origin chronological ordering invariant.
      # Substrate enforces that layer N's introducing slice
      # comes lexicographically at-or-after layer N-1's slice
      # (substrate was built up incrementally, never went back
      # to insert an earlier layer). If a future slice tries
      # to add layer 15 with an origin slice earlier than
      # layer 14's, this invariant fails.
      introspection_layer_chronology = rec {
        sequence = [
          { layer = "layer_1_lens_inventory";      slice = "v0.13-AA"; }
          { layer = "layer_2_verdict_inventory";   slice = "v0.13-AA"; }
          { layer = "layer_3_plate_shape";         slice = "v0.13-AA"; }
          { layer = "layer_4_coverage_aggregates"; slice = "v0.13-DD"; }
          { layer = "layer_5_lane_groupings";      slice = "v0.13-CCC"; }
          { layer = "layer_6_bridge_debt";         slice = "v0.13-EEE"; }
          { layer = "layer_7_witness_breakdown";   slice = "v0.13-MMM"; }
          { layer = "layer_8_gap_analysis";        slice = "v0.13-QQQ"; }
          { layer = "layer_9_dependency_graph";    slice = "v0.13-UUU"; }
          { layer = "layer_10_lifecycle";          slice = "v0.13-YYY"; }
          { layer = "layer_11_self_shape";         slice = "v0.13-BBBB"; }
          { layer = "layer_12_self_invariants";    slice = "v0.13-CCCC"; }
          { layer = "layer_13_api_surface";        slice = "v0.13-FFFF"; }
          { layer = "layer_14_per_lens_unified";   slice = "v0.13-GGGG"; }
          { layer = "layer_15_abstraction";        slice = "v0.13-MMMM"; }
          { layer = "layer_16_optimization";       slice = "v0.13-MMMM"; }
          { layer = "layer_17_history_p0";         slice = "v0.13-RRRR"; }
          { layer = "layer_18_reverse_trace_p1";   slice = "v0.13-SSSS"; }
          { layer = "layer_19_performance_p2";     slice = "v0.13-TTTT"; }
          { layer = "layer_20_self_update_safety_p3"; slice = "v0.13-UUUU"; }
          { layer = "layer_21_external_learning_p4"; slice = "v0.13-VVVV"; }
          { layer = "layer_22_abstraction_p5";       slice = "v0.13-WWWW"; }
          { layer = "layer_23_ontology_sentences_p6"; slice = "v0.13-XXXX"; }
          { layer = "layer_24_roadmap_graduation";    slice = "v0.13-YYYY"; }
          { layer = "layer_25_freecat_cli_capability"; slice = "v0.14-A"; }
          { layer = "layer_26_extended_owners";        slice = "v0.14-B"; }
          { layer = "layer_27_algo_synth_helpers";     slice = "v0.14-C"; }
          { layer = "layer_28_stdlib_semantic_helpers"; slice = "v0.14-D"; }
          { layer = "layer_29_format_surfaces";        slice = "v0.14-E"; }
          { layer = "layer_30_stdlib_roots";           slice = "v0.14-F"; }
          { layer = "layer_31_absorb_brain_missed";    slice = "v0.14-G"; }
          { layer = "layer_32_macro_only_family";      slice = "v0.14-H"; }
          { layer = "layer_33_stdlib_subtrees";        slice = "v0.14-I"; }
          { layer = "layer_34_crate_workspace";        slice = "v0.14-J"; }
          { layer = "layer_35_self_runtime_stack";     slice = "v0.14-K"; }
          { layer = "layer_36_final_sweep";            slice = "v0.14-L"; }
          { layer = "layer_37_math_substrate_summary"; slice = "v0.14-M"; }
          { layer = "layer_38_coding_substrate_summary"; slice = "v0.14-N"; }
          { layer = "layer_39_firewall_substrate_summary"; slice = "v0.14-O"; }
          { layer = "layer_40_substrate_lane_triad_summary"; slice = "v0.14-P"; }
          { layer = "layer_41_problem_solving_inventory";    slice = "v0.14-U"; }
        ];
        # Substrate's actual chronological suffix order:
        #   AA < BB < CC < ... < ZZ < AAA < BBB < ... < ZZZ
        #   < AAAA < BBBB < ...
        # i.e. length-first, then char-alphabetic. Pure lex
        # would put "BBBB" before "YYY" which is the opposite
        # of the substrate's actual evolution. The comparison
        # here implements the length-first ordering.
        is_monotonic =
          let
            slices = builtins.map (e: e.slice) sequence;
            len = builtins.length slices;
            # Compare two slice strings as substrate chronology:
            # split "v<major.minor>-<suffix>" → compare
            # major.minor numerically (lex works for X.Y with
            # equal digit counts), then suffix length-first
            # then alphabet. This handles v0.13-YYYY → v0.14-A
            # transition correctly (0.13 < 0.14 wins over
            # length-first comparison of YYYY vs A).
            splitSlice = s:
              let
                # Drop leading "v"
                noV = builtins.substring 1
                  (builtins.stringLength s - 1) s;
                parts = builtins.split "-" noV;
                # parts = [ "0.13", [ "-" ], "YYYY" ]
                head = builtins.elemAt parts 0;
                tail =
                  if builtins.length parts >= 3
                  then builtins.elemAt parts 2
                  else "";
              in { major = head; suffix = tail; };
            sliceLeq = a: b:
              let
                ap = splitSlice a;
                bp = splitSlice b;
                aSL = builtins.stringLength ap.suffix;
                bSL = builtins.stringLength bp.suffix;
              in
                if ap.major < bp.major then true
                else if ap.major > bp.major then false
                else
                  if aSL < bSL then true
                  else if aSL > bSL then false
                  else ap.suffix <= bp.suffix;
            pairs = builtins.genList
              (i: {
                a = builtins.elemAt slices i;
                b = builtins.elemAt slices (i + 1);
              })
              (len - 1);
          in
            builtins.all (p: sliceLeq p.a p.b) pairs;
        layer_count = builtins.length sequence;
      };
      # v0.13-HHHH: per-lens self-knowledge completeness score.
      # For each lens row in `per_lens_unified`, count how many
      # of the 8 substrate-side knowledge dimensions are
      # populated (non-null + non-empty + applicable):
      #   1. coverage block present
      #   2. positive witness present (if applicable)
      #   3. held witness present (if applicable)
      #   4. negative witness present (if applicable)
      #   5. replay witness present (if applicable)
      #   6. lifecycle.created_in_slice present
      #   7. verdict_name non-empty
      #   8. lane classified (always true; sanity)
      # Substrate emits per-row score + aggregates.
      per_lens_completeness_score =
        let
          scoreRow = row:
            let
              c = row.coverage;
              w = row.witnesses;
              applicableScore = appKey: witKey:
                if c == null then 0
                else
                  let
                    applicable =
                      if builtins.hasAttr appKey c
                      then builtins.getAttr appKey c
                      else true; # default-true when field absent
                  in
                    if !applicable then 1
                      # N/A by design = counted as complete (no obligation)
                    else if w == null then 0
                    else if (builtins.getAttr witKey w) == null then 0
                    else 1;
              coverageBlock = if c == null then 0 else 1;
              posScore = applicableScore "positive_applicable" "positive";
              heldScore = applicableScore "held_applicable" "held";
              negScore = applicableScore "negative_applicable" "negative";
              replayScore =
                applicableScore "replay_applicable" "replay_determinism";
              lifecycleScore =
                if row.lifecycle == null then 0
                else if !(row.lifecycle ? created_in_slice) then 0
                else 1;
              verdictScore =
                if row.verdict_name == "" then 0 else 1;
              laneScore = 1; # always classified
            in {
              lens_name = row.lens_name;
              score =
                coverageBlock + posScore + heldScore + negScore
                + replayScore + lifecycleScore + verdictScore
                + laneScore;
              max_score = 8;
              breakdown = {
                coverage_block_present = coverageBlock;
                positive_path_satisfied = posScore;
                held_path_satisfied = heldScore;
                negative_path_satisfied = negScore;
                replay_path_satisfied = replayScore;
                lifecycle_present = lifecycleScore;
                verdict_name_present = verdictScore;
                lane_classified = laneScore;
              };
            };
        in builtins.map scoreRow per_lens_unified;
      per_lens_completeness_aggregate =
        let
          scores = builtins.map (r: r.score) per_lens_completeness_score;
          allMax = builtins.all (s: s == 8) scores;
          minScore =
            builtins.foldl' (a: b: if b < a then b else a) 8 scores;
          maxScore =
            builtins.foldl' (a: b: if b > a then b else a) 0 scores;
          totalScore =
            builtins.foldl' (a: b: a + b) 0 scores;
        in {
          lens_count = builtins.length scores;
          all_lenses_max_score = allMax;
          min_score_observed = minScore;
          max_score_observed = maxScore;
          total_score = totalScore;
          max_possible_total = (builtins.length scores) * 8;
          coverage_percentage =
            if scores == []
            then 0
            else (totalScore * 100) / ((builtins.length scores) * 8);
        };
      # v0.13-FFFF: mirror primitive module API surface
      # declaration (Layer 13). The substrate declares the
      # public attribute names exported by the
      # `parametric-mirror-plate.px` module itself (its public
      # API surface). Host-side ratchet checks the declared
      # list matches `builtins.attrNames (import ./parametric-
      # mirror-plate.px)`. Drift = a new export was added or
      # an existing one removed without updating the declaration.
      mirror_primitive_public_api_surface = {
        # Manually pinned 18 names; verified by host ratchet
        # against actual attrNames of the imported module.
        declared_export_count = 18;
        declared_exports = [
          # Plate construction (4):
          "mkMirrorRoom" "bindSlot"
          "instantiate" "applyInstance"
          # Generic lens dispatch (1):
          "applyMirrorPlateWithLensDispatch"
          # Specialized dispatcher (1, intent-recognition lane wrapper):
          "applyIntentRecognitionPlateAt"
          # Introspection (2):
          "introspectMirrorPrimitiveInventory"
          "applyMirrorPrimitiveInventoryPlate"
          # Plate inventory primitives (4):
          "plateSlotNames" "requiredSlots" "missingSlots"
          "plateInvariants"
          # Substrate registries (4):
          "mirrorPlateLensRegistry" "knownVerdicts" "auxiliaryVerdicts"
          "validPlateVerdicts"
          # Identity (2):
          "ownerName" "meta"
        ];
      };
      # v0.13-EEEE: substrate health check. Substrate evaluates
      # each of its declared self-invariants against the actual
      # envelope values and emits a single-glance health verdict.
      # `all_invariants_passing` is the substrate's own
      # self-attestation that nothing in its self-shape has
      # drifted; the per-invariant breakdown surfaces exactly
      # which one would fail if any.
      substrate_health =
        let
          # 6 of 7 invariants are checked here (numeric "must
          # be zero", boolean "must be true", and v0.14-Q
          # cross-lane totals match). The 7th (envelope-self-
          # shape-consistency) requires reading
          # `builtins.attrNames` of the envelope itself, which
          # we can't do from inside the envelope without
          # circular evaluation. It remains host-only via the
          # v0.13-BBBB ratchet.
          orphanCount = orphan_auxiliary_verdict_count;
          applicabilityCount =
            gap_analysis.applicability_inconsistency_count;
          cycleCount = lens_dependency_cycle_count;
          monotonicLayers =
            introspection_layer_chronology.is_monotonic;
          losslessRecognition =
            substrate_optimization_recognition_is_lossless;
          # v0.14-Q: cross-lane totals consistency check.
          # The triad summary's cross_lane_totals MUST equal
          # the sum of per-lane source counts. Substrate-side
          # verifiable because both sides are envelope fields.
          triadOwnerSum =
            substrate_lane_triad_summary.per_lane_owner_file_counts.math
            + substrate_lane_triad_summary.per_lane_owner_file_counts.coding
            + substrate_lane_triad_summary.per_lane_owner_file_counts.firewall;
          triadDispatchedSum =
            substrate_lane_triad_summary.per_lane_dispatched_lens_counts.math
            + substrate_lane_triad_summary.per_lane_dispatched_lens_counts.coding
            + substrate_lane_triad_summary.per_lane_dispatched_lens_counts.firewall;
          triadHelperSum =
            substrate_lane_triad_summary.per_lane_helper_counts.math
            + substrate_lane_triad_summary.per_lane_helper_counts.coding
            + substrate_lane_triad_summary.per_lane_helper_counts.firewall;
          triadTotalsMatch =
            (substrate_lane_triad_summary.cross_lane_totals.total_owner_files == triadOwnerSum)
            && (substrate_lane_triad_summary.cross_lane_totals.total_dispatched_lenses == triadDispatchedSum)
            && (substrate_lane_triad_summary.cross_lane_totals.total_helpers == triadHelperSum);
          checks = {
            no-orphan-verdicts                       = orphanCount == 0;
            no-applicability-inconsistency           = applicabilityCount == 0;
            acyclic-dependency-graph                 = cycleCount == 0;
            chronological-layer-ordering             = monotonicLayers;
            optimization-recognition-lossless        = losslessRecognition;
            lane-triad-totals-match-per-lane-sums    = triadTotalsMatch;
          };
          failing =
            builtins.filter
              (n: !(builtins.getAttr n checks))
              (builtins.attrNames checks);
        in {
          all_substrate_side_invariants_passing = failing == [];
          failing_invariants = failing;
          invariant_status_by_name = checks;
          host_only_invariants = [ "envelope-self-shape-consistency" ];
        };
      # v0.13-DDDD: substrate self-summary (cockpit single-glance
      # view). Aggregates the substrate's most important
      # self-knowledge metrics into one attrset so consumers
      # don't have to walk 65+ fields to get a status read.
      substrate_self_summary = {
        lens_registry_size              = builtins.length perLens;
        introspection_layer_count       = 41;
        envelope_field_count            = 157;
        self_invariant_count            = 7;
        dependency_edge_count           = lens_dependency_edge_count;
        dependency_graph_acyclic        = lens_dependency_acyclic;
        coverage_full_saturation        = lens_with_complete_coverage_count;
        witness_full_saturation         = lens_with_declared_witnesses_count;
        lifecycle_full_saturation       = lens_with_lifecycle_metadata_count;
        foundation_lens_count           =
          builtins.length most_depended_on_lens_names;
      };
      # v0.13-BBBB: substrate self-shape declaration.
      # The substrate declares the count and grouping of its
      # own introspection envelope fields. Host-side cross-
      # validator (in v0.13-BBBB ratchet) checks the declared
      # count matches the actual `builtins.attrNames env` count.
      # Drift = substrate truth claim out-of-sync with envelope
      # shape; failing ratchet forces a sync.
      introspection_envelope_self_shape = {
        # Manually pinned. Each new envelope field increments
        # this by 1 (and updates the layer it belongs to).
        # Verified by the host ratchet against attrNames count.
        declared_field_count = 157;
        # The substrate's own grouping of its 10
        # self-knowledge layers. Each layer = a logical group
        # of fields. The grouping is the substrate's
        # *self-organization* claim, separate from the
        # mechanical field list.
        layer_field_counts = {
          layer_1_lens_inventory                  = 4;
          layer_2_verdict_inventory               = 16;
          layer_3_plate_shape                     = 4;
          layer_4_coverage_aggregates             = 6;
          layer_5_lane_groupings                  = 1;
          layer_6_bridge_debt                     = 3;
          layer_7_witness_breakdown               = 2;
          layer_8_gap_analysis                    = 1;
          layer_9_dependency_graph                = 9;
          layer_10_lifecycle                      = 4;
          layer_11_self_shape                     = 1;
          layer_12_self_invariants                = 5;
          layer_13_api_surface                    = 1;
          layer_14_per_lens_unified               = 7;
          layer_15_abstraction                    = 8;
          layer_16_optimization                   = 7;
          layer_17_history_p0                     = 3;
          layer_18_reverse_trace_p1               = 3;
          layer_19_performance_p2                 = 1;
          layer_20_self_update_safety_p3          = 1;
          layer_21_external_learning_p4           = 1;
          layer_22_abstraction_p5                 = 3;
          layer_23_ontology_sentences_p6          = 6;
          layer_24_roadmap_graduation             = 2;
          layer_25_freecat_cli_capability         = 5;
          layer_26_extended_owners                = 3;
          layer_27_algo_synth_helpers             = 3;
          layer_28_stdlib_semantic_helpers        = 4;
          layer_29_format_surfaces                = 3;
          layer_30_stdlib_roots                   = 4;
          layer_31_absorb_brain_missed            = 4;
          layer_32_macro_only_family              = 3;
          layer_33_stdlib_subtrees                = 2;
          layer_34_crate_workspace                = 2;
          layer_35_self_runtime_stack             = 3;
          layer_36_final_sweep                    = 4;
          layer_37_math_substrate_summary         = 1;
          layer_38_coding_substrate_summary       = 1;
          layer_39_firewall_substrate_summary     = 1;
          layer_40_substrate_lane_triad_summary   = 1;
          layer_41_problem_solving_inventory      = 1;
          # Misc top-level (outcome, primitive_owner, etc.).
          misc                                    = 13;
        };
      };
      lens_lifecycle_distribution_by_lane =
        let
          lifecycleSliceFor = lensName:
            let entry = builtins.getAttr lensName mirrorPlateLensRegistry;
            in
              if (entry ? lifecycle)
                 && (entry.lifecycle ? created_in_slice)
              then entry.lifecycle.created_in_slice
              else null;
          forLane = lane:
            let
              laneLenses = lensesByLane lane;
              slices = builtins.filter
                (s: s != null)
                (builtins.map (l: lifecycleSliceFor l.lens_name) laneLenses);
              uniq = builtins.attrNames
                (builtins.listToAttrs
                  (builtins.map (s: { name = s; value = true; }) slices));
              sorted = builtins.sort (a: b: a < b) uniq;
            in {
              lane_lens_count = builtins.length laneLenses;
              lens_with_lifecycle_count = builtins.length slices;
              distinct_slice_count = builtins.length sorted;
              earliest_slice =
                if sorted == [] then null else builtins.head sorted;
              latest_slice =
                if sorted == []
                then null
                else builtins.elemAt sorted (builtins.length sorted - 1);
            };
        in {
          coding = forLane "coding";
          gate = forLane "gate";
          math = forLane "math";
          mirror-primitive = forLane "mirror-primitive";
        };
      # v0.13-DDD: per-verdict reverse-map. Each known verdict
      # carries its emitter (dispatcher / wrapper / lens / orphan).
      # Sum across rows = known_verdict_count. Orphans should be 0
      # (substrate self-invariant from v0.13-CC).
      verdict_to_emitter_map = verdictToEmitterRows;
      verdict_to_emitter_row_count = builtins.length verdictToEmitterRows;
      # v0.13-EE (2026-05-17): next-frontier signal output. The
      # substrate emits its OWN next development priority rather
      # than a human picking by feel.
      next_frontier = {
        any_open = anyFrontierOpen;
        first_undeclared_lens = firstUndeclaredName;
        first_incomplete_lens =
          if firstIncomplete == null then null
          else firstIncomplete.lens_name;
        first_incomplete_missing_ratchets = firstIncompleteMissing;
        priority_actions = priorityActions;
      };
      # Plate invariants.
      plate_invariant_count = builtins.length invariantNames;
      plate_invariant_names = invariantNames;
      # v0.13-BB: harness primitive inventory. The harness owner
      # lives in its own file (mirror-plate-test-harness.px) but
      # is part of the mirror substrate's self-shape -- it is the
      # plate-application of verdicts ABOUT plate applications.
      harness_owner = harnessOwnerPath;
      harness_op_count = builtins.length harnessOpNames;
      harness_op_names = harnessOpNames;
      harness_verdict_count = builtins.length harnessVerdictInventory;
      harness_verdict_names = harnessVerdictInventory;
      harness_invariant_count = builtins.length harnessInvariantNames;
      harness_invariant_names = harnessInvariantNames;
    };

  # Lens-entry-style invocation. Same shape as other entries; lets
  # the introspection lens dispatch through
  # `applyMirrorPlateWithLensDispatch` like any other lens, which
  # is the meta-circular point: the primitive uses its own dispatch
  # machinery to inspect itself.
  applyMirrorPrimitiveInventoryPlate = _request:
    introspectMirrorPrimitiveInventory {};
  in {
  inherit
    ownerName
    plateSlotNames
    requiredSlots
    validPlateVerdicts
    auxiliaryVerdicts
    knownVerdicts
    mkMirrorRoom
    bindSlot
    missingSlots
    instantiate
    applyInstance
    applyIntentRecognitionPlateAt
    mirrorPlateLensRegistry
    applyMirrorPlateWithLensDispatch
    plateInvariants
    # v0.13-AA: mirror primitive introspection exports.
    introspectMirrorPrimitiveInventory
    applyMirrorPrimitiveInventoryPlate;
  meta = {
    source = "pnix-mirror-runtime primitives";
    owner = ownerName;
    base = "parametric-mirror-plate-v0";
    rev_note = "First `.px`-owned parametric-mirror-plate primitive. Slot inventory + bind/missing/instantiate/apply data plane. Lens/owner-law/capability-route values are stored as paths; their runtime dispatch is a downstream adapter. Reverse-definition view and meta-mirror pass are next-slice frontiers, but the construction-trace receipt this owner emits is the data backbone they will consume.";
  };
}
