        { transform_name = "inline-function";
          owner_file = "stdlib/lib/gate/code-transform/inline-function.px";
          verdict_family = [ "inline-function-ready" "inline-function-held" "inline-function-rejected" ]; }
        { transform_name = "move-symbol";
          owner_file = "stdlib/lib/gate/code-transform/move-symbol.px";
          verdict_family = [ "move-symbol-ready" "move-symbol-held" "move-symbol-rejected" ]; }
        { transform_name = "remove-edge";
          owner_file = "stdlib/lib/gate/code-transform/remove-edge.px";
          verdict_family = [ "remove-edge-ready" "remove-edge-held" "remove-edge-rejected" ]; }
        { transform_name = "remove-node";
          owner_file = "stdlib/lib/gate/code-transform/remove-node.px";
          verdict_family = [ "remove-node-ready" "remove-node-held" "remove-node-rejected" ]; }
        { transform_name = "remove-unused-import";
