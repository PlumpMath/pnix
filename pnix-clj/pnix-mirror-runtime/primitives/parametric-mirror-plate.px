# pnix-mirror-runtime.primitives.parametric-mirror-plate
#
# OWNER-LAW (2026-05-14): the `.px` substrate's owner for the
# parametric-mirror-plate axis. The mirror axiom
# (`project-wiki/maps/ankh-macro-mirror-turn-axiom.md`) and the
# parametric-mirror-plate sync notes state:
#
#   "a mirror is also read as a proof-template-like plate. A
#    mathematical proof template has slots for assumptions,
#    variables, constraints, transformations, and verification
#    obligations; a mirror has analogous runtime slots for
#    ContextualFact, lens, owner-law, capability route,
#    parameters, and receipts."
#
# Until this owner landed, the four learned-overlay rows
# (intent / operation / parameter / fact-cue) were the only
# substrate-side handles on parametric mirrors. Those are
# row-level metadata. This owner is the first `.px` lane that
# makes the *plate itself* — its slot inventory, missing-slot
# detection, instantiation and application — first-class data.
#
# # Slots
#
# The plate has six declared slots. None are filled at plate-
# construction time; the runtime instance receives bindings
# turn by turn.
#
#   facts            — list of ContextualFact bead refs the
#                      plate needs (recovered context atoms).
#                      Held when the required count is zero
#                      but the plate's `required_fact_count`
#                      demands more.
#   lens             — string path of the lens (interpretation
#                      surface) that reads the facts.
#   owner_law        — string path of the owner-law gate that
#                      authorises the plate's verdict.
#   capability_route — string path of the capability route that
#                      will execute the plate's effect.
#   parameters       — attrset of typed parameter slots; each
#                      key is a slot name, value is a string
#                      (the substrate refuses non-string for
#                      this v0 — full type schema lands later).
#   receipts         — list of typed-receipt refs the plate
#                      promises to emit when applied.
#
# # Plate vs. instance
#
# A plate is the schema. An instance is what you get after
# binding atoms into the plate's slots. `instantiate` returns
# either `MirrorInstance { plate, bindings, ready=true }` or
# `MirrorPlateHeld { missing_slots: [...] }`.
#
# # Apply
#
# `applyInstance instance problem` is the v0 application step.
# It accepts a `problem` attrset and returns a verdict + a
# receipt envelope. The receipt records which slot was read in
# which order, mirroring `p4-typed-receipt-stream.px` shape.
# This is a `candidate-only` receipt: no consequence-bearing
# side effects happen here; downstream owners (owner-law gate,
# capability execution) decide whether the verdict becomes a
# brain mutation. v0 keeps `apply` deterministic + pure — same
# `(instance, problem)` ⇒ same verdict.
#
# # Reverse view and meta-mirror
#
# Reverse-definition and meta-mirror pass are documented as
# next-slice frontier in `project-wiki/maps/...`. This owner
# emits the *construction trace* receipt needed to read a
# plate backward (from result → bindings → atoms → sentence)
# but does not yet expose a separate `reverseView` function.
# Meta-mirror pass is a normal mirror turn whose input is
# another mirror's plate/trace/Held state; the v0 lane is to
# treat such an input as a regular `problem` attribute.

let
  ownerName = "pnix-mirror-runtime/primitives/parametric-mirror-plate.px";

  # The canonical slot names. Sync test (when added) asserts the
  # Rust mirror's slot constants match this list verbatim.
  plateSlotNames = [
    "facts"
    "lens"
    "owner_law"
    "capability_route"
    "parameters"
    "receipts"
  ];

  # Required-slot policy. v0: all six are required for an instance
  # to be `ready=true`. Later versions may declare per-plate
  # variants where, e.g., `parameters` is empty when the plate
  # carries no operator-supplied fields. Held emits the missing
  # slot list, never silently fills.
  requiredSlots = plateSlotNames;

  # Plate verdicts. Stays byte-identical to the Rust mirror enum
  # added in `algorithm_synthesis_bridge.rs`.
  validPlateVerdicts = [
    "mirror-plate-empty"
    "mirror-instance-ready"
    "mirror-plate-held"
    "mirror-instance-applied"
    "mirror-instance-applied-held"
  ];

  # Auxiliary verdicts emitted by plate-primitive owners that build
  # *on top of* the six canonical apply verdicts above (lens dispatch,
  # lane wrappers, future owner-law/capability-route dispatch). They
  # live in the primitive so that no harness or downstream owner has
  # to re-declare their names — the primitive's inventory is the
  # single source of truth.
  auxiliaryVerdicts = [
    # v0.13-AA (2026-05-17): the intent-recognition lens entry's
    # lensVerdictName has lived in the lens registry since v0.7-A
    # but was never registered in knownVerdicts. The new
    # introspection primitive flagged it on first run as
    # `unregistered_lens_verdict`. Closing the substrate self-
    # invariant: every lens verdict name must live in knownVerdicts.
    "intent-recognition-classifier-verdict"
    "intent-recognition-mirror-plate-applied"
    "intent-recognition-mirror-plate-held"
    "mirror-plate-lens-dispatched"
    "mirror-plate-lens-dispatch-plate-held"
    "mirror-plate-lens-dispatch-unknown-lens"
    # v0.7-A (2026-05-15): 4 firewall-gate lens-dispatch verdict names
    # consumed by the gate-plate registry entries below. Each lens
    # dispatch through one of these gates emits
    # `mirror-plate-lens-dispatched` with `lens_verdict_name` set to
    # the matching entry below — kept in this inventory so harness
    # plates can validate envelopes by lens-verdict-name lookup.
    "macro-fold-gate-folded-text"
    "axis-separation-schema-verdict"
    "regression-proof-conflict-verdict"
    "owner-law-approval-verdict"
    # 2026-06-03: witness-template-mirror lens — bidirectional code↔meaning
    # lens (emit/witness/transpile), mirror-primitive lane. Registered so the
    # meta-circular mirror can dispatch NL→code analysis/codegen to it as a
    # route (ontology-examples loop). Kept in knownVerdicts so the substrate
    # self-invariant `unregistered_lens_verdict_count == 0` holds.
    "witness-template-lens-verdict"
    # 2026-06-03: canonical-meaning-mirror lens — math spoke. rule-as-data
    # canonicalForm (surface expr→canonical meaning), the math twin of the
    # witness lens. Same triangle hub (canonical meaning); registered so the
    # mirror can dispatch NL→math analysis (canonicalize/equivalent) as a route.
    "canonical-meaning-lens-verdict"
    # 2026-06-03: reasoning-dispatch-mirror lens — reasoning spoke. one entryFn
    # routes NL→reasoning to this session's reasoning owners (verify / invariant /
    # meta-verify / autonomous-improvement / type-fit / discourse / belief / EBL /
    # pipeline). mirror-primitive lane; kept in knownVerdicts so the substrate
    # self-invariant `unregistered_lens_verdict_count == 0` holds.
    "reasoning-dispatch-lens-verdict"
    # MR14 (2026-06-11): NL condition→action plan lens — algorithm.if-then
    # candidates from the nl_corpus generic-rule lane enter the mirror here.
    # Kept in knownVerdicts so `unregistered_lens_verdict_count == 0` holds.
    "condition-action-plan-verdict"
    # v0.8-A (2026-05-15): first math-domain lens. The math-definition
    # plate instantiates a registered mathematical definition,
    # returning shape + body + dependency edges + receipt vocabulary.
    # This is the substrate-side first instance of "math definitions
    # mechanically decomposed and re-assembled via mirror operations".
    "math-definition-instantiation"
    # v0.8-B (2026-05-15): math axiom lens. Distinct from
    # math-definition (an axiom is an unconditional assertion within
    # its theory; a definition is a conditional unfold). The
    # axiom-plate registry + dependent-theorem set enables the
    # substrate-side mechanical instance of reverse mathematics
    # (`reverseMathematicsImpact axiomName`).
    "math-axiom-application"
    # v0.8-C (2026-05-15): math proof verification lens. A proof is
    # an ordered sequence of plate-application steps. The proof-plate
    # walker resolves each step's `applies_name` against axiom-plate
    # or definition-plate; an unresolved reference short-circuits to
    # `held-at-step-N` with the offending name surfaced. This is the
    # substrate-side mechanical exposure of proof gaps.
    "math-proof-verification"
    # v0.8-D (2026-05-15): math theorem-store lifecycle lens.
    # Mechanically derives a theorem's lifecycle status (accepted /
    # held / candidate / rejected) from the proof verifier + the
    # counterexample registry. Status drift between proof and
    # theorem cannot happen because status is computed, not stored.
    "math-theorem-lifecycle"
    # v0.8-E (2026-05-15): meta-mirror proof checker. Takes the
    # output envelope of another mirror's plate (v0.8-C
    # verifyProofPlate) as input, performs mechanical structural
    # checks (outcome shape, step sequencing, step-kind/applies
    # consistency, held-step consistency), and emits a
    # counterexample-demand when the subject proof is held-at-step-N.
    # The concrete substrate-side instance of the CLAUDE.md
    # meta-mirror axiom in the math domain.
    "math-proof-meta-verification"
    # v0.9-A (2026-05-15): conjecture generator. Mechanical
    # enumeration of candidate conjectures by parameter substitution
    # on registered theorems. The substrate-side first instance of
    # "hidden gaps between definitions discovered via mirror
    # operations" -- v0.9-A *generates* novel-candidate rows; future
    # slices (proof search, counterexample search) judge them.
    "math-conjecture-generation"
    # v0.9-B (2026-05-15): conjecture judge. Closes the loop between
    # v0.9-A's novel-candidate emission and v0.8-E's counterexample-
    # demand mechanism. A candidate is mechanically judged
    # `verdict-true-by-registered-theorem` / `verdict-true-by-
    # equivalence` / `verdict-false-by-counterexample` / `held-for-
    # search` by registry lookup against knownTruths +
    # knownFalsehoods + knownTheorems.
    #
    # v0.10-B (2026-05-15): extended to drop into v0.10-A's
    # numeric-evaluator on registry miss. Two new inner verdicts:
    # `verdict-false-by-mechanical-counterexample` (substrate
    # computed disproof + auto-generated evidence string) and
    # `verdict-small-domain-verified` (finite-domain {0..5} hold;
    # NOT a universal proof). Lens entry and lensVerdictName
    # unchanged.
    "math-conjecture-judgment"
    # v0.9-C (2026-05-15): mechanical equivalence-class detector.
    # Groups v0.9-A candidates by byte-identical statement and
    # surfaces inverse-transformation-pair round-trips as
    # metadata. NOT a symbolic equivalence detector (no
    # commutativity / associativity / alpha-renaming).
    "math-conjecture-equivalence"
    # v0.9-D (2026-05-15): transformation pipeline (multi-step
    # composition). Extends v0.9-A's 5 transformations with 2
    # variable-rename rules (rename-n-m, rename-m-n) and produces
    # 7*7 = 49 2-step composition chains per theorem. Each chain
    # classified known / novel-candidate / no-effect /
    # no-effect-after-step1-only.
    "math-transformation-pipeline"
    # v0.9-E (2026-05-15): NL conjecture lifter. First cross-domain
    # bridge between natural-language utterances and the v0.9 math
    # lane. An utterance is exact-matched against a closed
    # pattern registry, lowered to a canonical math statement, and
    # judged in one call through v0.9-B.
    "math-nl-conjecture-lift"
    # v0.10-A (2026-05-15): symbolic numeric evaluator. First
    # actual computation primitive in the math lane. The substrate
    # parses + evaluates Peano arithmetic expressions and runs
    # universal-claim finite-domain checks, producing
    # counterexample evidence strings mechanically rather than by
    # registry lookup.
    "math-numeric-evaluation"
    # v0.10-D (2026-05-15): semantic-equivalence detector.
    # Detects byte-different statements that carry the same
    # mathematical content under alpha-rename of the universal
    # binder + commutativity of + and *. Below a full algebraic
    # simplifier; above v0.9-C's byte-identical grouping.
    #
    # v0.10-E (2026-05-15): same lens, broader fold. The
    # canonicaliser now flattens `+`/`*` chains, sorts leaves,
    # and rebuilds left-associatively, so associativity is also
    # captured. Lens entry function + lensVerdictName unchanged.
    #
    # v0.10-F: same lens, plus equation symmetry (LHS<->RHS sort).
    # v0.10-G: same lens, plus opt-in `mode = "identity-rewrite"`.
    "math-semantic-equivalence"
    # v0.10-H (2026-05-15): bounded induction evidence. Decomposes
    # v0.10-A's small-domain verdict into base-case verification +
    # finite-domain increment matching. Three outcomes:
    # induction-evidence-strong / induction-evidence-weak /
    # induction-base-failed. NOT a universal proof -- explicitly
    # finite-domain evidence that surfaces base vs step
    # responsibility.
    "math-induction-step"
    # v0.10-M (2026-05-15): mechanical counterexample registry.
    # Substrate-wide auto-derived list of v0.9-A's
    # transformation-generated novel candidates that v0.10-H
    # mechanically refutes (evidence-weak or evidence-base-failed).
    # Each row carries a substrate-built evidence string and the
    # witness n; the registry is decoupled from v0.8-D rejected
    # lifecycle.
    "math-mechanical-counterexample-registry"
    # v0.10-R (2026-05-15): disproof coverage analysis. Per-theorem
    # categorisation comparing v0.9-B's hand-registered
    # knownFalsehoods to the substrate's mechanically-discovered
    # semantic classes. Read-only audit surface; does NOT promote
    # rows between the two registries.
    "math-disproof-coverage"
    # v0.10-T (2026-05-15): discovered counterexample store.
    # Theorem-store-shaped row family for substrate-discovered
    # counterexamples. lifecycle_status = "discovered-
    # counterexample" (closed vocabulary, distinct from v0.8-D).
    # Decoupled from v0.8-D theorem-store and from v0.9-B
    # knownFalsehoods at the data level.
    "math-discovered-counterexample-store"
    # v0.13-E (2026-05-16): coding-agent candidate dispatcher
    # lens. The first coding-domain entry in the registry --
    # closes the substrate-axiom gap that v0.13-A/B/C/D left
    # open by registering NL utterance -> intent -> candidate
    # as a real `applyMirrorPlateWithLensDispatch` lane rather
    # than a direct .px import. The dispatcher unifies the
    # intent lifter + rename-symbol + remove-unused-import
    # proposers behind one lens entry.
    "coding-candidate-dispatch-verdict"
    # v0.13-F (2026-05-16): coding-agent review stage. Stage 2
    # of the 7-stage chain (candidate -> review -> apply ->
    # materialization -> verify -> rollback-handle -> rollback-
    # receipt). Decision vocabulary (approve / hold / reject)
    # mirrors RenameReviewDecision exactly; only approve carries
    # permits_apply = true. The Rust review-receipt builder stays
    # as the body; the plate decides if the chain shape is
    # reviewable before any apply path opens.
    "coding-review-stage-verdict"
    # v0.13-H (2026-05-16): coding-agent apply stage. Stage 3 of
    # the 7-stage chain. Confirms the chain shape can legally
    # produce a write (review-approved + permits_apply + repo
    # snapshot + timestamp) BEFORE any Rust IO happens. The
    # Rust apply executor stays as the body; the plate refuses
    # to authorize if any required slot is missing.
    "coding-apply-stage-verdict"
    # v0.13-I (2026-05-16): coding-agent materialization stage.
    # Stage 4 of the 7-stage chain. Validates structural shape +
    # closed vocab fields (deployment_mode in {dry-run, real-
    # write}, content_policy in {omit-content, include-content})
    # before the Rust bridge's TOCTOU + same-tenant gates run.
    "coding-materialization-stage-verdict"
    # v0.13-J (2026-05-16): coding-agent verify stage. Stage 5
    # of the 7-stage chain. Real semantic computation in plate
    # form -- deterministic per-file sha256 comparison +
    # first-mismatch identification. Drift => stage 6 rollback.
    "coding-verify-stage-verdict"
    # v0.13-K (2026-05-16): coding-agent rollback-handle stage.
    # Stage 6 of the 7-stage chain. Apply envelope + optional
    # verify envelope + initiator + timestamp -> rollback-
    # authorized. Distinguishes drift-triggered vs operator-
    # initiated rollback (drift_trigger flag).
    "coding-rollback-handle-stage-verdict"
    # v0.13-K (2026-05-16): coding-agent rollback-receipt stage.
    # Stage 7 (final) of the 7-stage chain. Rollback-authorized
    # envelope + executor + timestamp -> rollback-execution-
    # authorized. Closes the canonical chain at the plate level.
    "coding-rollback-receipt-stage-verdict"
    # v0.13-AA (2026-05-17): mirror primitive introspection.
    # The primitive's own inventory (slot names, verdict families,
    # lens registry, per-lens shape, invariants) is exposed as a
    # single envelope so substrate self-shape is replay-stable
    # without walking individual exports. Meta-circular: the
    # primitive uses its own dispatch machinery to inspect itself.
    "mirror-primitive-inventory-emitted"
    # v0.16-L (2026-05-18): emit-program-plate canonical lens.
    # The coding agent's generative source-emission plate
    # (BehaviorAtom list + per-language syntax constructor ->
    # emitted source text + project skeleton). Previously a
    # lane wrapper invoked directly by the dispatcher; now
    # reachable through generic lens dispatch with the standard
    # 6-slot plate machinery. Proves the substrate can compose
    # source code for all 12 host languages and 3 atom kinds
    # under the same plate primitive.
    "coding-emit-program"
    # v0.12-AAV (div-math, 2026-05-21): the math-kernel lens
    # verdict. math-kernel.px is the integrating capstone over
    # the 35 div-math owners; this verdict name tags every
    # applyMathKernel dispatch routed through the registry.
    "math-kernel-dispatch"
    # 2026-05-28: api-capability-substrate lens verdict.
    # Generic external-library call envelope (4 outcomes:
    # api-capability-emitted / held-unknown-library /
    # held-unknown-capability / held-non-native-host-lang).
    # User architectural directive: API libraries depend on
    # specific host languages — must work generically via
    # capability-row registry (no atom_kind explosion).
    "api-capability-substrate-result"
    # 2026-05-28: backfill — close the substrate self-consistency
    # invariant (`unregistered_lens_verdict_count == 0`) for the
    # 18 agent-loop lens entries added without updating
    # auxiliaryVerdicts. Each name is the lensVerdictName of one
    # entry in mirrorPlateLensRegistry from the agent-loop / patch-
    # plate work landed by parallel sessions.
    "agent-add-import-finder-result"
    "agent-test-stub-finder-result"
    "agent-verifier-result"
    "agent-auto-repair-orchestrator-result"
    "agent-failure-parser-result"
    "agent-held-gap-summarizer-result"
    "agent-loop-driver-result"
    "agent-multi-file-rename-result"
    "agent-patch-batch-plan-result"
    "agent-patch-ir-result"
    "agent-patch-preview-result"
    "agent-recipe-promotion-result"
    "agent-unused-import-finder-result"
    "agent-rename-finder-result"
    "agent-repair-decider-result"
    "agent-repair-policy-result"
    "agent-repo-scan-result"
    "agent-task-intake-result"
    "agent-patch-applier-result"
    # 2026-05-28: 5 axiom owners (Designed → Embedded transition).
    # Lens registry 등록 + auxiliaryVerdicts backfill 으로 substrate
    # self-consistency invariant `unregistered_lens_verdict_count==0`
    # 보존. CLAUDE.md "Mirror primitive introspection convergence
    # axiom (2026-05-17)" 충족.
    "internal-receipt-bundle-result"
    "parametric-diagram-cache-and-inference-result"
    "universal-conversion-result"
    "math-to-algorithm-to-nl-result"
    "implicit-explicit-reconstruction-result"
    # 2026-05-28 (follow-up): 10 more axiom owners → Embedded.
    # Cyc 원석 4-piece + 합동 + 시간 + 어원 + NL math congruence.
    "ambient-space-result"
    "morphism-result"
    "invariant-result"
    "second-order-lift-result"
    "congruence-criteria-result"
    "congruence-to-code-bridge-result"
    "fact-temporality-result"
    "equation-solving-result"
    "etymology-layer-result"
    "math-congruence-nl-lifter-result"
    # 2026-06-06: lift-witness-turn-graph — D8 symbolic-AI turn closure.
    # NL → emit → witness → pnix sequence → inverse NL + code re-witness.
    # Parallel to witness-template-mirror (atom-level) and math-to-algorithm-
    # to-nl (math-fact-level); this lens closes the *generated algorithm code*
    # round-trip lane with typed graph_stages construction trace.
    "lift-witness-turn-graph-result"
  ];

  # Full closed inventory = canonical + auxiliary. Harness primitives
  # consult this list when validating an envelope's verdict.
  knownVerdicts = validPlateVerdicts ++ auxiliaryVerdicts;

  # Build an empty plate with a caller-chosen id and no bindings.
  mkMirrorRoom = plate_id:
    {
      plate_id = plate_id;
      bindings = {};
      verdict = "mirror-plate-empty";
      missing_slots = plateSlotNames;
    };

  # Bind a single slot. Substrate refuses unknown slot names
  # rather than silently storing them. Returns the new plate
  # with the slot added to `bindings` and removed from
  # `missing_slots`.
  # S3 perf slice (2026-05-21): the `attrNames + length` half of
  # the readiness check is analytically equivalent to
  # `length newMissing == 0` under bindSlot's filter semantics
  # (rebinding an existing slot leaves missing_slots unchanged, so
  # missing_slots can only hit 0 after every plate slot has been
  # bound at least once -- which is exactly when attrNames length
  # matches plateSlotNames length). Dropping the redundant check
  # saves one `attrNames` + one `length` per binding step. External
  # callers receive the same `mirror-instance-ready` /
  # `mirror-plate-empty` verdict.
  bindSlot = plate: slot_name: value:
    if !(builtins.elem slot_name plateSlotNames) then
      throw "parametric mirror plate refuses unknown slot `${slot_name}` (known slots: ${builtins.concatStringsSep ", " plateSlotNames})"
    else
      let
        newBindings = plate.bindings // { "${slot_name}" = value; };
        newMissing =
          builtins.filter (s: s != slot_name) plate.missing_slots;
        ready = builtins.length newMissing == 0;
      in plate // {
        bindings = newBindings;
        missing_slots = newMissing;
        verdict =
          if ready then "mirror-instance-ready"
          else "mirror-plate-empty";
      };

  # List currently unbound required slots. v0 is a passthrough of
  # `plate.missing_slots`, exposed as a function so future
  # versions can compute it from per-plate policy without
  # rewriting callers.
  missingSlots = plate:
    if plate ? missing_slots then plate.missing_slots else plateSlotNames;

  # Try to instantiate the plate by folding a list of atom
  # bindings into it. `atoms` is a list of `{ slot, value }`
  # attrsets. Unknown slot names raise (same policy as
  # `bindSlot`); missing required slots → `mirror-plate-held`.
  #
  # S3 perf slice (2026-05-21): the foldl' previously called
  # `bindSlot` per atom, which rebuilt `plate`'s attrset 6 times,
  # filtered missing_slots 6 times, walked attrNames 6 times, and
  # reassigned verdict 6 times -- per dispatch. The body below
  # collapses that into one bindings build (still using `//` per
  # atom for last-wins semantics, but on the bindings attrset
  # rather than the full plate), one final missing_slots filter,
  # and one final plate merge. Throw timing and message texts
  # are byte-identical to the original (same first-invalid-atom
  # short-circuit). External `bindSlot` is unchanged.
  instantiate = plate: atoms:
    let
      newBindings =
        builtins.foldl'
          (acc: atom:
            if !(atom ? slot) || !(atom ? value) then
              throw "parametric mirror plate atom MUST carry `slot` and `value` keys"
            else if !(builtins.elem atom.slot plateSlotNames) then
              throw "parametric mirror plate refuses unknown slot `${atom.slot}` (known slots: ${builtins.concatStringsSep ", " plateSlotNames})"
            else
              acc // { "${atom.slot}" = atom.value; })
          {}
          atoms;
      newMissing =
        builtins.filter
          (s: !(builtins.hasAttr s newBindings))
          plateSlotNames;
      isReady = builtins.length newMissing == 0;
    in
      if isReady then
        plate // {
          bindings = newBindings;
          missing_slots = newMissing;
          verdict = "mirror-instance-ready";
        }
      else
        plate // {
          bindings = newBindings;
          missing_slots = newMissing;
          verdict = "mirror-plate-held";
          held_reason =
            "missing required slots: "
            + builtins.concatStringsSep ", " newMissing;
        };

  # Apply a ready instance to a problem attrset. v0 produces a
  # deterministic verdict + a construction-trace receipt that
  # names which slot was read in which order. The trace is the
  # raw material for the reverse-definition view (frontier).
  #
  # The substrate does NOT yet evaluate `lens` / `owner_law` /
  # `capability_route` as functions — those are paths stored as
  # strings, and the future runtime adapter will dispatch on
  # them. v0's job is to make the plate→instance→application
  # data plumbing first-class.
  applyInstance = instance: problem:
    if instance.verdict != "mirror-instance-ready" then {
      verdict = "mirror-instance-applied-held";
      held_reason =
        "cannot apply: instance verdict is `${instance.verdict}`";
      construction_trace = [];
      problem_keys = if builtins.isAttrs problem then builtins.attrNames problem else [];
    }
    else
      let
        # Construction trace: every slot value referenced in
        # the order it was declared in `plateSlotNames`. This
        # lets `reverseView` (frontier) walk from result back
        # to the sentence's atom bindings.
        trace =
          builtins.map
            (slot: {
              step = slot;
              bound_value_repr =
                let
                  v =
                    if instance.bindings ? "${slot}"
                    then instance.bindings."${slot}"
                    else null;
                in
                  if builtins.isString v then v
                  else if builtins.isAttrs v then "<attrset>"
                  else if builtins.isList v then "<list>"
                  else "<other>";
            })
            plateSlotNames;
      in {
        verdict = "mirror-instance-applied";
        plate_id = instance.plate_id;
        construction_trace = trace;
        problem_keys = if builtins.isAttrs problem then builtins.attrNames problem else [];
        receipt_envelope_kind = "parametric-mirror-plate-application";
      };

  # First plate re-expression of an existing legacy lane:
  # intent-recognition. This is intentionally narrow. It proves the
  # classifier can be reached *through* a ready mirror plate instance
  # while preserving the legacy `.px` classifier verdict byte-for-byte.
  #
  # `intent_owner_path` is a path expression supplied by the caller:
  #   applyIntentRecognitionPlateAt ./intent-recognition.px instance problem
  #
  # v0 slot convention:
  #   facts      = JSON list of fired signal strings
  #   parameters = JSON attrset, at minimum `{ utterance = "..."; }`
  #
  # If the plate is Held, no classifier is called. The returned held
  # envelope proves the plate is now on the critical path.
  #
  # 2026-05-17: historical compatibility wrapper. New public substrate
  # lanes should register in `mirrorPlateLensRegistry` and enter through
  # `applyMirrorPlateWithLensDispatch`; this function remains only to
  # preserve/export-test the first lane re-expression.
  applyIntentRecognitionPlateAt = intent_owner_path: instance: problem:
    let
      plate_application = applyInstance instance problem;
    in
      if plate_application.verdict != "mirror-instance-applied" then {
        verdict = "intent-recognition-mirror-plate-held";
        plate_id =
          if instance ? plate_id then instance.plate_id else null;
        plate_application = plate_application;
        classifier_verdict = null;
        reason = "intent-recognition plate did not apply; classifier not called";
      }
      else
        let
          intent = import intent_owner_path;
          rawFacts = builtins.fromJSON instance.bindings.facts;
          rawParams = builtins.fromJSON instance.bindings.parameters;
          params = if builtins.isAttrs rawParams then rawParams else {};
          firedSignals =
            if params ? fired_signals then params.fired_signals
            else if builtins.isList rawFacts then rawFacts
            else [];
          request = {
            utterance =
              if params ? utterance then params.utterance
              else if problem ? utterance then problem.utterance
              else "";
            fired_signals = firedSignals;
          };
          classifier_verdict = intent.classify request;
        in {
          verdict = "intent-recognition-mirror-plate-applied";
          plate_id = instance.plate_id;
          request = request;
          plate_application = plate_application;
          construction_trace = plate_application.construction_trace;
          classifier_verdict = classifier_verdict;
          legacy_equivalence_target =
            "intent-recognition.px::classify";
        };

  # Lens slot runtime dispatch registry.
  #
  # Background: when the legacy lane re-expression for
  # intent-recognition landed, the lens slot was a cosmetic string
  # path — the actual classifier was reached by a wrapper
  # (`applyIntentRecognitionPlateAt`) that hard-coded an `import` of
  # the intent owner. That meant the `lens` slot was on the
  # construction trace but not yet on the *critical path*: changing
  # the lens slot string would not have changed which classifier
  # was called.
  #
  # This registry makes the lens slot load-bearing. The lens path
  # string stored in `instance.bindings.lens` is looked up here;
  # the entry declares which `.px` owner to import, which function
  # to call, and how to build the lens's request attrset from the
  # plate's slot bindings + the turn's `problem`.
  #
  # v0 has one entry — the intent-recognition lane — so we can
  # prove byte-equivalence with the existing wrapper before
  # generalising. Adding a new lens lane = one entry here, no Rust
  # change, no new wrapper function. Unknown lens paths Hold with
  # the offending path on the receipt — silent fallback is refused.
  mirrorPlateLensRegistry = {
    "stdlib/lib/gate/algorithm-synthesis/intent-recognition.px" = {
      lensOwner =
        import ../../stdlib/lib/gate/algorithm-synthesis/intent-recognition.px;
      entryFn = "classify";
      lensVerdictName = "intent-recognition-classifier-verdict";
      legacyEquivalenceTarget =
        "intent-recognition.px::classify";
      # v0.13-ZZZ: lens lifecycle metadata.
      lifecycle = {
        created_in_slice = "v0.7-A";
      };
      # v0.13-DD/VV/WW witnesses. v0.13-JJJ + v0.13-MMM:
      # positive + held witnesses live in doghouse-core's
      # `intent_recognition_mirror_plate_instance.rs` (first
      # plate-instance proof slice); cross-validator scans that
      # file in addition to meta_circular_smoke.rs and the
      # firewall_gate_plate_dispatch.rs file. negative + replay
      # ratchets live in meta_circular_smoke.rs directly.
      coverage = {
        positive_ratchet = true;
        held_ratchet = true;
        negative_ratchet = true;
        replay_determinism_ratchet = true;
        coverage_witnesses = {
          positive = "intent_plate_ready_verdict_matches_direct_classifier_byte_for_byte";
          held = "intent_plate_held_verdict_matches_direct_classifier_byte_for_byte";
          negative = "meta_circular_intent_recognition_negative_ratchet_invalid_hint_rejected_native_on_pnixc_meta";
          replay_determinism = "meta_circular_intent_recognition_replay_determinism_ratchet_native_on_pnixc_meta";
        };
      };
      # Build the classifier's request attrset from plate bindings
      # + problem. Same projection logic the legacy wrapper uses,
      # now pulled into the registry so the lens slot is what
      # selects it.
      requestBuilder = bindings: problem:
        let
          rawFacts =
            if bindings ? facts && builtins.isString bindings.facts
            then builtins.fromJSON bindings.facts
            else [];
          rawParams =
            if bindings ? parameters && builtins.isString bindings.parameters
            then builtins.fromJSON bindings.parameters
            else {};
          params =
            if builtins.isAttrs rawParams then rawParams else {};
          firedSignals =
            if params ? fired_signals then params.fired_signals
            else if builtins.isList rawFacts then rawFacts
            else [];
        in {
          utterance =
            if params ? utterance then params.utterance
            else if problem ? utterance then problem.utterance
            else "";
          fired_signals = firedSignals;
        };
    };

    # 2026-06-03: witness-template-mirror — bidirectional code↔meaning lens.
    #
    # One canonical-atom-keyed template drives emit (meaning→code), witness
    # (code→meaning), and transpile (code→canonical→code), data-driven over
    # both language and atom-kind axes (langTemplates + kindSpecs). Registering
    # it here makes the meta-circular mirror able to *dispatch* NL-driven code
    # analysis / generation / transpilation to it as a route, with the plate's
    # construction_trace as the receipt (ontology-examples loop). Lane:
    # mirror-primitive (path is stdlib/lib/agent/...). entryFn `mirrorDispatch`
    # takes the parsed `parameters` slot { op; lang; code; from; to; kind; holes }.
    "stdlib/lib/agent/witness-template-mirror.px" = {
      lensOwner =
        import ../../stdlib/lib/agent/witness-template-mirror.px;
      entryFn = "mirrorDispatch";
      lensVerdictName = "witness-template-lens-verdict";
      legacyEquivalenceTarget =
        "witness-template-mirror.px::{witnessByLang,emitLineFor,translateCode}";
      lifecycle = {
        created_in_slice = "2026-06-03-witness-lens-fold-into-mirror";
      };
      coverage = {
        positive_ratchet = true;
        held_ratchet = false;
        held_applicable = false;
        negative_ratchet = false;
        negative_applicable = false;
        replay_determinism_ratchet = true;
        coverage_witnesses = {
          positive = "witness_template_lens_dispatch_via_pnixc_meta";
          held = null;
          negative = null;
          replay_determinism = "witness_template_lens_self_conformance_clean";
        };
      };
      # parameters slot = JSON-encoded request attrset; pass it through.
      requestBuilder = bindings: problem:
        let raw =
          if bindings ? parameters && builtins.isString bindings.parameters
          then builtins.fromJSON bindings.parameters
          else {};
        in if builtins.isAttrs raw then raw else {};
    };

    # 2026-06-03: canonical-meaning-mirror — math spoke (rule-as-data
    # canonicalForm). The math twin of the witness lens: surface expr →
    # canonical meaning via a DATA rule set. Registered so the mirror dispatches
    # NL→math analysis (canonicalize / equivalent) as a route. Lane:
    # mirror-primitive. entryFn `mirrorDispatch` takes the parsed parameters
    # slot { op="canonicalize"|"equivalent"; expr | a,b }.
    "stdlib/lib/agent/canonical-meaning-mirror.px" = {
      lensOwner =
        import ../../stdlib/lib/agent/canonical-meaning-mirror.px;
      entryFn = "mirrorDispatch";
      lensVerdictName = "canonical-meaning-lens-verdict";
      legacyEquivalenceTarget =
        "canonical-meaning-mirror.px::{canonicalString,equivalent}";
      lifecycle = {
        created_in_slice = "2026-06-03-math-spoke-fold-into-mirror";
      };
      coverage = {
        positive_ratchet = true;
        held_ratchet = false;
        held_applicable = false;
        negative_ratchet = false;
        negative_applicable = false;
        replay_determinism_ratchet = true;
        coverage_witnesses = {
          positive = "canonical_meaning_lens_dispatch_via_pnixc_meta";
          held = null;
          negative = null;
          replay_determinism = "canonical_meaning_lens_rule_as_data";
        };
      };
      requestBuilder = bindings: problem:
        let raw =
          if bindings ? parameters && builtins.isString bindings.parameters
          then builtins.fromJSON bindings.parameters
          else {};
        in if builtins.isAttrs raw then raw else {};
    };

    # 2026-06-03: reasoning-dispatch-mirror — reasoning spoke. ONE mirrorDispatch
    # entryFn routes NL→reasoning to this session's reasoning owners (search-
    # verify, invariant-spec, abstract-interpretation, meta-verify, autonomous-
    # improvement, type-fit-lattice, discourse-context, belief-revision, route-
    # generalization, coding-task-pipeline, general-utterance) by req.op. Lets the
    # mirror dispatch NL-driven verify / check / audit / learn / type-fit / coref /
    # plan as routes, with the plate trace as receipt (ontology-examples loop).
    # Lane: mirror-primitive (path stdlib/lib/agent/...).
    # MR14 (2026-06-11): NL condition→action plan lens. The nl_corpus
    # generic-rule lane (cue stream → rule rows) lifts Korean
    # condition→action sentences into `algorithm.if-then` candidates;
    # THIS lens is where those candidates enter the mirror. Registration
    # is the self-identity move: the handoff becomes a row of the
    # substrate's own introspectable inventory (self-audit), not merely
    # an operator display. Verdicts are candidate-only plans gated on
    # `execution-approval-gate` downstream — never direct effects.
    "stdlib/lib/nl/condition-action-plan.px" = {
