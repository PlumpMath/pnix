  };

  # Generic lens-slot dispatch. This is the substrate-side
  # mechanical AGI shape: the plate primitive itself decides which
  # lens to call, by reading the `lens` slot from a ready
  # instance, looking it up in `mirrorPlateLensRegistry`, and
  # invoking the registered entry function with a registry-built
  # request. There is no lane-specific code in this function — the
  # same dispatch is what every legacy lane will be routed
  # through.
  #
  # Verdict shape (kept distinct from `applyIntentRecognitionPlateAt`
  # so the generic envelope is observable):
  #   - applyInstance Held → `mirror-plate-lens-dispatch-plate-held`
  #   - lens not in registry → `mirror-plate-lens-dispatch-unknown-lens`
  #   - dispatch succeeded → `mirror-plate-lens-dispatched`
  #
  # The dispatched envelope carries:
  #   plate_id, lens_path, lens_entry_fn, request,
  #   plate_application (the underlying apply receipt),
  #   construction_trace, lens_result (the lens entry function's
  #   return value), legacy_equivalence_target (so byte-equivalence
  #   tests can match this generic shape to lane-specific
  #   wrappers).
  applyMirrorPlateWithLensDispatch = instance: problem:
    let
      plate_application = applyInstance instance problem;
    in
      if plate_application.verdict != "mirror-instance-applied" then {
        verdict = "mirror-plate-lens-dispatch-plate-held";
        plate_id =
          if instance ? plate_id then instance.plate_id else null;
        plate_application = plate_application;
        lens_path = null;
        lens_result = null;
        reason =
          "lens dispatch refused: plate not ready (verdict=`${plate_application.verdict}`)";
      }
      else
        let
          lens_path =
            if instance.bindings ? lens
              && builtins.isString instance.bindings.lens
            then instance.bindings.lens
            else null;
        in
          if lens_path == null then {
            verdict = "mirror-plate-lens-dispatch-unknown-lens";
            plate_id = instance.plate_id;
            plate_application = plate_application;
            lens_path = null;
            lens_result = null;
            reason =
              "lens slot missing or non-string; dispatch refused";
          }
          else if !(builtins.hasAttr lens_path mirrorPlateLensRegistry) then {
            verdict = "mirror-plate-lens-dispatch-unknown-lens";
            plate_id = instance.plate_id;
            plate_application = plate_application;
            lens_path = lens_path;
            lens_result = null;
            registered_lens_paths =
              builtins.attrNames mirrorPlateLensRegistry;
            reason =
              "lens path `${lens_path}` is not in mirrorPlateLensRegistry; refusing silent fallback";
          }
          else
            let
              entry = builtins.getAttr lens_path mirrorPlateLensRegistry;
              request = entry.requestBuilder instance.bindings problem;
              lens_result = entry.lensOwner."${entry.entryFn}" request;
            in {
              verdict = "mirror-plate-lens-dispatched";
              plate_id = instance.plate_id;
              lens_path = lens_path;
              lens_entry_fn = entry.entryFn;
              request = request;
              plate_application = plate_application;
              construction_trace = plate_application.construction_trace;
              lens_result = lens_result;
              lens_verdict_name = entry.lensVerdictName;
              legacy_equivalence_target = entry.legacyEquivalenceTarget;
            };

  plateInvariants = {
    no_silent_slot_fill =
      "unknown slot names raise; missing required slots are Held with the list — never silently filled";
    deterministic_apply =
      "same (instance, problem) ⇒ same applyInstance verdict and construction_trace";
    candidate_only_apply =
      "applyInstance emits a candidate-only receipt; no consequence-bearing side effects happen in v0";
    trace_orders_slots =
      "construction_trace walks `plateSlotNames` in declared order so reverse-definition view (frontier) can read result → bindings → atoms by reversing the trace list";
    lens_slot_load_bearing =
      "applyMirrorPlateWithLensDispatch looks up `instance.bindings.lens` in mirrorPlateLensRegistry; unknown lens paths Hold instead of silently falling back to a default lens";
  };

  # v0.13-AA (2026-05-17, owner-law/constitution): mirror primitive
  # introspection. The primitive's own inventory -- slot names,
  # canonical/auxiliary/known verdict families, lens registry,
  # per-lens (owner path, entry function, lens verdict name),
  # plate invariants -- is exposed as a single envelope so harness
  # / cockpit / external audit can read substrate self-shape
  # without walking individual exports.
  #
  # Convergence direction (2026-05-17 owner directive):
  # *all* future substrate work converges on mirror primitive
  # introspection. Lens row additions / verdict family extensions
  # / harness coverage / plate-slot evolution are visible here in
  # one envelope. This is the meta-circular surface that lets
  # substrate self-audit be replay-stable and decisive instead of
  # walking N independent surfaces.
  # v0.13-BB (2026-05-17): harness primitive inventory declared
  # as static constants -- the harness owner
  # (mirror-plate-test-harness.px) is itself a parametric function
  # `plate: ...` that takes the plate primitive as an argument, so
  # importing it back into the plate primitive would be circular.
  # The harness contract is stable; mirroring its inventory here
  # keeps the introspection envelope decisive without circular
  # import. Drift between this declared inventory and the real
  # harness primitive is caught by the v0.13-BB harness self-
  # consistency ratchet (planned next slice).
  harnessOwnerPath =
    "pnix-mirror-runtime/primitives/mirror-plate-test-harness.px";
  harnessOpInventory = [
    "assertPlatesEquivalent"
    "assertHeldShape"
    "assertInventoryClosed"
    "assertPlateApplyShape"
  ];
  harnessVerdictInventory = [
    "harness-pass"
    "harness-held"
    "harness-fail"
  ];
  harnessInvariantInventory = [
    "harness_is_plate_first"
    "malformed_input_path"
    "no_lane_specific_knowledge"
    "rust_assertion_scope"
    "verdicts_are_inventory"
  ];

  introspectMirrorPrimitiveInventory = _:
    let
      lensNames =
        builtins.sort (a: b: a < b)
          (builtins.attrNames mirrorPlateLensRegistry);
      perLens = builtins.map (n:
        # Use getAttr (not .${n}) because keys like
        # "pnix-mirror-runtime/.../*.px" contain `.px` which the
        # host parser would otherwise treat as nested attr access.
        let entry = builtins.getAttr n mirrorPlateLensRegistry;
        in {
          lens_name = n;
          owner_path = entry.lensOwner;
          entry_fn = entry.entryFn;
          lens_verdict_name = entry.lensVerdictName;
          # v0.13-DD: declared ratchet coverage. `null` when the
          # lens entry has not declared its coverage yet (the
          # substrate's progress signal -- adding new declarations
          # decreases the undeclared count).
          # v0.13-NN: optional `applicable` flags per ratchet type
          # let lens entries declare that a ratchet path doesn't
          # exist by design (e.g. dispatchers have no negative
          # outcome -- they route or Held only). N/A ratchets count
          # as satisfied for coverage-complete classification.
          # Default applicable=true if omitted.
          coverage =
            if entry ? coverage then
              let
                c = entry.coverage;
                posApp = if c ? positive_applicable then c.positive_applicable else true;
                heldApp = if c ? held_applicable then c.held_applicable else true;
                negApp = if c ? negative_applicable then c.negative_applicable else true;
                replayApp = if c ? replay_applicable then c.replay_applicable else true;
                # Ratchet considered satisfied if either declared
                # true OR declared N/A (applicable=false).
                posSat = (!posApp) || c.positive_ratchet;
                heldSat = (!heldApp) || c.held_ratchet;
                negSat = (!negApp) || c.negative_ratchet;
                replaySat = (!replayApp) || c.replay_determinism_ratchet;
              in {
                positive_ratchet = c.positive_ratchet;
                held_ratchet = c.held_ratchet;
                negative_ratchet = c.negative_ratchet;
                replay_determinism_ratchet = c.replay_determinism_ratchet;
                positive_applicable = posApp;
                held_applicable = heldApp;
                negative_applicable = negApp;
                replay_applicable = replayApp;
                status =
                  if posSat && heldSat && negSat && replaySat
                  then "coverage-complete"
                  else "coverage-incomplete";
                # v0.13-FFF: declared witness ratchet names.
                # Null when the lens hasn't declared witnesses yet.
                witnesses =
                  if c ? coverage_witnesses
                  then c.coverage_witnesses
                  else null;
              }
            else null;
        }) lensNames;
      lensVerdictNamesInRegistry =
        builtins.map (l: l.lens_verdict_name) perLens;
      # Cross-check: every lens's declared verdict name must live
      # in the primitive's knownVerdicts inventory. Hits == 0 is
      # the substrate self-consistency invariant.
      unregisteredLensVerdicts = builtins.filter
        (n: !(builtins.elem n knownVerdicts))
        lensVerdictNamesInRegistry;
      # v0.13-CC (2026-05-17): lens-verdict uniqueness + reverse
      # emitter map. Substrate self-invariant: no two lenses
      # declare the same lens_verdict_name (that would make the
      # verdict ambiguous between two dispatch paths).
      countOccurrences = name:
        builtins.length
          (builtins.filter (n: n == name) lensVerdictNamesInRegistry);
      duplicateLensVerdicts =
        # Unique names whose occurrence count > 1.
        let
          uniqueNames =
            builtins.filter
              (n:
                # Keep only the FIRST occurrence to dedup.
                let
                  prefix = builtins.head
                    (builtins.split n
                      (builtins.concatStringsSep "|"
                        lensVerdictNamesInRegistry));
                in true)
              lensVerdictNamesInRegistry;
          # Simpler: just walk knownVerdicts and check who has count > 1.
          dups = builtins.filter (n: countOccurrences n > 1)
            knownVerdicts;
        in dups;
      # v0.13-CC: emitter classification per verdict. Verdicts
      # can be emitted by (a) the plate primitive itself
      # (canonical verdicts from mkMirrorRoom / instantiate /
      # applyInstance), (b) the generic lens dispatcher
      # (`applyMirrorPlateWithLensDispatch` emits 3 specific
      # auxiliary verdicts), (c) a lane-specific wrapper like
      # `applyIntentRecognitionPlateAt`, or (d) a registered lens
      # entry. The substrate self-invariant is: every
      # knownVerdict has at least ONE declared emitter category.
      dispatcherEmittedVerdicts = [
        "mirror-plate-lens-dispatched"
        "mirror-plate-lens-dispatch-plate-held"
        "mirror-plate-lens-dispatch-unknown-lens"
      ];
      wrapperEmittedVerdicts = [
        "intent-recognition-mirror-plate-applied"
        "intent-recognition-mirror-plate-held"
      ];
      # Truly orphan auxiliary verdicts: in knownVerdicts (auxiliary
      # family) but NOT emitted by lens / dispatcher / wrapper.
      # Substrate self-invariant: empty list.
      orphanAuxiliaryVerdicts = builtins.filter
        (v:
          !(builtins.elem v lensVerdictNamesInRegistry)
            && !(builtins.elem v dispatcherEmittedVerdicts)
            && !(builtins.elem v wrapperEmittedVerdicts))
        auxiliaryVerdicts;
      invariantNames =
        builtins.sort (a: b: a < b)
          (builtins.attrNames plateInvariants);
      # v0.13-BB: harness inventory pulled from static declarations
      # above (circular-import safe).
      harnessOpNames = harnessOpInventory;
      harnessInvariantNames = harnessInvariantInventory;
      # v0.13-CCC (2026-05-17): lane-grouping. Classify each lens
      # by its owner path prefix into stable substrate lanes:
      # coding / gate / math / mirror-primitive (the self lens).
      classifyLane = lensName:
        if builtins.length (builtins.split "^stdlib/lib/coding/" lensName) > 1
          then "coding"
        else if builtins.length (builtins.split "^stdlib/lib/gate/" lensName) > 1
          then "gate"
        else if builtins.length (builtins.split "^stdlib/lib/math/" lensName) > 1
          then "math"
        else "mirror-primitive";
      lensesByLane = lane:
        builtins.filter (l: classifyLane l.lens_name == lane) perLens;
      laneSummary = lane:
        let
          ls = lensesByLane lane;
          complete = builtins.filter
            (l: l.coverage != null
              && l.coverage.status == "coverage-complete") ls;
          incomplete = builtins.filter
            (l: l.coverage != null
              && l.coverage.status == "coverage-incomplete") ls;
          undeclared = builtins.filter (l: l.coverage == null) ls;
        in {
          lens_count = builtins.length ls;
          complete_count = builtins.length complete;
          incomplete_count = builtins.length incomplete;
          undeclared_count = builtins.length undeclared;
        };
      # v0.13-DDD (2026-05-17): verdict-to-emitter reverse map.
      # For each verdict name, which lens (or dispatcher / wrapper)
      # emits it? Building blocks for the rendered map below.
      lookupEmitterFor = verdict:
        # Canonical plate verdicts are emitted by the plate
        # primitive itself: mkMirrorRoom / instantiate /
        # applyInstance. The substrate's plate operations DON'T
        # need a lens or wrapper -- they are the plate's own
        # value-level verdicts.
        if builtins.elem verdict validPlateVerdicts
        then { emitter_kind = "plate-primitive";
               emitter_name = "parametric-mirror-plate.px (canonical apply chain)"; }
        else if builtins.elem verdict dispatcherEmittedVerdicts
        then { emitter_kind = "dispatcher";
               emitter_name = "applyMirrorPlateWithLensDispatch"; }
        else if builtins.elem verdict wrapperEmittedVerdicts
        then { emitter_kind = "wrapper";
               emitter_name = "applyIntentRecognitionPlateAt"; }
        else
          let
            lensHits = builtins.filter
              (l: l.lens_verdict_name == verdict) perLens;
          in
            if lensHits == [] then
              { emitter_kind = "orphan"; emitter_name = null; }
            else
              { emitter_kind = "lens";
                emitter_name = (builtins.head lensHits).lens_name; };
      verdictToEmitterRows = builtins.map (v:
        let e = lookupEmitterFor v;
        in {
          verdict_name = v;
          emitter_kind = e.emitter_kind;
          emitter_name = e.emitter_name;
        }) knownVerdicts;
      # v0.13-EE (2026-05-17): next-frontier signal building blocks.
      # Defined in let-block (NOT in output attrset) so they can
      # reference each other.
      undeclaredLenses =
        builtins.filter (l: l.coverage == null) perLens;
      incompleteLenses =
        builtins.filter
          (l: l.coverage != null
            && l.coverage.status == "coverage-incomplete")
          perLens;
      firstUndeclaredName =
        if undeclaredLenses == [] then null
        else (builtins.head undeclaredLenses).lens_name;
      firstIncomplete =
        if incompleteLenses == [] then null
        else builtins.head incompleteLenses;
      firstIncompleteMissing =
        if firstIncomplete == null then []
        else
          let c = firstIncomplete.coverage;
          in builtins.filter (n: n != null) [
            # v0.13-NN: skip ratchets that are declared N/A.
            (if (!c.positive_applicable) || c.positive_ratchet then null
             else "positive_ratchet")
            (if (!c.held_applicable) || c.held_ratchet then null
             else "held_ratchet")
            (if (!c.negative_applicable) || c.negative_ratchet then null
             else "negative_ratchet")
            (if (!c.replay_applicable) || c.replay_determinism_ratchet then null
             else "replay_determinism_ratchet")
          ];
      priorityActions = builtins.filter (a: a != null) [
        (if firstUndeclaredName == null then null
         else "declare-coverage-for-${firstUndeclaredName}")
        (if firstIncomplete == null then null
         else "add-${
           if firstIncompleteMissing == [] then "<none>"
           else builtins.head firstIncompleteMissing
         }-for-${firstIncomplete.lens_name}")
      ];
      anyFrontierOpen =
        firstUndeclaredName != null || firstIncomplete != null;
    in rec {
      outcome = "mirror-primitive-inventory-emitted";
      primitive_owner = ownerName;
      # v0.13-BB: transport metadata. canonical = pnixc-meta native;
      # bridge-debt paths are the legacy transports listed in
      # CLAUDE.md::"historical bridge-debt transports" that should
      # converge onto pnixc-meta canonical runner.
      canonical_transport = "pnixc-meta-native";
      native_dispatch_supported = true;
      bridge_debt_paths = [
        "pnix-query-px-eval"
        "pnix_eval::eval_to_json"
        "apply_mirror_plate_via_lens_dispatch_via_px_substrate"
      ];
      bridge_debt_count = 3;
      # v0.13-EEE (2026-05-17): bridge-debt caller-count baseline.
      # Substrate-declared baselines from measurement at the
      # v0.13-EEE slice. Each future slice that migrates a
      # caller to pnixc-meta-native or retires a path lowers the
      # actual count; the host-side cross-check ratchet can pin
      # "actual <= baseline" (monotonic shrink toward 0).
      bridge_debt_caller_baseline = [
        {
          path = "pnix_eval::eval_to_json";
          measured_in_file =
            "crates/doghouse-core/src/algorithm_synthesis_bridge.rs";
          baseline_caller_count = 32;
        }
        {
          path = "apply_mirror_plate_via_lens_dispatch_via_px_substrate";
          measured_in_file =
            "crates/doghouse-core/src/algorithm_synthesis_bridge.rs";
          baseline_caller_count = 14;
        }
        # pnix-query-px-eval lives in pnix-query-runtime crate +
        # standalone binary; treat as the substrate-level legacy
        # transport rather than a per-file caller count.
        {
          path = "pnix-query-px-eval";
          measured_in_file = "<crate-scope>";
          baseline_caller_count = -1;
        }
      ];
      # Slot inventory.
      plate_slot_count = builtins.length plateSlotNames;
      plate_slot_names = plateSlotNames;
      # Verdict families.
      canonical_verdict_count = builtins.length validPlateVerdicts;
      canonical_verdict_names = validPlateVerdicts;
      auxiliary_verdict_count = builtins.length auxiliaryVerdicts;
      known_verdict_count = builtins.length knownVerdicts;
      # Lens registry.
      lens_registry_count = builtins.length lensNames;
      lens_names = lensNames;
      per_lens = perLens;
      # Substrate self-consistency invariant: every registered
      # lens's verdict name lives in knownVerdicts. Empty list is
      # the closed-substrate invariant.
      unregistered_lens_verdict_count =
        builtins.length unregisteredLensVerdicts;
      unregistered_lens_verdict_names = unregisteredLensVerdicts;
      # v0.13-CC: substrate self-consistency invariant -- no two
      # lenses declare the same lens_verdict_name (otherwise the
      # verdict would be ambiguous between two dispatch paths).
      duplicate_lens_verdict_count =
        builtins.length duplicateLensVerdicts;
      duplicate_lens_verdict_names = duplicateLensVerdicts;
      # v0.13-CC: emitter classification. Each auxiliary verdict
      # has at least one declared emitter (lens / dispatcher /
      # wrapper). Empty orphan list is the closed-substrate
      # invariant.
      dispatcher_emitted_verdict_count =
        builtins.length dispatcherEmittedVerdicts;
      dispatcher_emitted_verdict_names = dispatcherEmittedVerdicts;
      wrapper_emitted_verdict_count =
        builtins.length wrapperEmittedVerdicts;
      wrapper_emitted_verdict_names = wrapperEmittedVerdicts;
      lens_emitted_verdict_count =
        builtins.length lensVerdictNamesInRegistry;
      orphan_auxiliary_verdict_count =
        builtins.length orphanAuxiliaryVerdicts;
      orphan_auxiliary_verdict_names = orphanAuxiliaryVerdicts;
      # v0.13-DD: coverage declaration progress. As more lens
      # entries declare their `coverage` attrset, declared_count
      # grows. The substrate exposes the running progress so any
      # ratchet can monotonically pin "declared >= N" and force
      # future slices to keep advancing.
      lens_with_declared_coverage_count =
        builtins.length
          (builtins.filter (l: l.coverage != null) perLens);
      lens_without_declared_coverage_count =
        builtins.length
          (builtins.filter (l: l.coverage == null) perLens);
      lens_with_complete_coverage_count =
        builtins.length
          (builtins.filter
            (l: l.coverage != null
              && l.coverage.status == "coverage-complete")
            perLens);
      lens_with_incomplete_coverage_count =
        builtins.length
          (builtins.filter
            (l: l.coverage != null
              && l.coverage.status == "coverage-incomplete")
            perLens);
      # v0.13-CCC: lane-grouped coverage summary. Each lane gets a
      # { lens_count; complete_count; incomplete_count;
      #   undeclared_count; } snapshot. Sum of lens_counts across
      # lanes = lens_registry_count.
      lens_by_lane = {
        coding = laneSummary "coding";
        gate = laneSummary "gate";
        math = laneSummary "math";
        mirror-primitive = laneSummary "mirror-primitive";
      };
      # v0.13-FFF: coverage-witness progress signal. Substrate
      # tracks how many lenses have declared ratchet names that
      # the host-side cross-validator can grep-verify. Monotonic
      # growth as future slices add witnesses.
      lens_with_declared_witnesses_count =
        builtins.length
          (builtins.filter
            (l: l.coverage != null && l.coverage.witnesses != null)
            perLens);
      lens_without_declared_witnesses_count =
        builtins.length
          (builtins.filter
            (l: l.coverage != null && l.coverage.witnesses == null)
            perLens);
      # v0.13-MMM: witness-by-path-type breakdown. For each of
      # the four coverage paths (positive / held / negative /
      # replay_determinism), how many lenses have a non-null
      # witness for that path? Plus `fully_witnessed_count` =
      # lenses where every *applicable* path has a witness
      # (N/A paths are skipped). Future slices that add held /
      # negative / replay witnesses to math lenses will move
      # these counters monotonically upward; envelope tracks
      # progress automatically.
      witnesses_by_path_type =
        let
          witnessedFor = pathKey:
            builtins.length
              (builtins.filter
                (l:
                  l.coverage != null
                    && l.coverage.witnesses != null
                    && (builtins.getAttr pathKey l.coverage.witnesses) != null)
                perLens);
        in {
          positive_witnessed_count = witnessedFor "positive";
          held_witnessed_count = witnessedFor "held";
          negative_witnessed_count = witnessedFor "negative";
          replay_determinism_witnessed_count =
            witnessedFor "replay_determinism";
          fully_witnessed_count =
            builtins.length
              (builtins.filter
                (l:
                  l.coverage != null
                    && l.coverage.witnesses != null
                    && (let
                          c = l.coverage; w = c.witnesses;
                          posOK = (!c.positive_applicable) || w.positive != null;
                          heldOK = (!c.held_applicable) || w.held != null;
                          negOK = (!c.negative_applicable) || w.negative != null;
                          replayOK = (!c.replay_applicable)
                            || w.replay_determinism != null;
                        in posOK && heldOK && negOK && replayOK))
                perLens);
        };
      # v0.13-QQQ: gap-analysis. Substrate classifies remaining
      # witness gaps by *kind* so future slices target them
      # precisely:
      #   1. needs-witness   : applicability=true, witness=null
      #   2. n-a-by-design   : applicability=false, witness=null
      #   3. inconsistency   : applicability=false, witness!=null
      #      (substrate truth drift -- MUST be 0)
      # Per-path breakdown carries lens names directly so the
      # consumer knows exactly which lens needs which path filled.
      gap_analysis =
        let
          gapForPath = pathKey:
            builtins.filter
              (l:
                let
                  c = l.coverage;
                  applicableKey =
                    if pathKey == "replay_determinism"
                    then "replay_applicable"
                    else pathKey + "_applicable";
                in c != null
                  && (builtins.getAttr applicableKey c)
                  && (c.witnesses == null
                      || (builtins.getAttr pathKey c.witnesses) == null))
              perLens;
          inconsistencyForPath = pathKey:
            builtins.filter
              (l:
                let
                  c = l.coverage;
                  applicableKey =
                    if pathKey == "replay_determinism"
                    then "replay_applicable"
                    else pathKey + "_applicable";
                in c != null
                  && (!(builtins.getAttr applicableKey c))
                  && c.witnesses != null
                  && (builtins.getAttr pathKey c.witnesses) != null)
              perLens;
          posGap = gapForPath "positive";
          heldGap = gapForPath "held";
          negGap = gapForPath "negative";
          replayGap = gapForPath "replay_determinism";
          allInconsistencies =
            (inconsistencyForPath "positive")
            ++ (inconsistencyForPath "held")
            ++ (inconsistencyForPath "negative")
            ++ (inconsistencyForPath "replay_determinism");
        in {
          needs_witness_count =
            (builtins.length posGap)
            + (builtins.length heldGap)
            + (builtins.length negGap)
            + (builtins.length replayGap);
          needs_witness_count_by_path = {
            positive = builtins.length posGap;
            held = builtins.length heldGap;
            negative = builtins.length negGap;
            replay_determinism = builtins.length replayGap;
          };
          needs_witness_by_path = {
            positive = builtins.map (l: l.lens_name) posGap;
            held = builtins.map (l: l.lens_name) heldGap;
            negative = builtins.map (l: l.lens_name) negGap;
            replay_determinism =
              builtins.map (l: l.lens_name) replayGap;
          };
          # Substrate self-invariant: MUST be 0. If non-zero,
          # an applicability flag claims the path is N/A but a
          # witness was declared anyway -- substrate truth drift.
          applicability_inconsistency_count =
            builtins.length allInconsistencies;
          applicability_inconsistency_lenses =
            builtins.map (l: l.lens_name) allInconsistencies;
        };
      # v0.13-UUU: lens dependency graph (Layer 9). Each lens
      # may declare its inter-lens imports as a `dependencies`
      # field on its registry entry. The introspection envelope
      # walks the registry and emits:
      #   - lens_dependency_edges: [{ source; target; }]
      #   - lens_dependency_edge_count: int
      #   - lens_with_dependencies_count: int (source side)
      #   - lens_in_degree: { lens_name = count of who depends
      #                       on this lens }
      # Host-side cross-validator grep-verifies each declared
      # dependency exists in the actual .px file's `import`
      # statements (substrate truth check across surfaces).
      lens_dependency_edges =
        let
          edgesPerLens = l:
            let deps =
              if (builtins.getAttr l.lens_name mirrorPlateLensRegistry) ? dependencies
              then (builtins.getAttr l.lens_name mirrorPlateLensRegistry).dependencies
              else [];
            in builtins.map (target: { source = l.lens_name; target = target; }) deps;
        in
          builtins.concatLists (builtins.map edgesPerLens perLens);
      lens_dependency_edge_count =
        builtins.length
          (builtins.concatLists
            (builtins.map
              (l:
                if (builtins.getAttr l.lens_name mirrorPlateLensRegistry) ? dependencies
                then (builtins.getAttr l.lens_name mirrorPlateLensRegistry).dependencies
                else [])
              perLens));
      lens_with_dependencies_count =
        builtins.length
          (builtins.filter
            (l:
              let
                entry = builtins.getAttr l.lens_name mirrorPlateLensRegistry;
              in entry ? dependencies && (builtins.length entry.dependencies) > 0)
            perLens);
      # v0.13-VVV: lens in-degree map + most-depended-on
      # (substrate identifies its own foundation lenses).
      # For each registered lens, count how many other lenses
      # declare it as a dependency (target side). The lens(es)
      # with maximum in-degree are the substrate's foundation
      # -- removing them would break the most dependent code.
      lens_in_degree =
        let
          allEdges =
            builtins.concatLists
              (builtins.map
                (l:
                  let
                    entry =
                      builtins.getAttr l.lens_name mirrorPlateLensRegistry;
                  in
                    if entry ? dependencies
                    then builtins.map
                      (t: { source = l.lens_name; target = t; })
                      entry.dependencies
                    else [])
                perLens);
          countTargetingEdges = targetName:
            builtins.length
              (builtins.filter
                (e: e.target == targetName)
                allEdges);
        in
          builtins.listToAttrs
            (builtins.map
              (l: {
                name = l.lens_name;
                value = countTargetingEdges l.lens_name;
              })
              perLens);
      most_depended_on_in_degree =
        let
          allEdges =
            builtins.concatLists
              (builtins.map
                (l:
                  let entry = builtins.getAttr l.lens_name mirrorPlateLensRegistry;
                  in if entry ? dependencies
                     then builtins.map (t: { source = l.lens_name; target = t; }) entry.dependencies
                     else [])
                perLens);
          inDegrees = builtins.map
            (l:
              builtins.length
                (builtins.filter (e: e.target == l.lens_name) allEdges))
            perLens;
          maxDeg = builtins.foldl' (a: b: if b > a then b else a) 0 inDegrees;
        in maxDeg;
      most_depended_on_lens_names =
        let
          allEdges =
            builtins.concatLists
              (builtins.map
                (l:
                  let entry = builtins.getAttr l.lens_name mirrorPlateLensRegistry;
                  in if entry ? dependencies
                     then builtins.map (t: { source = l.lens_name; target = t; }) entry.dependencies
                     else [])
                perLens);
          inDegFor = name:
            builtins.length
              (builtins.filter (e: e.target == name) allEdges);
          maxDeg =
            builtins.foldl'
              (a: l: let d = inDegFor l.lens_name; in if d > a then d else a)
              0 perLens;
        in
          if maxDeg == 0
          then []
          else
            builtins.map (l: l.lens_name)
              (builtins.filter
                (l: (inDegFor l.lens_name) == maxDeg)
                perLens);
      # v0.13-WWW + v0.13-XXX: transitive-closure-based fields.
      # Single source-of-truth computation; cycle-count + acyclic
      # boolean + per-lens transitive-deps + max chain depth are
      # all derived from it.
      lens_transitive_dependencies =
        let
          directDeps = name:
            let entry = builtins.getAttr name mirrorPlateLensRegistry;
            in if entry ? dependencies then entry.dependencies else [];
          uniqueList = lst:
            builtins.attrNames
              (builtins.listToAttrs
                (builtins.map (n: { name = n; value = true; }) lst));
          expandStep = curMap: name:
            let
              direct = directDeps name;
              expanded =
                builtins.concatLists
                  (builtins.map
                    (t:
                      if builtins.hasAttr t curMap
                      then builtins.getAttr t curMap
                      else [])
                    direct);
            in uniqueList (direct ++ expanded);
          initialMap =
            builtins.listToAttrs
              (builtins.map
                (l: { name = l.lens_name; value = directDeps l.lens_name; })
                perLens);
          iter = depth: m:
            if depth == 0
            then m
            else
              iter (depth - 1)
                (builtins.listToAttrs
                  (builtins.map
                    (l: { name = l.lens_name;
                          value = expandStep m l.lens_name; })
                    perLens));
        in iter (builtins.length perLens) initialMap;
      lens_dependency_cycle_count =
        builtins.length
          (builtins.filter
            (l:
              builtins.elem l.lens_name
                (builtins.getAttr l.lens_name lens_transitive_dependencies))
            perLens);
      lens_dependency_acyclic =
        (builtins.length
          (builtins.filter
            (l:
              builtins.elem l.lens_name
                (builtins.getAttr l.lens_name lens_transitive_dependencies))
            perLens)) == 0;
      # v0.13-XXX: transitive dependency closure (Layer 9
      # extension). Per-lens fully-reachable set. Combined with
      # in-degree (v0.13-VVV) this is substrate's complete view
      # of its own dependency structure. Closure field defined
      # above (v0.13-WWW); aggregates derive via rec self-ref.
      lens_transitive_dependency_count_by_lens =
        builtins.listToAttrs
          (builtins.map
            (l: {
              name = l.lens_name;
              value = builtins.length
                (builtins.getAttr l.lens_name lens_transitive_dependencies);
            })
            perLens);
      lens_max_transitive_dependency_count =
        builtins.foldl'
          (a: l:
            let n = builtins.length
              (builtins.getAttr l.lens_name lens_transitive_dependencies);
            in if n > a then n else a)
          0 perLens;
      # v0.13-YYY: lens lifecycle metadata (Layer 10).
      # Substrate tracks the slice that introduced each lens.
      # Monotonic growth as more lens entries get their
      # `lifecycle` block.
      lens_with_lifecycle_metadata_count =
        builtins.length
          (builtins.filter
            (l:
              let entry = builtins.getAttr l.lens_name mirrorPlateLensRegistry;
              in entry ? lifecycle)
            perLens);
      lens_lifecycle_metadata_by_lens =
        builtins.listToAttrs
          (builtins.map
            (l: {
              name = l.lens_name;
              value =
                let entry = builtins.getAttr l.lens_name mirrorPlateLensRegistry;
                in if entry ? lifecycle then entry.lifecycle else null;
            })
            perLens);
      lens_lifecycle_created_in_slice_inventory =
        let
          slicesWithLifecycle =
            builtins.filter
              (s: s != null)
              (builtins.map
                (l:
                  let entry = builtins.getAttr l.lens_name mirrorPlateLensRegistry;
                  in
                    if (entry ? lifecycle)
                       && (entry.lifecycle ? created_in_slice)
                    then entry.lifecycle.created_in_slice
                    else null)
                perLens);
          uniqueSlices =
            builtins.attrNames
              (builtins.listToAttrs
                (builtins.map
                  (s: { name = s; value = true; })
                  slicesWithLifecycle));
        in builtins.sort (a: b: a < b) uniqueSlices;
      # v0.13-AAAA: lifecycle distribution per lane. Substrate
      # surfaces its own *evolution velocity* — how many lenses
      # each lane introduced, and across how many distinct
      # slices. The 4 lanes are derived from `lens_by_lane`
      # (v0.13-CCC).
      # v0.13-CCCC: substrate self-invariants roster (Layer 12).
      # Substrate emits the explicit list of its own pinned
      # self-invariants. Each row: invariant_name (slug),
      # field (the envelope field the invariant is checked
      # against), expected_value (always 0 for current ones --
      # they are "must-be-zero" guards), ratchet_test_name
      # (host-side ratchet that verifies the invariant),
      # slice_introduced (when the invariant landed).
      # Host-side cross-validator (v0.13-CCCC ratchet) checks:
      #   - each invariant's actual envelope value equals expected
      #   - each named ratchet test exists in the source surface
      substrate_self_invariants = [
        {
          invariant_name = "no-orphan-verdicts";
          field = "orphan_auxiliary_verdict_count";
          expected_value = 0;
          ratchet_test_name = "meta_circular_mirror_primitive_introspection_v0_13_cc_emitter_classification_native_on_pnixc_meta";
          slice_introduced = "v0.13-CC";
          rationale = "every known verdict in the substrate must have a registered emitter";
        }
        {
          invariant_name = "no-applicability-inconsistency";
          field = "gap_analysis.applicability_inconsistency_count";
          expected_value = 0;
          ratchet_test_name = "meta_circular_mirror_primitive_introspection_v0_13_qqq_gap_analysis_self_invariant_native_on_pnixc_meta";
          slice_introduced = "v0.13-QQQ";
          rationale = "no lens may declare a witness for a path it claims is N/A by design";
        }
        {
          invariant_name = "acyclic-dependency-graph";
          field = "lens_dependency_cycle_count";
          expected_value = 0;
          ratchet_test_name = "meta_circular_mirror_primitive_introspection_v0_13_www_acyclic_dependency_invariant_native_on_pnixc_meta";
          slice_introduced = "v0.13-WWW";
          rationale = "lens registry's declared dependency graph must remain a DAG";
        }
        {
          invariant_name = "envelope-self-shape-consistency";
          field = "introspection_envelope_self_shape.declared_field_count";
          expected_value = "==builtins.length(attrNames env)";
          ratchet_test_name = "meta_circular_mirror_primitive_introspection_v0_13_bbbb_envelope_self_shape_native_on_pnixc_meta";
          slice_introduced = "v0.13-BBBB";
          rationale = "substrate's declared envelope size must match its actual attribute count";
        }
        {
          invariant_name = "chronological-layer-ordering";
          field = "introspection_layer_chronology.is_monotonic";
          expected_value = true;
          ratchet_test_name = "meta_circular_mirror_primitive_introspection_v0_13_iiii_chronological_layer_ordering_native_on_pnixc_meta";
          slice_introduced = "v0.13-IIII";
          rationale = "substrate construction is monotone — layer N's introducing slice never predates layer N-1's";
        }
        {
          invariant_name = "optimization-recognition-lossless";
          field = "substrate_optimization_recognition_is_lossless";
          expected_value = true;
          ratchet_test_name = "meta_circular_mirror_primitive_introspection_v0_13_mmmm_self_abstraction_and_optimization_native_on_pnixc_meta";
          slice_introduced = "v0.13-MMMM";
          rationale = "substrate's abstraction-recognition step must drop no member lens metadata — short-path candidates lossless at the recognition layer";
        }
        {
          invariant_name = "lane-triad-totals-match-per-lane-sums";
          field = "substrate_lane_triad_summary.cross_lane_totals.*";
          expected_value = "==sum(per_lane_*_counts)";
          ratchet_test_name = "substrate_lane_triad_summary_native_on_pnixc_meta";
          slice_introduced = "v0.14-P";
          rationale = "cross-lane meta-summary totals (owner files, dispatched lenses, helpers) must equal the sum of their per-lane source counts — the substrate's first cross-lane consistency invariant; lane summary drift becomes immediately visible";
        }
      ];
      substrate_self_invariant_count =
        builtins.length substrate_self_invariants;
      # v0.13-DDDD: layer-origin chronology. Substrate emits the
      # slice that introduced each of its 12 self-knowledge
      # layers. Cockpit-friendly view of how the introspection
      # subsystem itself was built.
      introspection_layer_origin_slice = {
        layer_1_lens_inventory      = "v0.13-AA";
        layer_2_verdict_inventory   = "v0.13-AA";
        layer_3_plate_shape         = "v0.13-AA";
        layer_4_coverage_aggregates = "v0.13-DD";
        layer_5_lane_groupings      = "v0.13-CCC";
        layer_6_bridge_debt         = "v0.13-EEE";
        layer_7_witness_breakdown   = "v0.13-MMM";
        layer_8_gap_analysis        = "v0.13-QQQ";
        layer_9_dependency_graph    = "v0.13-UUU";
        layer_10_lifecycle          = "v0.13-YYY";
        layer_11_self_shape         = "v0.13-BBBB";
        layer_12_self_invariants    = "v0.13-CCCC";
        layer_13_api_surface        = "v0.13-FFFF";
        layer_14_per_lens_unified   = "v0.13-GGGG";
        layer_15_abstraction        = "v0.13-MMMM";
        layer_16_optimization       = "v0.13-MMMM";
        layer_17_history_p0         = "v0.13-RRRR";
        layer_18_reverse_trace_p1   = "v0.13-SSSS";
        layer_19_performance_p2     = "v0.13-TTTT";
        layer_20_self_update_safety_p3 = "v0.13-UUUU";
        layer_21_external_learning_p4  = "v0.13-VVVV";
        layer_22_abstraction_p5        = "v0.13-WWWW";
        layer_23_ontology_sentences_p6 = "v0.13-XXXX";
        layer_24_roadmap_graduation    = "v0.13-YYYY";
        layer_25_freecat_cli_capability = "v0.14-A";
        layer_26_extended_owners        = "v0.14-B";
        layer_27_algo_synth_helpers     = "v0.14-C";
        layer_28_stdlib_semantic_helpers = "v0.14-D";
        layer_29_format_surfaces         = "v0.14-E";
        layer_30_stdlib_roots            = "v0.14-F";
        layer_31_absorb_brain_missed     = "v0.14-G";
        layer_32_macro_only_family       = "v0.14-H";
        layer_33_stdlib_subtrees         = "v0.14-I";
        layer_34_crate_workspace         = "v0.14-J";
        layer_35_self_runtime_stack      = "v0.14-K";
        layer_36_final_sweep             = "v0.14-L";
        layer_37_math_substrate_summary  = "v0.14-M";
        layer_38_coding_substrate_summary = "v0.14-N";
        layer_39_firewall_substrate_summary = "v0.14-O";
        layer_40_substrate_lane_triad_summary = "v0.14-P";
        layer_41_problem_solving_inventory    = "v0.14-U";
      };
      # v0.13-GGGG: per-lens unified self-knowledge view
      # (Layer 14). Each registered lens gets a single row that
      # joins ALL substrate-side metadata about it: lane,
      # verdict, coverage status, witnesses, dependencies,
      # transitive closure, in-degree, lifecycle slice. This is
      # the cross-product of the previous layers — instead of
      # 13 separate envelope fields, consumers can iterate one
      # list to see everything the substrate knows about a
      # given lens.
      per_lens_unified =
        let
          inDegFor = name:
            builtins.length
              (builtins.filter
                (e: e.target == name)
                lens_dependency_edges);
          entryFor = name:
            builtins.getAttr name mirrorPlateLensRegistry;
          coverageFor = name:
            let e = entryFor name;
            in if e ? coverage then e.coverage else null;
          witnessesFor = name:
            let c = coverageFor name;
            in if c != null && c ? coverage_witnesses
               then c.coverage_witnesses else null;
          dependsFor = name:
            let e = entryFor name;
            in if e ? dependencies then e.dependencies else [];
          lifecycleFor = name:
            let e = entryFor name;
            in if e ? lifecycle then e.lifecycle else null;
          transitiveFor = name:
            if builtins.hasAttr name lens_transitive_dependencies
            then builtins.getAttr name lens_transitive_dependencies
            else [];
        in
          builtins.map
            (l: {
              lens_name = l.lens_name;
              lane = classifyLane l.lens_name;
              verdict_name = l.lens_verdict_name;
              coverage = coverageFor l.lens_name;
              witnesses = witnessesFor l.lens_name;
              direct_dependencies = dependsFor l.lens_name;
              transitive_dependencies = transitiveFor l.lens_name;
              in_degree = inDegFor l.lens_name;
              lifecycle = lifecycleFor l.lens_name;
              is_foundation =
                builtins.elem l.lens_name most_depended_on_lens_names;
            })
            perLens;
      # v0.13-MMMM: substrate self-abstraction (lens families).
      # Substrate clusters its own lenses by *coverage shape*
      # (4-tuple of applicability flags) and emits family
      # roster + counts. This is substrate-side pattern
      # discovery — substrate finds repeated shapes across its
      # own registry without anyone telling it which lenses
      # share structure.
      #
      # Family naming: 4-char shape string (T = applicable,
      # F = N/A by design), in path order: positive / held /
      # negative / replay_determinism.
      #
      # Example families:
      #   TTTT : full-applicable (all 4 paths required)
      #   TTFF : pure-function   (no negative, no replay)
      #   TFFF : lookup-only     (positive-only)
      lens_families =
        let
          applicableTuple = row:
            let c = row.coverage;
            in
              if c == null then "----"
              else
                let
                  p = if builtins.hasAttr "positive_applicable" c
                      then c.positive_applicable else true;
                  h = if builtins.hasAttr "held_applicable" c
                      then c.held_applicable else true;
                  n = if builtins.hasAttr "negative_applicable" c
                      then c.negative_applicable else true;
                  r = if builtins.hasAttr "replay_applicable" c
                      then c.replay_applicable else true;
                  fc = b: if b then "T" else "F";
                in (fc p) + (fc h) + (fc n) + (fc r);
          shapes =
            builtins.map (l: { lens_name = l.lens_name; shape = applicableTuple l; }) perLens;
          uniqueShapes =
            builtins.attrNames
              (builtins.listToAttrs
                (builtins.map
                  (s: { name = s.shape; value = true; })
                  shapes));
          familyFor = sh: {
            shape = sh;
            lens_count =
              builtins.length (builtins.filter (s: s.shape == sh) shapes);
            lens_names =
              builtins.map (s: s.lens_name)
                (builtins.filter (s: s.shape == sh) shapes);
            substrate_name =
              if sh == "TTTT" then "full-applicable"
              else if sh == "TTFF" then "pure-function-no-replay"
              else if sh == "TFFF" then "positive-only"
              else if sh == "TTTF" then "no-replay"
              else if sh == "TFFT" then "positive-and-replay"
              else "shape-" + sh;
          };
        in builtins.map familyFor (builtins.sort (a: b: a < b) uniqueShapes);
      lens_family_count = builtins.length lens_families;
      # v0.13-NNNN: family × lane cross-distribution. Substrate
      # discovers WHERE each family's members live (which lanes).
      # A lane-homogeneous family signals lane-specific shape
      # convergence; a cross-lane family signals shape that
      # crosses substrate boundaries — both are substantive
      # insights about how the registry self-organizes.
      lens_family_lane_distribution =
        let
          classifyLane = lensName:
            if builtins.length (builtins.split "^stdlib/lib/coding/" lensName) > 1
              then "coding"
            else if builtins.length (builtins.split "^stdlib/lib/gate/" lensName) > 1
              then "gate"
            else if builtins.length (builtins.split "^stdlib/lib/math/" lensName) > 1
              then "math"
            else "mirror-primitive";
          rowForFamily = family:
            let
              lanes = builtins.map classifyLane family.lens_names;
              uniqueLanes =
                builtins.attrNames
                  (builtins.listToAttrs
                    (builtins.map (l: { name = l; value = true; }) lanes));
              perLaneCount = lane:
                builtins.length (builtins.filter (l: l == lane) lanes);
              perLaneRows =
                builtins.map
                  (l: { lane = l; count = perLaneCount l; })
                  (builtins.sort (a: b: a < b) uniqueLanes);
            in {
              family_shape = family.shape;
              family_substrate_name = family.substrate_name;
              total_members = family.lens_count;
              distinct_lane_count = builtins.length uniqueLanes;
              lane_distribution = perLaneRows;
              is_lane_homogeneous =
                (builtins.length uniqueLanes) == 1;
              is_cross_lane = (builtins.length uniqueLanes) > 1;
              dominant_lane =
                if uniqueLanes == []
                then null
                else
                  builtins.head
                    (builtins.sort
                      (a: b: (perLaneCount a) > (perLaneCount b))
                      uniqueLanes);
            };
        in builtins.map rowForFamily lens_families;
      # v0.13-OOOO: substrate discovers its own *missing shape
      # space*. The coverage shape is a 4-bit code (positive /
      # held / negative / replay applicability) giving 16
      # possible families. Currently 6 are populated; the other
      # 10 are unrealized. Substrate enumerates the missing
      # shapes + classifies each by viability (which would be
      # semantically valid vs degenerate).
      lens_family_missing_shapes =
        let
          allShapes = [
            "FFFF" "FFFT" "FFTF" "FFTT"
            "FTFF" "FTFT" "FTTF" "FTTT"
            "TFFF" "TFFT" "TFTF" "TFTT"
            "TTFF" "TTFT" "TTTF" "TTTT"
          ];
          presentShapes =
            builtins.map (f: f.shape) lens_families;
          missing =
            builtins.filter
              (s: !(builtins.elem s presentShapes))
              allShapes;
          # Semantic classification of each missing shape:
          #   degenerate = no positive path (lens emits nothing
          #     useful) — FFFF, FFFT, FFTF, FFTT.
          #   strange   = no positive but has held/negative/
          #     replay only — FTFF, FTFT, FTTF, FTTT.
          #   viable    = positive present, just unrealized
          #     combination — TFTF, TFTT.
          classifyShape = s:
            let
              p = (builtins.substring 0 1 s) == "T";
            in
              if !p
              then
                if s == "FFFF" || s == "FFFT"
                   || s == "FFTF" || s == "FFTT"
                then "degenerate-no-positive-path"
                else "strange-positive-absent"
              else "viable-unrealized-combination";
          rowFor = s: {
            shape = s;
            viability = classifyShape s;
          };
        in builtins.map rowFor missing;
      lens_family_shape_space_summary =
        let
          missing = lens_family_missing_shapes;
          present_count = builtins.length lens_families;
          missing_count = builtins.length missing;
          degenerate =
            builtins.filter
              (m: m.viability == "degenerate-no-positive-path")
              missing;
          strange =
            builtins.filter
              (m: m.viability == "strange-positive-absent")
              missing;
          viable =
            builtins.filter
              (m: m.viability == "viable-unrealized-combination")
              missing;
        in {
          total_possible_shapes = 16;
          present_shape_count = present_count;
          missing_shape_count = missing_count;
          # Substrate's own self-observation:
          present_plus_missing_equals_total =
            (present_count + missing_count) == 16;
          missing_degenerate_count = builtins.length degenerate;
          missing_strange_count = builtins.length strange;
          missing_viable_unrealized_count = builtins.length viable;
          # The viable-unrealized shapes are the substrate's
          # frontier — places it could grow without semantic
          # nonsense.
          viable_unrealized_shapes =
            builtins.map (m: m.shape) viable;
        };
      # v0.14-L: final sweep — project-wiki + scripts +
      # Cargo.toml workspace shape.
      substrate_project_wiki_summary = {
        total_md_files = 145;
        maps_count = 88;
        checklists_count = 8;
        context_packs_count = 8;
        misc_count = 41;
        root_owners = [
          "project-wiki/index.md"
          "project-wiki/SCHEMA.md"
          "project-wiki/START.md"
          "project-wiki/glossary.md"
          "project-wiki/log.md"
          "project-wiki/implementation-playbook.md"
        ];
        role =
          "navigation-and-read-model-substrate; NOT semantic owner per CLAUDE.md (truth source = source / .px owner / done.md / convergence.md / gate-todo.md)";
      };
      substrate_scripts_summary = {
        total_script_files = 739;
        script_types =
          "mix of .sh shell scripts + .py python harnesses + misc tooling";
        notable_categories = [
          "all-examples-validation"
          "adaptive-normalization-packet-smoke"
          "api-surface-validation"
          "apply-patch-px-*-smoke"
          "android-runtime-probe"
          "(many more — substrate enumerates count + sample only;
            per-file enumeration would balloon envelope)"
        ];
        role =
          "host-side harness / smoke / validation / probe scripts; not substrate semantic owners";
      };
      substrate_cargo_workspace_shape = {
        cargo_toml_file = "Cargo.toml";
        workspace_line_count = 130;
        workspace_member_count = 72;
        note =
          "72 members (= 70 crates/* + 2 special: pnix-mirror-runtime/cargo workspace inclusion items; or count via exact toml parse, but substrate-side estimate from grep is 72). Substrate does NOT parse Cargo.toml structure here; consumers should verify via cargo metadata when needed.";
      };
      substrate_final_sweep_summary = {
