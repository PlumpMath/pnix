    # llll/nnnn/qqqq lens 들이 만든 verdict 가 이 plan envelope 으로
    # lowering 되어 pnixc-meta src/store/ executor 의 input 이 된다.
    "stdlib/lib/gate/substrate-store-execution-plan-shape-policy.px" = {
