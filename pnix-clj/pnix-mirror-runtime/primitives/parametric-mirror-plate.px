          wired_lane_count = 2;
          substrate_only_lane_count = 2;
          honest_note = "v0.14-V (2026-05-18): coding-candidate lane is now wired to doghouse utterance path via POST /substrate/coding-candidate + freecat-cli --coding-candidate flag (P1 + P2 of the v0.14-U capability lift roadmap). Operator typing 'rename foo to bar' through freecat-cli now reaches the substrate's coding-candidate-dispatcher.px directly (not general ontology). 2 of 4 lanes wired: general-ontology (since beginning) + coding-candidate (v0.14-V). math-conjecture and firewall-5-gate remain substrate-only (math-conjecture needs POST /substrate/math-conjecture; firewall lane requires operator-approval ingest path which is heavier). Until those endpoints land, claiming freecat-cli is a 'coding-and-math agent' overclaims on math — but the coding portion is now real.";
        };
        owner_directive_anchor =
          "pnixc-meta 의 지능이 아직 문제풀이 능력 준비가 안 되어있다면 그것을 우선 끌어올려야겠지? — v0.14-U inventory is the baseline measurement that future capability upgrades pin against.";
