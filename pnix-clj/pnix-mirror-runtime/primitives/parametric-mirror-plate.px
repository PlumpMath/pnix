      # Mirror primitive introspection extends to enumerate
      # EXISTING owners outside its own registry:
      #   - 14 code-transform owners in stdlib/lib/gate/code-transform/
      #   - 3 ankh-language overlays in stdlib/lib/ankh-language/
      #
      # These owners already exist (with their own owner-law
      # files and language fields). This slice does NOT
      # reinvent them — it adds substrate-side self-knowledge
      # that they exist and what their verdict-shape contracts
      # are. Each row references the existing owner file path
      # so consumers can grep / follow.
      #
      # Rollback context: v0.14-A originally added a new
      # programming-language-pattern-registry.px file. That
      # was a constitution violation (duplicate of existing
      # gate/code-transform/ language fields). Rolled back.
      # This v0.14-A retry extends introspection without
      # adding new owners.
      #
      # Owner constitution compliance:
      #   immutable accumulation : pure enumeration of existing
      #     owner names; no state mutation
      #   performance stability  : O(known_transforms) = O(14)
      #   determinism            : hard-pinned list reflects
      #     filesystem ground truth at this slice; future
      #     extensions append + bump declared count
      freecat_cli_code_transform_inventory = [
        { transform_name = "add-edge";
          owner_file = "stdlib/lib/gate/code-transform/add-edge.px";
          verdict_family = [ "add-edge-ready" "add-edge-held" "add-edge-rejected" ]; }
        { transform_name = "add-extern-decl";
          owner_file = "stdlib/lib/gate/code-transform/add-extern-decl.px";
          verdict_family = [ "add-extern-decl-ready" "add-extern-decl-held" "add-extern-decl-rejected" ]; }
        { transform_name = "add-import";
          owner_file = "stdlib/lib/gate/code-transform/add-import.px";
          verdict_family = [ "add-import-ready" "add-import-held" "add-import-rejected" ]; }
        { transform_name = "add-node";
          owner_file = "stdlib/lib/gate/code-transform/add-node.px";
          verdict_family = [ "add-node-ready" "add-node-held" "add-node-rejected" ]; }
        { transform_name = "add-test-stub";
