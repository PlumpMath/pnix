    # v0.8-C (2026-05-15): math proof verification lens.
    #
    # Lens entry function: `applyProofPlate` takes `{ proof_name; }`
    # and returns a step-trace verification envelope. Each step's
    # `applies_name` is resolved against the v0.8-A definition
    # registry or v0.8-B axiom registry; the first unresolved
    # reference short-circuits to `held-at-step-N`.
    "stdlib/lib/math/proof-plate.px" = {
      lensOwner =
