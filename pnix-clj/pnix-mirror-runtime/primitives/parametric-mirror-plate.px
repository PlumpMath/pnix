          positive = "mr14_condition_action_plan_lens_dispatches_via_mirror";
          held = "mr14_condition_action_plan_lens_held_missing_action";
          negative = null;
          replay_determinism = null;
        };
      };
      requestBuilder = bindings: problem:
        let
          raw =
            if bindings ? parameters && builtins.isString bindings.parameters
            then builtins.fromJSON bindings.parameters
            else if bindings ? parameters && builtins.isAttrs bindings.parameters
            then bindings.parameters
            else {};
        in if builtins.isAttrs raw then raw else {};
    };
    "stdlib/lib/agent/reasoning-dispatch-mirror.px" = {
      lensOwner =
        import ../../stdlib/lib/agent/reasoning-dispatch-mirror.px;
      entryFn = "mirrorDispatch";
      lensVerdictName = "reasoning-dispatch-lens-verdict";
      legacyEquivalenceTarget =
        "reasoning-dispatch-mirror.px::mirrorDispatch{verify-claim,check-invariant,meta-audit,...}";
      lifecycle = {
        created_in_slice = "2026-06-03-reasoning-spoke-fold-into-mirror";
      };
      coverage = {
        positive_ratchet = true;
        held_ratchet = false;
        held_applicable = false;
        negative_ratchet = false;
        negative_applicable = false;
        replay_determinism_ratchet = true;
        coverage_witnesses = {
          positive = "reasoning_dispatch_lens_dispatch_via_pnixc_meta";
          held = null;
          negative = null;
          replay_determinism = "reasoning_dispatch_lens_data_driven";
        };
      };
      requestBuilder = bindings: problem:
        let raw =
