{
  name = "pnixc.emit.aot";
  schema = "pnixc-stage-v1";
  input = "fxcore";
  output = "aot";
  format = "native";

  artifacts = [
    "dist/bin/pnixc"
    "dist/lib/libpnixc"
    "dist/manifest/pnixc.json"
  ];

  notes = [
    "AOT emission requires module input"
    "artifacts follow AotTarget naming in host build"
  ];
}
