rec {
  name = "pnixc.clojure.projection";
  schema = "pnix-clj.clojure-projection.v0";
  host = "clojure";
  cross_host_parity = false;
  semantic_owner = "pnix-clj";

  termTags = [
    "Scalar"
    "Symbol"
    "Keyword"
    "List"
    "Vector"
    "Map"
    "Set"
    "Var"
    "Namespace"
    "Exception"
    "JavaClass"
    "JavaObject"
    "ControlFlowReceipt"
    "MacroexpandReceipt"
    "DynamicBindingReceipt"
    "JavaInteropReceipt"
    "ReflectionReceipt"
    "ClassloaderReceipt"
    "NamespaceResolutionReceipt"
    "HostObjectConstructionReceipt"
    "PolymorphismDispatchReceipt"
    "MetadataReceipt"
    "StateEffectReceipt"
    "LazyEvaluationReceipt"
    "ConcurrencyReceipt"
    "CoordinationReceipt"
  ];
  scalarKinds = [ "nil" "bool" "int" "float" "string" "char" "ratio" "bigint" "bigdec" ];

  ok = path: term: {
    status = "ok";
    reason = "clojure-projection-term-valid";
    schema = schema;
    path = path;
    tag = term.tag;
  };

  held = reason: path: {
    status = "failed";
    reason = reason;
    schema = schema;
    path = path;
  };

  hasString = term: key:
    builtins.isAttrs term && builtins.hasAttr key term && builtins.isString (builtins.getAttr key term);

  hasList = term: key:
    builtins.isAttrs term && builtins.hasAttr key term && builtins.isList (builtins.getAttr key term);

  hasBool = term: key:
    builtins.isAttrs term && builtins.hasAttr key term && builtins.isBool (builtins.getAttr key term);

  hasInt = term: key:
    builtins.isAttrs term && builtins.hasAttr key term && builtins.isInt (builtins.getAttr key term);

  stringOrNull = value:
    value == null || builtins.isString value;

  optionalString = term: key:
    !(builtins.hasAttr key term) || stringOrNull (builtins.getAttr key term);

  validateOptionalTerm = path: term: key:
    if !(builtins.hasAttr key term) || builtins.getAttr key term == null then { status = "ok"; }
    else validateTermAt (path + "." + key) (builtins.getAttr key term);

  validateOptionalTermList = path: term: key:
    if !(builtins.hasAttr key term) || builtins.getAttr key term == null then { status = "ok"; }
    else if !(builtins.isList (builtins.getAttr key term)) then held (key + "-not-list") path
    else
      let xs = builtins.getAttr key term;
      in validateEach xs path (i: item: validateTermAt (path + "." + key + "[" + (builtins.toString i) + "]") item);

  validateOptionalStringList = path: term: key:
    if !(builtins.hasAttr key term) || builtins.getAttr key term == null then { status = "ok"; }
    else if !(builtins.isList (builtins.getAttr key term)) then held (key + "-not-list") path
    else
      let xs = builtins.getAttr key term;
      in validateEach xs path (i: item:
        if item == null || builtins.isString item then { status = "ok"; }
        else held (key + "-item-not-string-or-null") (path + "." + key + "[" + (builtins.toString i) + "]"));

  validateEach = xs: path: f:
    let
      step = acc: item:
        if acc.status != "ok" then acc
        else
          let res = f acc.index item;
          in if res.status != "ok" then res else { status = "ok"; index = acc.index + 1; };
    in (builtins.foldl' step { status = "ok"; index = 0; } xs);

  validateTerm = term:
    validateTermAt "$" term;

  validateTermAt = path: term:
    if !(builtins.isAttrs term) then held "term-not-attrs" path
    else if !(hasString term "tag") then held "missing-string-tag" path
    else if !(builtins.elem term.tag termTags) then held "unknown-term-tag" path
    else if !(hasString term "host") || term.host != host then held "host-not-clojure" path
    else
      if term.tag == "Scalar" then validateScalar path term
      else if term.tag == "Symbol" then validateNamed path term "symbol"
      else if term.tag == "Keyword" then validateNamed path term "keyword"
      else if term.tag == "List" then validateSequence path term "items" true
      else if term.tag == "Vector" then validateSequence path term "items" false
      else if term.tag == "Map" then validateMap path term
      else if term.tag == "Set" then validateSequence path term "items" false
      else if term.tag == "Var" then validateVar path term
      else if term.tag == "Namespace" then validateNamespace path term
      else if term.tag == "Exception" then validateException path term
      else if term.tag == "JavaClass" then validateJavaClass path term
      else if term.tag == "JavaObject" then validateJavaObject path term
      else if term.tag == "ControlFlowReceipt" then validateControlFlowReceipt path term
      else if term.tag == "MacroexpandReceipt" then validateMacroexpandReceipt path term
      else if term.tag == "DynamicBindingReceipt" then validateDynamicBindingReceipt path term
      else if term.tag == "JavaInteropReceipt" then validateJavaInteropReceipt path term
      else if term.tag == "ReflectionReceipt" then validateReflectionReceipt path term
      else if term.tag == "ClassloaderReceipt" then validateClassloaderReceipt path term
      else if term.tag == "NamespaceResolutionReceipt" then validateNamespaceResolutionReceipt path term
      else if term.tag == "HostObjectConstructionReceipt" then validateHostObjectConstructionReceipt path term
      else if term.tag == "PolymorphismDispatchReceipt" then validatePolymorphismDispatchReceipt path term
      else if term.tag == "MetadataReceipt" then validateMetadataReceipt path term
      else if term.tag == "StateEffectReceipt" then validateStateEffectReceipt path term
      else if term.tag == "LazyEvaluationReceipt" then validateLazyEvaluationReceipt path term
      else if term.tag == "ConcurrencyReceipt" then validateConcurrencyReceipt path term
      else if term.tag == "CoordinationReceipt" then validateCoordinationReceipt path term
      else held "unknown-term-tag" path;

  validateScalar = path: term:
    if !(hasString term "kind") then held "scalar-kind-missing" path
    else if !(builtins.elem term.kind scalarKinds) then held "scalar-kind-unknown" path
    else ok path term;

  validateNamed = path: term: kind:
    if !(term ? ns) then held (kind + "-ns-missing") path
    else if term.ns != null && !(builtins.isString term.ns) then held (kind + "-ns-not-string-or-null") path
    else if !(hasString term "name") then held (kind + "-name-missing") path
    else ok path term;

  validateSequence = path: term: field: formRequired:
    if !(hasList term field) then held "sequence-items-missing" path
    else if formRequired && !(hasBool term "form") then held "list-form-flag-missing" path
    else
      let
        items = builtins.getAttr field term;
        res = validateEach items path (i: item: validateTermAt (path + ".items[" + (builtins.toString i) + "]") item);
      in if res.status == "ok" then ok path term else res;

  validatePair = path: pair:
    if !(builtins.isAttrs pair) then held "map-pair-not-attrs" path
    else if !(pair ? key) then held "map-pair-key-missing" path
    else if !(pair ? value) then held "map-pair-value-missing" path
    else
      let keyRes = validateTermAt (path + ".key") pair.key;
      in if keyRes.status != "ok" then keyRes
         else validateTermAt (path + ".value") pair.value;

  validateMap = path: term:
    if !(hasList term "pairs") then held "map-pairs-missing" path
    else
      let
        res = validateEach term.pairs path (i: pair: validatePair (path + ".pairs[" + (builtins.toString i) + "]") pair);
      in if res.status == "ok" then ok path term else res;

  validateVar = path: term:
    if !(hasString term "ns") then held "var-ns-missing" path
    else if !(hasString term "name") then held "var-name-missing" path
    else if builtins.hasAttr "dynamic" term && !(builtins.isBool term.dynamic) then held "var-dynamic-not-bool" path
    else ok path term;

  validateNamespace = path: term:
    if !(hasString term "name") then held "namespace-name-missing" path
    else ok path term;

  validateException = path: term:
    if !(hasString term "class") then held "exception-class-missing" path
    else if !(optionalString term "message") then held "exception-message-not-string-or-null" path
    else if !(optionalString term "cause_class") then held "exception-cause-class-not-string-or-null" path
    else
      let dataRes = validateOptionalTerm path term "data";
      in if dataRes.status == "ok" then ok path term else dataRes;

  validateJavaClass = path: term:
    if !(hasString term "name") then held "java-class-name-missing" path
    else if !(hasString term "simple_name") then held "java-class-simple-name-missing" path
    else if !(optionalString term "package") then held "java-class-package-not-string-or-null" path
    else if !(hasBool term "primitive") then held "java-class-primitive-missing" path
    else if !(hasBool term "array") then held "java-class-array-missing" path
    else if !(hasBool term "interface") then held "java-class-interface-missing" path
    else ok path term;

  validateJavaObject = path: term:
    if !(hasString term "class") then held "java-object-class-missing" path
    else if !(optionalString term "string") then held "java-object-string-not-string-or-null" path
    else if !(optionalString term "projection_note") then held "java-object-note-not-string-or-null" path
    else ok path term;

  validateControlFlowReceipt = path: term:
    if !(hasString term "status") then held "control-flow-status-missing" path
    else if !(hasString term "form_kind") then held "control-flow-form-kind-missing" path
    else if !(optionalString term "source_hash") then held "control-flow-source-hash-not-string-or-null" path
    else
      let resultRes = validateOptionalTerm path term "result";
      in if resultRes.status != "ok" then resultRes
         else
           let exceptionRes = validateOptionalTerm path term "exception";
           in if exceptionRes.status != "ok" then exceptionRes
              else
                let effectsRes = validateOptionalTermList path term "effects";
                in if effectsRes.status == "ok" then ok path term else effectsRes;

  validateMacroexpandReceipt = path: term:
    if !(hasString term "status") then held "macroexpand-status-missing" path
    else if !(hasString term "phase") then held "macroexpand-phase-missing" path
    else if !(optionalString term "source_hash") then held "macroexpand-source-hash-not-string-or-null" path
    else
      let sourceRes = validateOptionalTerm path term "source_term";
      in if sourceRes.status != "ok" then sourceRes
         else
           let expandedRes = validateOptionalTerm path term "expanded_term";
           in if expandedRes.status != "ok" then expandedRes
              else
                let finalRes = validateOptionalTerm path term "final_term";
                in if finalRes.status != "ok" then finalRes
                   else
                     let stepsRes = validateOptionalTermList path term "steps";
                     in if stepsRes.status != "ok" then stepsRes
                        else
                          let featuresRes = validateOptionalStringList path term "features";
                          in if featuresRes.status != "ok" then featuresRes
                             else
                               let exceptionRes = validateOptionalTerm path term "exception";
                               in if exceptionRes.status == "ok" then ok path term else exceptionRes;

  validateDynamicBindingReceipt = path: term:
    if !(hasString term "status") then held "dynamic-binding-status-missing" path
    else if !(optionalString term "source_hash") then held "dynamic-binding-source-hash-not-string-or-null" path
    else
      let varRes = validateOptionalTerm path term "var";
      in if varRes.status != "ok" then varRes
         else
           let valueRes = validateOptionalTerm path term "binding_value";
           in if valueRes.status != "ok" then valueRes
              else
                let resultRes = validateOptionalTerm path term "result";
                in if resultRes.status != "ok" then resultRes
                   else
                     let exceptionRes = validateOptionalTerm path term "exception";
                     in if exceptionRes.status == "ok" then ok path term else exceptionRes;

  validateJavaInteropReceipt = path: term:
    if !(hasString term "status") then held "java-interop-status-missing" path
    else if !(hasString term "op") then held "java-interop-op-missing" path
    else if !(hasString term "target") then held "java-interop-target-missing" path
    else if !(optionalString term "member") then held "java-interop-member-not-string-or-null" path
    else if !(hasList term "args") then held "java-interop-args-missing" path
    else
      let argsRes = validateEach term.args path (i: item: validateTermAt (path + ".args[" + (builtins.toString i) + "]") item);
      in if argsRes.status != "ok" then argsRes
         else
           let argClassRes = validateOptionalStringList path term "arg_classes";
           in if argClassRes.status != "ok" then argClassRes
              else if !(optionalString term "result_class") then held "java-interop-result-class-not-string-or-null" path
              else if !(optionalString term "exception_class") then held "java-interop-exception-class-not-string-or-null" path
              else
                let resultRes = validateOptionalTerm path term "result";
                in if resultRes.status != "ok" then resultRes
                   else
                     let exceptionRes = validateOptionalTerm path term "exception";
                     in if exceptionRes.status == "ok" then ok path term else exceptionRes;

  validateReflectionReceipt = path: term:
    if !(hasString term "status") then held "reflection-status-missing" path
    else if !(hasString term "op") then held "reflection-op-missing" path
    else if !(hasString term "target_class") then held "reflection-target-class-missing" path
    else if !(optionalString term "member") then held "reflection-member-not-string-or-null" path
    else if !(hasList term "args") then held "reflection-args-missing" path
    else
      let argsRes = validateEach term.args path (i: item: validateTermAt (path + ".args[" + (builtins.toString i) + "]") item);
      in if argsRes.status != "ok" then argsRes
         else
           let argClassRes = validateOptionalStringList path term "arg_classes";
           in if argClassRes.status != "ok" then argClassRes
              else if !(optionalString term "result_class") then held "reflection-result-class-not-string-or-null" path
              else if !(optionalString term "exception_class") then held "reflection-exception-class-not-string-or-null" path
              else
                let resultRes = validateOptionalTerm path term "result";
                in if resultRes.status != "ok" then resultRes
                   else
                     let exceptionRes = validateOptionalTerm path term "exception";
                     in if exceptionRes.status == "ok" then ok path term else exceptionRes;

  validateClassloaderReceipt = path: term:
    if !(hasString term "status") then held "classloader-status-missing" path
    else if !(hasString term "op") then held "classloader-op-missing" path
    else if !(hasString term "context") then held "classloader-context-missing" path
    else if !(hasList term "args") then held "classloader-args-missing" path
    else
      let argsRes = validateEach term.args path (i: item: validateTermAt (path + ".args[" + (builtins.toString i) + "]") item);
      in if argsRes.status != "ok" then argsRes
         else
           let argClassRes = validateOptionalStringList path term "arg_classes";
           in if argClassRes.status != "ok" then argClassRes
              else if !(optionalString term "result_class") then held "classloader-result-class-not-string-or-null" path
              else if !(optionalString term "exception_class") then held "classloader-exception-class-not-string-or-null" path
              else
                let resultRes = validateOptionalTerm path term "result";
                in if resultRes.status != "ok" then resultRes
                   else
                     let exceptionRes = validateOptionalTerm path term "exception";
                     in if exceptionRes.status == "ok" then ok path term else exceptionRes;

  validateNamespaceResolutionReceipt = path: term:
    if !(hasString term "status") then held "namespace-resolution-status-missing" path
    else if !(hasString term "op") then held "namespace-resolution-op-missing" path
    else if !(hasString term "ns") then held "namespace-resolution-ns-missing" path
    else if !(hasString term "requested") then held "namespace-resolution-requested-missing" path
    else if !(optionalString term "alias") then held "namespace-resolution-alias-not-string-or-null" path
    else if !(optionalString term "symbol") then held "namespace-resolution-symbol-not-string-or-null" path
    else if !(optionalString term "result_class") then held "namespace-resolution-result-class-not-string-or-null" path
    else if !(optionalString term "exception_class") then held "namespace-resolution-exception-class-not-string-or-null" path
    else
      let resultRes = validateOptionalTerm path term "result";
      in if resultRes.status != "ok" then resultRes
         else
           let exceptionRes = validateOptionalTerm path term "exception";
           in if exceptionRes.status == "ok" then ok path term else exceptionRes;

  validateHostObjectConstructionReceipt = path: term:
    if !(hasString term "status") then held "host-object-status-missing" path
    else if !(hasString term "construction_kind") then held "host-object-construction-kind-missing" path
    else if !(hasString term "type_name") then held "host-object-type-name-missing" path
    else if !(optionalString term "source_hash") then held "host-object-source-hash-not-string-or-null" path
    else if !(optionalString term "result_class") then held "host-object-result-class-not-string-or-null" path
    else if !(hasList term "interfaces") then held "host-object-interfaces-missing" path
    else
      let interfaceRes = validateOptionalStringList path term "interfaces";
      in if interfaceRes.status != "ok" then interfaceRes
         else if !(hasBool term "record") then held "host-object-record-flag-missing" path
         else
           let objectRes = validateOptionalTerm path term "object";
           in if objectRes.status != "ok" then objectRes
              else
                let resultRes = validateOptionalTerm path term "result";
                in if resultRes.status != "ok" then resultRes
                   else if !(optionalString term "exception_class") then held "host-object-exception-class-not-string-or-null" path
                   else
                     let exceptionRes = validateOptionalTerm path term "exception";
                     in if exceptionRes.status == "ok" then ok path term else exceptionRes;

  validatePolymorphismDispatchReceipt = path: term:
    if !(hasString term "status") then held "polymorphism-status-missing" path
    else if !(hasString term "dispatch_kind") then held "polymorphism-dispatch-kind-missing" path
    else if !(hasString term "dispatch_name") then held "polymorphism-dispatch-name-missing" path
    else if !(optionalString term "dispatch_value") then held "polymorphism-dispatch-value-not-string-or-null" path
    else if !(optionalString term "source_hash") then held "polymorphism-source-hash-not-string-or-null" path
    else if !(hasList term "args") then held "polymorphism-args-missing" path
    else
      let argsRes = validateEach term.args path (i: item: validateTermAt (path + ".args[" + (builtins.toString i) + "]") item);
      in if argsRes.status != "ok" then argsRes
         else
           let argClassRes = validateOptionalStringList path term "arg_classes";
           in if argClassRes.status != "ok" then argClassRes
              else if !(optionalString term "result_class") then held "polymorphism-result-class-not-string-or-null" path
              else if !(optionalString term "exception_class") then held "polymorphism-exception-class-not-string-or-null" path
              else
                let resultRes = validateOptionalTerm path term "result";
                in if resultRes.status != "ok" then resultRes
                   else
                     let exceptionRes = validateOptionalTerm path term "exception";
                     in if exceptionRes.status == "ok" then ok path term else exceptionRes;

  validateMetadataReceipt = path: term:
    if !(hasString term "status") then held "metadata-status-missing" path
    else if !(hasString term "op") then held "metadata-op-missing" path
    else if !(optionalString term "target_kind") then held "metadata-target-kind-not-string-or-null" path
    else if !(optionalString term "target_class") then held "metadata-target-class-not-string-or-null" path
    else if !(optionalString term "source_hash") then held "metadata-source-hash-not-string-or-null" path
    else if !(optionalString term "result_class") then held "metadata-result-class-not-string-or-null" path
    else if !(optionalString term "exception_class") then held "metadata-exception-class-not-string-or-null" path
    else
      let targetRes = validateOptionalTerm path term "target";
      in if targetRes.status != "ok" then targetRes
         else
           let metadataRes = validateOptionalTerm path term "metadata";
           in if metadataRes.status != "ok" then metadataRes
              else
                let resultRes = validateOptionalTerm path term "result";
                in if resultRes.status != "ok" then resultRes
                   else
                     let exceptionRes = validateOptionalTerm path term "exception";
                     in if exceptionRes.status == "ok" then ok path term else exceptionRes;

  validateStateEffectReceipt = path: term:
    if !(hasString term "status") then held "state-effect-status-missing" path
    else if !(hasString term "op") then held "state-effect-op-missing" path
    else if !(optionalString term "target_kind") then held "state-effect-target-kind-not-string-or-null" path
    else if !(optionalString term "target_class") then held "state-effect-target-class-not-string-or-null" path
    else if !(optionalString term "source_hash") then held "state-effect-source-hash-not-string-or-null" path
    else if !(hasList term "effects") then held "state-effect-effects-missing" path
    else if !(optionalString term "result_class") then held "state-effect-result-class-not-string-or-null" path
    else if !(optionalString term "exception_class") then held "state-effect-exception-class-not-string-or-null" path
    else
      let initialRes = validateOptionalTerm path term "initial";
      in if initialRes.status != "ok" then initialRes
         else
           let finalRes = validateOptionalTerm path term "final";
           in if finalRes.status != "ok" then finalRes
              else
                let effectsRes = validateEach term.effects path (i: item: validateTermAt (path + ".effects[" + (builtins.toString i) + "]") item);
                in if effectsRes.status != "ok" then effectsRes
                   else
                     let resultRes = validateOptionalTerm path term "result";
                     in if resultRes.status != "ok" then resultRes
                        else
                          let exceptionRes = validateOptionalTerm path term "exception";
                          in if exceptionRes.status == "ok" then ok path term else exceptionRes;

  validateLazyEvaluationReceipt = path: term:
    if !(hasString term "status") then held "lazy-evaluation-status-missing" path
    else if !(hasString term "op") then held "lazy-evaluation-op-missing" path
    else if !(optionalString term "target_kind") then held "lazy-evaluation-target-kind-not-string-or-null" path
    else if !(optionalString term "target_class") then held "lazy-evaluation-target-class-not-string-or-null" path
    else if !(optionalString term "source_hash") then held "lazy-evaluation-source-hash-not-string-or-null" path
    else if !(hasInt term "realized_count") then held "lazy-evaluation-realized-count-missing" path
    else if !(hasList term "effects") then held "lazy-evaluation-effects-missing" path
    else if !(optionalString term "result_class") then held "lazy-evaluation-result-class-not-string-or-null" path
    else if !(optionalString term "exception_class") then held "lazy-evaluation-exception-class-not-string-or-null" path
    else
      let effectsRes = validateEach term.effects path (i: item: validateTermAt (path + ".effects[" + (builtins.toString i) + "]") item);
      in if effectsRes.status != "ok" then effectsRes
         else
           let resultRes = validateOptionalTerm path term "result";
           in if resultRes.status != "ok" then resultRes
              else
                let exceptionRes = validateOptionalTerm path term "exception";
                in if exceptionRes.status == "ok" then ok path term else exceptionRes;

  validateConcurrencyReceipt = path: term:
    if !(hasString term "status") then held "concurrency-status-missing" path
    else if !(hasString term "op") then held "concurrency-op-missing" path
    else if !(optionalString term "target_kind") then held "concurrency-target-kind-not-string-or-null" path
    else if !(optionalString term "target_class") then held "concurrency-target-class-not-string-or-null" path
    else if !(optionalString term "source_hash") then held "concurrency-source-hash-not-string-or-null" path
    else if !(hasBool term "completed") then held "concurrency-completed-missing" path
    else if !(hasList term "effects") then held "concurrency-effects-missing" path
    else if !(optionalString term "result_class") then held "concurrency-result-class-not-string-or-null" path
    else if !(optionalString term "exception_class") then held "concurrency-exception-class-not-string-or-null" path
    else
      let effectsRes = validateEach term.effects path (i: item: validateTermAt (path + ".effects[" + (builtins.toString i) + "]") item);
      in if effectsRes.status != "ok" then effectsRes
         else
           let resultRes = validateOptionalTerm path term "result";
           in if resultRes.status != "ok" then resultRes
              else
                let exceptionRes = validateOptionalTerm path term "exception";
                in if exceptionRes.status == "ok" then ok path term else exceptionRes;

  validateCoordinationReceipt = path: term:
    if !(hasString term "status") then held "coordination-status-missing" path
    else if !(hasString term "op") then held "coordination-op-missing" path
    else if !(optionalString term "target_kind") then held "coordination-target-kind-not-string-or-null" path
    else if !(optionalString term "target_class") then held "coordination-target-class-not-string-or-null" path
    else if !(optionalString term "source_hash") then held "coordination-source-hash-not-string-or-null" path
    else if !(hasBool term "completed") then held "coordination-completed-missing" path
    else if !(hasList term "effects") then held "coordination-effects-missing" path
    else if !(optionalString term "result_class") then held "coordination-result-class-not-string-or-null" path
    else if !(optionalString term "exception_class") then held "coordination-exception-class-not-string-or-null" path
    else
      let initialRes = validateOptionalTerm path term "initial";
      in if initialRes.status != "ok" then initialRes
         else
           let finalRes = validateOptionalTerm path term "final";
           in if finalRes.status != "ok" then finalRes
              else
                let effectsRes = validateEach term.effects path (i: item: validateTermAt (path + ".effects[" + (builtins.toString i) + "]") item);
                in if effectsRes.status != "ok" then effectsRes
                   else
                     let resultRes = validateOptionalTerm path term "result";
                     in if resultRes.status != "ok" then resultRes
                        else
