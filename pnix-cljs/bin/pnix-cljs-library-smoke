#!/usr/bin/env bash
# Local library export smoke (not npm registry).
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
host="$(cd "$here/.." && pwd)"
product="$host/pnix-cljs"
out="${PNIX_CLJS_LIBRARY_EXPORT:-$product/target/pnix-cljs-library}"
no_export=0
if [[ "${1:-}" == "--no-export" ]]; then
  no_export=1
elif [[ -n "${1:-}" ]]; then
  echo "usage: pnix-cljs-library-smoke [--no-export]" >&2
  exit 2
fi

echo "== pnix-cljs-library-smoke (local feed only) =="

if [[ ! -f "$out/manifest.json" ]] || \
   [[ "$product/dist/pnix-cljs-module.js" -nt "$out/manifest.json" ]] || \
   ! grep -q 'callFileValueJson' "$out/share/pnix-cljs/pnix-cljs-module.js" 2>/dev/null; then
  if [[ "$no_export" -eq 1 ]]; then
    echo "FAIL: missing $out/manifest.json — run export-pnix-cljs-library" >&2
    exit 1
  fi
  echo "  library missing — exporting → $out"
  "$here/export-pnix-cljs-library" "$out"
fi

test -f "$out/share/pnix-cljs/pnix-cljs-module.js"
test -f "$out/lib/node_modules/@plumpmath/pnix-cljs/package.json"
test -f "$out/refs.env"
echo "  OK  export layout (share + scoped package)"

if ! command -v node >/dev/null 2>&1; then
  echo "FAIL: node not on PATH" >&2
  exit 1
fi

tmp_root="$(mktemp -d "${TMPDIR:-/tmp}/pnix-cljs-lib-smoke.XXXXXX")"
px="$tmp_root/program.px"
library="$tmp_root/library.px"
trap 'rm -rf "$tmp_root"' EXIT
printf '%s\n' '1 + 2' >"$px"
printf '%s\n' '{ double = x: x * 2; }' >"$library"

export NODE_PATH="$out/lib/node_modules:$out/share/pnix-cljs${NODE_PATH:+:$NODE_PATH}"
scoped_package="$out/lib/node_modules/@plumpmath/pnix-cljs"
flat_module="$out/share/pnix-cljs/pnix-cljs-module.js"

# Require the exact exported package path.  A Nix-provided node wrapper can
# prepend its own NODE_PATH and otherwise make this local-export smoke test an
# older installed package instead of the artifact under test.
scoped="$(
  node -e "const p=require(process.argv[1]); process.stdout.write(String(p.evalFileValueJson(process.argv[2])))" "$scoped_package" "$px"
)"
if [[ "$scoped" != "3" ]]; then
  echo "FAIL: scoped require evalFileValueJson => '$scoped' (want 3)" >&2
  exit 1
fi
echo "  OK  require('@plumpmath/pnix-cljs') => 3"

called="$(
  node -e "const p=require(process.argv[1]); process.stdout.write(p.callFileValueJson(process.argv[2], 'double', '[21]'))" "$scoped_package" "$library"
)"
if [[ "$called" != "42" ]]; then
  echo "FAIL: scoped require callFileValueJson => '$called' (want 42)" >&2
  exit 1
fi
echo "  OK  require('@plumpmath/pnix-cljs').callFileValueJson => 42"

# Flat fallback
flat="$(
  node -e "const p=require(process.argv[1]); process.stdout.write(String(p.evalFileValueJson(process.argv[2])))" "$flat_module" "$px"
)"
if [[ "$flat" != "3" ]]; then
  echo "FAIL: flat require => '$flat' (want 3)" >&2
  exit 1
fi
echo "  OK  require('pnix-cljs-module.js') => 3"

# Mini example if present
smoke_mjs="$(cd "$host/.." && pwd)/examples/host-import/cljs/smoke.mjs"
if [[ -f "$smoke_mjs" ]]; then
  ex="$(node "$smoke_mjs" 2>/dev/null | tr -d '[:space:]')"
  if [[ "$ex" != "3" ]]; then
    echo "FAIL: examples/host-import/cljs/smoke.mjs => '$ex' (want 3)" >&2
    exit 1
  fi
  echo "  OK  host-import cljs/smoke.mjs => 3"
else
  echo "  SKIP host-import smoke.mjs"
fi

echo "== summary: PASS (local library only; not npm) =="
