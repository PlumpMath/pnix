# pnix builtin 함수 예제 (hot-reloadable)
# 한국어 질의 시 자동 포함. Rust 하드코딩 아님.
{
  examples = [
    {
      concept = "map";
      examples = [
        { title = "각 원소 2배"; input = "builtins.map (x: x * 2) [ 1 2 3 ]"; result = "[ 2 4 6 ]"; meaning = "리스트의 모든 원소에 함수를 적용한다."; }
        { title = "문자열 길이"; input = "builtins.map builtins.stringLength [ \"abc\" \"de\" ]"; result = "[ 3 2 ]"; meaning = "각 문자열의 길이를 구한다."; }
      ];
      why = "map은 for 루프 대신 선언적으로 변환을 표현한다. 함수형 프로그래밍의 기본이다.";
    }
    {
      concept = "filter";
      examples = [
        { title = "짝수만 걸러내기"; input = "builtins.filter (x: builtins.mod x 2 == 0) [ 1 2 3 4 5 6 ]"; result = "[ 2 4 6 ]"; meaning = "조건을 만족하는 원소만 남긴다."; }
      ];
      why = "filter는 데이터에서 필요한 것만 선별한다. SQL의 WHERE절과 같은 역할이다.";
    }
    {
      concept = "foldl'";
      examples = [
        { title = "합계 구하기"; input = "builtins.foldl' (acc: x: acc + x) 0 [ 1 2 3 4 ]"; result = "10"; meaning = "초기값 0에서 시작해 왼쪽부터 더해간다: 0+1+2+3+4 = 10."; }
        { title = "최대값 구하기"; input = "builtins.foldl' (acc: x: if x > acc then x else acc) 0 [ 3 7 2 9 1 ]"; result = "9"; meaning = "리스트를 하나의 값으로 접는다(reduce)."; }
      ];
      why = "foldl'은 리스트를 하나의 값으로 축약한다. sum, max, concat 등 모든 집계가 fold이다.";
    }
    {
      concept = "length";
      examples = [
        { title = "리스트 길이"; input = "builtins.length [ \"a\" \"b\" \"c\" ]"; result = "3"; meaning = "원소의 개수를 반환한다."; }
      ];
    }
    {
      concept = "elemAt";
      examples = [
        { title = "인덱스 접근"; input = "builtins.elemAt [ \"a\" \"b\" \"c\" ] 1"; result = "\"b\""; meaning = "0부터 시작하는 인덱스로 원소를 꺼낸다."; }
      ];
    }
    {
      concept = "concatStringsSep";
      examples = [
        { title = "쉼표로 합치기"; input = "builtins.concatStringsSep \", \" [ \"a\" \"b\" \"c\" ]"; result = "\"a, b, c\""; meaning = "구분자를 넣어 문자열 목록을 하나로 합친다."; }
      ];
    }
    {
      concept = "split";
      examples = [
        { title = "쉼표로 나누기"; input = "builtins.split \",\" \"a,b,c\""; result = "[ \"a\" \"b\" \"c\" ]"; meaning = "정규식 패턴으로 문자열을 나눈다."; }
      ];
    }
    {
      concept = "ontologyQuery";
      examples = [
        { title = "builtin 조회"; input = "builtins.ontologyQuery { subj = \"map\"; pred = \"is-a\"; }"; result = "[{ subj = \"map\", pred = \"is-a\", obj = \"builtin\", ... }]"; meaning = "ontology store에서 fact를 쿼리한다."; }
        { title = "도메인 조회"; input = "builtins.ontologyQuery { pred = \"domain\"; obj = \"physics\"; }"; result = "물리 도메인의 모든 fact 목록"; meaning = "predicate와 object로 검색한다."; }
      ];
      why = "ontologyQuery는 pnix가 자기 자신에 대해 아는 것을 쿼리하는 핵심 함수이다. meta-circular의 ontology 층위.";
    }
    {
      concept = "ontologyEmit";
      examples = [
        { title = "새 fact 방출"; input = "builtins.ontologyEmit { subj = \"힘\"; pred = \"formula\"; obj = \"F=ma\"; }"; result = "{ subj = \"힘\", pred = \"formula\", obj = \"F=ma\", status = \"candidate\", ... }"; meaning = "새 ontology fact를 store에 기록한다. candidate 상태로 생성된다."; }
      ];
      why = "ontologyEmit으로 pnix가 새 지식을 스스로 만들 수 있다. 학습의 시작점이다.";
    }
    {
      concept = "ontologyEvaluate";
      examples = [
        { title = "해석 평가"; input = "builtins.ontologyEvaluate policy interpretation"; result = "{ score = 0.85, safety = 0.9, ... }"; meaning = "6축(coherence, coverage, loss, cost, replayability, safety)으로 해석을 평가한다."; }
      ];
      why = "ontologyEvaluate는 여러 해석이 경쟁할 때 어떤 것이 더 나은지 결정론적으로 평가한다.";
    }
    {
      concept = "ontologyLift";
      examples = [
        { title = "맥락 올리기"; input = "builtins.ontologyLift \"Physics\" { subj = \"힘\"; pred = \"is-a\"; obj = \"concept\"; }"; result = "lifted fact with Physics context"; meaning = "fact를 새 맥락으로 들어올린다."; }
      ];
    }
  ];
}
