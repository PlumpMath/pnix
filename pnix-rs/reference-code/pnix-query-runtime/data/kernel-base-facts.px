# kernel-base-facts.px — standalone kernel base query fact shaping owner
#
# pnix-query-runtime 는 매 요청마다 아래 base fact 들을 candidate 로 lift
# 한다. 이 shaping literal (context / subj / pred / obj / id-template) 은
# Rust 하드코드가 아니라 이 파일이 소유한다.
#
# ## base-query-facts
#
# 각 entry 의 template 에서 허용되는 placeholder:
#   ${route}            : dispatch 된 route id (예: "concept-definition-lookup")
#   ${route-segment}    : route id 의 `/` 를 `.` 로 바꾼 형태 (id template 전용)
#   ${utterance}        : 원본 사용자 발화
#   ${scope}            : 요청 scope (brief / standard / detailed)
#   ${term}             : definition lane 의 concept term
#   ${domain}           : definition lane concept.domain
#   ${predicate}        : property lane 의 ontology predicate
#   ${definition-ko}    : definition lane concept.definition_ko
#   ${formal-name-en}   : definition lane concept formal-name-en
#
# obj-literal 은 template 이 아닌 그대로의 값이다. ${...} 치환이 일어나지 않는다.
# when-route 가 있으면 해당 route 에서만 emit 된다.
# 순서대로 emit 된다. loader 가 중복 id 를 거부한다.
#
# ## concept-source-facts
#
# `query-classifiers.px` 의 `kernel-source-fact-fields` / `kernel-source-list-fields`
# 가 concept field → predicate 매핑을 소유한다. 이 파일은 그 매핑으로 생성된
# ContextualFact 의 id / provenance 포맷을 소유한다.
#
# concept-source-facts template 에서 허용되는 placeholder:
#   ${term}             : concept.term_ko (한국어 용어)
#   ${predicate}        : mapping rule 의 predicate
#   ${index}            : list field 의 경우 list 안의 0-based index
#   ${source-ref}       : concept.source_ref (provenance 용)
{
  base-query-facts = [
    {
      id-template = "fact.pnix.route.${route-segment}";
      context = "Pnix.Query";
      subj = "pnix";
      pred = "service-route";
      obj-template = "${route}";
    }
    {
      id-template = "fact.pnix.scope";
      context = "Pnix.Query";
      subj = "pnix";
      pred = "request-scope";
      obj-template = "${scope}";
    }
    {
      id-template = "fact.pnix.language";
      context = "Pnix.Query";
      subj = "user";
      pred = "language";
      obj-literal = "ko";
    }
    {
      id-template = "fact.pnix.utterance";
      context = "Pnix.Query";
      subj = "user";
      pred = "utterance-text";
      obj-template = "${utterance}";
    }
    {
      when-route = "concept-definition-lookup";
      id-template = "fact.pnix.concept.term";
      context = "Pnix.ConceptQuery";
      subj = "user";
      pred = "concept-query-term";
      obj-template = "${term}";
    }
    {
      when-route = "concept-definition-lookup";
      id-template = "fact.pnix.concept.domain";
      context = "Pnix.ConceptQuery";
      subj = "pnix";
      pred = "concept-domain";
      obj-template = "${domain}";
    }
    {
      when-route = "concept-definition-lookup";
      id-template = "fact.pnix.concept.definition";
      context = "Pnix.ConceptQuery";
      subj = "pnix";
      pred = "concept-definition-ko";
      obj-template = "${definition-ko}";
    }
    {
      when-route = "concept-definition-lookup";
      id-template = "fact.pnix.concept.formal-en";
      context = "Pnix.ConceptQuery";
      subj = "pnix";
      pred = "concept-formal-name-en";
      obj-template = "${formal-name-en}";
    }
    {
      when-route = "concept-predicate-lookup";
      id-template = "fact.pnix.predicate.term";
      context = "Pnix.PredicateQuery";
      subj = "user";
      pred = "predicate-query-term";
      obj-template = "${term}";
    }
    {
      when-route = "concept-predicate-lookup";
      id-template = "fact.pnix.predicate.kind";
      context = "Pnix.PredicateQuery";
      subj = "pnix";
      pred = "predicate-query-kind";
      obj-template = "${predicate}";
    }
    {
      when-route = "concept-predicate-lookup";
      id-template = "fact.pnix.predicate.domain";
      context = "Pnix.PredicateQuery";
      subj = "pnix";
      pred = "concept-domain";
      obj-template = "${domain}";
    }
  ];

  concept-source-facts = {
    scalar-id-template = "fact.pnix.concept.${term}.${predicate}";
    list-id-template = "fact.pnix.concept.${term}.${predicate}.${index}";
    provenance-template = "concept-source:${source-ref}";
  };

  # ## query-provenance-templates
  #
  # answer_definition / answer_property / answer_why / answer_held 가 요청마다
  # 조립하는 provenance vector 의 literal 을 `.px` owner 로 올린 것.
  # concept_source_facts 의 자체 provenance 는 concept-source-facts
  # 섹션이 소유한다. 여기는 "query 시점의 base provenance" 를 owner 한다.
  #
  # template placeholder:
  #   - utterance      : ${utterance}
  #   - concept-source : ${source-ref}
  query-provenance-templates = {
    utterance = "utterance:${utterance}";
    concept-source = "concept-source:${source-ref}";
  };

  # ## semantic-id-templates
  #
  # standalone kernel 이 매 요청마다 만드는 episode / record / knowledge id 의
  # shape owner. `finalize_response` 는 episode-id 를 만들어 `build_envelope`
  # 에 넘기고, build_envelope 는 record-id / knowledge-id / knowledge-summary
  # 를 이 section 에서 읽는다.
  #
  # placeholder:
  #   - episode-id-template   : ${counter}
  #   - record-id-template    : ${episode-id}, ${index}
  #   - knowledge-id-template : ${episode-id}
  #   - knowledge-summary     : literal (no placeholder, loader 는 placeholder 를 거부한다)
  semantic-id-templates = {
    episode-id-template = "episode.pnix.standalone.${counter}";
    record-id-template = "record.fact.${episode-id}.${index}";
    knowledge-id-template = "knowledge.pnix.${episode-id}";
    knowledge-summary = "pnix standalone query kernel staging record";
  };

  # ## pipeline-trace-note-prefixes
  #
  # `build_response_documents` / `build_output_fragments` 가 pipeline-trace
  # fragment 를 조립할 때 note 를 필터하는 prefix 리스트 owner.
  #
  # consumer contract:
  #   - note.starts_with(prefix) 중 어느 하나라도 만족하면 pipeline trace 에 포함
  #   - 이 리스트는 note-templates 섹션의 prefix 강제 (held-* → "held-",
  #     truth-regime → "truth-regime:" 등) 와 반드시 일치해야 한다.
  #   - "ontology-" prefix 는 pnix-core::judgment 가 append 하는 note 를 잡는다
  #     (emission 쪽은 pnix-core, 이 consumer 는 standalone kernel).
  #
  # loader 는 빈 리스트 / non-string entry 를 거부한다.
  pipeline-trace-note-prefixes = [
    "ontology-"
    "truth-regime:"
    "held-"
  ];

  # ## response-document-schema
  #
  # `build_response_documents` 가 만드는 PX 문서 헤더 / 필드 이름과
  # `.org` 문서의 사용자 facing 마크업 owner.
  #
  # **이관 범위 (의도적 제한):**
  #   - PX 문서의 헤더 코멘트와 다섯 개 필드 이름 (episode-id / summary /
  #     transcript / pipeline / facts-count) 는 이 섹션이 owner.
  #   - `.org` 문서의 title, pipeline-section-header, facts-count 템플릿도
  #     여기서 owner.
  #
  # **유지하는 것 (puck webview_chat.rs coupling):**
  #   - `.org` 의 `- ~{line}~` pipeline-trace 라인 마크업은 puck
  #     `webview_chat.rs` L423 이 string match 로 소비한다. 여기서 owner 로
  #     올리면 drift 위험이 커서 puck consumer 마이그레이션과 같이 가야 한다.
  #
  # **이미 이관된 것:**
  #   - transcript 역할 태그 변환은 아래 `org-transcript-transforms` 가 owner.
  #     runtime 은 note-templates 가 만든 transcript line 에 대해 input-prefix →
  #     output-prefix 규칙만 generic 하게 적용한다.
  #
  # placeholder:
  #   - org-facts-count-template : ${count}
  response-document-schema = {
    px-header-comment = "# pnix ontology response document (auto-generated)";
    px-field-episode-id = "episode-id";
    px-field-summary = "summary";
    px-field-transcript = "transcript";
    px-field-pipeline = "pipeline";
    px-field-facts-count = "facts-count";

    org-title = "* Ontology Response";
    org-pipeline-section-header = "** Pipeline";
    org-facts-count-template = "- Facts: ${count}";

    # transcript line 에서 역할 태그 prefix 를 찾아 .org 마크업으로 변환하는
    # 규칙 리스트. runtime 은 리스트를 순서대로 훑어 첫 매치를 적용한다.
    #
    # 매치 안 되면 transcript line 을 그대로 emit (fallback).
    #
    # 각 entry:
    #   input-prefix  : transcript line 이 이 prefix 로 시작하면 매치
    #   output-prefix : 매치된 line 의 input-prefix 를 잘라내고 그 앞에 이 prefix 를 붙여서 emit
    #
    # cross-section 계약: note-templates.transcript-user / transcript-pnix 가
    # transcript-note-prefix 이후에 아래 entry 의 input-prefix 로 이어지는
    # 형식이어야 한다. 예:
    #   transcript-note-prefix       = "transcript:"
    #   note-templates.transcript-user = "transcript:user: ${utterance}"
    #   org-transcript-transforms[0].input-prefix = "user: "
    # 이 일관성을 깨면 transcript 본문이 .org 의 Q: 마크업으로 변환되지 않지만
    # fallback 덕분에 원본 라인 그대로 emit 되므로 production bug 는 아니다.
    org-transcript-transforms = [
      { input-prefix = "user: "; output-prefix = "** Q: "; }
      { input-prefix = "pnix: "; output-prefix = ""; }
    ];
  };

  # ## output-fragment-templates
  #
  # standalone kernel 이 만드는 `KernelOutputFragment` 두 종류 (pipeline-trace,
  # response-document) 의 `kind` 와 `visibility` 값 owner.
  #
  # producer / producer_contract const (`OUTPUT_FRAGMENT_PRODUCER_PNIX`,
  # `OUTPUT_FRAGMENT_CONTRACT_V1`) 는 이 파일에 올리지 않는다. 이 두 값은
  # puck `webview_chat.rs` 의 `producer_contract` / `producer_route` 검증과
  # pairing 되어 있고, puck 쪽은 현재 sanctioned scope 밖이다. drift 위험이
  # 있어서 puck consumer 마이그레이션과 함께 이관해야 한다.
  #
  # loader 는:
  #   - pipeline-trace / response-document 두 entry 가 모두 존재할 것을 강제
  #   - 각 entry 의 `kind` / `visibility` 가 non-empty 문자열일 것을 강제
  output-fragment-templates = {
    pipeline-trace = {
      kind = "pipeline-trace";
      visibility = "dev";
    };
    response-document = {
      kind = "response-document";
      visibility = "dev";
    };
  };

  # ## transcript-note-prefix
  #
  # `transcript_from_notes` 가 envelope notes 중 transcript 라인을 뽑을 때
  # 사용하는 단일 canonical prefix. 이 값은 아래 `note-templates` 의
  # `transcript-user` / `transcript-pnix` 가 공통으로 시작해야 하는 prefix 와
  # 반드시 같아야 한다. loader 가 양쪽 일관성을 강제한다:
  #
  #   transcript-note-prefix = "transcript:"
  #   note-templates.transcript-user  must starts_with "transcript:"
  #   note-templates.transcript-pnix  must starts_with "transcript:"
  #
  # 값을 바꾸려면 이 entry 한 곳만 바꾸면 되고, note-templates 쪽 prefix 강제도
  # 자동으로 그 새 prefix 를 따라간다.
  transcript-note-prefix = "transcript:";

  # ## note-templates
  #
  # standalone kernel 이 semantic ingest envelope 의 `notes` 로 emit 하는
  # pipeline trace / transcript / held / invert 계열 문자열의 owner.
  # 이전에는 Rust 에 `format!("held-reason:{reason}")` 같은 literal 이 박혀 있었다.
  #
  # ### consumer 계약
  #
  # build_response_documents / build_output_fragments 가 pipeline-trace
  # fragment 를 조립할 때 아래 prefix 로 note 를 필터한다:
  #   - "ontology-"
  #   - "truth-regime:"
  #   - "held-"
  # transcript_from_notes 는 "transcript:" prefix 로 transcript line 을 뽑는다.
  #
  # 그래서 loader 는 아래 template 들의 **prefix** 를 위 consumer 계약에 맞게 강제한다:
  #   - transcript-user / transcript-pnix           → "transcript:"
  #   - held-reason / held-term /
  #     held-reopen-reason / held-reopen-term       → "held-"
  #   - truth-regime                                → "truth-regime:"
  # invert-trigger / predicate-query 는 pipeline-trace 필터에 안 걸리므로 prefix 강제 없음.
  #
  # ### template placeholder
  #
  #   - transcript-user      : ${utterance}
  #   - transcript-pnix      : ${response}
  #   - held-reopen-reason   : ${reason}
  #   - held-reopen-term     : ${term}
  #   - held-reason          : ${reason}
  #   - held-term            : ${term}
  #   - invert-trigger       : ${trigger-type}
  #   - truth-regime         : ${regime}
  #   - predicate-query      : ${predicate}
  #
  # 다른 placeholder 는 load 단계에서 schema error 다.
  note-templates = {
    transcript-user = "transcript:user: ${utterance}";
    transcript-pnix = "transcript:pnix: ${response}";
    held-reopen-reason = "held-reopen:reason:${reason}";
    held-reopen-term = "held-reopen:term:${term}";
    held-reason = "held-reason:${reason}";
    held-term = "held-term:${term}";
    invert-trigger = "invert-trigger:${trigger-type}";
    truth-regime = "truth-regime:${regime}";
    predicate-query = "predicate-query:${predicate}";
  };
}
