  { symbol = "q"; quantity-ko = "전하"; unit = "C"; unit-ko = "쿨롱"; context = "Physics.Electromagnetism"; }
  { symbol = "B"; quantity-ko = "자기장"; unit = "T"; unit-ko = "테슬라"; context = "Physics.Electromagnetism"; }
