  { symbol = "G"; quantity-ko = "중력상수"; unit = "N·m²/kg²"; unit-ko = "뉴턴 제곱미터 매 킬로그램 제곱"; context = "Physics.Gravity"; }
  { symbol = "g"; quantity-ko = "중력가속도"; unit = "m/s²"; unit-ko = "미터 매 초 제곱"; context = "Physics.Gravity"; }
