  { symbol = "v"; quantity-ko = "속도"; unit = "m/s"; unit-ko = "미터 매 초"; context = "Physics.Mechanics"; }
  { symbol = "p"; quantity-ko = "운동량"; unit = "kg·m/s"; unit-ko = "킬로그램 미터 매 초"; context = "Physics.Mechanics"; }
  { symbol = "E"; quantity-ko = "에너지"; unit = "J"; unit-ko = "줄"; context = "Physics.Energy"; }
  { symbol = "K"; quantity-ko = "운동에너지"; unit = "J"; unit-ko = "줄"; context = "Physics.Energy"; }
