  { symbol = "W"; quantity-ko = "일"; unit = "J"; unit-ko = "줄"; context = "Physics.Energy"; }
  { symbol = "P"; quantity-ko = "압력"; unit = "Pa"; unit-ko = "파스칼"; context = "Physics.Thermodynamics"; }
  { symbol = "T"; quantity-ko = "온도"; unit = "K"; unit-ko = "켈빈"; context = "Physics.Thermodynamics"; }
  { symbol = "Q"; quantity-ko = "열"; unit = "J"; unit-ko = "줄"; context = "Physics.Thermodynamics"; }
  { symbol = "S"; quantity-ko = "엔트로피"; unit = "J/K"; unit-ko = "줄 매 켈빈"; context = "Physics.Thermodynamics"; }
  { symbol = "I"; quantity-ko = "전류"; unit = "A"; unit-ko = "암페어"; context = "Physics.Electromagnetism"; }
  { symbol = "V"; quantity-ko = "전압"; unit = "V"; unit-ko = "볼트"; context = "Physics.Electromagnetism"; }
