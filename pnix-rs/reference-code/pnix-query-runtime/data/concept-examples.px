# 개념별 예시 + 계산 과정 (hot-reloadable)
# 개념 정의와 분리. "왜 그런지" "어떻게 계산하는지"에 답한다.
{
  examples = [
    {
      concept = "미분";
      examples = [
        {
          title = "x²의 미분";
          input = "f(x) = x²";
          process = "f'(x) = lim(h→0) [(x+h)² - x²] / h = lim(h→0) [2xh + h²] / h = 2x";
          result = "f'(x) = 2x";
          meaning = "x가 1 증가할 때 y는 약 2x만큼 증가한다. x=3이면 기울기가 6이다.";
        }
        {
          title = "sin(x)의 미분";
          input = "f(x) = sin(x)";
          result = "f'(x) = cos(x)";
          meaning = "사인 함수의 변화율은 코사인 함수이다. sin이 최대(1)일 때 변화율은 0이다.";
        }
      ];
      why = "미분이 중요한 이유: 물리에서 속도=위치의 미분, 가속도=속도의 미분이다. 경제학에서 한계비용, 공학에서 최적화 문제에 쓰인다.";
      how = "미분하는 방법: 1) 도함수 정의(극한)로 직접 계산 2) 미분 공식 적용 (합, 곱, 몫, 합성함수) 3) 특수 함수 미분표 활용";
    }
    {
      concept = "적분";
      examples = [
        {
          title = "2x의 적분";
          input = "∫2x dx";
          process = "역도함수: (2x의 역미분) = x² + C";
          result = "x² + C";
          meaning = "넓이로 해석하면, 0에서 a까지 2x의 아래 넓이는 a²이다.";
        }
      ];
      why = "적분이 중요한 이유: 넓이, 부피, 일(에너지), 확률 등 누적량을 계산한다. 미분의 역연산이다.";
      how = "적분하는 방법: 1) 역도함수 구하기 2) 치환적분 3) 부분적분 4) 정적분은 구간의 넓이";
    }
    {
      concept = "힘";
      examples = [
        {
          title = "F=ma 계산";
          input = "질량 3kg, 가속도 4m/s²";
          process = "F = ma = 3 × 4 = 12";
          result = "12 N (뉴턴)";
          meaning = "3kg 물체를 4m/s² 가속하려면 12N의 힘이 필요하다.";
        }
      ];
      why = "힘이 중요한 이유: 모든 운동의 원인이다. 뉴턴 역학의 기초이며, F=ma는 물리학의 가장 기본 법칙이다.";
    }
    {
      concept = "운동에너지";
      examples = [
        {
          title = "Eₖ = ½mv² 계산";
          input = "질량 2kg, 속도 5m/s";
          process = "Eₖ = ½ × 2 × 5² = ½ × 2 × 25 = 25";
          result = "25 J (줄)";
          meaning = "2kg 물체가 5m/s로 움직일 때 25J의 운동에너지를 갖는다.";
        }
      ];
      why = "운동에너지가 중요한 이유: 에너지 보존법칙의 핵심이다. 운동에너지와 위치에너지의 합은 항상 일정하다.";
    }
    {
      concept = "이차방정식";
      examples = [
        {
          title = "x² - 5x + 6 = 0";
          process = "판별식 D = 25 - 24 = 1 > 0. 근의 공식: x = (5 ± 1) / 2";
          result = "x = 3 또는 x = 2";
          meaning = "인수분해하면 (x-2)(x-3) = 0이므로 x=2, x=3이다.";
        }
      ];
      how = "이차방정식 푸는 방법: 1) 인수분해 2) 근의 공식 x = (-b±√(b²-4ac)) / 2a 3) 완전제곱식";
    }
  ];
}
