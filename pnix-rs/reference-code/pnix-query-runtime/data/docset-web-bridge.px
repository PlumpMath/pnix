# docset-web-bridge.px — docset 결과를 ontology fact로 내리는 lowering contract
#
# 목적:
# - Rust는 SQLite/XML 조회만 담당한다.
# - 어떤 predicate로 fact를 만들지, 어떤 domain/api-kind/source로 승격할지는
#   이 파일이 owner가 된다.
# - 즉 "docset 연동"이 아니라 "docset 의미를 pnix ontology로 흡수"하는 계약이다.
#
# 현재 1차 구현 범위:
# - result → ContextualFact lowering
# - language별 api-kind / domain / provenance source
# - description truncate limit
# - related result 연결 개수
# - accept / candidate / held / rejected status gate
# - primary result ranking
# - default trust + language별 source-trust + threshold gate
#
# 아직 이 파일이 하지 않는 것:
# - richer multi-source trust model
# - judge/select/promotion 전체를 별도 `.px` eval로 승격
# 위 둘은 다음 wave에서 같은 surface를 확장한다.
{
  default = {
    predicate-bindings = {
      kind-predicate = "is-a";
      domain-predicate = "domain";
      definition-predicate = "definition-ko";
      signature-predicate = "signature";
      formula-predicate = "formula";
      related-predicate = "related-concept";
    };
    fact-fields = [
      { source = "api-kind"; predicate-key = "kind-predicate"; context = "Docset.ConceptToFact"; layer = "L2"; object-template = "${value}"; }
      { source = "domain"; predicate-key = "domain-predicate"; context = "Docset.ConceptToFact"; layer = "L2"; object-template = "${value}"; }
      { source = "description"; predicate-key = "definition-predicate"; context = "Docset.ConceptToFact"; layer = "L2"; object-template = "${value}"; }
      { source = "signature"; predicate-key = "signature-predicate"; context = "Docset.ConceptToFact"; layer = "L2"; object-template = "${value}"; }
      { source = "signature"; predicate-key = "formula-predicate"; context = "Docset.ConceptToFact"; layer = "L2"; object-template = "${value}"; }
    ];
    list-fields = [
      { source = "related-results"; predicate-key = "related-predicate"; context = "Docset.ConceptToFact"; layer = "L2"; object-template = "${value}"; }
    ];
    source-metadata = {
      context = "Docset.SourceMetadata";
      layer = "L3";
      field-predicate = "docset-source-field";
      value-predicate = "docset-source-value";
      list-field-predicate = "docset-source-list";
      list-item-predicate = "docset-source-item";
      field-object-template = "field:${query-term}:${field}:${source-predicate}";
      value-object-template = "value:${query-term}:${field}:${source-predicate}:${value}";
      list-field-object-template = "list:${query-term}:${field}:${source-predicate}";
      list-item-object-template = "item:${query-term}:${index}:${field}:${source-predicate}:${value}";
    };
    scalar-source-templates = {
      api-kind = "${api-kind}";
      domain = "${domain}";
      description = "${description-truncated}";
      signature = "${signature}";
    };
    list-source-templates = {
      related-results = "${subject}";
    };
    observation-ref-template = "source:${source-prefix}/${lang}";
    subject-template = "${name}";
    episode-id-template = "${episode-prefix}.${lang}.${query-term}";
    knowledge-id-template = "knowledge.docset.${target-status}.${lang}.${query-term}";
    episode-summary-template = "docset bridge lowered '${name}' as ${target-status} knowledge";
    knowledge-summary-template = "docset bridge target status: ${target-status}";
    provenance-templates = [
      "docset-bridge:lang:${lang}"
      "docset-bridge:query:${query-term}"
      "docset-bridge:decision:${decision}"
      "docset-bridge:target-status:${target-status}"
      "docset-bridge:score:${score}"
    ];
    note-templates = [
      "docset-bridge:query:${query-term}"
      "docset-bridge:lang:${lang}"
      "docset-bridge:target-status:${target-status}"
      "docset-bridge:score:${score}"
      "docset-bridge:ranking:px-policy"
    ];
    language-api-kind-template = "${language}-api";
    language-domain-template = "${language}";
    description-max-chars = "300";
    related-limit = "3";
    episode-prefix = "episode.docset";
    source-prefix = "docset";
    recurse-statuses = ["accepted" "candidate"];
    fallback-decision = { decision = "defer"; target-status = "candidate"; confidence = "0.6"; };
    decision-match-policy = "first";
    decision-rules = [
      { decision = "accept"; target-status = "accepted"; min-score = "1.10"; requires-quality = "true"; confidence = "1.0"; }
      { decision = "defer"; target-status = "candidate"; min-score = "0.65"; confidence = "0.8"; }
      { decision = "hold"; target-status = "held"; min-score = "0.35"; confidence = "0.45"; }
      { decision = "reject"; target-status = "rejected"; min-score = "0.0"; confidence = "0.2"; }
    ];
    quality-empty-policy = "pass";
    quality-match-policy = "any";
    quality-rules = [
      { kind = "signature-presence"; }
      { kind = "description-min-chars"; min-chars = "32"; }
    ];
    score-base-trust = "0.35";
    score-aggregation = "sum";
    score-rules = [
      { kind = "base-trust"; weight = "1.0"; }
      { kind = "signature-presence"; weight = "1.0"; }
      { kind = "description-length-ratio"; weight = "0.75"; cap-chars = "160"; }
    ];
    selection-rules = [
      { kind = "score-desc"; }
      { kind = "name-asc"; }
    ];
  };

  languages = [
    { language = "javascript"; api-kind = "javascript-api"; domain = "javascript"; source-trust = "0.45"; }
    { language = "python"; api-kind = "python-api"; domain = "python"; source-trust = "0.45"; }
    { language = "rust"; api-kind = "rust-api"; domain = "rust"; source-trust = "0.45"; }
    { language = "go"; api-kind = "go-api"; domain = "go"; source-trust = "0.45"; }
    { language = "java"; api-kind = "java-api"; domain = "java"; source-trust = "0.45"; }
    { language = "unity"; api-kind = "unity-api"; domain = "unity"; source-trust = "0.55"; }
    { language = "rhino"; api-kind = "rhino-api"; domain = "rhino"; source-trust = "0.50"; }
    { language = "grasshopper"; api-kind = "grasshopper-api"; domain = "grasshopper"; source-trust = "0.50"; }
    { language = "csharp"; api-kind = "csharp-api"; domain = "csharp"; source-trust = "0.40"; }
  ];

  # scoreEntry — docset entry 에 대한 score 를 계산하는 `.px eval owner`.
  # Rust `score_docset_entry` (또는 후속 renamed helper) 가 pnix-eval library
  # 를 통해 이 lambda 를 호출한다. pnixc --eval 은 foldl' + attrset 조합에서
  # "evaluation environment dropped" 버그가 있으므로 fixture 가 이 lambda 를
  # 직접 호출하지는 않고, conceptToFact 만 fixture 에서 exercise 한다. 이
  # lambda 는 production Rust 쪽 pnix-eval library path 로만 실행된다.
  # payload shape:
  #   { base-trust: Float, has-signature: Bool, description-length: Int,
  #     aggregation: String ("sum"|"max"),
  #     rules: [ { kind: String, weight: Float, cap-chars: Int } ] }
  # 반환:
  #   { score: Float }
  scoreEntry = payload: {
    score = builtins.foldl' (acc: rule:
      (
        if payload.aggregation == "max" then
          (
            if (
              if rule.kind == "base-trust" then payload.base-trust * rule.weight
              else if rule.kind == "signature-presence" then (if payload.has-signature then rule.weight else 0.0)
              else if rule.kind == "description-length-ratio" then (
                (if payload.description-length > rule.cap-chars then rule.cap-chars else payload.description-length) * 1.0 / (if rule.cap-chars > 0 then rule.cap-chars else 1) * rule.weight
              )
              else 0.0
            ) > acc then (
              if rule.kind == "base-trust" then payload.base-trust * rule.weight
              else if rule.kind == "signature-presence" then (if payload.has-signature then rule.weight else 0.0)
              else if rule.kind == "description-length-ratio" then (
                (if payload.description-length > rule.cap-chars then rule.cap-chars else payload.description-length) * 1.0 / (if rule.cap-chars > 0 then rule.cap-chars else 1) * rule.weight
              )
              else 0.0
            ) else acc
          )
        else
          acc + (
            if rule.kind == "base-trust" then payload.base-trust * rule.weight
            else if rule.kind == "signature-presence" then (if payload.has-signature then rule.weight else 0.0)
            else if rule.kind == "description-length-ratio" then (
              (if payload.description-length > rule.cap-chars then rule.cap-chars else payload.description-length) * 1.0 / (if rule.cap-chars > 0 then rule.cap-chars else 1) * rule.weight
            )
            else 0.0
          )
      )
    ) 0.0 payload.rules;
  };

  # acceptQuality — docset entry 의 quality (signature 존재 / description 최소
  # 길이) 를 평가하는 `.px eval owner`. Rust `docset_bridge_meets_accept_quality`
  # (후속 `docset_quality_via_px_eval`) 가 pnix-eval library 로 이 lambda 를
  # 호출한다. payload shape:
  #   { has-signature: Bool, description-length: Int,
  #     empty-policy: String ("pass"|"fail"),
  #     match-policy: String ("any"|"all"),
  #     rules: [ { kind: String ("signature-presence"|"description-min-chars"),
  #                min-chars: Int } ] }
  # 반환:
  #   { accepted: Bool }
  acceptQuality = payload: {
    accepted = (
      if (builtins.length payload.rules) == 0 then
        (payload.empty-policy == "pass")
      else (
        if payload.match-policy == "all" then
          (builtins.foldl' (acc: rule:
            acc && (
              if rule.kind == "signature-presence" then payload.has-signature
              else if rule.kind == "description-min-chars" then (payload.description-length >= rule.min-chars)
              else false
            )
          ) true payload.rules)
        else
          (builtins.foldl' (acc: rule:
            acc || (
              if rule.kind == "signature-presence" then payload.has-signature
              else if rule.kind == "description-min-chars" then (payload.description-length >= rule.min-chars)
              else false
            )
          ) false payload.rules)
      )
    );
  };

  # decideEntry — score + quality 를 바탕으로 docset entry 의 decision
  # (accept/defer/hold/reject) 을 선택하는 `.px eval owner`. Rust
  # `docset_bridge_decision_for_entry` (후속 `docset_decision_via_px_eval`)
  # 가 pnix-eval library 로 이 lambda 를 호출한다. payload shape:
  #   { score: Float, has-min-quality: Bool,
  #     match-policy: String ("first"|"last"),
  #     rules: [ { decision, target-status, min-score, confidence,
  #                requires-quality: Bool } ],
  #     fallback: { decision, target-status, min-score, confidence,
  #                 requires-quality: Bool } }
  # 반환:
  #   { decision-label: String, target-status-label: String,
  #     confidence: Float, score: Float, matched: Bool }
  decideEntry = payload: (
    let
      initial = { found = false; rule = payload.fallback; };
      folder = acc: rule: (
        let matches = (payload.score >= rule.min-score)
                      && ((!rule.requires-quality) || payload.has-min-quality);
        in
          if payload.match-policy == "last" then
            (if matches then { found = true; rule = rule; } else acc)
          else
            (if acc.found then acc
             else (if matches then { found = true; rule = rule; } else acc))
      );
      result = builtins.foldl' folder initial payload.rules;
    in {
      decision-label = result.rule.decision;
      target-status-label = result.rule.target-status;
      confidence = result.rule.confidence;
      score = payload.score;
      matched = result.found;
    }
  );

  # compareEntries — docset entry 쌍의 ordering 을 selection-rules 에 따라
  # 계산하는 `.px eval owner`. pnix-eval library 가 string 비교 연산자를
  # 지원하지 않아, Rust 가 score-sign / name-sign 을 pre-compute 해서
  # payload 로 넘긴다. `.px` 는 rule.kind → 어느 sign 을 쓸지 + asc/desc
  # 방향 결정만 담당한다. payload shape:
  #   { score-sign: Int (-1/0/1, sign of left.score - right.score),
  #     name-sign:  Int (-1/0/1, sign of left.name .cmp right.name),
  #     rules: [ { kind: String ("score-desc"|"score-asc"|"name-asc"|"name-desc") } ] }
  # 반환:
  #   { ordering: Int (-1 = left first, 1 = right first, 0 = equal) }
  compareEntries = payload: (
    let
      folder = acc: rule: (
        if acc != 0 then acc
        else if rule.kind == "score-desc" then (0 - payload.score-sign)
        else if rule.kind == "score-asc" then payload.score-sign
        else if rule.kind == "name-asc" then payload.name-sign
        else if rule.kind == "name-desc" then (0 - payload.name-sign)
        else 0
      );
    in { ordering = builtins.foldl' folder 0 payload.rules; }
  );

  # conceptToFact — docset entry 를 ontology fact 로 lift 하는 `.px eval owner`.
  # pnix-eval / pnixc --eval 이 이 lambda 를 실제 실행한다. PxValue 기반
  # 선언적 reducer (decision-rules / score-rules / quality-rules 등) 는
  # 여전히 위에 있지만, conceptToFact 는 runtime 판단을 `.px` 로 끌어올리는
  # 첫 번째 eval-owner 본체다. payload 는 아래 shape 를 가정한다:
  #   { name, language, api-kind, domain, description, signature,
  #     related-results, source-trust, query-term, description-truncated }
  # 반환 attrset 은 fixture 의 proof gate (`proof` + `used-px-owner`) 와
  # runtime caller 가 함께 소비한다. builtins.ontologyLift 호출로 최소 1개
  # observation fact 를 Candidate 로 lift 한다.
  conceptToFact = payload: {
    proof = "docset-web-bridge-conceptToFact";
    used-px-owner = true;
    subject = payload.name;
    language = payload.language;
    api-kind = payload.api-kind;
    domain = payload.domain;
    description = payload.description;
    # ontology lift — definition-ko carrier 를 Candidate 로 올린다.
    definition-fact = builtins.ontologyLift {
      value = payload.description;
      predicate = "definition-ko";
      subject = payload.name;
    } "Docset.ConceptToFact";
    # ontology lift — is-a (api-kind) carrier.
    kind-fact = builtins.ontologyLift {
      value = payload.api-kind;
      predicate = "is-a";
      subject = payload.name;
    } "Docset.ConceptToFact";
    # ontology lift — domain carrier.
    domain-fact = builtins.ontologyLift {
      value = payload.domain;
      predicate = "domain";
      subject = payload.name;
    } "Docset.ConceptToFact";
  };
}
