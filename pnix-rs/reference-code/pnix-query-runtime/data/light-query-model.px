{
  # context별 한국어 라벨 (cache hit 응답에서 사용)
  context-labels = [
    { context = "Physics.Light.General"; label-ko = "빛 일반 맥락"; }
    { context = "Physics.Light.DoubleSlit"; label-ko = "이중슬릿 맥락"; }
    { context = "Physics.Light.Photoelectric"; label-ko = "광전효과 맥락"; }
  ];

  # batch 186 (2026-04-16): light dialogue 의 초기 held context.
  # `"빛은 뭐야?"` 같은 context-free 질문이 처음 들어올 때 저장되는 subject
  # context namespace. follow-up 은 narrower `Physics.Light.DoubleSlit` /
  # `Physics.Light.Photoelectric` 로 reopen 한다. Rust 는 이 context 리터럴을
  # 직접 하드코딩하지 않고 이 section 에서 읽는다.
  initial-held-context = "Physics.Light.General";

  question-rules = [
    {
      utterance-all = ["빛" "뭐"];
    }
  ];

  followup-rules = [
    {
      initial-all = ["빛"];
      follow-up-all = ["이중슬릿"];
      selected-context = "Physics.Light.DoubleSlit";
    }
    {
      initial-all = ["빛"];
      follow-up-all = ["광전효과"];
      selected-context = "Physics.Light.Photoelectric";
    }
  ];

  # batch 35 (2026-04-14) 에서 `handoff_concept_terms_for_template` 이
  # `parse_korean_arithmetic` / `parse_korean_newton_force` structured parser
  # 경유로 옮겨진 뒤 `utterance-triggers` 는 runtime 에서 더 이상 읽히지 않는다.
  # batch 36 에서 legacy data 를 삭제. concept term 매핑은 이제 Rust parser
  # output (`operator_ko` / newton triple) 이 소유한다.
  handoff-template-rules = [
    {
      template-id = "pnix.math.arithmetic.safe-handoff";
      fixed-terms = [];
    }
    {
      template-id = "pnix.physics.newton-force.safe-handoff";
      fixed-terms = ["힘"];
    }
  ];
}
