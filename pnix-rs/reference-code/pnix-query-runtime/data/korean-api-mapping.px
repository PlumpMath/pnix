# korean-api-mapping.px — 한글 프로그래밍 용어 → 영어 API 이름 매핑 (hot-reloadable)
#
# docset 검색 시 한글 용어를 영어 API로 자동 변환.
# "배열은 뭐야?" → javascript.Array 검색
# "함수란?" → javascript.Function 검색
{
  # 한글 → 영어 API 매핑 (언어 무관 — 공통 프로그래밍 개념)
  common = [
    { ko = "배열"; en = "Array"; }
    { ko = "함수"; en = "Function"; }
    { ko = "객체"; en = "Object"; }
    { ko = "문자열"; en = "String"; }
    { ko = "숫자"; en = "Number"; }
    { ko = "불리언"; en = "Boolean"; }
    { ko = "맵"; en = "Map"; }
    { ko = "셋"; en = "Set"; }
    { ko = "프로미스"; en = "Promise"; }
    { ko = "비동기"; en = "async"; }
    { ko = "반복자"; en = "Iterator"; }
    { ko = "생성자"; en = "constructor"; }
    { ko = "클래스"; en = "class"; }
    { ko = "상속"; en = "extends"; }
    { ko = "인터페이스"; en = "interface"; }
    { ko = "제네릭"; en = "generics"; }
    { ko = "타입"; en = "type"; }
    { ko = "변수"; en = "variable"; }
    { ko = "상수"; en = "const"; }
    { ko = "루프"; en = "loop"; }
    { ko = "조건문"; en = "conditional"; }
    { ko = "예외"; en = "Error"; }
    { ko = "이벤트"; en = "Event"; }
    { ko = "리스트"; en = "list"; }
    { ko = "딕셔너리"; en = "dict"; }
    { ko = "튜플"; en = "tuple"; }
    { ko = "람다"; en = "lambda"; }
    { ko = "클로저"; en = "closure"; }
    { ko = "모듈"; en = "module"; }
    { ko = "패키지"; en = "package"; }
    { ko = "임포트"; en = "import"; }
  ];

  # JavaScript 전용
  javascript = [
    { ko = "도큐먼트"; en = "document"; }
    { ko = "엘리먼트"; en = "Element"; }
    { ko = "노드"; en = "Node"; }
    { ko = "이벤트리스너"; en = "addEventListener"; }
    { ko = "페치"; en = "fetch"; }
    { ko = "웹소켓"; en = "WebSocket"; }
    { ko = "캔버스"; en = "Canvas"; }
    { ko = "로컬스토리지"; en = "localStorage"; }
    { ko = "셋타임아웃"; en = "setTimeout"; }
    { ko = "콘솔"; en = "console"; }
  ];

  # Python 전용
  python = [
    { ko = "리스트"; en = "list"; }
    { ko = "딕셔너리"; en = "dict"; }
    { ko = "집합"; en = "set"; }
    { ko = "튜플"; en = "tuple"; }
    { ko = "출력"; en = "print"; }
    { ko = "범위"; en = "range"; }
    { ko = "길이"; en = "len"; }
    { ko = "정렬"; en = "sorted"; }
    { ko = "필터"; en = "filter"; }
    { ko = "매핑"; en = "map"; }
  ];

  # docset 언어 선택 정책 — common 섹션 매칭일 때 시도 순서.
  # 한글 fallback이 어느 언어 docset을 우선 검색할지 결정한다.
  # 언어 전용 섹션(javascript/python/...) 매칭은 해당 언어를 직접 사용.
  language-priority = [ "javascript" "python" "rust" "go" "java" ];
}
