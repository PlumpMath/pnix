# Python builtin 함수 — ontology fact로 선언 (hot-reloadable)
# "python의 print가 뭐야?" → 정의 + 예시 + 해석
# 새 함수 추가 = 이 파일에 항목 추가. Rust 재빌드 0.
{
  examples = [
    {
      concept = "python.print";
      examples = [
        { title = "기본 출력"; input = "print('hello')"; result = "hello"; meaning = "문자열을 표준 출력에 출력한다. 줄바꿈이 자동으로 붙는다."; }
        { title = "여러 값 출력"; input = "print(1, 2, 3, sep=', ')"; result = "1, 2, 3"; meaning = "sep으로 구분자를 지정하면 여러 값 사이에 그 문자가 들어간다."; }
      ];
      why = "print는 디버깅과 사용자 출력의 기본이다. f-string과 함께 가장 많이 쓰인다.";
    }
    {
      concept = "python.len";
      examples = [
        { title = "리스트 길이"; input = "len([1, 2, 3])"; result = "3"; meaning = "리스트, 문자열, 딕셔너리 등 컬렉션의 원소 수를 반환한다."; }
        { title = "문자열 길이"; input = "len('hello')"; result = "5"; meaning = "문자열의 글자 수를 센다. 유니코드 문자도 1글자로 센다."; }
      ];
    }
    {
      concept = "python.range";
      examples = [
        { title = "0부터 4까지"; input = "list(range(5))"; result = "[0, 1, 2, 3, 4]"; meaning = "range(n)은 0부터 n-1까지의 정수 시퀀스를 만든다. 리스트가 아니라 iterator다."; }
        { title = "시작/끝/간격"; input = "list(range(2, 10, 3))"; result = "[2, 5, 8]"; meaning = "range(start, stop, step)으로 시작값, 끝값(미포함), 간격을 지정한다."; }
      ];
    }
    {
      concept = "python.map";
      examples = [
        { title = "각 원소 변환"; input = "list(map(str, [1, 2, 3]))"; result = "['1', '2', '3']"; meaning = "각 원소에 함수를 적용한다. pnix의 builtins.map과 같은 개념이다."; }
      ];
      why = "Python의 map은 pnix의 builtins.map과 동일한 함수형 패턴이다. 다만 Python에서는 list comprehension이 더 자주 쓰인다.";
    }
    {
      concept = "python.filter";
      examples = [
        { title = "짝수만"; input = "list(filter(lambda x: x % 2 == 0, [1, 2, 3, 4]))"; result = "[2, 4]"; meaning = "조건 함수가 True를 반환하는 원소만 남긴다. pnix의 builtins.filter와 같다."; }
      ];
    }
    {
      concept = "python.zip";
      examples = [
        { title = "두 리스트 묶기"; input = "list(zip([1, 2, 3], ['a', 'b', 'c']))"; result = "[(1, 'a'), (2, 'b'), (3, 'c')]"; meaning = "여러 iterable을 병렬로 묶어 tuple의 시퀀스를 만든다."; }
      ];
    }
    {
      concept = "python.enumerate";
      examples = [
        { title = "인덱스 포함 순회"; input = "list(enumerate(['a', 'b', 'c']))"; result = "[(0, 'a'), (1, 'b'), (2, 'c')]"; meaning = "인덱스와 값을 함께 순회한다. for i, v in enumerate(lst) 패턴으로 가장 많이 쓴다."; }
      ];
    }
    {
      concept = "python.sorted";
      examples = [
        { title = "정렬"; input = "sorted([3, 1, 4, 1, 5])"; result = "[1, 1, 3, 4, 5]"; meaning = "새 정렬된 리스트를 반환한다. 원본은 변경하지 않는다."; }
        { title = "역순 정렬"; input = "sorted([3, 1, 4], reverse=True)"; result = "[4, 3, 1]"; meaning = "reverse=True로 내림차순 정렬한다. key= 인자로 정렬 기준을 지정할 수도 있다."; }
      ];
    }
    {
      concept = "python.isinstance";
      examples = [
        { title = "타입 확인"; input = "isinstance(42, int)"; result = "True"; meaning = "객체가 특정 타입인지 확인한다. 상속 관계도 인식한다."; }
      ];
    }
    {
      concept = "python.dict.get";
      examples = [
        { title = "기본값 조회"; input = "{'a': 1}.get('b', 0)"; result = "0"; meaning = "키가 없으면 기본값을 반환한다. KeyError가 나지 않아 안전하다."; }
      ];
    }
    {
      concept = "python.list_comprehension";
      examples = [
        { title = "리스트 컴프리헨션"; input = "[x**2 for x in range(5)]"; result = "[0, 1, 4, 9, 16]"; meaning = "for 루프와 조건을 한 줄로 표현하여 새 리스트를 만든다. Pythonic한 핵심 문법이다."; }
        { title = "조건 포함"; input = "[x for x in range(10) if x % 2 == 0]"; result = "[0, 2, 4, 6, 8]"; meaning = "if 절로 조건을 걸어 필터링하면서 변환한다. filter+map을 한 줄로."; }
      ];
      why = "리스트 컴프리헨션은 Python에서 가장 많이 쓰이는 패턴이다. map/filter보다 가독성이 좋다.";
    }
  ];
}
