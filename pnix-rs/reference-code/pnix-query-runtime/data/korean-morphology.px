# 한국어 형태 정규화 규칙 (정본).
# generic table + generator 방식: Rust가 데카르트곱 자동 확장.
# retrieval.rs가 이 파일을 hot-reload로 참조.
{
  # 조사/어미 제거 목록 (길이 내림차순 정렬)
  strip-suffixes = [
    "에서는" "으로는" "이란" "이다" "에서" "에게" "으로" "에는"
    "이고" "이며" "하다" "하는" "한다" "했다" "해서" "하면"
    "란" "에" "을" "를" "은" "는" "이" "가" "의" "과" "와"
  ];

  # 보조 동사 목록 — 이것만 나오면 앞 토큰이 본동사.
  # batch 137 (2026-04-16): retrieval.rs AUXILIARY_VERBS const 에서 .px owner 로 이관.
  auxiliary-verbs = [
    "있다" "없다" "않다" "못하다" "하다" "보다" "주다" "싶다" "되다"
  ];

  # 보조 동사 앞에 오는 연결 어미 — "먹고 있다" 의 "고" 같은 suffix.
  # batch 138 (2026-04-16): retrieval.rs looks_like_auxiliary_companion inline array
  # 에서 .px owner 로 이관.
  auxiliary-companion-suffixes = [
    "고" "지" "게" "서" "어" "아" "며" "면서" "려고" "려" "도록"
  ];

  # 인용 어미 — clause splitter 가 quotation clause 를 감지할 때 사용.
  # batch 139 (2026-04-16): retrieval.rs 의 inline quote_markers 에서 이관.
  quote-markers = [
    "다고" "라고" "냐고" "자고"
  ];

  # Intent / SearchDepth / OutputScope enum → Korean label 매핑.
  # batch 153 (2026-04-16): intent.rs QueryIntent::korean_description 에서 이관.
  intent-type-labels = {
    Definition = "정의 질문";
    Explanation = "설명 요청";
    Computation = "계산 요청";
    Comparison = "비교 질문";
    Listing = "목록 요청";
    PropertyQuery = "속성 질문";
    Continuation = "이어가기";
    EquationSolve = "방정식 풀이";
    VectorOperation = "벡터 연산";
    PhysicsFormula = "물리 공식 적용";
    Unknown = "의도 불명";
  };
  search-depth-labels = {
    Shallow = "얕은 탐색";
    Medium = "보통 탐색";
    Deep = "깊은 탐색";
    Targeted = "대상 지정 탐색";
    None = "탐색 불필요";
  };
  output-scope-labels = {
    Brief = "간략 응답";
    Standard = "표준 응답";
    Detailed = "상세 응답";
  };
  intent-description-labels = {
    intent-prefix = "의도";
    primary-terms-prefix = "핵심 용어";
    confidence-prefix = "확신도";
  };
  # intent 감지 근거 라벨 (evidence strings). analyze_intent 가 candidate
  # 후보 push 할 때 "계산 키워드 감지" 같은 한 줄 reason 을 남긴다.
  # batch 154 (2026-04-16): intent.rs 에서 이관.
  intent-evidence-labels = {
    computation = "계산 키워드 감지";
    equation = "방정식 패턴 감지";
    vector = "벡터 패턴 감지";
    physics = "물리 공식 패턴 감지";
    calculus = "미적분 패턴 감지";
    comparison = "비교 키워드 감지";
    listing = "목록 키워드 감지";
    continuation = "이어가기 패턴 감지";
    property = "속성 키워드 감지";
    explanation = "설명 패턴 감지";
    definition = "정의 질문 패턴 감지";
    unknown = "의도 불명";
    depth-upgrade = "상세 요청 수식어로 depth 상향";
    scope-downgrade = "간략 요청 수식어로 scope 하향";
  };

  # 한글 산술 연산자 → 기호 매핑. "5 더하기 3" 을 '+' 로 parse.
  # batch 152 (2026-04-16): computation.rs parse_korean_arithmetic 의
  # inline ops 배열을 .px owner 로 이관.
  korean-arithmetic-operators = [
    { korean = "더하기"; symbol = "+"; }
    { korean = "빼기"; symbol = "-"; }
    { korean = "곱하기"; symbol = "×"; }
    { korean = "나누기"; symbol = "÷"; }
  ];

  # 문장 의미 분석 결과 설명에 쓰이는 scalar label 들.
  # batch 151/166 (2026-04-16): retrieval.rs analyze_sentence_semantics 에서 이관.
  sentence-analysis-labels = {
    verb-prefix = "동사";
    frame-label = "frame";
    negation = "부정";
    commonsense-prefix = "상식";
    violation-prefix = "제약 위반";
    related-prefix = "관련";
    multi-clause-prefix = "절 복문 분석";
  };

  # Recipe OS 명령어 target 추출 시 제거할 한글 동사/접두어.
  # "문서 열어줘" → "문서" 로 뽑기 위해 동사/수식어를 strip.
  # batch 156 (2026-04-16): conversation.rs handoff_target 추출부에서 이관.
  recipe-command-strip-words = [
    "열어줘" "실행해줘" "켜줘" "찾아줘" "보여줘" "파일 "
  ];

  # 인사/작별 episode summary prefix.
  # batch 156 (2026-04-16): conversation.rs greeting/farewell dispatch 에서 이관.
  dialogue-scalars = {
    greeting-summary-prefix = "인사";
    farewell-summary-prefix = "작별";
    why-default-provenance = "직접 정의됨";
  };

  # batch 256 (2026-04-18): emergent_search.rs 의 한글 메시지/템플릿 owner.
  # `emergent-search-empty-result`: search_web 결과가 0 건일 때 transcript.
  # `emergent-search-empty-follow-up`: 같은 상황에서 내보내는 follow-up hint.
  # `emergent-search-ko-definition-template`: 한글 질의에 추가로 붙이는 보조
  #   쿼리 템플릿. placeholder `{clean}` 가 utterance.trim() 으로 치환된다.
  emergent-search-empty-result = "검색 결과 없음.";
  emergent-search-empty-follow-up =
    "네트워크를 확인하거나 다른 표현으로 질문해주세요.";
  emergent-search-ko-definition-template = "{clean} 정의 뜻";

  # batch 257 (2026-04-18): expr.rs `try_computation_envelope` 전처리 affix.
  # 사용자 발화에서 "수식이 아닌 한글 꼬리" 를 제거할 때 쓴다.
  # 순서 중요 — 긴 affix 가 먼저 (짧은 affix 가 긴 affix 의 접두부를 먹어
  # 버리지 않도록). Rust 는 이 리스트를 순회만 하고 어느 affix 를 지울지는
  # 모른다.
  computation-cleanup-affixes = [
    "계산해줘" "계산해" "계산"
    "간단히" "자세히"
    "은 뭐야?" "는 뭐야?" "은 뭐야" "는 뭐야"
    "은 얼마야?" "는 얼마야?" "은 얼마야" "는 얼마야"
    "은?" "는?"
  ];

  # Cache hit 응답 조립 템플릿. conversation/cache.rs 가 저장된 응답을 재사용
  # 할 때 사용자에게 내보내는 Korean 문구들.
  # batch 169 (2026-04-16): cache.rs 의 Korean format! / literal 이관.
  cache-hit-templates = {
    default-cached-summary = "doghouse가 저장된 응답을 다시 조립했다";
    narrow-followup-available = "더 좁은 맥락 follow-up 가능";
    selected-context = "선택 맥락 ${label}";
    related-info = "관련 정보: ${info}.";
    related-links = "관련 링크: ${links}.";
    context-summary = " 관련 맥락 ${count}개(${contexts})가 함께 저장되어 있다.";
    response-summary =
      "doghouse가 저장소에서 같은 한국어 질문의 기존 응답을 빠르게 재사용했다. ${mode} 일치로 관련 저장 응답 ${count}개를 참고했다.${context-summary} ${clean-summary}";
    response-summary-split-anchor = "doghouse가 저장소에서 같은 한국어 질문의 기존 응답을";
    reuse-note-marker = "기존 응답을 빠르게 재사용";
  };

  # Context pronoun merge 템플릿. "그거" + "예시" → "운동량의 예시" 재조합 시
  # 사용하는 Korean 연결 문구. batch 167 (2026-04-16): conversation.rs 에서 이관.
  context-merge-templates = {
    of-utterance = "${prev}의 ${utterance}";
    recipe-shell-command = "${summary}\n실행 명령: ${shell-cmd}";
  };

  # Invert (P8) why/contradiction response prose 템플릿. conversation.rs P8
  # dispatch 에서 사용하는 Korean format.
  # batch 168 (2026-04-16): why-no-text-fallback / contradiction-branch-desc 이관.
  invert-response-templates = {
    why-no-text-fallback = "'${term}'이(가) '${definition}'인 이유: 근거는 [${prov}]이다.";
    contradiction-branch-desc = "'${term}'에 대해 ${count}개의 서로 다른 정의가 존재한다: ${samples}";
  };

  # Computation dispatch summary 템플릿 — computation.rs 의 각 compute branch
  # 가 episode summary 에 남기는 Korean 한 줄 요약.
  # batch 175 (2026-04-16): computation.rs 에서 이관.
  computation-summary-templates = {
    unit-conversion = "doghouse가 단위를 변환했다. ${from} → ${to}: ${result}.";
    percentage = "doghouse가 백분율을 계산했다. ${base}의 ${pct}% = ${result}.";
    mixed-query = "doghouse가 혼합 수식을 계산했다. 결과: ${result}.";
    result-prefix = "계산 결과: ${value}";
    dimension-check = "차원 검사: ${check}";
    calculus-op = "doghouse가 ${op}을 수행했다. ${op}(${input}) = ${result}.";
    calculus-step = "규칙 ${rule}: ${input} → ${output}";
    calculus-result-brief = "${op} 결과: ${result}";
    calculus-op-name-summary = "doghouse가 ${op-name}을(를) 계산했다. ${canonical}.";
    # batch 192 (2026-04-16): 연산 종류 detail line + 계산 오류 prefix.
    detail-op-kind = "연산 종류: ${op-name}";
    error-prefix = "계산 오류: ${error}";
    linear-equation = "1차 방정식: ${canonical}";
    equation-original = "원식: ${canonical}";
    equation-solution = "풀이 결과: ${canonical}";
    # batch 193 (2026-04-16): 방정식 풀이 summary + 판별식 + 변수 결과 template.
    linear-equation-summary = "doghouse가 1차 방정식을 풀었다. ${canonical} → ${solution}.";
    quadratic-equation-summary = "doghouse가 2차 방정식을 풀었다. ${canonical} → ${solution}.";
    variable-result = "변수 ${var} = ${value}";
    discriminant-positive = "판별식 D = ${value} > 0 → 서로 다른 두 실근";
    discriminant-zero = "판별식 D = 0 → 중근";
    discriminant-negative = "판별식 D = ${value} < 0 → 실수 해 없음";
    # batch 194 (2026-04-16): 미적분 연산 한글 라벨.
    # computation.rs calculus dispatch 에서 op 한글 이름 + concept lookup term.
    calculus-op-differentiate = "미분";
    calculus-op-integrate = "적분";
  };

  # batch 189 (2026-04-16): 한국어 큰 수 단위명.
  # `format_korean_integer` 가 10000/1억/1조 단위로 수를 표기할 때 쓰는
  # 한글 접미사. Rust 는 수치 분기(abs >= 1조, abs >= 1억, abs >= 1만)만
  # 수행하고 접미사 자체는 이 `.px` 에서 읽는다.
  korean-number-units = {
    jo = "조";
    eok = "억";
    man = "만";
  };

  # computation-kind 한글 라벨.
  # batch 175 (2026-04-16): '단위 변환' 같은 computation-kind fact object 라벨.
  # batch 195 (2026-04-16): percentage / mixed-query 에 "계산" 접미 full label 추가
  # + percentage-canonical template + equation-concept-term.
  computation-kind-labels = {
    unit-conversion = "단위 변환";
    percentage = "백분율";
    percentage-full = "백분율 계산";
    mixed-query = "혼합 수식";
    mixed-query-full = "혼합 수식 계산";
  };

  # batch 195 (2026-04-16): 백분율 결과 canonical form.
  percentage-canonical-template = "${base}의 ${pct}% = ${result}";

  # batch 195: 방정식 개념 lookup term. concept_facts_for_term 에 전달.
  equation-concept-term = "방정식";

  # batch 198 (2026-04-16): continuation 응답 조립 + cross-concept 비교 응답 template.
  continuation-response-templates = {
    elaborate-header = "${term}에 대해 더 자세히 설명한다.";
    example-header = "${term}의 구체적인 사용 예시:";
    example-formula = "공식으로 보면 ${formula}이다.";
    example-definition = "정의: ${definition}";
    example-related = "관련 개념인 ${related}와 함께 쓰이는 경우가 많다.";
    related-empty = "${term}에는 등록된 관련 개념이 없다.";
    related-header = "${term}의 관련 개념: ${list}.";
    summary = "doghouse가 이전 '${term}' 질의를 이어서 ${kind} 응답을 했다.";
  };
  cross-concept-response-templates = {
    inverse-ab = "${a}은(는) ${b}의 역연산이다.";
    inverse-ba = "${b}은(는) ${a}의 역연산이다.";
    same-category = "둘 다 같은 분류(${category})에 속한다.";
    same-domain-diff-category = "둘 다 같은 도메인(${domain})이지만 분류가 다르다(${cat-a}, ${cat-b}).";
    related-link = "서로 관련 개념으로 연결되어 있다.";
    summary = "doghouse가 '${a}'와 '${b}'의 관계를 온톨로지에서 비교하여 응답했다.";
  };

  # batch 199 (2026-04-16): 한국어 산술 연산 동사 → 명사(개념) 매핑.
  # handoff_concept_terms_for_template 에서 operator_ko ("더하기")를 concept term
  # ("덧셈")으로 변환할 때 사용. Rust match arm 의 한글 literal 4 개를 이관.
  # px_loader 의 key 는 identifier 만 가능하므로 (한글 quoted key 미지원)
  # list-of-pair 형식으로 저장한다.
  arithmetic-operator-concept-mapping = [
    { operator = "더하기"; concept = "덧셈"; }
    { operator = "빼기"; concept = "뺄셈"; }
    { operator = "곱하기"; concept = "곱셈"; }
    { operator = "나누기"; concept = "나눗셈"; }
  ];

  # batch 201 (2026-04-16): concept_seed.rs summary template.
  concept-seed-summary-templates = {
    legacy-observation = "한글 수학/물리 개념 어휘 seed: 엄밀한 정의, 영어 formal name, 기호, 관련 개념";
    legacy-episode-summary = "수학/물리 핵심 개념의 한글 정의 어휘 (accepted seed)";
    px-load-observation = ".px 파일에서 ${count}개 개념 로드";
    px-load-episode-summary = ".px 파일 기반 개념 어휘 (${count}개)";
  };

  # batch 199: newton force handoff 에서 "힘" 외에 추가로 삽입할 concept term.
  # "힘" 은 light-query-model.px fixed-terms 에 이미 있으므로 여기는 나머지만.
  newton-force-extra-concept-terms = ["질량" "가속도"];

  # batch 203 (2026-04-16): expr.rs 수학 에러 메시지 21 개.
  # MathExpr::eval / solve_linear / solve_quadratic / eval_vector 에서
  # 사용하는 EvalError 한글 메시지. Rust 는 key lookup + placeholder 치환만.
  math-error-messages = {
    division-by-zero = "0으로 나눌 수 없다.";
    sqrt-negative = "음수의 제곱근은 실수 범위에서 정의되지 않는다.";
    factorial-range = "팩토리얼은 0 이상 20 이하의 정수에서만 계산된다.";
    equation-not-equation = "방정식 형태(= 포함)가 아니다.";
    equation-no-variable = "방정식에 변수가 없다.";
    equation-identity = "항등식이다. 모든 값이 해이다.";
    equation-contradiction = "모순이다. 해가 없다.";
    equation-variable-cancelled = "변수가 소거됐다.";
    equation-no-real-solution = "실수 해가 없다 (판별식 < 0).";
    equation-double-root = "${var} = ${value} (중근)";
    equation-not-linear = "이 식은 1차 방정식으로 풀 수 없다.";
    equation-not-quadratic = "이 식은 2차 방정식으로 풀 수 없다.";
    equation-degree-too-high = "3차 이상의 식은 풀 수 없다.";
    equation-quadratic-requires-linear = "2차 이상의 식은 1차 방정식 풀이로 풀 수 없다.";
    equation-variable-in-denominator-linear = "분모에 변수가 있는 식은 1차 방정식으로 풀 수 없다.";
    equation-variable-in-denominator = "분모에 변수가 있는 식은 풀 수 없다.";
    equation-wrong-variable = "변수 '${name}'은(는) '${var}'이 아니다.";
    eval-is-equation = "등식은 직접 eval할 수 없다. solve_linear를 사용하라.";
    eval-is-vector = "벡터 연산은 eval_vector를 사용하라.";
    eval-not-vector = "벡터 연산이 아니다.";
    integral-reciprocal-unsupported = "∫x⁻¹ dx = ln|x| + C는 아직 지원되지 않는다.";
  };

  # batch 207 (2026-04-16): light.rs dispatch summary + transcript template 11 개.
  light-dispatch-templates = {
    concept-formula-suffix = " 공식: ${formula}.";
    concept-unit-suffix = " 단위: ${unit}.";
    transcript-reference-prefix = "transcript:doghouse: (참고) ${sentence}";
    summary-handoff-with-computation = "doghouse가 한글 의미를 연결하고 계산을 수행했다. 구체 .px payload와 MathML 표현을 생성하여 puck/freecat으로 넘긴다.";
    summary-handoff-no-computation = "doghouse가 한글 의미를 연결했고 실제 계산은 puck/freecat `.px` handoff로 넘긴다.";
    summary-held = "doghouse가 질문을 저장했고 더 좁은 실험 context가 오면 같은 의미 lane을 다시 연다.";
    summary-default = "doghouse가 한글 의미를 연결하고 관련 응답을 준비했다.";
    detail-expression-projection = "구체 .px payload와 expression projection이 함께 준비되었다.";
    followup-reopen-summary = "follow-up reopen: doghouse가 질문을 더 좁은 context `${context}`로 다시 열었고, 필요한 실행은 puck/freecat 쪽으로 넘긴다.";
    followup-reopen-transcript = "transcript:doghouse: 같은 질문을 더 좁은 실험 context로 다시 열었다.";
  };

  # batch 208: doghouse-http.rs 기본 도메인.
  default-learn-domain = "수학물리";

  # batch 202 (2026-04-16): retrieval.rs 잔존 response template 2 개.
  constraint-violation-template =
    "'${noun}'은(는) ${frame}.${role}에 부적합 — Sentient(생물) 제약 위반";
  conflict-warning = "(주의: 이 개념에 대해 상충하는 정의가 존재한다.)";

  # batch 196 (2026-04-16): 단위 변환 방향 입자 ("로"/"으로")와 백분율 소유격 입자 ("의"/"에서").
  # conversion-direction-particles 는 action-rules.px unit-convert-particles.direction-particles 와
  # 의미적으로 동일하지만, computation.rs parse_unit_conversion 은 korean-morphology.px 를
  # hot-reload 하므로 여기에 한 벌 더 둔다 (두 consumer 가 같은 loader 경로를 쓰지 않아
  # cross-file 참조가 되지 않음). 추후 loader 통합 시 한 곳으로 합친다.
  conversion-direction-particles = ["로" "으로"];
  percentage-of-particles = ["의" "에서"];

  # Dispatch summary 템플릿 — 각 dispatch branch 가 episode summary 에 남기는
  # Korean 한 줄 요약 prefix.
  # batch 164 (2026-04-16): conversation.rs 의 summary format! 들을 .px 로 이관.
  dispatch-summary-templates = {
    multi-clause = "doghouse가 복문을 분석했다. ${inner}";
    invert-why = "ontology invert: '${term}'의 '왜'를 역추적했다.";
    invert-contradiction = "ontology invert: '${term}'의 모순을 감지했다.";
    os-recipe = "doghouse가 OS 작업을 준비했다: ${template-id}";
    computation-ast = "doghouse가 .px 규칙으로 계산했다. ${inner}";
    why-answer-prefix = "'${term}'이(가) 그런 이유: ${why}";
    why-answer-boundary = " 단, ${boundary}";
    context-utterance = "${prev}의 ${utterance}";
  };

  # Held concept 응답/summary/follow-up 템플릿. conversation.rs held_concept_envelope
  # 가 개념을 store 에서 못 찾았을 때 돌려주는 Korean message 들.
  # batch 163 (2026-04-16): held_concept 경로의 Korean format! 을 전부 .px 로 이관.
  held-concept-templates = {
    nearby-prefix = " 비슷한 개념: ${nearby}.";
    followup-no-hint =
      "'${term}'에 대한 정의가 아직 온톨로지에 없다.${nearby-hint} 구체적으로 어떤 맥락인지 알려주면 held judgement를 다시 열 수 있다.";
    followup-with-hint =
      "'${term}'에 대한 정의가 아직 없다. ${missing-hint}${nearby-hint} 질문을 더 좁혀서 이어 말하면 held judgement를 다시 열 수 있다.";
    summary =
      "doghouse가 '${term}'을(를) 개념 질의로 인식했으나 정의가 없어 held 상태로 저장했다.";
    response-empty =
      "'${term}'에 대한 엄밀한 정의가 아직 등록되어 있지 않다. 더 구체적인 맥락을 알려주면 다시 열겠다.";
    response-with-nearby =
      "'${term}'에 대한 엄밀한 정의가 아직 등록되어 있지 않다.${nearby-hint} 관련 개념을 질문해볼 수 있다.";
    response-with-hint =
      "'${term}'에 대한 엄밀한 정의가 아직 등록되어 있지 않다. ${missing-hint}";
  };

  # Concept query dispatch summary 템플릿 — knowledge.rs의 concept-definition
  # / concept-predicate dispatch summary Korean 문장.
  # batch 171 (2026-04-16): knowledge.rs 에서 이관.
  concept-query-summary-templates = {
    concept-definition =
      "doghouse가 저장된 온톨로지에서 '${term}'(${domain}/${category})의 엄밀한 한글 정의를 조회하여 응답했다. 연결 개념 ${hops}개 탐색.";
    predicate-query-response = "${term}의 ${label}: ${values}.";
    predicate-query-summary =
      "doghouse가 저장된 온톨로지에서 '${term}'의 ${label}를 조회했다.";
  };

  # Concept demo (computation) 응답 템플릿. knowledge.rs concept_computation_demo_envelope.
  # batch 165 (2026-04-16): '의 연산 예시 (...)' / '(단위: ...)' Korean literal 이관.
  concept-demo-templates = {
    header = "${term}의 연산 예시 (${domain}):";
    unit-suffix = " (단위: ${unit})";
    hop-connection = " 연결 지식으로 ${hops}이(가) 있다.";
    # batch 197 (2026-04-16): concept computation demo summary.
    summary = "doghouse가 '${term}'의 연산 예시를 ${count}개 공식으로 조립했다.";
  };

  # Domain listing 응답/요약 템플릿. knowledge.rs build_domain_listing 에서 사용.
  # batch 162 (2026-04-16): domain listing 응답 조립 Korean template 을 .px 로 이관.
  domain-listing-templates = {
    header = "${domain} 개념 ${count}개: ${terms}.";
    preview-prefix = "대표 개념: ${preview}";
    summary = "doghouse가 저장된 온톨로지에서 ${domain} 도메인의 개념 ${count}개를 조회했다.";
  };

  # Rich concept response 조립 템플릿. knowledge.rs assemble_rich_response 가
  # 각 사실을 검출했을 때 어떤 Korean 문구로 append 할지 정의.
  # batch 160 (2026-04-16): 이전에는 Rust format! 으로 하드코딩.
  concept-response-templates = {
    definition = "${term}은(는) ${definition}";
    formula = "공식은 ${formula}이다.";
    unit = "단위는 ${unit}이다.";
    formal-name-and-symbol = "영어로 ${formal-en}, 기호는 ${symbol}이다.";
    formal-name-only = "영어로 ${formal-en}이다.";
    inverse = "역연산은 ${inverse}이다.";
    related = "관련 개념으로 ${related}이(가) 있다.";
    domain-and-category = "${domain} 분야의 ${category}에 속한다.";
    usage-example = "사용법: ${example}";
    signature-example = "예시: ${signature}";
    signature-interpretation = "해석: ${definition}";
    example-concept = "예시: ${input} → ${result}";
    example-extra = "또 다른 예시: ${input} → ${result}";
    example-meaning = "해석: ${meaning}";
  };

  # 문장 분석 결과 validity label (유효/제약 위반/불완전) + 요약 prefix.
  # batch 155 (2026-04-16): conversation.rs envelope_from_sentence_analysis 에서 이관.
  sentence-validity-labels = {
    valid = "유효";
    constraint-violated = "제약 위반";
    incomplete = "불완전";
  };
  sentence-summary-prefix = "doghouse가 문장을 분석했다";

  # CacheHitMode enum 의 Korean label (정확/정규화/의미).
  # batch 155 (2026-04-16): conversation.rs CacheHitMode::korean_label 에서 이관.
  cache-hit-mode-labels = {
    exact = "정확";
    normalized = "정규화";
    semantic = "의미";
  };

  # ConceptPredicateQuery::empty_response 용 Korean 템플릿. ${term} placeholder 지원.
  # batch 155 (2026-04-16): conversation.rs ConceptPredicateQuery::empty_response 에서 이관.
  concept-predicate-empty-responses = {
    unit-ko = "${term}에는 별도의 단위가 정의되어 있지 않다.";
    formula = "${term}에는 별도의 공식이 정의되어 있지 않다.";
    inverse-of = "${term}에는 역연산이 정의되어 있지 않다.";
    default = "${term}에 대한 해당 정보가 없다.";
  };

  # 응답 조립 시 predicate 별 Korean 라벨 prefix.
  # assemble_scoped_response 의 '단위: ... / 공식: ... / 기호: ... / 영어: ... /
  # 역연산: ... / 도메인: ... / 분류: ... / 관련 개념: ... / 의미역(frame): ... /
  # 연결 지식: ...' 조립에 쓰인다.
  # batch 150 (2026-04-16): retrieval.rs 에서 이관.
  response-labels = {
    unit-ko = "단위";
    formula = "공식";
    formal-symbol = "기호";
    formal-name-en = "영어";
    inverse-of = "역연산";
    domain = "도메인";
    category = "분류";
    related-concept = "관련 개념";
    semantic-frame = "의미역(frame)";
    hop-knowledge = "연결 지식";
    conflict-warning = "(주의: 이 개념에 대해 상충하는 정의가 존재한다.)";
  };

  # 문장 관계 / 서법 한글 표시 라벨 — multi-clause summary 와 mood 출력용.
  # batch 148 (2026-04-16): retrieval.rs 에서 이관.
  clause-relation-labels = {
    contrast = "대조";
    sequential = "순서";
    conditional = "조건";
    cause = "원인";
    simultaneous = "동시";
    background = "배경";
    purpose = "목적";
    alternative = "선택";
    transition = "전환";
    root = "시작";
  };
  sentence-mood-labels = {
    declarative = "서술문";
    interrogative = "의문문";
    imperative = "명령문";
    propositive = "청유문";
    unknown = "알 수 없음";
  };

  # 부정 단일 토큰 — "안", "못" 같이 full token 으로 나오는 부정 표지.
  # substring 매칭이 아닌 exact token 매칭용.
  # batch 149 (2026-04-16): retrieval.rs 의 t == '안' || t == '못' 에서 이관.
  negation-tokens = [ "안" "못" ];

  # 발화 동사 클래스 — 문장 의미 분석 시 verb stem 의 semantic class 판별.
  # batch 147 (2026-04-16): retrieval.rs is_statement_verb / is_chatting_verb
  # matches! arm 에서 이관.
  statement-verbs = [
    "발표하다" "보고하다" "보도하다" "선언하다" "주장하다" "진술하다"
    "설명하다" "알리다"
  ];
  chatting-verbs = [
    "대화하다" "얘기하다" "이야기하다" "떠들다" "소곤거리다" "환담하다"
    "노닥거리다"
  ];

  # 생물/무생물 카테고리 — ConceptNet IsA/InstanceOf 검사 시 semantic class 판별.
  # batch 139 (2026-04-16): retrieval.rs is_likely_sentient inline arrays 에서 이관.
  sentient-categories = [
    "사람" "인간" "동물" "생물" "인물" "사람들" "직업" "학생" "선생"
    "의사" "군인" "경찰" "포유류" "조류" "곤충" "파충류" "어류"
  ];
  inanimate-categories = [
    "물질" "광물" "돌" "금속" "물체" "도구" "기계" "장치" "음식"
    "열매" "과일" "채소" "식물" "나무" "꽃" "건물" "장소" "지역"
    "국가" "도시" "개념" "현상" "사건" "숫자" "색"
  ];

  # ── 불규칙 동사: base(축약형) × suffixes 데카르트곱 자동 생성 ──
  # { contracted = "줬"; stem = "주다"; } × suffixes = ["다" "어" "지" "나" "니"]
  # → "줬다"→"주다", "줬어"→"주다", "줬지"→"주다", "줬나"→"주다", "줬니"→"주다"
  irregular-verb-bases = [
    { contracted = "줬"; stem = "주다"; }
    { contracted = "했"; stem = "하다"; }
    { contracted = "됐"; stem = "되다"; }
    { contracted = "갔"; stem = "가다"; }
    { contracted = "왔"; stem = "오다"; }
    { contracted = "났"; stem = "나다"; }
    { contracted = "봤"; stem = "보다"; }
    { contracted = "보냈"; stem = "보내다"; }
    { contracted = "샀"; stem = "사다"; }
    { contracted = "물었"; stem = "묻다"; }
    { contracted = "답했"; stem = "답하다"; }
    { contracted = "대답했"; stem = "대답하다"; }
    { contracted = "배웠"; stem = "배우다"; }
    { contracted = "가르쳤"; stem = "가르치다"; }
    { contracted = "빌렸"; stem = "빌리다"; }
    { contracted = "탔"; stem = "타다"; }
    { contracted = "셨"; stem = "시다"; }
  ];
  # 불규칙 축약형에 붙는 어미 (데카르트곱)
  irregular-suffixes = ["다" "어" "지" "나" "니"];

  # ── 규칙 어미 (stem + restore) ──
  # 길이 내림차순. ending을 strip하고 "다"를 붙인다.
  regular-endings = [
    "고있었다" "었는데" "았는데" "고있다" "어지다" "아지다"
    "었어?" "았어?" "습니다" "ㅂ니다"
    "었다" "았다" "었어" "았어" "었지" "았지"
    "었나" "았나" "었니" "았니"
    "ㅆ다" "는다" "ㄴ다" "는지" "ㄹ까" "나요"
  ];

  # 존댓말 (stem-suffix 방식)
  honorific-endings = [
    { ending = "세요"; stem-suffix = "시다"; }
    { ending = "한다"; stem-suffix = "하다"; }
  ];

  # ── 조사 → 의미역 매핑: role → particles 테이블 (역전) ──
  # Rust generator가 role → particle × 1 매핑으로 자동 확장
  # 긴 조사 우선 정렬은 generator가 처리
  role-to-particles = [
    { role = "Agent"; particles = ["가" "이" "은" "는"]; }
    { role = "Theme"; particles = ["을" "를"]; }
    { role = "Recipient"; particles = ["에게" "한테" "께"]; }
    { role = "Source"; particles = ["에서는" "에서"]; }
    { role = "Goal"; particles = ["으로" "로"]; }
    { role = "Instrument"; particles = ["으로써" "로써"]; }
    { role = "Co-participant"; particles = ["과함께" "와함께" "같이" "와" "과"]; }
    { role = "Possessor"; particles = ["의"]; }
    { role = "Location"; particles = ["에는" "에"]; }
    { role = "Time_start"; particles = ["부터"]; }
    { role = "Time_end"; particles = ["까지"]; }
    { role = "Cause"; particles = ["때문에"]; }
    { role = "Purpose"; particles = ["위해"]; }
    { role = "Standard"; particles = ["보다"]; }
    { role = "Manner"; particles = ["처럼"]; }
    { role = "Degree"; particles = ["만큼"]; }
    # 복합 조사
    { role = "Source"; particles = ["에게서"]; }
    { role = "Quote"; particles = ["이라고" "라고" "다고" "냐고" "자고"]; }
    { role = "Addition"; particles = ["에다가"]; }
  ];

  # ── 접속 조사/연결어미: 복문을 절로 분리하는 기준 ──
  # Rust clause splitter가 이 테이블로 문장을 절 단위로 나눈다
  clause-connectors = [
    { connector = "지만"; relation = "contrast"; ko = "대조"; }
    { connector = "는데"; relation = "background"; ko = "배경"; }
    { connector = "면서"; relation = "simultaneous"; ko = "동시"; }
    { connector = "으며"; relation = "simultaneous"; ko = "동시"; }
    { connector = "며"; relation = "simultaneous"; ko = "동시"; }
    { connector = "으면"; relation = "conditional"; ko = "조건"; }
    { connector = "면"; relation = "conditional"; ko = "조건"; }
    { connector = "아서"; relation = "cause"; ko = "원인"; }
    { connector = "어서"; relation = "cause"; ko = "원인"; }
    { connector = "니까"; relation = "cause"; ko = "원인"; }
    { connector = "고"; relation = "sequential"; ko = "순서"; }
    { connector = "거나"; relation = "alternative"; ko = "선택"; }
    { connector = "든지"; relation = "alternative"; ko = "선택"; }
    { connector = "다가"; relation = "transition"; ko = "전환"; }
    { connector = "려고"; relation = "purpose"; ko = "목적"; }
    { connector = "도록"; relation = "purpose"; ko = "목적"; }
    { connector = "아도"; relation = "concession"; ko = "양보"; }
    { connector = "어도"; relation = "concession"; ko = "양보"; }
    { connector = "더니"; relation = "discovery"; ko = "발견"; }
    { connector = "자"; relation = "immediate"; ko = "즉시"; }
    { connector = "라서"; relation = "cause"; ko = "원인"; }
  ];

  # batch 258 (2026-04-18): `relative-clause-markers` 는 first commit 이후
  # 어떤 Rust 에서도 read 되지 않았고 pnix-query-runtime 쪽에서도 사용처가
  # 없었다. 진짜 orphan 이라 integration gap 정리 차원에서 제거. 관계절
  # 어미 해석이 실제로 필요해지면 NLP 파이프라인 설계 시점에 schema 를
  # 같이 정해서 새로 추가한다.
  #
  # ── 인용절 표지: pnix-query-runtime kernel 의 token 분리에 사용 ──
  # "철수가 온다고 말했다" → "온다고" = 인용절
  quotation-markers = [
    "다고" "라고" "냐고" "자고"
  ];
}
