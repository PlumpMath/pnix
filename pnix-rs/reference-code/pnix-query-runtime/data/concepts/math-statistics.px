# 통계 추가 개념 (math-probability.px에 없는 것만)
# 평균, 중앙값, 분산, 표준편차, 정규분포 등은 math-probability.px에 이미 정의됨
[
  {
    term-ko = "최빈값";
    definition-ko = "데이터에서 가장 자주 나타나는 값. 두 개 이상일 수 있으며, 없을 수도 있다";
    formal-name-en = "mode";
    context = "Math.Statistics";
    domain = "수학";
    related-concepts = ["평균" "중앙값"];
    category = "통계";
  }
  {
    term-ko = "사분위수";
    definition-ko = "데이터를 크기 순으로 정렬한 뒤 4등분하는 세 값. Q1(25%), Q2(50%=중앙값), Q3(75%)이다";
    formal-name-en = "quartile";
    context = "Math.Statistics";
    domain = "수학";
    related-concepts = ["중앙값" "범위"];
    category = "통계";
  }
  {
    term-ko = "상관계수";
    definition-ko = "두 변수 사이의 선형 관계의 강도와 방향을 나타내는 값. -1에서 1 사이이며, 0이면 선형 관계가 없다";
    formal-name-en = "correlation coefficient";
    formal-symbol = "r";
    context = "Math.Statistics";
    domain = "수학";
    related-concepts = ["분산"];
    formula = "r = Σ(xᵢ-x̄)(yᵢ-ȳ) / √(Σ(xᵢ-x̄)²·Σ(yᵢ-ȳ)²)";
    category = "통계";
  }
]
