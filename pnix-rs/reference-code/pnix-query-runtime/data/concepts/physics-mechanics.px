# 물리 · 역학
[
  {
    term-ko = "힘";
    definition-ko = "물체의 운동 상태를 변화시키는 원인이다. 뉴턴의 제2법칙에 의해 F = ma로 정의된다.";
    formal-name-en = "force";
    formal-symbol = "F";
    context = "Physics.Mechanics";
    domain = "물리";
    related-concepts = ["질량" "가속도" "운동량" "미분" "벡터"];
    unit-ko = "뉴턴(N)";
    formula = "F = ma = dp/dt";
    category = "역학";
    # P8: "왜?" 역추적을 위한 provenance
    why = "뉴턴이 1687년 Principia Mathematica에서 정립. 운동의 원인을 질량과 가속도의 곱으로 정의한 것은 갈릴레오의 관성 개념과 케플러의 행성 운동 법칙을 통합한 결과.";
    historical-provenance = ["뉴턴(1687)" "갈릴레오(관성)" "케플러(행성운동)"];
    boundary-conditions = "상대론적 속도(v→c)에서는 F=ma가 깨지고 F=dp/dt로 일반화. 양자 역학에서는 힘 개념이 포텐셜로 대체.";
  }
  {
    term-ko = "질량";
