# 생물 기초 개념 (고등학교 수준)
[
  {
    term-ko = "세포";
    definition-ko = "생물의 구조와 기능의 기본 단위. 세포막, 세포질, 핵으로 구성된다. 원핵세포와 진핵세포로 나뉜다";
    formal-name-en = "cell";
    context = "Science.Biology";
    domain = "생물";
    related-concepts = ["DNA" "세포분열" "유전자"];
    category = "생물";
  }
  {
    term-ko = "DNA";
    definition-ko = "디옥시리보핵산. 유전 정보를 저장하는 이중나선 구조의 고분자. A-T, G-C 염기쌍으로 이루어진다";
    formal-name-en = "deoxyribonucleic acid";
    context = "Science.Biology";
    domain = "생물";
    related-concepts = ["유전자" "RNA" "단백질" "세포"];
    category = "생물";
  }
  {
    term-ko = "유전자";
    definition-ko = "DNA의 특정 구간으로, 하나의 단백질을 합성하는 정보를 담고 있다. 형질을 결정하는 유전의 기본 단위이다";
    formal-name-en = "gene";
    context = "Science.Biology";
    domain = "생물";
    related-concepts = ["DNA" "염색체" "유전" "단백질"];
    category = "생물";
  }
  {
    term-ko = "광합성";
    definition-ko = "식물이 빛에너지를 이용하여 이산화탄소와 물로부터 포도당과 산소를 만드는 과정";
    formal-name-en = "photosynthesis";
    context = "Science.Biology";
    domain = "생물";
    related-concepts = ["세포호흡" "엽록체" "에너지"];
    formula = "6CO₂ + 6H₂O → C₆H₁₂O₆ + 6O₂";
    category = "생물";
  }
  {
    term-ko = "세포호흡";
    definition-ko = "세포에서 포도당을 분해하여 ATP 형태의 에너지를 얻는 과정. 미토콘드리아에서 일어난다";
    formal-name-en = "cellular respiration";
    context = "Science.Biology";
    domain = "생물";
    related-concepts = ["광합성" "ATP" "미토콘드리아"];
    formula = "C₆H₁₂O₆ + 6O₂ → 6CO₂ + 6H₂O + ATP";
    category = "생물";
  }
  {
    term-ko = "진화";
    definition-ko = "생물 집단의 유전적 구성이 세대를 거치며 변화하는 과정. 자연선택이 주된 메커니즘이다";
    formal-name-en = "evolution";
    context = "Science.Biology";
    domain = "생물";
    related-concepts = ["자연선택" "유전자" "돌연변이" "적응"];
    category = "생물";
  }
  {
    term-ko = "생태계";
    definition-ko = "일정한 지역에서 생물과 비생물 환경이 상호작용하는 체계. 생산자, 소비자, 분해자로 구성된다";
    formal-name-en = "ecosystem";
    context = "Science.Biology";
    domain = "생물";
    related-concepts = ["먹이사슬" "에너지흐름" "물질순환"];
    category = "생물";
  }
  {
    term-ko = "세포분열";
    definition-ko = "하나의 세포가 둘 이상으로 나뉘는 과정. 체세포분열(유사분열)과 감수분열이 있으며, 성장과 생식의 기초이다";
    formal-name-en = "cell division";
    context = "Science.Biology";
    domain = "생물";
    related-concepts = ["세포" "DNA" "유전자" "염색체"];
    category = "생물";
  }
  {
    term-ko = "효소";
    definition-ko = "생체 내 화학 반응의 속도를 높이는 단백질 촉매. 기질 특이성이 있으며, 온도와 pH에 영향을 받는다";
    formal-name-en = "enzyme";
    context = "Science.Biology";
    domain = "생물";
    related-concepts = ["단백질" "세포호흡" "광합성"];
    category = "생물";
  }
  {
    term-ko = "항상성";
    definition-ko = "생물체가 외부 환경 변화에도 내부 환경을 일정하게 유지하는 성질. 체온, 혈당, pH 등이 조절된다";
    formal-name-en = "homeostasis";
    context = "Science.Biology";
    domain = "생물";
    related-concepts = ["효소" "신경계" "호르몬"];
    category = "생물";
  }
  {
    term-ko = "면역";
    definition-ko = "외부 병원체(세균, 바이러스 등)로부터 몸을 보호하는 방어 체계. 선천면역과 후천면역(적응면역)으로 나뉜다";
    formal-name-en = "immunity";
    context = "Science.Biology";
    domain = "생물";
    related-concepts = ["세포" "항체" "백신"];
    category = "생물";
  }
]
