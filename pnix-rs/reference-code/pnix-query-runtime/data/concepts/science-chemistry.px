# 화학 기초 개념 (고등학교 수준)
[
  {
    term-ko = "원소";
    definition-ko = "같은 수의 양성자를 가진 원자로 이루어진 순수한 물질. 현재 118종이 알려져 있으며, 주기율표로 정리된다";
    formal-name-en = "element";
    context = "Science.Chemistry";
    domain = "화학";
    related-concepts = ["원자" "주기율표" "화학결합"];
    category = "화학";
  }
  {
    term-ko = "원자";
    definition-ko = "물질을 이루는 기본 입자. 양성자와 중성자로 된 핵, 그 주위의 전자로 구성된다";
    formal-name-en = "atom";
    context = "Science.Chemistry";
    domain = "화학";
    related-concepts = ["원소" "전자" "양성자" "분자"];
    category = "화학";
  }
  {
    term-ko = "분자";
    definition-ko = "두 개 이상의 원자가 화학 결합으로 연결된 입자. 물(H₂O), 산소(O₂) 등이 있다";
    formal-name-en = "molecule";
    context = "Science.Chemistry";
    domain = "화학";
    related-concepts = ["원자" "화학결합" "화학식"];
    category = "화학";
  }
  {
    term-ko = "화학결합";
    definition-ko = "원자 사이의 인력으로 형성되는 결합. 이온결합, 공유결합, 금속결합으로 나뉜다";
    formal-name-en = "chemical bond";
    context = "Science.Chemistry";
    domain = "화학";
    related-concepts = ["원자" "이온" "공유결합" "전자"];
    category = "화학";
  }
  {
    term-ko = "산화환원";
    definition-ko = "전자의 이동이 수반되는 화학 반응. 전자를 잃으면 산화, 얻으면 환원이다";
    formal-name-en = "redox reaction";
    context = "Science.Chemistry";
    domain = "화학";
    related-concepts = ["전자" "산화" "환원" "화학반응"];
    category = "화학";
  }
  {
    term-ko = "몰";
    definition-ko = "물질의 양을 나타내는 단위. 1몰 = 6.022×10²³개(아보가드로 수)의 입자를 포함한다";
    formal-name-en = "mole";
    formal-symbol = "mol";
    context = "Science.Chemistry";
    domain = "화학";
    related-concepts = ["아보가드로수" "원자량" "분자량"];
    formula = "1 mol = 6.022 × 10²³";
    unit-ko = "몰(mol)";
    category = "화학";
  }
  {
    term-ko = "주기율표";
    definition-ko = "원소를 원자번호 순으로 배열하여 화학적 성질의 주기성을 보여주는 표. 멘델레예프가 고안했다";
    formal-name-en = "periodic table";
    context = "Science.Chemistry";
    domain = "화학";
    related-concepts = ["원소" "원자" "주기"];
    category = "화학";
  }
  {
    term-ko = "pH";
    definition-ko = "수용액의 산성도를 나타내는 지표. pH = -log[H⁺]. pH 7이 중성, 7 미만이 산성, 7 초과가 염기성이다";
    formal-name-en = "pH";
    formal-symbol = "pH";
    context = "Science.Chemistry";
    domain = "화학";
    related-concepts = ["산" "염기" "중화반응"];
    formula = "pH = -log₁₀[H⁺]";
    category = "화학";
