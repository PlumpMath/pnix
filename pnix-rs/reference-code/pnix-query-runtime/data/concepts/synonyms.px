# 동의어/별칭 매핑 (정본, generic)
# canonical → aliases 역전 테이블. Rust generator가 alias → canonical로 자동 확장.
# 중복 canonical 이름이 한 곳에만 등장 → 관리 용이.
{
  synonym-groups = [
    # ── 수학 · 연산 ──
    { canonical = "덧셈"; aliases = ["더하기" "합" "합산" "덧셈연산"]; }
    { canonical = "뺄셈"; aliases = ["빼기" "차" "감산"]; }
    { canonical = "곱셈"; aliases = ["곱하기" "적" "승산"]; }
    { canonical = "나눗셈"; aliases = ["나누기" "몫" "제산"]; }
    { canonical = "거듭제곱"; aliases = ["제곱" "자승" "거듭제곱연산"]; }
    { canonical = "제곱근"; aliases = ["루트" "근호" "√"]; }
    { canonical = "팩토리얼"; aliases = ["!" "계승"]; }
    { canonical = "원주율"; aliases = ["파이" "π" "원주율값"]; }
    { canonical = "표준편차"; aliases = ["시그마" "σ"]; }
    { canonical = "평균"; aliases = ["뮤" "μ" "기대값"]; }

    # ── 수학 · 삼각함수 ──
    { canonical = "사인"; aliases = ["sin" "사인함수" "싸인"]; }
    { canonical = "코사인"; aliases = ["cos" "코사인함수" "코싸인"]; }
    { canonical = "탄젠트"; aliases = ["tan" "탄젠트함수" "탄"]; }

    # ── 수학 · 해석학/선형대수 ──
    { canonical = "적분"; aliases = ["적분연산" "인테그랄" "∫"]; }
    { canonical = "미분"; aliases = ["미분연산" "디퍼렌셜" "미분법"]; }
    { canonical = "행렬"; aliases = ["행렬곱" "매트릭스"]; }
    { canonical = "벡터"; aliases = ["벡터공간" "벡타"]; }
    { canonical = "내적"; aliases = ["스칼라곱" "점곱" "닷곱" "dot"]; }
    { canonical = "외적"; aliases = ["크로스곱" "벡터곱" "cross"]; }
    { canonical = "방정식"; aliases = ["방정식풀이"]; }
    { canonical = "이차방정식"; aliases = ["근의공식" "이차공식"]; }

    # ── 물리 · 역학 ──
    { canonical = "힘"; aliases = ["F" "포스" "뉴턴" "Newton"]; }
    { canonical = "질량"; aliases = ["m" "무게"]; }
    { canonical = "가속도"; aliases = ["a" "가속"]; }
    { canonical = "속도"; aliases = ["v" "속"]; }
    { canonical = "운동량"; aliases = ["p" "모멘텀"]; }
    { canonical = "에너지"; aliases = ["E" "에너지량"]; }
    { canonical = "운동에너지"; aliases = ["K" "KE" "운동에너지량"]; }
    { canonical = "위치에너지"; aliases = ["U" "PE" "포텐셜에너지"]; }
    { canonical = "일"; aliases = ["W" "일량"]; }

    # ── 물리 · 열역학 ──
    { canonical = "온도"; aliases = ["T" "온도값"]; }
    { canonical = "열"; aliases = ["Q" "열량"]; }
    { canonical = "엔트로피"; aliases = ["S" "엔트로피값"]; }
    { canonical = "압력"; aliases = ["P" "기압"]; }

    # ── 물리 · 전자기 ──
    { canonical = "전류"; aliases = ["I" "전류량"]; }
    { canonical = "전압"; aliases = ["V" "전위차" "볼트"]; }
    { canonical = "저항"; aliases = ["R" "저항값" "옴"]; }
    { canonical = "전하"; aliases = ["q" "전하량"]; }
    { canonical = "자기장"; aliases = ["B" "자기장세기"]; }
    { canonical = "전기장"; aliases = ["전장"]; }

    # ── 복합 용어 / 구어 / 교과서 표현 ──
    { canonical = "이차방정식"; aliases = ["2차방정식" "이차식" "2차식" "이차방정식풀이"]; }
    { canonical = "만유인력"; aliases = ["뉴턴법칙" "만유인력법칙" "만유인력의법칙" "중력법칙"]; }
    { canonical = "중력가속도"; aliases = ["g"]; }
    { canonical = "라디안"; aliases = ["rad" "호도" "호도법"]; }
    { canonical = "원주율"; aliases = ["pi" "3.14"]; }
    { canonical = "미적분"; aliases = ["미적분학" "calculus" "미적"]; }
    { canonical = "전력"; aliases = ["전력량" "전기전력" "와트"]; }
    { canonical = "광합성"; aliases = ["photosynthesis"]; }
    { canonical = "파동"; aliases = ["wave" "물결파"]; }
    { canonical = "도플러효과"; aliases = ["도플러" "Doppler"]; }
  ];
}
