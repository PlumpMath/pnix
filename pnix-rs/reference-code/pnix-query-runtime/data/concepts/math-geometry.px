# 기하학 (Geometry)
[
  {
    term-ko = "점";
    definition-ko = "위치만 있고 크기(길이, 넓이, 부피)가 없는 기하학의 기본 대상. 유클리드 기하에서 정의 불가능한 원시 개념(primitive notion)이다";
    formal-name-en = "point";
    formal-symbol = "P";
    context = "Math.Geometry";
    domain = "수학";
    related-concepts = ["직선" "평면"];
    category = "기하학";
  }
  {
    term-ko = "직선";
    definition-ko = "두 점을 지나 양방향으로 무한히 뻗는 1차원 도형. 유클리드 기하의 원시 개념이며, 두 점이 하나의 직선을 유일하게 결정한다";
    formal-name-en = "line";
    formal-symbol = "l";
    context = "Math.Geometry";
    domain = "수학";
    related-concepts = ["점" "평면" "각"];
    category = "기하학";
  }
  {
    term-ko = "평면";
    definition-ko = "일직선 위에 있지 않은 세 점에 의해 유일하게 결정되는 2차원 도형. 무한히 넓고 두께가 없으며, 유클리드 기하의 원시 개념이다";
    formal-name-en = "plane";
    formal-symbol = "";
    context = "Math.Geometry";
    domain = "수학";
    related-concepts = ["점" "직선"];
    category = "기하학";
  }
  {
    term-ko = "각";
    definition-ko = "공통 끝점(꼭짓점)을 가진 두 반직선(변)이 이루는 도형. 크기는 도(degree) 또는 라디안(radian)으로 측정한다";
    formal-name-en = "angle";
    formal-symbol = "∠";
    context = "Math.Geometry";
    domain = "수학";
    related-concepts = ["직선" "삼각형" "라디안" "호도법"];
    category = "기하학";
  }
  {
    term-ko = "원";
    definition-ko = "평면 위에서 한 정점(중심)으로부터 일정한 거리(반지름)에 있는 점들의 집합. 둘레의 길이는 2πr, 넓이는 πr²이다";
    formal-name-en = "circle";
    formal-symbol = "○";
    context = "Math.Geometry";
    domain = "수학";
    related-concepts = ["원주율" "넓이" "라디안"];
    formula = "x² + y² = r²";
    category = "기하학";
  }
  {
    term-ko = "삼각형";
    definition-ko = "세 점(꼭짓점)과 그들을 잇는 세 선분(변)으로 이루어진 다각형. 내각의 합은 유클리드 평면에서 항상 180°이다";
    formal-name-en = "triangle";
    formal-symbol = "△";
    context = "Math.Geometry";
    domain = "수학";
    related-concepts = ["각" "넓이" "피타고라스 정리" "합동" "닮음"];
    formula = "넓이 = (1/2) · 밑변 · 높이";
    category = "기하학";
  }
  {
    term-ko = "원주율";
    definition-ko = "원의 둘레와 지름의 비. 초월수이며 무리수이고, 값은 3.14159265...로 시작한다. 기하학, 해석학, 확률론 등 수학 전반에 나타난다";
    formal-name-en = "pi";
    formal-symbol = "π";
    context = "Math.Geometry";
    domain = "수학";
    related-concepts = ["원" "무리수" "라디안" "상수"];
    formula = "π = 원의 둘레 / 지름";
    category = "기하학";
  }
  {
    term-ko = "넓이";
    definition-ko = "2차원 도형이 차지하는 평면 영역의 크기. 단위 정사각형의 넓이를 1로 정의하고, 적분을 통해 일반적인 영역의 넓이를 계산한다";
    formal-name-en = "area";
    formal-symbol = "A";
    context = "Math.Geometry";
    domain = "수학";
    related-concepts = ["부피" "적분" "삼각형" "원"];
    category = "기하학";
  }
  {
    term-ko = "부피";
    definition-ko = "3차원 입체가 차지하는 공간의 크기. 단위 정육면체의 부피를 1로 정의하고, 삼중적분을 통해 일반 영역의 부피를 계산한다";
    formal-name-en = "volume";
    formal-symbol = "V";
    context = "Math.Geometry";
    domain = "수학";
    related-concepts = ["넓이" "적분"];
    category = "기하학";
  }
  {
    term-ko = "대칭";
    definition-ko = "기하학적 변환(반사, 회전, 병진 등)에 대해 도형이 불변인 성질. 대칭 변환의 집합은 군(group)을 이루며, 이를 대칭군이라 한다";
    formal-name-en = "symmetry";
    formal-symbol = "";
    context = "Math.Geometry";
    domain = "수학";
    related-concepts = ["합동" "닮음"];
    category = "기하학";
  }
  {
    term-ko = "합동";
    definition-ko = "두 도형이 크기와 모양이 완전히 같은 관계. 한 도형을 등거리 변환(합동 변환: 평행이동, 회전, 반사)으로 다른 도형에 겹칠 수 있을 때 합동이다";
    formal-name-en = "congruence";
    formal-symbol = "≅";
    context = "Math.Geometry";
    domain = "수학";
    related-concepts = ["닮음" "대칭" "삼각형"];
    category = "기하학";
  }
  {
    term-ko = "닮음";
    definition-ko = "두 도형이 모양은 같으나 크기가 다를 수 있는 관계. 대응하는 각이 같고 대응하는 변의 비가 일정할 때 닮음이며, 닮음비 k에 의해 특징지어진다";
    formal-name-en = "similarity";
    formal-symbol = "∼";
    context = "Math.Geometry";
    domain = "수학";
    related-concepts = ["합동" "대칭" "삼각형"];
    category = "기하학";
  }
  {
    term-ko = "직사각형";
    definition-ko = "네 각이 모두 직각인 사각형. 넓이는 가로×세로이다";
    formal-name-en = "rectangle";
    context = "Math.Geometry"; domain = "수학";
    related-concepts = ["정사각형" "사각형" "넓이"];
    formula = "S = a × b";
    category = "기하학";
  }
  {
    term-ko = "정사각형";
    definition-ko = "네 변의 길이와 네 각이 모두 같은 사각형. 넓이는 한 변의 제곱이다";
    formal-name-en = "square";
    context = "Math.Geometry"; domain = "수학";
    related-concepts = ["직사각형" "사각형" "넓이"];
    formula = "S = a²";
    category = "기하학";
  }
  {
    term-ko = "타원";
    definition-ko = "두 초점으로부터의 거리의 합이 일정한 점들의 집합. 원은 타원의 특수한 경우이다";
    formal-name-en = "ellipse";
    context = "Math.Geometry"; domain = "수학";
    related-concepts = ["원" "포물선" "쌍곡선"];
    formula = "x²/a² + y²/b² = 1";
    category = "기하학";
  }
  {
    term-ko = "구";
    definition-ko = "한 점(중심)에서 같은 거리(반지름)에 있는 점들의 집합. 겉넓이 4πr², 부피 4/3πr³이다";
    formal-name-en = "sphere";
    context = "Math.Geometry"; domain = "수학";
    related-concepts = ["원" "부피" "넓이"];
    formula = "V = 4/3·πr³, S = 4πr²";
    category = "기하학";
  }
  {
    term-ko = "원기둥";
    definition-ko = "원형 밑면과 일정한 높이를 가진 입체. 부피 = πr²h이다";
    formal-name-en = "cylinder";
    context = "Math.Geometry"; domain = "수학";
    related-concepts = ["원" "부피" "넓이"];
    formula = "V = πr²h";
    category = "기하학";
  }
  {
    term-ko = "원뿔";
    definition-ko = "원형 밑면에서 꼭짓점으로 좁아지는 입체. 부피 = 1/3·πr²h이다";
    formal-name-en = "cone";
    context = "Math.Geometry"; domain = "수학";
    related-concepts = ["원" "부피" "원기둥"];
    formula = "V = 1/3·πr²h";
    category = "기하학";
  }
  {
    term-ko = "다각형";
    definition-ko = "세 개 이상의 직선 변으로 둘러싸인 평면 도형. 변의 수에 따라 삼각형, 사각형, 오각형 등으로 불린다";
    formal-name-en = "polygon";
    context = "Math.Geometry"; domain = "수학";
    related-concepts = ["삼각형" "사각형" "정다각형"];
    formula = "내각의 합 = (n-2)·180°";
    category = "기하학";
  }
]
