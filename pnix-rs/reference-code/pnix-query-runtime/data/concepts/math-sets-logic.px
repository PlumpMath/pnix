# 집합·논리 기초
[
  {
    term-ko = "집합";
    definition-ko = "명확한 기준으로 구별되는 대상들의 모임. 원소, 부분집합, 합집합, 교집합, 여집합 등의 연산이 정의된다";
    formal-name-en = "set";
    context = "Math.Sets"; domain = "수학";
    related-concepts = ["원소" "부분집합" "합집합" "교집합"];
    category = "집합론";
  }
  {
    term-ko = "합집합";
    definition-ko = "두 집합 A, B의 원소를 모두 모은 집합. A ∪ B로 표기한다";
    formal-name-en = "union";
    formal-symbol = "∪";
    context = "Math.Sets"; domain = "수학";
    related-concepts = ["집합" "교집합" "여집합"];
    formula = "A ∪ B = {x | x∈A 또는 x∈B}";
    category = "집합론";
  }
  {
    term-ko = "교집합";
    definition-ko = "두 집합 A, B에 공통으로 속하는 원소들의 집합. A ∩ B로 표기한다";
    formal-name-en = "intersection";
    formal-symbol = "∩";
    context = "Math.Sets"; domain = "수학";
    related-concepts = ["집합" "합집합"];
    formula = "A ∩ B = {x | x∈A 그리고 x∈B}";
    category = "집합론";
  }
  {
    term-ko = "명제";
    definition-ko = "참 또는 거짓을 판별할 수 있는 문장이나 식. 논리학의 기본 단위이다";
    formal-name-en = "proposition";
    context = "Math.Logic"; domain = "수학";
    related-concepts = ["역" "이" "대우" "필요조건" "충분조건"];
    category = "논리";
  }
  {
    term-ko = "필요충분조건";
    definition-ko = "p이면 q이고 q이면 p일 때, p는 q의 필요충분조건(⟺)이다. 동치 관계라고도 한다";
    formal-name-en = "necessary and sufficient condition";
    formal-symbol = "⟺";
    context = "Math.Logic"; domain = "수학";
    related-concepts = ["명제" "필요조건" "충분조건"];
    category = "논리";
  }
  {
    term-ko = "귀류법";
    definition-ko = "증명하려는 명제의 부정을 가정하여 모순을 이끌어내는 증명 방법. 간접 증명법이라고도 한다";
    formal-name-en = "proof by contradiction";
    context = "Math.Logic"; domain = "수학";
    related-concepts = ["명제" "증명"];
    category = "논리";
  }
]
