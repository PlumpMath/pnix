# 선형대수 (Linear Algebra)
[
  {
    term-ko = "벡터";
    definition-ko = "크기와 방향을 갖는 양. 선형대수에서는 벡터공간의 원소로, 덧셈과 스칼라 곱셈에 대해 닫혀 있는 대수적 구조의 기본 대상이다";
    formal-name-en = "vector";
    formal-symbol = "v";
    context = "Math.LinearAlgebra";
    domain = "수학";
    related-concepts = ["행렬" "내적" "외적"];
    category = "선형대수";
  }
  {
    term-ko = "행렬";
    definition-ko = "수 또는 기호를 직사각형 배열로 나열한 것. m×n 행렬은 m개의 행과 n개의 열로 구성되며, 선형 변환을 표현하는 기본 도구이다";
    formal-name-en = "matrix";
    formal-symbol = "A";
    context = "Math.LinearAlgebra";
    domain = "수학";
    related-concepts = ["벡터" "행렬식" "역행렬" "단위행렬" "고유값"];
    category = "선형대수";
  }
  {
    term-ko = "행렬식";
    definition-ko = "정사각 행렬에 대해 정의되는 스칼라 값. 기하학적으로 선형 변환에 의한 부피의 변화율(부호 포함)을 나타내며, det(A) = 0이면 역행렬이 존재하지 않는다";
    formal-name-en = "determinant";
    formal-symbol = "det(A)";
    context = "Math.LinearAlgebra";
    domain = "수학";
    related-concepts = ["행렬" "역행렬" "고유값"];
    formula = "det(A) = Σ sgn(σ) · Π aᵢ,σ(ᵢ)";
    category = "선형대수";
  }
  {
    term-ko = "고유값";
    definition-ko = "정사각 행렬 A에 대해 Av = λv를 만족하는 스칼라 λ. 대응하는 영이 아닌 벡터 v를 고유벡터라 하며, 특성다항식 det(A - λI) = 0의 근이다";
    formal-name-en = "eigenvalue";
    formal-symbol = "λ";
    context = "Math.LinearAlgebra";
    domain = "수학";
    related-concepts = ["행렬" "행렬식" "벡터"];
    formula = "Av = λv, det(A - λI) = 0";
    category = "선형대수";
  }
  {
    term-ko = "내적";
    definition-ko = "두 벡터로부터 스칼라를 얻는 이항 연산. ℝⁿ에서 a · b = Σ aᵢbᵢ = |a||b|cos θ이며, 양의 정부호(positive definite) 등의 조건을 만족한다";
    formal-name-en = "inner product";
    formal-symbol = "a · b";
    context = "Math.LinearAlgebra";
    domain = "수학";
    related-concepts = ["벡터" "외적" "코사인"];
    formula = "a · b = Σᵢ aᵢbᵢ = |a||b|cos θ";
    category = "선형대수";
  }
  {
    term-ko = "외적";
    definition-ko = "ℝ³에서 두 벡터로부터 두 벡터에 모두 수직인 벡터를 얻는 연산. |a × b| = |a||b|sin θ이며, 결과의 방향은 오른손 법칙을 따른다";
    formal-name-en = "cross product";
    formal-symbol = "a × b";
    context = "Math.LinearAlgebra";
    domain = "수학";
    related-concepts = ["벡터" "내적" "사인"];
    formula = "|a × b| = |a||b|sin θ";
    category = "선형대수";
  }
  {
    term-ko = "역행렬";
    definition-ko = "정사각 행렬 A에 대해 AB = BA = I를 만족하는 행렬 B = A⁻¹. det(A) ≠ 0일 때만 존재하며, 선형 연립방정식의 해를 구하는 데 사용된다";
    formal-name-en = "inverse matrix";
    formal-symbol = "A⁻¹";
    context = "Math.LinearAlgebra";
    domain = "수학";
    related-concepts = ["행렬" "행렬식" "단위행렬" "방정식"];
    formula = "AA⁻¹ = A⁻¹A = I";
    category = "선형대수";
  }
  {
    term-ko = "단위행렬";
    definition-ko = "대각 성분이 모두 1이고 나머지가 0인 정사각 행렬. 행렬 곱셈의 항등원으로, 임의의 행렬 A에 대해 AI = IA = A가 성립한다";
    formal-name-en = "identity matrix";
    formal-symbol = "I";
    context = "Math.LinearAlgebra";
    domain = "수학";
    related-concepts = ["행렬" "역행렬"];
    formula = "AI = IA = A";
    category = "선형대수";
  }
  # 행렬식, 역행렬, 고유값은 이미 위에 정의됨 — 중복 안 함
  {
    term-ko = "고유벡터";
    definition-ko = "행렬 A에 의해 방향이 변하지 않는 영이 아닌 벡터. Av = λv에서 v가 고유벡터이다";
    formal-name-en = "eigenvector";
    context = "Math.LinearAlgebra"; domain = "수학";
    related-concepts = ["고유값" "행렬" "벡터"];
    formula = "Av = λv";
    category = "선형대수";
  }
  {
    term-ko = "선형독립";
    definition-ko = "벡터들의 일차결합으로 영벡터를 만들 수 있는 방법이 모든 계수가 0인 경우뿐인 것. 선형종속의 반대이다";
    formal-name-en = "linear independence";
    context = "Math.LinearAlgebra"; domain = "수학";
    related-concepts = ["벡터" "기저" "차원"];
    category = "선형대수";
  }
]
