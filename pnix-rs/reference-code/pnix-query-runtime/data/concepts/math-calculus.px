# 해석학 (Calculus)
[
  {
    term-ko = "미적분";
    definition-ko = "미분과 적분을 통합하여 다루는 수학의 분야. 미분은 변화율, 적분은 누적량을 계산한다. 미적분의 기본정리에 의해 미분과 적분은 역연산 관계이다";
    formal-name-en = "calculus";
    context = "Math.Calculus";
    domain = "수학";
    related-concepts = ["미분" "적분" "극한" "도함수"];
    formula = "∫ₐᵇ f'(x)dx = f(b) - f(a)";
    category = "해석학";
  }
  {
    term-ko = "극한";
    definition-ko = "변수가 특정 값에 한없이 가까워질 때 함수값이 수렴하는 값. ε-δ 논법으로 엄밀하게 정의되며, 연속성과 미분의 기초이다";
    formal-name-en = "limit";
    formal-symbol = "lim";
    context = "Math.Calculus";
    domain = "수학";
    related-concepts = ["연속" "미분" "급수"];
    formula = "lim(x→a) f(x) = L";
    category = "해석학";
  }
  {
    term-ko = "연속";
    definition-ko = "함수 f가 점 a에서 연속이란, lim(x→a) f(x) = f(a)가 성립함을 뜻한다. 즉 극한값과 함수값이 일치하고 둘 다 존재해야 한다";
    formal-name-en = "continuity";
    formal-symbol = "";
    context = "Math.Calculus";
    domain = "수학";
    related-concepts = ["극한" "미분" "함수"];
    category = "해석학";
  }
  {
    term-ko = "미분";
    definition-ko = "함수의 순간변화율을 구하는 연산. f'(x) = lim(h→0) [f(x+h) - f(x)] / h로 정의되며, 접선의 기울기에 해당한다";
    formal-name-en = "differentiation";
    formal-symbol = "d/dx";
    context = "Math.Calculus";
    domain = "수학";
    related-concepts = ["도함수" "극한" "적분" "연속"];
    formula = "f'(x) = lim(h→0) [f(x+h) - f(x)] / h";
    inverse-of = "적분";
    category = "해석학";
  }
  {
    term-ko = "적분";
    definition-ko = "함수의 정의역 위에서의 누적량을 계산하는 연산. 리만 적분은 구간을 분할하여 넓이의 극한으로 정의하며, 미적분학의 기본정리에 의해 미분의 역연산이다";
    formal-name-en = "integration";
    formal-symbol = "∫";
    context = "Math.Calculus";
    domain = "수학";
    related-concepts = ["미분" "부정적분" "넓이" "극한"];
    formula = "∫ₐᵇ f(x) dx = F(b) - F(a)";
    inverse-of = "미분";
    category = "해석학";
  }
  {
    term-ko = "도함수";
    definition-ko = "함수 f의 각 점에서의 미분계수를 대응시킨 새로운 함수 f'. 도함수가 존재하면 원래 함수는 그 점에서 미분 가능(differentiable)하다고 한다";
    formal-name-en = "derivative";
    formal-symbol = "f'";
    context = "Math.Calculus";
    domain = "수학";
    related-concepts = ["미분" "함수" "연속"];
    formula = "f'(x) = dy/dx";
    category = "해석학";
  }
  {
    term-ko = "부정적분";
    definition-ko = "주어진 함수를 도함수로 갖는 모든 함수의 집합. F'(x) = f(x)를 만족하는 F(x) + C (C는 적분상수)로 표현된다";
    formal-name-en = "indefinite integral";
    formal-symbol = "∫ f(x) dx";
    context = "Math.Calculus";
    domain = "수학";
    related-concepts = ["적분" "도함수" "상수"];
    formula = "∫ f(x) dx = F(x) + C";
    category = "해석학";
  }
  {
    term-ko = "급수";
    definition-ko = "수열의 항을 순서대로 더한 것. 부분합의 수열이 수렴하면 급수가 수렴한다고 하며, 그 극한을 급수의 합이라 한다";
    formal-name-en = "series";
    formal-symbol = "Σ";
    context = "Math.Calculus";
    domain = "수학";
    related-concepts = ["극한" "테일러 급수"];
    formula = "Σₙ₌₁^∞ aₙ = lim(N→∞) Σₙ₌₁^N aₙ";
    category = "해석학";
  }
  {
    term-ko = "테일러 급수";
    definition-ko = "무한번 미분 가능한 함수를 한 점 a 주위에서 다항식의 무한합으로 전개한 것. 수렴 반경 내에서 원래 함수와 일치한다";
    formal-name-en = "Taylor series";
    formal-symbol = "";
    context = "Math.Calculus";
    domain = "수학";
    related-concepts = ["급수" "도함수" "다항식" "극한"];
    formula = "f(x) = Σₙ₌₀^∞ f⁽ⁿ⁾(a)/n! · (x-a)ⁿ";
    category = "해석학";
  }
  {
    term-ko = "수열";
    definition-ko = "자연수 집합에서 실수 집합으로의 함수. 순서가 있는 수의 나열이며, 등차수열·등비수열·피보나치 수열 등이 있다";
    formal-name-en = "sequence";
    formal-symbol = "aₙ";
    context = "Math.Calculus";
    domain = "수학";
    related-concepts = ["급수" "극한" "수렴" "등차수열" "등비수열"];
    formula = "aₙ = f(n)";
    category = "해석학";
  }
  {
    term-ko = "등차수열";
    definition-ko = "연속하는 두 항의 차가 일정한 수열. 공차 d를 사용하여 aₙ = a₁ + (n-1)d로 표현한다";
    formal-name-en = "arithmetic sequence";
    formal-symbol = "";
    context = "Math.Calculus";
    domain = "수학";
    related-concepts = ["수열" "등비수열" "급수"];
    formula = "aₙ = a₁ + (n-1)d, Sₙ = n(a₁+aₙ)/2";
    category = "해석학";
  }
  {
    term-ko = "등비수열";
    definition-ko = "연속하는 두 항의 비가 일정한 수열. 공비 r을 사용하여 aₙ = a₁·rⁿ⁻¹로 표현한다";
    formal-name-en = "geometric sequence";
    formal-symbol = "";
    context = "Math.Calculus";
    domain = "수학";
    related-concepts = ["수열" "등차수열" "급수" "지수함수"];
    formula = "aₙ = a₁·rⁿ⁻¹, Sₙ = a₁(1-rⁿ)/(1-r)";
    category = "해석학";
  }
  {
    term-ko = "수렴";
    definition-ko = "수열이나 급수가 특정 값에 한없이 가까워지는 성질. 수렴하지 않으면 발산한다";
    formal-name-en = "convergence";
    formal-symbol = "";
    context = "Math.Calculus";
    domain = "수학";
    related-concepts = ["극한" "수열" "급수" "발산"];
    formula = "lim(n→∞) aₙ = L";
    category = "해석학";
  }
]
