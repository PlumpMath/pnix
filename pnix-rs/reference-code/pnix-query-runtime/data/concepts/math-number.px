# 수체계 (Number Systems)
[
  {
    term-ko = "수";
    definition-ko = "양, 순서, 관계를 나타내는 추상적 대상의 총칭";
    formal-name-en = "number";
    formal-symbol = "";
    context = "Math.Number";
    domain = "수학";
    related-concepts = ["자연수" "정수" "유리수" "실수" "복소수"];
    category = "수체계";
  }
  {
    term-ko = "자연수";
    definition-ko = "0을 포함하지 않는 양의 정수 집합. 페아노 공리계에 의해 정의되며, 후속자 함수 S(n)으로 귀납적으로 구성된다";
    formal-name-en = "natural number";
    formal-symbol = "ℕ";
    context = "Math.Number";
    domain = "수학";
    related-concepts = ["수" "정수" "소수"];
    category = "수체계";
  }
  {
    term-ko = "정수";
    definition-ko = "자연수, 0, 자연수의 덧셈에 대한 역원(음의 정수)으로 이루어진 집합. 덧셈과 곱셈에 대해 환(ring)을 이룬다";
    formal-name-en = "integer";
    formal-symbol = "ℤ";
    context = "Math.Number";
    domain = "수학";
    related-concepts = ["자연수" "유리수" "수"];
    category = "수체계";
  }
  {
    term-ko = "유리수";
    definition-ko = "두 정수 p, q (q ≠ 0)의 비 p/q로 표현 가능한 수의 집합. 사칙연산에 대해 체(field)를 이루나 완비(complete)하지 않다";
    formal-name-en = "rational number";
    formal-symbol = "ℚ";
    context = "Math.Number";
    domain = "수학";
    related-concepts = ["정수" "실수" "무리수"];
    category = "수체계";
  }
  {
    term-ko = "실수";
    definition-ko = "유리수의 데데킨트 절단(Dedekind cut) 또는 코시 수열의 동치류로 정의되는 완비 순서체. 수직선 위의 모든 점에 대응한다";
    formal-name-en = "real number";
    formal-symbol = "ℝ";
    context = "Math.Number";
    domain = "수학";
    related-concepts = ["유리수" "무리수" "복소수"];
    category = "수체계";
  }
  {
    term-ko = "복소수";
    definition-ko = "a + bi (a, b ∈ ℝ, i² = -1) 형태의 수. 대수적으로 닫힌 체(algebraically closed field)이며, 대수학의 기본정리에 의해 모든 다항방정식이 근을 갖는다";
    formal-name-en = "complex number";
    formal-symbol = "ℂ";
    context = "Math.Number";
    domain = "수학";
    related-concepts = ["실수" "허수" "방정식"];
    category = "수체계";
  }
  {
    term-ko = "허수";
    definition-ko = "실수가 아닌 복소수의 허수부를 구성하는 단위. i² = -1을 만족하는 수로, 복소평면에서 세로축에 대응한다";
    formal-name-en = "imaginary unit";
    formal-symbol = "i";
    context = "Math.Number";
    domain = "수학";
    related-concepts = ["복소수" "실수"];
    formula = "i² = -1";
    category = "수체계";
  }
  {
    term-ko = "무리수";
    definition-ko = "두 정수의 비로 표현할 수 없는 실수. √2, π, e 등이 대표적이며, 유리수의 여집합으로서 ℝ 위에 조밀하다";
    formal-name-en = "irrational number";
    formal-symbol = "";
    context = "Math.Number";
    domain = "수학";
    related-concepts = ["유리수" "실수" "원주율"];
    category = "수체계";
  }
  {
    term-ko = "소수";
    definition-ko = "1보다 큰 자연수 중 1과 자기 자신만을 약수로 갖는 수. 산술의 기본정리에 의해 모든 자연수는 소수의 곱으로 유일하게 분해된다";
    formal-name-en = "prime number";
    formal-symbol = "p";
    context = "Math.Number";
    domain = "수학";
    related-concepts = ["자연수" "정수"];
    category = "수체계";
  }
]
