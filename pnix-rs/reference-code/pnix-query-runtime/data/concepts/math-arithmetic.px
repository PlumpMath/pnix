# 수학 · 사칙연산 + 초등연산
[
  {
    term-ko = "덧셈";
    definition-ko = "두 수를 합하여 하나의 수를 구하는 이항연산이다. a + b = c에서 a, b는 피가수이고 c는 합이다. 교환법칙과 결합법칙이 성립한다.";
    formal-name-en = "addition";
    formal-symbol = "+";
    context = "Math.Arithmetic";
    domain = "수학";
    related-concepts = ["뺄셈" "곱셈"];
    formula = "a + b = c";
    inverse-of = "";
    category = "사칙연산";
  }
  {
    term-ko = "뺄셈";
    definition-ko = "덧셈의 역연산이다. a − b = c는 c + b = a를 만족하는 c를 구하는 것이다.";
    formal-name-en = "subtraction";
    formal-symbol = "−";
    context = "Math.Arithmetic";
    domain = "수학";
    related-concepts = ["덧셈"];
    formula = "a − b = c";
    inverse-of = "덧셈";
    category = "사칙연산";
  }
  {
    term-ko = "곱셈";
    definition-ko = "한 수를 다른 수만큼 반복하여 더하는 이항연산이다. a × b에서 a, b는 인수이고 결과는 곱이다. 교환법칙과 결합법칙이 성립한다.";
    formal-name-en = "multiplication";
    formal-symbol = "×";
    context = "Math.Arithmetic";
    domain = "수학";
    related-concepts = ["나눗셈" "덧셈"];
    formula = "a × b = c";
    category = "사칙연산";
  }
  {
    term-ko = "나눗셈";
    definition-ko = "곱셈의 역연산이다. a ÷ b = c는 c × b = a를 만족하는 c를 구하는 것이다. b ≠ 0이어야 한다.";
    formal-name-en = "division";
    formal-symbol = "÷";
    context = "Math.Arithmetic";
    domain = "수학";
    related-concepts = ["곱셈"];
    formula = "a ÷ b = c (b ≠ 0)";
    inverse-of = "곱셈";
    category = "사칙연산";
  }
  {
    term-ko = "거듭제곱";
    definition-ko = "같은 수를 여러 번 곱하는 연산이다. aⁿ은 a를 n번 곱한 것이다.";
    formal-name-en = "exponentiation";
    formal-symbol = "aⁿ";
    context = "Math.Elementary";
    domain = "수학";
    related-concepts = ["제곱근" "곱셈"];
    formula = "aⁿ = a × a × … × a (n번)";
    category = "초등연산";
  }
  {
    term-ko = "제곱근";
    definition-ko = "제곱하여 a가 되는 수이다. √a = b이면 b² = a이다. a ≥ 0이어야 한다.";
    formal-name-en = "square root";
    formal-symbol = "√";
    context = "Math.Elementary";
    domain = "수학";
    related-concepts = ["거듭제곱"];
    formula = "√a = a^(1/2)";
    category = "초등연산";
  }
  {
    term-ko = "절댓값";
    definition-ko = "수직선 위에서 원점까지의 거리이다. |a| = a (a ≥ 0), |a| = −a (a < 0).";
    formal-name-en = "absolute value";
    formal-symbol = "|a|";
    context = "Math.Elementary";
    domain = "수학";
    related-concepts = ["실수"];
    formula = "|a| = √(a²)";
    category = "초등연산";
  }
  {
    term-ko = "팩토리얼";
    definition-ko = "1부터 n까지의 모든 자연수를 곱한 값이다. 0! = 1로 정의한다.";
    formal-name-en = "factorial";
    formal-symbol = "n!";
    context = "Math.Elementary";
    domain = "수학";
    related-concepts = ["자연수" "곱셈"];
    formula = "n! = n × (n−1) × … × 2 × 1";
    category = "초등연산";
  }
  {
    term-ko = "백분율";
    definition-ko = "전체를 100으로 놓았을 때의 비율이다. p% = p/100이다.";
    formal-name-en = "percentage";
    formal-symbol = "%";
    context = "Math.Elementary";
    domain = "수학";
    related-concepts = ["나눗셈"];
    unit-ko = "%";
    formula = "p% = p/100";
    category = "초등연산";
  }
  {
    term-ko = "최대공약수";
    definition-ko = "두 개 이상의 정수의 공통 약수 중 가장 큰 수이다.";
    formal-name-en = "greatest common divisor";
    formal-symbol = "gcd(a,b)";
    context = "Math.Elementary";
    domain = "수학";
    related-concepts = ["최소공배수" "소수"];
    formula = "gcd(a, b)";
    category = "정수론";
  }
  {
    term-ko = "최소공배수";
    definition-ko = "두 개 이상의 정수의 공통 배수 중 가장 작은 양수이다.";
    formal-name-en = "least common multiple";
    formal-symbol = "lcm(a,b)";
    context = "Math.Elementary";
    domain = "수학";
    related-concepts = ["최대공약수"];
    formula = "lcm(a, b) = |a × b| / gcd(a, b)";
    category = "정수론";
  }
]
