# 삼각함수 (Trigonometry)
[
  {
    term-ko = "사인";
    definition-ko = "직각삼각형에서 한 예각의 대변과 빗변의 비. 단위원 위의 점 (cos θ, sin θ)에서 y좌표에 해당하며, 주기 2π인 홀함수이다";
    formal-name-en = "sine";
    formal-symbol = "sin";
    context = "Math.Trigonometry";
    domain = "수학";
    related-concepts = ["코사인" "탄젠트" "라디안" "피타고라스 정리"];
    formula = "sin θ = 대변 / 빗변";
    category = "삼각함수";
  }
  {
    term-ko = "코사인";
    definition-ko = "직각삼각형에서 한 예각의 인접변과 빗변의 비. 단위원 위의 점 (cos θ, sin θ)에서 x좌표에 해당하며, 주기 2π인 짝함수이다";
    formal-name-en = "cosine";
    formal-symbol = "cos";
    context = "Math.Trigonometry";
    domain = "수학";
    related-concepts = ["사인" "탄젠트" "라디안" "피타고라스 정리"];
    formula = "cos θ = 인접변 / 빗변";
    category = "삼각함수";
  }
  {
    term-ko = "탄젠트";
    definition-ko = "사인과 코사인의 비로 정의되는 삼각함수. tan θ = sin θ / cos θ이며, cos θ = 0인 점에서 정의되지 않고, 주기는 π이다";
    formal-name-en = "tangent";
    formal-symbol = "tan";
    context = "Math.Trigonometry";
    domain = "수학";
    related-concepts = ["사인" "코사인"];
    formula = "tan θ = sin θ / cos θ = 대변 / 인접변";
    category = "삼각함수";
  }
  {
    term-ko = "피타고라스 정리";
    definition-ko = "직각삼각형에서 빗변의 제곱은 나머지 두 변의 제곱의 합과 같다. 삼각함수의 기본 항등식 sin²θ + cos²θ = 1의 기하학적 근거이다";
    formal-name-en = "Pythagorean theorem";
    formal-symbol = "";
    context = "Math.Trigonometry";
    domain = "수학";
    related-concepts = ["사인" "코사인" "삼각형" "직선"];
    formula = "a² + b² = c²";
    category = "삼각함수";
  }
  {
    term-ko = "라디안";
    definition-ko = "원의 반지름과 같은 길이의 호에 대한 중심각의 크기. 1 rad = 180°/π이며, 해석학에서의 미분 공식이 깔끔해지는 자연스러운 각도 단위이다";
    formal-name-en = "radian";
    formal-symbol = "rad";
    context = "Math.Trigonometry";
    domain = "수학";
    related-concepts = ["호도법" "원" "원주율"];
    formula = "θ(rad) = 호의 길이 / 반지름";
    category = "삼각함수";
  }
  {
    term-ko = "호도법";
    definition-ko = "각의 크기를 라디안 단위로 나타내는 방법. 완전한 한 바퀴가 2π rad에 해당하며, 60분법(degree)과의 변환은 π rad = 180°이다";
    formal-name-en = "radian measure";
    formal-symbol = "";
    context = "Math.Trigonometry";
    domain = "수학";
    related-concepts = ["라디안" "원주율" "각"];
    formula = "π rad = 180°";
    category = "삼각함수";
  }
  {
    term-ko = "단위원";
    definition-ko = "반지름이 1인 원. 삼각함수의 기하학적 정의에 사용된다. 점 (cosθ, sinθ)이 단위원 위의 점이다";
    formal-name-en = "unit circle";
    context = "Math.Trigonometry"; domain = "수학";
    related-concepts = ["사인" "코사인" "라디안" "원"];
    category = "삼각함수";
  }
  {
    term-ko = "역삼각함수";
    definition-ko = "삼각함수의 역함수. arcsin, arccos, arctan 등이 있으며, 각도를 구할 때 사용한다";
    formal-name-en = "inverse trigonometric function";
    context = "Math.Trigonometry"; domain = "수학";
    related-concepts = ["사인" "코사인" "탄젠트"];
    formula = "arcsin(x): [-1,1]→[-π/2,π/2]";
    category = "삼각함수";
  }
  {
    term-ko = "삼각함수덧셈정리";
    definition-ko = "두 각의 합 또는 차에 대한 삼각함수 값을 각각의 삼각함수 값으로 표현하는 공식";
    formal-name-en = "angle addition formulas";
    context = "Math.Trigonometry"; domain = "수학";
    related-concepts = ["사인" "코사인" "탄젠트"];
    formula = "sin(A+B) = sinA·cosB + cosA·sinB, cos(A+B) = cosA·cosB - sinA·sinB";
    category = "삼각함수";
  }
  {
    term-ko = "코시컨트";
    definition-ko = "사인의 역수. csc(θ) = 1/sin(θ)이다";
    formal-name-en = "cosecant";
    formal-symbol = "csc";
    context = "Math.Trigonometry"; domain = "수학";
    related-concepts = ["사인" "시컨트" "코탄젠트"];
    formula = "csc(θ) = 1/sin(θ)";
    category = "삼각함수";
  }
  {
    term-ko = "시컨트";
    definition-ko = "코사인의 역수. sec(θ) = 1/cos(θ)이다";
    formal-name-en = "secant";
    formal-symbol = "sec";
    context = "Math.Trigonometry"; domain = "수학";
    related-concepts = ["코사인" "코시컨트" "코탄젠트"];
    formula = "sec(θ) = 1/cos(θ)";
    category = "삼각함수";
  }
  {
    term-ko = "코탄젠트";
    definition-ko = "탄젠트의 역수. cot(θ) = cos(θ)/sin(θ)이다";
    formal-name-en = "cotangent";
    formal-symbol = "cot";
    context = "Math.Trigonometry"; domain = "수학";
    related-concepts = ["탄젠트" "코시컨트" "시컨트"];
    formula = "cot(θ) = cos(θ)/sin(θ)";
    category = "삼각함수";
  }
]
