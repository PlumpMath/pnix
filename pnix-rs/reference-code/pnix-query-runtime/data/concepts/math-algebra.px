# 대수 (Algebra)
[
  {
    term-ko = "방정식";
    definition-ko = "미지수를 포함하는 등식으로, 그 등식을 참으로 만드는 미지수의 값(근)을 구하는 것이 목적이다";
    formal-name-en = "equation";
    formal-symbol = "";
    context = "Math.Algebra";
    domain = "수학";
    related-concepts = ["등호" "변수" "이차방정식" "부등식"];
    category = "대수";
  }
  {
    term-ko = "부등식";
    definition-ko = "두 수학적 표현 사이의 대소 관계(<, >, ≤, ≥)를 나타내는 식. 해집합이 일반적으로 구간 또는 영역으로 주어진다";
    formal-name-en = "inequality";
    formal-symbol = "";
    context = "Math.Algebra";
    domain = "수학";
    related-concepts = ["방정식" "변수" "집합"];
    category = "대수";
  }
  {
    term-ko = "다항식";
    definition-ko = "유한 개의 단항식의 합으로 표현되는 식. p(x) = aₙxⁿ + aₙ₋₁xⁿ⁻¹ + ... + a₁x + a₀ 형태이며, 가장 높은 차수 n을 차수(degree)라 한다";
    formal-name-en = "polynomial";
    formal-symbol = "p(x)";
    context = "Math.Algebra";
    domain = "수학";
    related-concepts = ["변수" "상수" "이차방정식" "함수"];
    category = "대수";
  }
  {
    term-ko = "이차방정식";
    definition-ko = "ax² + bx + c = 0 (a ≠ 0) 형태의 방정식. 판별식 D = b² - 4ac에 의해 근의 존재와 성질이 결정된다";
    formal-name-en = "quadratic equation";
    formal-symbol = "";
    context = "Math.Algebra";
    domain = "수학";
    related-concepts = ["방정식" "다항식" "복소수"];
    formula = "x = (-b ± √(b² - 4ac)) / 2a";
    category = "대수";
  }
  {
    term-ko = "변수";
    definition-ko = "값이 변할 수 있는 양을 나타내는 기호. 자유변수와 속박변수로 구분되며, 함수의 정의역 원소에 대응한다";
    formal-name-en = "variable";
    formal-symbol = "x";
    context = "Math.Algebra";
    domain = "수학";
    related-concepts = ["상수" "함수" "방정식"];
    category = "대수";
  }
  {
    term-ko = "상수";
    definition-ko = "고정된 값을 갖는 양. 수학적 맥락에서 변하지 않는 확정된 수 또는 기호(π, e 등)를 가리킨다";
    formal-name-en = "constant";
    formal-symbol = "c";
    context = "Math.Algebra";
    domain = "수학";
    related-concepts = ["변수" "원주율"];
    category = "대수";
  }
  {
    term-ko = "함수";
    definition-ko = "정의역의 각 원소에 공역의 원소를 하나씩 대응시키는 관계. f: X → Y로 표기하며, x ∈ X에 대해 f(x) ∈ Y가 유일하게 결정된다";
    formal-name-en = "function";
    formal-symbol = "f";
    context = "Math.Algebra";
    domain = "수학";
    related-concepts = ["변수" "집합" "도함수"];
    category = "대수";
  }
  {
    term-ko = "등호";
    definition-ko = "두 수학적 표현이 같은 값을 나타냄을 표시하는 이항 관계. 반사성, 대칭성, 추이성을 만족하는 동치 관계이다";
    formal-name-en = "equality";
    formal-symbol = "=";
    context = "Math.Algebra";
    domain = "수학";
    related-concepts = ["방정식" "부등식"];
    category = "대수";
  }
]
