# 전자기학 (Electromagnetism)
[
  {
    term-ko = "전하";
    definition-ko = "물질이 갖는 전기적 성질의 근원이 되는 물리량. 양전하와 음전하가 있으며, 전하량은 보존된다. 기본 전하량은 e = 1.602 × 10⁻¹⁹ C이다";
    formal-name-en = "electric charge";
    formal-symbol = "q";
    context = "Physics.Electromagnetism";
    domain = "물리";
    related-concepts = ["전류" "전기장" "쿨롱의 법칙"];
    unit-ko = "C (쿨롱)";
    category = "전자기학";
  }
  {
    term-ko = "전류";
    definition-ko = "단위 시간당 흐르는 전하량. I = dq/dt이며, 도체에서 전자의 이동 방향과 관례적 전류 방향은 반대이다";
    formal-name-en = "electric current";
    formal-symbol = "I";
    context = "Physics.Electromagnetism";
    domain = "물리";
    related-concepts = ["전하" "전압" "저항" "옴의 법칙"];
    unit-ko = "A (암페어)";
    formula = "I = dq/dt";
    category = "전자기학";
  }
  {
    term-ko = "전압";
    definition-ko = "두 점 사이의 전위차. 단위 전하를 한 점에서 다른 점으로 이동시키는 데 필요한 일로 정의되며, 전류를 구동하는 원인이다";
    formal-name-en = "voltage";
    formal-symbol = "V";
    context = "Physics.Electromagnetism";
    domain = "물리";
    related-concepts = ["전류" "저항" "옴의 법칙" "전기장"];
    unit-ko = "V (볼트)";
    formula = "V = W / q";
    category = "전자기학";
  }
  {
    term-ko = "저항";
    definition-ko = "전류의 흐름을 방해하는 정도. 물질의 고유 성질(비저항)과 도체의 기하학적 형태에 의해 결정되며, 옴의 법칙에서 V = IR의 비례 상수이다";
    formal-name-en = "electrical resistance";
    formal-symbol = "R";
    context = "Physics.Electromagnetism";
    domain = "물리";
    related-concepts = ["전류" "전압" "옴의 법칙"];
    unit-ko = "Ω (옴)";
    formula = "R = V / I";
    category = "전자기학";
  }
  {
    term-ko = "전기장";
    definition-ko = "전하가 주변 공간에 만드는 벡터장. 점전하 q에 의한 전기장은 E = kq/r² (방사 방향)이며, 시험 전하가 받는 단위 전하당 힘으로 정의된다";
    formal-name-en = "electric field";
    formal-symbol = "E";
    context = "Physics.Electromagnetism";
    domain = "물리";
    related-concepts = ["전하" "자기장" "쿨롱의 법칙" "전압"];
    unit-ko = "V/m (볼트 퍼 미터)";
    formula = "E = F / q = kq / r²";
    category = "전자기학";
  }
  {
    term-ko = "자기장";
    definition-ko = "운동하는 전하나 전류가 주변 공간에 만드는 벡터장. 운동하는 전하 q에 작용하는 로런츠 힘 F = qv × B로 정의되며, 전기장과 함께 전자기파를 구성한다";
    formal-name-en = "magnetic field";
    formal-symbol = "B";
    context = "Physics.Electromagnetism";
    domain = "물리";
    related-concepts = ["전기장" "전류" "패러데이 법칙"];
    unit-ko = "T (테슬라)";
    formula = "F = qv × B";
    category = "전자기학";
  }
  {
    term-ko = "옴의 법칙";
    definition-ko = "도체에 흐르는 전류는 양 끝의 전압에 비례하고 저항에 반비례한다. V = IR은 선형 저항성 물질에 대한 경험 법칙이다";
    formal-name-en = "Ohm's law";
    formal-symbol = "";
    context = "Physics.Electromagnetism";
    domain = "물리";
    related-concepts = ["전압" "전류" "저항"];
    unit-ko = "";
    formula = "V = IR";
    category = "전자기학";
  }
  {
    term-ko = "쿨롱의 법칙";
    definition-ko = "두 점전하 사이에 작용하는 정전기력은 두 전하량의 곱에 비례하고 거리의 제곱에 반비례한다. 만유인력 법칙과 같은 역제곱 법칙 형태이다";
    formal-name-en = "Coulomb's law";
    formal-symbol = "";
    context = "Physics.Electromagnetism";
    domain = "물리";
    related-concepts = ["전하" "전기장"];
    unit-ko = "";
    formula = "F = k · q₁q₂ / r²";
    category = "전자기학";
  }
  {
    term-ko = "패러데이 법칙";
    definition-ko = "폐회로를 관통하는 자기 선속의 시간 변화율이 유도 기전력을 발생시킨다. 렌츠의 법칙에 의해 유도 기전력은 선속 변화를 방해하는 방향으로 생긴다";
    formal-name-en = "Faraday's law of induction";
    formal-symbol = "";
    context = "Physics.Electromagnetism";
    domain = "물리";
    related-concepts = ["자기장" "전기장" "전압"];
    unit-ko = "";
    formula = "ε = -dΦ_B/dt";
    category = "전자기학";
  }
  {
    term-ko = "전력";
    definition-ko = "단위 시간당 소비하는 전기 에너지. P = VI = I²R = V²/R이다. 단위는 와트(W)이다";
    formal-name-en = "electric power";
    formal-symbol = "P";
    context = "Physics.Electromagnetism";
    domain = "물리";
    related-concepts = ["전압" "전류" "저항" "에너지"];
    unit-ko = "와트(W)";
    formula = "P = VI = I²R";
    category = "전자기학";
  }
  {
    term-ko = "전기회로";
    definition-ko = "전류가 흐를 수 있는 닫힌 경로. 직렬회로와 병렬회로가 있으며, 키르히호프 법칙으로 분석한다";
    formal-name-en = "electric circuit";
    context = "Physics.Electromagnetism";
    domain = "물리";
    related-concepts = ["전류" "전압" "저항" "옴의 법칙"];
    category = "전자기학";
  }
]
