# 열역학 (Thermodynamics)
[
  {
    term-ko = "온도";
    definition-ko = "물체를 구성하는 입자들의 평균 운동 에너지에 대응하는 거시적 상태량. 열평형 상태에 있는 두 계는 같은 온도를 갖는다(열역학 제0법칙)";
    formal-name-en = "temperature";
    formal-symbol = "T";
    context = "Physics.Thermodynamics";
    domain = "물리";
    related-concepts = ["열" "엔트로피" "비열"];
    unit-ko = "K (켈빈)";
    category = "열역학";
  }
  {
    term-ko = "열";
    definition-ko = "온도 차이에 의해 계 사이에서 전달되는 에너지. 일(work)과 함께 내부 에너지를 변화시키는 두 가지 에너지 전달 방식 중 하나이다";
    formal-name-en = "heat";
    formal-symbol = "Q";
    context = "Physics.Thermodynamics";
    domain = "물리";
    related-concepts = ["온도" "비열" "열역학 제1법칙" "엔트로피"];
    unit-ko = "J (줄)";
    formula = "Q = mcΔT";
    category = "열역학";
  }
  {
    term-ko = "엔트로피";
    definition-ko = "계의 무질서도 또는 미시 상태의 수를 나타내는 상태함수. 통계역학적으로 S = k_B ln Ω이며, 고립계에서 비가역 과정을 거치면 항상 증가한다";
    formal-name-en = "entropy";
    formal-symbol = "S";
    context = "Physics.Thermodynamics";
    domain = "물리";
    related-concepts = ["열역학 제2법칙" "온도" "열"];
    unit-ko = "J/K (줄 퍼 켈빈)";
    formula = "dS = δQ_rev / T";
    category = "열역학";
  }
  {
    term-ko = "압력";
    definition-ko = "단위 면적당 작용하는 수직 방향의 힘. 유체에서는 모든 방향으로 동일하게 작용하며(파스칼의 원리), 이상기체에서 PV = nRT를 만족한다";
    formal-name-en = "pressure";
    formal-symbol = "P";
    context = "Physics.Thermodynamics";
    domain = "물리";
    related-concepts = ["온도" "열역학 제1법칙"];
    unit-ko = "Pa (파스칼)";
    formula = "P = F / A";
    category = "열역학";
  }
  {
    term-ko = "비열";
    definition-ko = "단위 질량의 물질의 온도를 1K 올리는 데 필요한 열량. 물질의 고유한 열적 성질이며, 정압 비열(cₚ)과 정적 비열(cᵥ)로 구분된다";
    formal-name-en = "specific heat capacity";
    formal-symbol = "c";
    context = "Physics.Thermodynamics";
    domain = "물리";
    related-concepts = ["열" "온도"];
    unit-ko = "J/(kg·K)";
    formula = "c = Q / (mΔT)";
    category = "열역학";
  }
  {
    term-ko = "열역학 제1법칙";
    definition-ko = "에너지 보존 법칙의 열역학적 표현. 계의 내부 에너지 변화는 계에 가해진 열과 계가 한 일의 차이와 같다: ΔU = Q - W";
    formal-name-en = "first law of thermodynamics";
    formal-symbol = "";
    context = "Physics.Thermodynamics";
    domain = "물리";
    related-concepts = ["열" "열역학 제2법칙" "압력"];
    unit-ko = "";
    formula = "ΔU = Q - W";
    category = "열역학";
  }
  {
    term-ko = "열역학 제2법칙";
    definition-ko = "고립계의 엔트로피는 결코 감소하지 않으며, 비가역 과정에서는 항상 증가한다. 동치 표현: 열은 저절로 저온에서 고온으로 이동하지 않는다(클라우지우스)";
    formal-name-en = "second law of thermodynamics";
    formal-symbol = "";
    context = "Physics.Thermodynamics";
    domain = "물리";
    related-concepts = ["엔트로피" "열역학 제1법칙" "열" "온도"];
    unit-ko = "";
    formula = "ΔS_total ≥ 0";
    category = "열역학";
  }
]
