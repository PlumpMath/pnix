    category = "지구과학";
  }
  {
    term-ko = "판구조론";
    definition-ko = "지구의 표면이 여러 개의 판(plate)으로 이루어져 있고, 이 판들이 서로 움직이면서 지진, 화산, 산맥 등을 만든다는 이론";
    formal-name-en = "plate tectonics";
    context = "Science.Earth"; domain = "지구과학";
