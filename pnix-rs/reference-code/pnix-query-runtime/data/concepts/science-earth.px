# 지구과학 기초 개념
[
  {
    term-ko = "지진";
    definition-ko = "지구 내부의 힘에 의해 지각이 갑자기 흔들리는 현상. 진앙, 진원, 규모(리히터), 진도(메르칼리)로 측정한다";
    formal-name-en = "earthquake";
