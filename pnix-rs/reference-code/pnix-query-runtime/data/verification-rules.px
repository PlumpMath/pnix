# 계산 검증 규칙 (정본). pnix 플랫폼 내장.
# 자동 학습된 fact의 수학/물리적 정합성을 검증한다.
# Python 없이 pnix symbolic engine + 이 규칙만으로 기본 검증 가능.
# hot-reload: .px 편집 → 즉시 반영.
{
  # ── 차원 검증 규칙 ──────────────────────────────────
  # 수식의 양변 차원이 맞는지 검사.
  dimension-rules = [
    { formula-pattern = "F = m * a"; left-dim = "M·L·T⁻²"; right-dim = "M·L·T⁻²"; }
    { formula-pattern = "p = m * v"; left-dim = "M·L·T⁻¹"; right-dim = "M·L·T⁻¹"; }
    { formula-pattern = "K = 0.5 * m * v^2"; left-dim = "M·L²·T⁻²"; right-dim = "M·L²·T⁻²"; }
    { formula-pattern = "W = F * d"; left-dim = "M·L²·T⁻²"; right-dim = "M·L²·T⁻²"; }
    { formula-pattern = "E = m * c^2"; left-dim = "M·L²·T⁻²"; right-dim = "M·L²·T⁻²"; }
  ];

  # ── 미분 검증 규칙 ──────────────────────────────────
  # pnix symbolic differentiate로 검증 가능한 공식 쌍.
  differentiation-rules = [
    { input = "x^n"; result = "n * x^(n-1)"; rule = "power-rule"; }
    { input = "sin(x)"; result = "cos(x)"; rule = "sin-derivative"; }
    { input = "cos(x)"; result = "-sin(x)"; rule = "cos-derivative"; }
    { input = "e^x"; result = "e^x"; rule = "exp-derivative"; }
    { input = "ln(x)"; result = "1/x"; rule = "log-derivative"; }
    { input = "f(x) + g(x)"; result = "f'(x) + g'(x)"; rule = "sum-rule"; }
    { input = "f(x) * g(x)"; result = "f'(x)*g(x) + f(x)*g'(x)"; rule = "product-rule"; }
    { input = "f(g(x))"; result = "f'(g(x)) * g'(x)"; rule = "chain-rule"; }
  ];

  # ── 적분 검증 규칙 ──────────────────────────────────
  # 적분 결과를 미분해서 원래 함수가 나오는지 교차 검증.
  integration-verification-method = "differentiate-result-and-compare";

  # ── 수치 검증 규칙 ──────────────────────────────────
  # 기호 계산 결과에 구체 값을 대입해서 수치적으로 일치하는지 확인.
  numeric-verification = {
    method = "substitute-and-compare";
    test-values = ["0" "1" "2" "-1" "0.5" "3.14159"];
    tolerance = "1e-10";
  };

  # ── 물리 상수 검증 (NIST/CODATA 2022) ──────────────
  # 자동 학습된 물리 상수가 CODATA 값과 일치하는지 검사.
  physical-constants = [
    { name = "광속"; symbol = "c"; value = "299792458"; unit = "m/s"; source = "CODATA-2022"; }
    { name = "중력가속도"; symbol = "g"; value = "9.80665"; unit = "m/s²"; source = "ISO-80000"; }
    { name = "플랑크상수"; symbol = "h"; value = "6.62607015e-34"; unit = "J·s"; source = "CODATA-2022"; }
    { name = "볼츠만상수"; symbol = "k_B"; value = "1.380649e-23"; unit = "J/K"; source = "CODATA-2022"; }
    { name = "아보가드로수"; symbol = "N_A"; value = "6.02214076e23"; unit = "mol⁻¹"; source = "CODATA-2022"; }
    { name = "기본전하"; symbol = "e"; value = "1.602176634e-19"; unit = "C"; source = "CODATA-2022"; }
    { name = "전자질량"; symbol = "m_e"; value = "9.1093837015e-31"; unit = "kg"; source = "CODATA-2022"; }
    { name = "양성자질량"; symbol = "m_p"; value = "1.67262192369e-27"; unit = "kg"; source = "CODATA-2022"; }
    { name = "진공유전율"; symbol = "ε₀"; value = "8.8541878128e-12"; unit = "F/m"; source = "CODATA-2022"; }
    { name = "진공투자율"; symbol = "μ₀"; value = "1.25663706212e-6"; unit = "N/A²"; source = "CODATA-2022"; }
  ];

  # ── 코드 인젝션 방지 (Python 검증 시) ──────────────
  # 인터넷에서 온 문자열을 Python에 직접 전달 금지.
  # 반드시 pnix symbolic AST → Python AST 구조 변환만 허용.
  python-verification = {
    method = "ast-to-ast";
    # 허용된 Python 함수 화이트리스트
    allowed-functions = [
      "sympy.diff" "sympy.integrate" "sympy.solve" "sympy.simplify"
      "sympy.expand" "sympy.factor" "sympy.limit" "sympy.series"
      "numpy.sin" "numpy.cos" "numpy.exp" "numpy.log" "numpy.sqrt"
    ];
    # 금지: eval, exec, __import__, os, sys, subprocess
    blocked-patterns = ["eval(" "exec(" "__import__" "os." "sys." "subprocess" "open("];
    # string 전달 금지 — AST 노드만
    input-format = "pnix-sym-ast";
    timeout-ms = "5000";
  };

  # ── 교차 검증 정책 ─────────────────────────────────
  # 자동 학습 fact 승격 전에 몇 가지 독립 검증을 통과해야 하는지.
  cross-verification = {
    # 최소 2개 독립 소스에서 교차 확인
    min-independent-sources = "2";
    # pnix symbolic과 Python sympy 결과 일치 필요
    require-symbolic-match = "true";
    # 차원 검사 통과 필요 (물리량인 경우)
    require-dimension-check = "true";
    # 물리 상수는 CODATA 값과 비교
    require-constant-match = "true";
    constant-tolerance = "1e-6";
  };
}
