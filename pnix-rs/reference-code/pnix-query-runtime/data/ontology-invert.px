# ontology-invert.px — 역방향 탐색으로 새로운 의미 생성 (hot-reloadable)
#
# 기존 ontology fact를 뒤집어서 "왜?"를 묻는 규칙.
# 인과 관계 역추적, 전제 조건 추출, 모순 감지.
#
# 사용:
# - "왜 X는 Y인가?" → X→Y 관계를 역추적
# - "X가 없다면?" → X에 의존하는 모든 fact를 탐색
# - "X와 Y가 모순이면?" → 공통 전제를 찾아서 분기점 추출
{
  # overlapping trigger selection policy. Rust는 정책 문자열과 per-trigger priority만 해석한다.
  # priority-then-pattern-length = higher priority wins, tie는 더 긴 pattern 우선.
  trigger-selection = "priority-then-pattern-length";

  # why branch route template. Rust는 ${trigger_type} 치환만 수행한다.
  route-template = "ontology-invert-${trigger_type}";

  # standalone kernel why lane fallback owner.
  # 특정 trigger type에 interpretation-rules가 없거나, domain 매핑이 비어 있어도
  # Rust literal이 아니라 이 섹션이 direct/rich shaping과 truth-regime 기본값을 소유한다.
  default-truth-regime = "interpretive";
  default-interpretation-rule = {
    direct-fact-predicates = ["why" "boundary-condition"];
    source-include-predicates = ["causal-chain" "boundary-condition"];
    source-include-context-prefixes = ["ontology-invert."];
    direct-interpretation-id = "interp.invert.direct.${trigger_type}.${term}";
    rich-interpretation-id = "interp.invert.rich.${trigger_type}.${term}";
  };

  # 역방향 질문 패턴 — 한국어 "왜" 질의 감지
  # truth-regime: formal-closed / empirical-physical / speculative-theoretical / interpretive / auto
  # auto = 질의 대상 concept의 domain에서 자동 결정
  invert-triggers = [
    { pattern = "왜"; type = "causal-inverse"; truth-regime = "auto"; priority = "0"; }
    { pattern = "원인"; type = "causal-inverse"; truth-regime = "auto"; priority = "1"; }
    { pattern = "이유"; type = "causal-inverse"; truth-regime = "auto"; priority = "1"; }
    { pattern = "근거"; type = "evidence-inverse"; truth-regime = "auto"; priority = "3"; }
    { pattern = "증명"; type = "causal-inverse"; truth-regime = "formal-closed"; priority = "4"; }
    { pattern = "유도"; type = "causal-inverse"; truth-regime = "formal-closed"; priority = "4"; }
    { pattern = "실험"; type = "causal-inverse"; truth-regime = "empirical-physical"; priority = "4"; }
    { pattern = "없다면"; type = "counterfactual"; truth-regime = "auto"; priority = "5"; }
    { pattern = "없으면"; type = "counterfactual"; truth-regime = "auto"; priority = "5"; }
    { pattern = "모순"; type = "contradiction-detect"; truth-regime = "auto"; priority = "6"; }
    { pattern = "다르다면"; type = "alternative"; truth-regime = "auto"; priority = "5"; }
    { pattern = "역사"; type = "causal-inverse"; truth-regime = "interpretive"; priority = "2"; }
    { pattern = "사건"; type = "causal-inverse"; truth-regime = "interpretive"; priority = "2"; }
  ];

  # domain → truth-regime 자동 매핑 (truth-regime = "auto"일 때)
  domain-to-regime = [
    { domain-prefix = "수학"; regime = "formal-closed"; }
    { domain-prefix = "논리"; regime = "formal-closed"; }
    { domain-prefix = "물리"; regime = "empirical-physical"; }
    { domain-prefix = "화학"; regime = "empirical-physical"; }
    { domain-prefix = "생물"; regime = "empirical-physical"; }
    { domain-prefix = "역사"; regime = "interpretive"; }
    { domain-prefix = "정치"; regime = "interpretive"; }
    { domain-prefix = "종교"; regime = "interpretive"; }
    { domain-prefix = "문학"; regime = "interpretive"; }
    { domain-prefix = "코드"; regime = "interpretive"; }
    { domain-prefix = "양자중력"; regime = "speculative-theoretical"; }
    { domain-prefix = "끈이론"; regime = "speculative-theoretical"; }
    { domain-prefix = "M-theory"; regime = "speculative-theoretical"; }
  ];

  # truth-regime → fact emission policy (.px가 owner, Rust는 generic dispatcher)
  # 각 rule이 regime에 대해 어떤 source-field(why/boundary-conditions)를 사용해서
  # 어떤 predicate/context/fact-id/layer/confidence로 Candidate fact를 만들지 선언.
  # source-field: "why" | "boundary-conditions" (def_fact의 local text source 선택)
  # confidence 생략 → decision-lane default, layer 생략 → "L3".
  # candidates = [] → 새 Candidate 생성 안 함 (formal-closed에서 rhetoric accumulation 방지).
  regime-policies = [
    {
      regime = "formal-closed";
      candidates = [];
    }
    {
      regime = "empirical-physical";
      candidates = [
        {
          source-field = "boundary-conditions";
          predicate = "boundary-condition";
          context = "ontology-invert.boundary";
          fact-id-template = "fact.invert.boundary.${term}";
          layer = "L3";
        }
      ];
    }
    {
      regime = "speculative-theoretical";
      candidates = [
        {
          source-field = "why";
          predicate = "causal-chain";
          context = "ontology-invert.speculative";
          fact-id-template = "fact.invert.speculative.${term}";
          layer = "L3";
          confidence = "0.5";
        }
      ];
    }
    {
      regime = "interpretive";
      candidates = [
        {
          source-field = "why";
          predicate = "causal-chain";
          context = "ontology-invert.causal";
          fact-id-template = "fact.invert.causal-chain.${term}";
          layer = "L3";
        }
        {
          source-field = "boundary-conditions";
          predicate = "boundary-condition";
          context = "ontology-invert.boundary";
          fact-id-template = "fact.invert.boundary.${term}";
          layer = "L3";
        }
      ];
    }
  ];

  # trigger-type → candidate fact emission rule (.px가 owner, Rust는 generic dispatcher)
  # 각 rule이 trigger_type에 대해 어떤 predicate/context/obj-template로 ContextualFact를 만들지 선언.
  # obj-template의 supported placeholder: ${term}, ${provenance}
  # (standalone kernel이 load 단계에서 unsupported placeholder는 schema error로 거부한다)
  invert-candidate-rules = [
    {
      type = "causal-inverse";
      concept-field = "why";
      predicate = "causal-chain";
      context = "ontology-invert.causal";
    }
    {
      type = "causal-inverse";
      concept-field = "boundary-conditions";
      predicate = "boundary-condition";
      context = "ontology-invert.boundary";
    }
    {
      type = "counterfactual";
      predicate = "counterfactual-impact";
      context = "ontology-invert.counterfactual";
      obj-template = "'${term}' 부재 시 의존 fact의 영향을 평가할 필요가 있다";
    }
    {
      type = "evidence-inverse";
      predicate = "evidence-support";
      context = "ontology-invert.evidence";
      obj-template = "'${term}'의 근거 사슬: ${provenance}";
    }
    {
      type = "alternative";
      predicate = "alternative-interpretation";
      context = "ontology-invert.alternative";
      obj-template = "'${term}'의 대안 해석 후보들";
    }
  ];

  # trigger-type → interpretation shaping rule (.px가 owner)
  # Rust는 type 매칭 + ${...} 치환 + fallback만 수행한다.
  interpretation-rules = [
    {
      type = "causal-inverse";
      direct-fact-predicates = ["causal-chain" "boundary-condition"];
      source-include-predicates = ["causal-chain" "boundary-condition"];
      source-include-context-prefixes = ["ontology-invert."];
      direct-interpretation-id = "interp.invert.direct.${trigger_type}.${term}";
      rich-interpretation-id = "interp.invert.rich.${trigger_type}.${term}";
    }
    {
      type = "evidence-inverse";
      direct-fact-predicates = ["evidence-support"];
      source-include-predicates = ["evidence-support"];
      source-include-context-prefixes = ["ontology-invert.evidence"];
      direct-interpretation-id = "interp.invert.direct.${trigger_type}.${term}";
      rich-interpretation-id = "interp.invert.rich.${trigger_type}.${term}";
    }
    {
      type = "counterfactual";
      direct-fact-predicates = ["counterfactual-impact"];
      source-include-predicates = ["counterfactual-impact"];
      source-include-context-prefixes = ["ontology-invert.counterfactual"];
      direct-interpretation-id = "interp.invert.direct.${trigger_type}.${term}";
      rich-interpretation-id = "interp.invert.rich.${trigger_type}.${term}";
    }
    {
      type = "contradiction-detect";
      direct-fact-predicates = ["branch-point"];
      source-include-predicates = ["branch-point" "definition-ko"];
      source-include-context-prefixes = ["ontology-invert.contradiction"];
      direct-interpretation-id = "interp.invert.direct.${trigger_type}.${term}";
      rich-interpretation-id = "interp.invert.rich.${trigger_type}.${term}";
    }
    {
      type = "alternative";
      direct-fact-predicates = ["alternative-interpretation"];
      source-include-predicates = ["alternative-interpretation"];
      source-include-context-prefixes = ["ontology-invert.alternative"];
      direct-interpretation-id = "interp.invert.direct.${trigger_type}.${term}";
      rich-interpretation-id = "interp.invert.rich.${trigger_type}.${term}";
    }
  ];

  # batch 128 (2026-04-16): 이전에는 여기 `operations = {...}` (human-readable
  # description/steps) 과 `output-format = {...}` (legacy rendering template) 가
  # 있었으나, 둘 다 runtime consumer 가 없는 declarative text spec 이었다.
  # 역추적 연산 자체의 canonical owner 는 아래 섹션들이다:
  # - `invert-triggers` / `invert-candidate-rules` — trigger dispatch + fact shape
  # - `regime-policies` — truth-regime별 fact emission (batch 125)
  # - `interpretation-rules` — why lane interpretation shaping
  # - `default-truth-regime` — fallback regime owner (batch 127)
  # 그래서 `operations` / `output-format` 는 convergence.md 논의 주석에 남기고
  # runtime payload 인 이 파일에서는 제거한다. 문서 전체 흐름은 convergence.md
  # §P5 "ontology query REPL 루프" 와 §P8 "역추적 연산" 주석을 본다.
}
