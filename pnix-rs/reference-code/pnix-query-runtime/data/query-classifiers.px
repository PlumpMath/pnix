{
  # ── Standalone kernel dispatch priority ────────────────────────
  # Rust는 이 리스트를 순회만 하고, 우선순위 자체는 .px가 정본이다.
  # 가능한 값: "why" "property" "definition"
  query-dispatch-priority = ["why" "property" "definition"];

  # Standalone kernel route ids. Rust는 key lookup만 수행한다.
  kernel-dispatch-routes = {
    definition = "concept-definition-lookup";
    property = "concept-predicate-lookup";
    held = "lightweight-korean-dialogue-held";
  };

  # Standalone kernel success carrier predicates.
  # Rust fallback helper는 이 리스트를 순회만 하고, 어떤 predicate 묶음을
  # kernel-resolved envelope로 인정할지는 .px가 정본이다.
  kernel-success-predicates = [
    "definition-ko"
    "formula"
    "unit-ko"
    "formal-symbol"
    "inverse-of"
    "domain-concept-count"
    "cross-concept-term-a"
    "sentence-verb"
    "requires-context-before-commit"
    "reopens-judgement"
    "selected-context"
  ];

  # Held fallback reason ids. Rust는 이 키를 note/fact/follow-up lookup에만 사용한다.
  held-reason-keys = {
    requires-context = "requires-context";
    unknown-term = "unknown-term";
  };

  # Standalone kernel held dispatch policy.
  # Rust는 when/term-source를 해석만 수행한다.
  held-reason-rules = [
    {
      when = "known-term";
      reason-key = "requires-context";
      term-source = "matched-term";
    }
    {
      when = "unknown-term";
      reason-key = "unknown-term";
      term-source = "first-extracted-term";
    }
  ];

  # Standalone kernel concept attrset -> source fact lowering.
  # Rust는 field/predicate 리스트를 순회만 수행한다.
  kernel-source-fact-fields = [
    { field = "definition-ko"; predicate = "definition-ko"; }
    { field = "formal-name-en"; predicate = "formal-name-en"; }
    { field = "formal-symbol"; predicate = "formal-symbol"; }
    { field = "domain"; predicate = "domain"; }
    { field = "unit-ko"; predicate = "unit-ko"; }
    { field = "formula"; predicate = "formula"; }
    { field = "inverse-of"; predicate = "inverse-of"; }
    { field = "category"; predicate = "category"; }
    { field = "why"; predicate = "why"; }
    { field = "boundary-conditions"; predicate = "boundary-condition"; }
  ];

  kernel-source-list-fields = [
    { field = "related-concepts"; predicate = "related-concept"; }
  ];

  kernel-source-metadata = {
    context = "Pnix.KernelSource";
    layer = "L1";
    status = "accepted";
    confidence = "1.0";
    field-predicate = "kernel-source-field";
    value-predicate = "kernel-source-value";
    list-field-predicate = "kernel-source-list-field";
    list-item-predicate = "kernel-source-list-item";
    field-object-template = "${field}";
    value-object-template = "${field}=${value}";
    list-field-object-template = "${field}";
    list-item-object-template = "${field}=${value}";
  };

  # ── Execution handoff classifier rules ──────────────────────────
  # Each rule maps utterance keywords to a handoff template query.
  # match-any: utterance contains ANY of these → triggers this rule.
  # match-terms + match-units: utterance contains at least one term
  #   AND at least one unit → triggers this rule.
  handoff-classifiers = [
    {
      template-id = "pnix.math.arithmetic.safe-handoff";
      tags = ["math" "arithmetic" "safe-handoff"];
      execution-owner = "puck/freecat";
      visibility = "safe-handoff";
      match-any = ["더하기" "빼기" "곱하기" "나누기"];
    }
    {
      template-id = "pnix.physics.newton-force.safe-handoff";
      tags = ["physics" "newton-force" "safe-handoff"];
      execution-owner = "puck/freecat";
      visibility = "safe-handoff";
      match-terms = ["질량" "가속도" "힘"];
      match-units = ["kg" "m/s" "뉴턴"];
    }
    # M1 Recipe OS handoffs
    {
      template-id = "pnix.recipe.app.launch";
      tags = ["recipe" "os" "launch"];
      execution-owner = "puck/os";
      visibility = "safe-handoff";
      match-any = ["열어줘" "실행해줘" "켜줘" "시작해줘"];
    }
    {
      template-id = "pnix.recipe.file.search";
      tags = ["recipe" "os" "search"];
      execution-owner = "puck/os";
      visibility = "safe-handoff";
      match-any = ["찾아줘" "파일 검색" "어디에 있어"];
    }
    {
      template-id = "pnix.recipe.clipboard";
      tags = ["recipe" "os" "clipboard"];
      execution-owner = "puck/os";
      visibility = "safe-handoff";
      match-any = ["클립보드" "복사한 거" "붙여넣기 내용"];
    }
    {
      template-id = "pnix.recipe.app.list";
      tags = ["recipe" "os" "list"];
      execution-owner = "puck/os";
      visibility = "safe-handoff";
      match-any = ["앱 목록" "설치된 앱" "앱 뭐 있어"];
    }
    {
      template-id = "pnix.recipe.notify";
      tags = ["recipe" "os" "notify"];
      execution-owner = "puck/os";
      visibility = "safe-handoff";
      match-any = ["알림 보내" "알림 표시"];
    }
    {
      template-id = "pnix.recipe.process.list";
      tags = ["recipe" "os" "process"];
      execution-owner = "puck/os";
      visibility = "safe-handoff";
      match-any = ["프로세스" "실행중인" "뭐 돌아가고"];
    }
    # coding-agent typed artifact handoff (multi-step verb chain)
    # ──────────────────────────────────────────────────────────
    # 7 verb (ask / plan / patch / verify / rollback / decide / retention)
    # entries 는 `coding-agent-classifier-entries.px` 의 generic constructor
    # (`mkCodingAgentVerbEntry` + `codingAgentVerbData`) 가 owns — 헌법 §20
    # ("`.px` 도 하드코딩 목록으로 쓰지 마라") 정합. 새 verb 추가 시 그쪽
    # data entry 1 줄 만 추가하면 된다.
    #
    # kernel parser side: `pnix-query-runtime/src/kernel.rs::load_query_classifiers`
    # 가 `parse_px_file_with_nix_fallback` 사용 — literal-only `parse_px` 가
    # `import + ++` expression 을 받지 못해도 nix-eval fallback 이 evaluate
    # 한 결과를 PxValue 로 lower 한다.
    #
    # 헌법 §16 정렬: artifact 의 정본 owner 는 client (puck-cli/freecat-cli).
    # doghouse 는 verb-specific family store retrieval + carry 만. server
    # subprocess / git probe 0.
  ] ++ (import ./coding-agent-classifier-entries.px).entries;

  # ── Predicate query classifier rules ────────────────────────────
  # Maps Korean property query patterns to ontology fact predicates.
  # Rust는 generic match-any/match-all rule만 평가한다.
  predicate-classifiers = [
    { match-any = ["단위"]; predicate = "unit-ko"; label-ko = "단위"; }
    { match-any = ["공식"]; predicate = "formula"; label-ko = "공식"; }
    { match-any = ["기호"]; predicate = "formal-symbol"; label-ko = "기호"; }
    { match-any = ["역연산"]; predicate = "inverse-of"; label-ko = "역연산"; }
    {
      match-any = ["개념" "뭐"];
      match-all = ["관련"];
      predicate = "related-concept";
      label-ko = "관련 개념";
    }
  ];

  # ── Domain listing classifier rules ─────────────────────────────
  domain-classifiers = [
    { keyword = "수학"; domain = "수학"; }
    { keyword = "물리"; domain = "물리"; }
    { keyword = "화학"; domain = "화학"; }
    { keyword = "생물"; domain = "생물"; }
    { keyword = "지구과학"; domain = "지구과학"; }
    { keyword = "집합"; domain = "수학"; }
    { keyword = "논리"; domain = "수학"; }
    { keyword = "통계"; domain = "수학"; }
  ];

  # List-intent markers: utterance must contain "개념" AND one of these.
  domain-list-intent-markers = ["뭐" "있어" "있나" "알려" "목록" "무엇"];

  # ── Concept query configuration ─────────────────────────────────
  # "What" markers for concept definition questions
  concept-what-markers = ["뭐" "무엇" "뭔"];

  # Definition suffix patterns (e.g., "미분이란?", "적분란?")
  concept-definition-suffixes = ["이란" "란"];

  # "Explain" markers (e.g., "미분 설명해줘", "적분 알려줘", "힘에 대해")
  concept-explain-markers = ["설명" "알려" "에 대해" "에 관해" "에 대하여" "에 관하여"];

  # batch 42 (2026-04-14): concept demo/example markers.
  # "X의 연산을 보여줘", "X의 예시를 들어봐", "X의 계산 예시" 같은 demo 질의를
  # classify_concept_query Pattern 5 에서 explain 경로와 같이 처리하기 위한 marker.
  # conversation.rs 의 is_demo_query substring/split escape hatch 를 대체한다.
  concept-demo-markers = ["연산" "예시" "계산 예시"];

  # batch 43 (2026-04-14): computation signal literals.
  # `intent.rs` 의 `has_computation_signals` 가 사용하는 한국어 연산 키워드 리스트.
  # Rust 는 이 리스트를 iterator 로 순회만 한다. `×` / `÷` char signal 과
  # `(=) && (얼마)` conjunction 은 구조가 달라서 Rust 에 남겨둔다.
  computation-signals = ["더하기" "빼기" "곱하기" "나누기" "제곱" "루트" "팩토리얼" "계산"];

  # batch 44 (2026-04-14): calculus signal literals.
  # `intent.rs` 의 `has_calculus_signals` 가 사용하는 한국어 미적분 키워드.
  # 동일한 iterator 순회 template.
  calculus-signals = ["미분" "적분"];

  # batch 183 (2026-04-16): calculus dispatch markers (diff / int 구분).
  # `expr::parse_korean_calculus` 가 사용한다. 각 리스트에 해당하는 단어가
  # utterance 에 하나라도 있으면 해당 operation 으로 분기된다.
  calculus-diff-markers = ["미분"];
  calculus-int-markers = ["적분"];
  # batch 215: Korean trig function names (긴 것부터 적용).
  # expr.rs parse_korean_math_expr 에서 utterance prefix match 에 사용.
  # 각 entry: { name = "한글이름"; func = "sin|cos|tan|asin|acos|atan"; default-degree = "true|false"; }
  trig-functions = [
    { name = "아크사인"; func = "asin"; default-degree = "false"; }
    { name = "아크코사인"; func = "acos"; default-degree = "false"; }
    { name = "아크탄젠트"; func = "atan"; default-degree = "false"; }
    { name = "사인"; func = "sin"; default-degree = "true"; }
    { name = "코사인"; func = "cos"; default-degree = "true"; }
    { name = "탄젠트"; func = "tan"; default-degree = "true"; }
  ];
  # batch 214: calculus utterance strip suffixes (긴 것부터 적용).
  # expr.rs parse_korean_calculus 가 utterance 에서 calculus 관련 한글을 제거할 때 사용.
  calculus-strip-suffixes = ["미분해줘" "적분해줘" "미분해" "적분해" "미분" "적분" "해줘" "구해줘"];

  # batch 44 (2026-04-14): physics intent signals (unit + concept conjunction).
  # `intent.rs` 의 `has_physics_signals` 가 사용. 두 리스트 모두 매칭되면 true
  # (`unit ∧ concept`). Rust 는 두 리스트를 각각 iterator 순회하고 AND 연산만.
  physics-unit-signals = ["kg" "m/s" "뉴턴" "N이"];
  physics-concept-signals = ["질량" "가속도" "운동량" "운동에너지" "힘"];

  # batch 45 (2026-04-14): intent depth/scope modifier adverbs.
  # `analyze_intent` 에서 SearchDepth/OutputScope 를 올리거나 내리는 modifier.
  # detailed → depth 상향, brief → depth/scope 하향.
  intent-detailed-modifiers = ["자세히" "상세히" "깊이" "완전히"];
  intent-brief-modifiers = ["간단히" "짧게" "한줄로"];

  # batch 45 (2026-04-14): definition signal literals for `has_definition_signals`.
  # interrogative + what-marker 분기는 기존 `concept-what-markers` 를 재사용하고,
  # 이 리스트는 선언적 definition 어미/키워드 ("이란", "란", "정의") 를 담는다.
  definition-signals = ["이란" "란" "정의"];

  # batch 45 (2026-04-14): equation solver verb signals ("풀어줘", "구해줘").
  # `has_equation_signals` 의 verb 축. `=` char 와 `x`/`y` 변수 char 는 Rust 에
  # char-level 로 남는다.
  equation-verb-signals = ["풀어줘" "구해줘"];

  # batch 46 (2026-04-14): mixed-query trailing suffix markers.
  # `computation::preprocess_mixed_query` 가 `=` 뒤쪽 수식 추출에서 제거하는
  # 한국어 질문 어미 marker. 예: "F = 5 얼마야?" → "얼마" 앞까지만 남긴다.
  # Rust 는 이 리스트를 순회하면서 `math_part.find(suffix)` 로 접두사 잘라낸다.
  mixed-query-trailing-suffixes = ["얼마" "몇" "뉴턴" "줄"];

  # batch 46 (2026-04-14): mixed-query math-intent markers (string only).
  # `preprocess_mixed_query` 가 "수식/계산 의도" 감지에 사용하는 한국어 marker.
  # char-level signal (`×`, `*`, `+`) 은 batch 251 에서 `.px` char list owner
  # 로 이관됨 (`mixed-math-op-char-markers`). 이 리스트는 string marker 만 담는다.
  mixed-query-math-markers = ["얼마" "몇" "뉴턴" "줄" "계산"];

  # batch 251 (2026-04-17): char-level arithmetic detectors. Rust 는 `.px`
  # char list 를 받아 `chars().any` 로 검사만 한다 (`text_contains_any_char`
  # helper). 각 리스트는 문자 한 글자짜리 문자열의 모음이다.
  #
  # equation-char-markers: `=` 가 있으면 방정식 후보.
  # intent-math-op-char-markers: `×` / `÷` 만 단독으로 본다 (곱하기/나누기 의도).
  # mixed-math-op-char-markers: `preprocess_mixed_query` 의 revised-expression
  #   감지용 char set (multiply / times / add).
  # variable-char-markers: ASCII 변수 문자 `x` / `y` — 방정식 좌변/우변 감지.
  equation-char-markers = ["="];
  intent-math-op-char-markers = ["×" "÷"];
  mixed-math-op-char-markers = ["×" "*" "+"];
  variable-char-markers = ["x" "y"];

  # batch 253 (2026-04-18): math-context char markers + Korean particle chars.
  #
  # math-context-char-markers: `normalize_korean_numerals` 가 "수학/물리 문맥"
  #   을 감지할 때 쓰는 char set (`N` 단위, `+` 연산자, `=` 방정식).
  # korean-sentence-particle-chars: `preprocess_mixed_query` 가 `=` 뒤쪽 수식
  #   부분을 뽑을 때 문장의 조사/마침부호를 split 경계로 쓴다. 도메인 지식
  #   (어떤 char 가 한국어 조사인지) 은 `.px` 가 소유하고, Rust 는 `split`
  #   closure 에서 char list 를 사용만 한다.
  math-context-char-markers = ["N" "+" "="];
  korean-sentence-particle-chars = ["은" "는" "이" "가" "?"];

  # batch 254 (2026-04-18): Rust 파서가 참조하는 한국어 morpheme 스칼라/리스트.
  # 도메인 지식 (어떤 한글이 possessive/copula/ordinal 인지) 은 `.px` 만 소유.
  #
  # korean-power-expression-particle: `X의 Y` 형태에서 "~의" 로 base/exponent 를
  #   분리할 때 쓰는 한글 소유격 조사 한 글자. `expr.rs::parse_power_form` 이 사용.
  # korean-equation-copula-endings: 방정식 한 쪽 문자열에서 문장 종결 표현
  #   (`이야`, `야`) 을 trim 할 때 쓰는 어미 리스트. `expr.rs::parse_equation_side`
  #   가 사용. Rust 는 길이가 긴 순서로 받아서 `trim_end_matches` 로 순차 제거.
  # korean-ordinal-prefix-char: `제2법칙` 같은 서수 접두어 한 글자.
  #   `retrieval.rs::korean_digit_boundary_spacing` 이 한글+숫자 경계에서
  #   공백 삽입을 건너뛸 예외로 사용.
  korean-power-expression-particle = "의";
  korean-equation-copula-endings = ["이야" "야"];
  korean-ordinal-prefix-char = "제";

  # batch 47 (2026-04-14): mixed-query explicit-unit marker → unit mapping.
  # `preprocess_mixed_query` 가 utterance 에서 명시 단위 marker 를 찾아서
  # 대응 unit 문자열을 선택하는 데 사용. attrset list 로 marker/unit 페어.
  mixed-query-explicit-units = [
    { marker = "뉴턴"; unit = "N"; }
    { marker = "줄"; unit = "J"; }
    { marker = "kg"; unit = "kg"; }
    { marker = "Pa"; unit = "Pa"; }
  ];

  # batch 47 (2026-04-14): unit-conversion intent markers.
  # `parse_unit_conversion` 이 변환 의도 (`를 ~로 바꿔/변환`) 감지에 사용.
  # 기존 `unit-conversion-markers` 는 다른 consumer 용이라 별도 list.
  conversion-intent-markers = ["를 " "을 " "로 변환" "로 바꿔" "로 바꾸" "몇 "];

  # batch 48 (2026-04-14): Korean quote ending markers for retrieval.rs
  # has_*_quote 함수들. 각 list 는 utterance 내 substring 검사 + FrameNet Quote
  # role token 의 suffix 검사에 함께 쓰인다.
  requestive-quote-endings = [
    "달라고" "해달라고" "하라고" "오라고" "가라고" "주라고" "보내라고" "말라고"
  ];
  requestive-quote-stem-endings = ["달" "하"];
  propositive-quote-endings = ["자고"];
  interrogative-quote-endings = ["냐고" "느냐고"];
  commitment-quote-endings = ["겠다고"];

  # batch 49 (2026-04-14): expr.rs 한국어 수식 파서 markers.
  # `parse_korean_math_expr` 의 factorial / sqrt / power / 벡터 연산자 감지
  # + `normalize_korean_numerals` 의 math context 감지에 사용.
  factorial-markers = ["팩토리얼"];
  sqrt-markers = ["루트" "제곱근"];
  power-markers = ["제곱" "승"];
  vec-dot-markers = ["내적"];
  vec-add-markers = ["더하" "더해"];
  vec-add-conjunction-pair = ["더" "줘"];
  vec-sub-markers = ["빼"];
  scalar-mul-markers = ["곱하기" "스칼라"];
  math-context-markers = ["더하기" "빼기" "곱하기" "나누기" "kg" "m/s" "미분" "적분" "제곱"];

  # batch 50 (2026-04-14): concept-question 추가 markers.
  # conversation.rs dispatch 의 `is_concept_question` gate 에서 what-markers +
  # explain-markers 와 함께 chain 되어 사용. `정의`, `보여줘`, `개념` 같은
  # 직접 concept 요청 marker 를 담는다.
  concept-question-markers = ["정의" "보여줘" "개념"];

  # batch 51 (2026-04-14): intent vector signal markers.
  # `intent::has_vector_signals` 가 사용. 괄호 쌍 ≥ 2 이거나 이 리스트 중
  # 하나 매칭이면 vector intent 로 간주.
  vector-intent-markers = ["벡터" "내적" "외적"];

  # batch 51 (2026-04-14): intent continuation elaborate depth markers.
  # `has_continuation_signals` 에서 "자세히" 단독 vs "더 알려/설명/자세" 구분.
  continuation-elaborate-markers = ["더 알려" "더 설명" "더 자세"];

  # batch 51 (2026-04-14): HasProperty life ontology markers.
  # retrieval.rs 의 frame role check 에서 "살아있음/생명" 속성 판단.
  has-property-life-markers = ["살아있" "생명"];

  # batch 51 (2026-04-14): negation markers for retrieval.rs clause 분석.
  # "~지 않다" / "~지않" 부정 구문 감지.
  negation-markers = ["지 않" "지않"];

  # batch 52 (2026-04-14): domain-listing trigger markers.
  # `classify_domain_listing` 이 utterance 가 개념 목록 질의인지 판단할 때
  # 사용 (`"X 개념 뭐 있어?"` 같은 패턴). list-intent-markers 와 AND 로 함께.
  domain-listing-trigger-markers = ["개념"];

  # batch 54 (2026-04-14): OS-level execution-owner 식별용 marker.
  # `conversation.rs` recipe handoff gate 가 classifier 의 execution-owner 필드
  # 가 OS-level 인지 판단할 때 사용 (예: "puck/freecat.os", "doghouse.os").
  os-execution-owner-markers = ["os"];

  # batch 55 (2026-04-14): Korean verb morphology suffixes for retrieval.rs.
  # declarative (`다`) 와 connective (`고`, `지`, `게`) 동사 활용 접미사.
  # `extract_verb_stem` 과 `find_main_verb` 에서 사용.
  declarative-verb-suffixes = ["다"];
  connective-verb-suffixes = ["고" "지" "게"];

  # batch 57 (2026-04-14): doghouse pipeline trace note prefixes.
  # conversation.rs `build_output_fragments` 가 pipeline-trace fragment 를
  # 조립할 때 note filter 에 사용. pnix-query-runtime 의 `kernel-base-facts.px`
  # `pipeline-trace-note-prefixes` (`ontology-`, `truth-regime:`, `held-`) 와
  # 별도 set — doghouse 쪽 dispatcher note (`cache-hit:`, `intent:`) 포함.
  doghouse-pipeline-trace-note-prefixes = ["ontology-" "cache-hit:" "intent:"];

  # batch 60 (2026-04-14): equation result question markers.
  # `intent::has_computation_signals` 의 `(=) ∧ ("얼마")` conjunction 에서
  # 결과 질문 marker 축을 소유. "얼마" 외에 확장하려면 이 리스트에 추가.
  # char `=` 와의 AND 는 Rust 에 남는다 (conjunction 은 list 로 표현 안 됨).
  equation-result-question-markers = ["얼마"];

  # batch 61 (2026-04-14): concept term stopwords.
  # `intent::is_noise_term` 이 term extraction 결과에서 의미 없는 토큰을
  # 필터링하는 데 사용. 대부분은 question word (뭐/무엇/뭔/얼마/어떻게/왜/어디)
  # 와 bound noun/의존명사 (것/거/때/수/점). `수` 는 개념일 수도 있지만 noise
  # 우세.
  concept-term-stopwords = ["뭐" "무엇" "뭔" "얼마" "어떻게" "왜" "어디" "것" "거" "때" "수" "점"];

  # Standalone kernel definition intent rules.
  # Rust는 rule 리스트를 순회만 한다. legacy marker 필드는 다른 consumer 호환용이다.
  definition-query-rules = [
    { match-any = ["뭐" "무엇" "뭔"]; }
    { match-any = ["이란" "란"]; }
    { match-any = ["설명" "알려" "에 대해" "에 관해" "에 대하여" "에 관하여"]; }
  ];

  # Tokens to skip when extracting concept term from explain patterns
  concept-explain-skip-tokens = ["설명" "알려" "해줘" "줘" "해"];

  # ── Term extraction suffixes ───────────────────────────────────
  # "X에 대해 설명해줘" → 접미 표현 앞의 단어를 concept term 후보로 추출.
  # Rust 쪽은 이 리스트를 순회만 한다. 새 표현은 .px에서 추가.
  term-extraction-suffixes = ["에 대해" "에 관해" "에 대하여" "에 관하여"];

  # 조사 기반 concept term 후보 추출에 허용되는 particle kind.
  # pnix-core KoreanParticleKind.as_str() 값과 동일한 소문자 문자열을 사용한다.
  term-extraction-particle-kinds = ["subject" "topic" "object" "genitive" "conjunctive"];

  # concept term normalization에서 좌우 trim할 문자.
  term-normalization-trim-chars = ["?" "!" "," "." "\"" "'"];

  # term 추출 fallback 정책.
  # known-concept-token-scan = 조사/접미 규칙이 실패하면 whitespace token 중 ontology 개념을 재탐색.
  # disabled = fallback 재탐색 없이 종료.
  term-fallback-policy = "known-concept-token-scan";

  # Question word stems excluded from concept term extraction
  question-word-stems = ["뭐" "무엇" "뭔" "얼마" "어떻게"];

  # ── Continuation classifier rules ──────────────────────────────
  # kind: elaborate | example | related
  # match-any: utterance contains ANY of these → triggers this kind.
  # match-all: utterance must contain ALL of these → triggers this kind.
  continuation-classifiers = [
    {
      kind = "example";
      match-any = ["예시"];
      match-all-pairs = [["예" "들어"]];
    }
    {
      kind = "related";
      match-any = ["관련 개념" "연관"];
    }
    {
      kind = "elaborate";
      match-any = ["더 알려" "더 설명" "자세히" "더 자세"];
    }
  ];

  # ── Cross-concept classifier rules ─────────────────────────────
  # Keywords that signal a cross-concept comparison query.
  cross-concept-markers = ["관계" "차이" "비교" "다른 점"];

  # ── Physics formula classifier rules ───────────────────────────
  # Each rule maps keyword+unit combinations to a formula route.
  # Evaluated in order; first match wins.
  physics-formula-classifiers = [
    {
      formula-id = "momentum";
      concept-term = "운동량";
      match-all = ["운동량" "kg" "m/s"];
    }
    {
      formula-id = "kinetic-energy";
      concept-term = "운동에너지";
      match-all = ["운동에너지" "kg" "m/s"];
    }
    {
      formula-id = "work";
      concept-term = "일";
      match-any-term = ["일" "W"];
      match-all-unit = ["N" "m"];
      match-none = ["m/s"];
    }
    {
      formula-id = "newton-force";
      concept-term = "힘";
      match-any-term = ["질량" "가속도" "힘"];
      match-any-unit = ["kg" "m/s"];
    }
  ];

  # ── CT diagram commute diagnostic templates ───────────────────
  # batch 174 (2026-04-16): computation.rs verify_diagram_commute 의 Korean
  # 하드코딩 제거. formula-id 별로 Korean 진단 문구 prefix / 정합/불일치 label
  # 을 .px 가 소유한다. dimension path 계산 자체는 Rust 에 남음.
  physics-ct-commute-templates = [
    {
      formula-id = "newton-force";
      template = "CT commute ${mark}: F=ma 경로 ${path-a} = 힘 차원 ${path-b}${suffix}";
      valid-suffix = " — 정합";
      invalid-suffix = " — 불일치!";
    }
    {
      formula-id = "momentum";
      template = "CT commute ${mark}: p=mv ${path-a} = F×t ${path-b}${suffix}";
      valid-suffix = " — 정합";
      invalid-suffix = " — 불일치!";
    }
    {
      formula-id = "kinetic-energy-or-work";
      template = "CT commute ${mark}: ½mv² ${path-a} = F×d ${path-b}${suffix}";
      valid-suffix = " — 일-에너지 정리 정합";
      invalid-suffix = " — 불일치!";
    }
  ];

  # ── Physics formula presentation templates ─────────────────────
  # batch 172 (2026-04-16): computation.rs 의 Rust 하드코딩 Korean summary /
  # formula-name / dimension-check 를 .px owner 로 이관. canonical/mathml/
  # openmath 템플릿도 여기서 소유. Rust 는 ${...} placeholder 치환만.
  physics-formula-templates = [
    {
      formula-id = "momentum";
      formula-name = "운동량 p=mv";
      dimension-check = "질량[M] × 속도[L·T⁻¹] = 운동량[M·L·T⁻¹] ✓";
      canonical-template = "p = ${m} × ${v} = ${result} kg·m/s";
      summary-template =
        "doghouse가 운동량을 계산했다. p = mv = ${m} × ${v} = ${result} kg·m/s.";
    }
    {
      formula-id = "kinetic-energy";
      formula-name = "운동에너지 K=½mv²";
      dimension-check = "질량[M] × 속도²[L²·T⁻²] = 에너지[M·L²·T⁻²] ✓";
      canonical-template = "K = ½ × ${m} × ${v}² = ${result} J";
      summary-template =
        "doghouse가 운동에너지를 계산했다. K = ½mv² = ½ × ${m} × ${v}² = ${result} J.";
    }
    {
      formula-id = "work";
      formula-name = "일 W=Fd";
      dimension-check = "힘[M·L·T⁻²] × 거리[L] = 에너지[M·L²·T⁻²] ✓";
      canonical-template = "W = ${f} × ${d} = ${result} J";
      summary-template = "doghouse가 일을 계산했다. W = Fd = ${f} × ${d} = ${result} J.";
    }
    {
      formula-id = "newton-force";
      formula-name = "뉴턴 힘 F=ma";
      dimension-check = "질량[M] × 가속도[L·T⁻²] = 힘[M·L·T⁻²] ✓";
      canonical-template = "F = ${m} × ${a} = ${result} N";
      summary-template = "doghouse가 힘을 계산했다. F = ma = ${m} × ${a} = ${result} N.";
    }
  ];

  # ── Equation route markers ─────────────────────────────────────
  equation-markers = ["풀어줘"];

  # ── Unit conversion markers ───────────────────────────────────
  # "3km를 m로" 패턴 인식
  unit-conversion-markers = ["로 변환" "로 바꿔" "로 바꾸" "몇 m" "몇 cm" "몇 km" "몇 g" "몇 kg" "몇 초" "몇 분"];
  unit-conversion-particles = ["를" "을" "는" "은"];
  unit-conversion-targets = ["로" "으로"];

  # ── Percentage markers ────────────────────────────────────────
  percentage-markers = ["%"];

  # ── Recipe OS markers (M1) ──────────────────────────────────
  # OS 작업 의도 감지 → recipe-os.px handoff
  recipe-launch-markers = ["열어줘" "실행해줘" "켜줘" "시작해줘" "실행해" "열어" "켜"];
  recipe-search-markers = ["찾아줘" "찾아" "어디에 있어" "파일 검색"];
  recipe-clipboard-markers = ["클립보드" "복사한 거" "붙여넣기"];
  recipe-notify-markers = ["알림 보내" "알려줘"];
  recipe-process-markers = ["프로세스" "실행중" "실행 중인 거" "뭐 돌아가고"];
  recipe-app-list-markers = ["앱 목록" "설치된 앱" "앱 뭐 있어" "앱 리스트"];

  # ── Causal / conditional query markers ────────────────────────
  # "왜 ~인가?", "이유가 뭐야?" → 인과 추론
  causal-markers = ["왜" "이유" "원인" "때문"];
  # "~하면 어떻게 돼?" → 조건부 추론
  conditional-markers = ["하면" "이면" "라면" "만약" "경우" "다면"];
  # "어떻게 ~하는가?" → 과정/절차
  process-markers = ["어떻게" "단계" "절차" "방법" "과정"];
}
