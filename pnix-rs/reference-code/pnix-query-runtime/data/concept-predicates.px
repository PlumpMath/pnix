# concept-predicates.px — concept 정의에 쓰이는 predicate canonical list
#
# retrieval.rs `collect_concept_facts` 가 concept 를 store 에서 꺼낼 때 이 predicate
# list 로 filter 한다. Rust const CONCEPT_PREDICATES 을 .px owner 로 이관한 것.
#
# batch 136 (2026-04-16): 이전에는 retrieval.rs 에 Rust const 로 hardcoded 돼 있었다.
# 의미상 "concept 의 shape" 를 정의하는 ontology 정책이므로 .px owner 가 맞다.
#
# 새 predicate 를 concept filter 에 추가하려면 Rust 소스를 건드리지 말고
# 이 파일 predicates 리스트에 추가하면 된다.
{
  predicates = [
    # 기본 concept 정의 필드
    "definition-ko"
    "formal-name-en"
    "formal-symbol"
    "domain"
    "related-concept"
    "unit-ko"
    "formula"
    "inverse-of"
    "category"
    "semantic-frame"
    "frame-definition"
    "frame-role"
    "role-constraint"

    # ConceptNet 관계
    "conceptnet-relatedto"
    "conceptnet-synonym"
    "conceptnet-isa"
    "conceptnet-antonym"
    "conceptnet-partof"
    "conceptnet-hasproperty"
    "conceptnet-usedfor"
    "conceptnet-capableof"

    # introspection predicates (convergence Phase 0-3)
    "is-a"
    "defined-in"
    "has-type"
    "arity"
    "description"
    "input-name"
    "input-type"
    "output-type"
    "signature"
    "alias-of"
    "defined-in-stdlib"
    "example"
  ];
}
