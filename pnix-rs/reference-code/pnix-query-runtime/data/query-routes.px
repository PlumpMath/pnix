    policy-coverage = "0.0";
    policy-coherence = "0.0";
    policy-loss = "0.0";
    policy-cost = "0.0";
    policy-accept-threshold = "0.0";
    # OS 작업 요청 → recipe-os.px에서 handoff 생성
    # 트리거: "열어줘" "실행해줘" "찾아줘" "클립보드" "알림" "프로세스"
    recipe-source = "recipe-os.px";
  }
  {
    route = "coding-agent-handoff";
    query-context = "Doghouse.QueryModel.CodingAgent";
    include-hop-knowledge = "false";
    default-preview = "1";
    policy-coverage = "0.0";
    policy-coherence = "0.0";
    policy-loss = "0.0";
    policy-cost = "0.0";
    policy-accept-threshold = "0.0";
    # coding-agent typed artifact handoff:
    # 사용자 utterance 가 *.px 분류기로 coding-agent intent 로 분류되면 doghouse 는
    # 자기 redb store 의 `coding_artifacts` family table 에서 가장 최근 typed
    # `coding.request` (또는 family 안의 다른 latest) artifact 를 retrieve 해서
    # envelope output_fragments 로 carry 한다.
    #
    # 헌법 §16 정렬: doghouse 는 typed artifact 를 *생성/실행* 하지 않는다.
    # artifact 의 정본 owner 는 *client (puck-cli / freecat-cli)* 의
    # `pnix-executor-graph::cli::build_coding_agent_request_with_probe` 다.
    # client 가 자기 cwd / git probe 로 emit 한 artifact 를 doghouse store 의
    # `append_coding_memory_artifact` 로 push 한 뒤, 사용자 dialogue lane 이
    # 그것을 retrieve 해 typed surface 로 보여준다. server 측 git subprocess /
    # file system scan 0.
    artifact-family = "coding.request";
    artifact-owner = "puck-cli|freecat-cli";
    store-table = "coding_artifacts_by_family";
  }
]
