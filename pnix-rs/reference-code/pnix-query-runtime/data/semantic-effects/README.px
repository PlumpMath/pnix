# Semantic Effect Ontology
#
# 각 .px 파일은 하나의 도메인(context)에 대한 semantic-effect를 정의한다.
# effect = 동사/행위의 의미 구조 (FrameNet frame에 대응)
# role = 참여자 역할 (FrameNet frame element에 대응)
# constraint = 역할에 대한 의미적 제약 (entity property 검증용)
#
# 구조:
#   effects: [ { id, term-ko, roles: [ { name, constraint, optional } ], preconditions, postconditions } ]
#   entity-classes: [ { id, term-ko, properties: [...] } ]
#
# hot-reload: .px 파일 수정 → 서버 재시작 없이 즉시 반영
# 용도: 문장의 의미적 정합성 검증 ("말이 되는지")
{
  schema-version = "semantic-effect-v1";
}
