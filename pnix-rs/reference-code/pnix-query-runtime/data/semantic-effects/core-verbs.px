# 핵심 한국어 동사 semantic-effect seed (수동 큐레이션)
# kfn-full.px에서 추출한 핵심 일상 동사 + frame 매핑
[
  {
    frame = "Giving";
    definition-en = "A Donor transfers a Theme to a Recipient.";
    terms-ko = ["주다" "건네다" "기부하다" "제공하다" "넘겨주다" "선물"];
    roles = [{ name = "Donor"; constraint = "Sentient"; } { name = "Recipient"; constraint = "Sentient"; } { name = "Theme"; constraint = ""; }];
  }
  {
    frame = "Lending";
    definition-en = "A Lender temporarily gives a Theme to a Borrower.";
    terms-ko = ["빌려주다" "대여하다" "임대하다"];
    roles = [{ name = "Lender"; constraint = "Sentient"; } { name = "Borrower"; constraint = "Sentient"; } { name = "Theme"; constraint = ""; }];
  }
  {
    frame = "Ingestion";
    definition-en = "An Ingestor consumes food or drink (Ingestibles).";
    terms-ko = ["먹다" "마시다" "삼키다" "섭취하다" "음식" "식사"];
    roles = [{ name = "Ingestor"; constraint = "Sentient"; } { name = "Ingestibles"; constraint = ""; }];
  }
  {
    frame = "Creating";
    definition-en = "A Creator brings about a Created_entity.";
    terms-ko = ["만들다" "생산하다" "제조하다" "창작하다" "설립하다" "건설하다" "짓다"];
    roles = [{ name = "Creator"; constraint = "Sentient"; } { name = "Created_entity"; constraint = ""; }];
  }
  {
    frame = "Cause_to_fragment";
    definition-en = "An Agent causes a Whole_patient to break into Pieces.";
    terms-ko = ["부수다" "깨뜨리다" "부러뜨리다" "파괴하다" "박살내다"];
    roles = [{ name = "Agent"; constraint = "Sentient"; } { name = "Whole_patient"; constraint = ""; }];
  }
  {
    frame = "Motion";
    definition-en = "A Theme starts in one place (Source) and ends up in another (Goal).";
    terms-ko = ["가다" "오다" "달리다" "걷다" "뛰다" "이동하다" "움직이다" "날다"];
    roles = [{ name = "Theme"; constraint = ""; } { name = "Source"; constraint = ""; } { name = "Goal"; constraint = ""; } { name = "Path"; constraint = ""; }];
  }
  {
    frame = "Communication";
    definition-en = "A Communicator conveys a Message to an Addressee.";
    terms-ko = ["말하다" "이야기하다" "전하다" "알리다" "설명하다" "대화하다"];
    roles = [{ name = "Communicator"; constraint = "Sentient"; } { name = "Message"; constraint = ""; } { name = "Addressee"; constraint = "Sentient"; }];
  }
  {
    frame = "Perception_active";
    definition-en = "A Perceiver_agentive intentionally directs perception at a Phenomenon.";
    terms-ko = ["보다" "듣다" "살펴보다" "관찰하다" "바라보다" "지켜보다"];
    roles = [{ name = "Perceiver_agentive"; constraint = "Sentient"; } { name = "Phenomenon"; constraint = ""; }];
  }
  {
    frame = "Destroying";
    definition-en = "A Destroyer destroys the Undergoer or Patient.";
    terms-ko = ["파괴하다" "없애다" "무너뜨리다" "폭파하다" "태우다" "부수다"];
    roles = [{ name = "Destroyer"; constraint = "Sentient"; } { name = "Patient"; constraint = ""; }];
  }
  {
    frame = "Commerce_buy";
    definition-en = "A Buyer purchases Goods from a Seller for Money.";
    terms-ko = ["사다" "구매하다" "구입하다" "장만하다" "쇼핑하다"];
    roles = [{ name = "Buyer"; constraint = "Sentient"; } { name = "Goods"; constraint = ""; } { name = "Seller"; constraint = "Sentient"; } { name = "Money"; constraint = ""; } { name = "Place"; constraint = "Location"; }];
  }
  {
    frame = "Commerce_sell";
    definition-en = "A Seller sells Goods to a Buyer, possibly for Money and at a Place.";
    terms-ko = ["팔다" "판매하다" "매각하다" "팔아넘기다"];
    roles = [{ name = "Seller"; constraint = "Sentient"; } { name = "Buyer"; constraint = "Sentient"; } { name = "Goods"; constraint = ""; } { name = "Money"; constraint = ""; } { name = "Place"; constraint = "Location"; }];
  }
  {
    frame = "Sending";
    definition-en = "A Sender causes a Theme to travel to a Recipient or Goal.";
    terms-ko = ["보내다" "부치다" "파견하다"];
    roles = [{ name = "Sender"; constraint = "Sentient"; } { name = "Recipient"; constraint = "Sentient"; } { name = "Goal"; constraint = "Location"; } { name = "Source"; constraint = "Location"; } { name = "Theme"; constraint = ""; }];
  }
  {
    frame = "Bringing";
    definition-en = "An Agent brings a Theme from a Source to a Goal.";
    terms-ko = ["가져오다" "받아오다" "데려오다" "가져가다" "데려가다"];
    roles = [{ name = "Agent"; constraint = "Sentient"; } { name = "Theme"; constraint = ""; } { name = "Source"; constraint = "Location"; } { name = "Goal"; constraint = "Location"; }];
  }
  {
    frame = "Placing";
    definition-en = "An Agent places a Theme at a Goal location.";
    terms-ko = ["놓다" "두다" "올려놓다" "배치하다" "설치하다" "심다"];
    roles = [{ name = "Agent"; constraint = "Sentient"; } { name = "Theme"; constraint = ""; } { name = "Goal"; constraint = ""; }];
  }
  {
    frame = "Removing";
