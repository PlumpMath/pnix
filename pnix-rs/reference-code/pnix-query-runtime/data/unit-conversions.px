# 단위 변환 규칙 (hot-reloadable, generic)
# 한 방향만 선언 → Rust generator가 역방향(1/factor) 자동 생성
# auto-reverse = "true" 이면 역방향 자동 추가
{
  # 한국어 단위명 → 기호 (긴 이름 먼저)
  unit-aliases = [
    { alias = "킬로미터"; symbol = "km"; }
    { alias = "센티미터"; symbol = "cm"; }
    { alias = "밀리미터"; symbol = "mm"; }
    { alias = "미터"; symbol = "m"; }
    { alias = "킬로그램"; symbol = "kg"; }
    { alias = "밀리그램"; symbol = "mg"; }
    { alias = "그램"; symbol = "g"; }
    { alias = "밀리리터"; symbol = "mL"; }
    { alias = "리터"; symbol = "L"; }
    { alias = "뉴턴"; symbol = "N"; }
    { alias = "줄"; symbol = "J"; }
    { alias = "와트"; symbol = "W"; }
    { alias = "파스칼"; symbol = "Pa"; }
    { alias = "라디안"; symbol = "라디안"; }
    { alias = "초"; symbol = "초"; }
    { alias = "도"; symbol = "도"; }
  ];

  # 단위 변환 (한 방향 + auto-reverse)
  # { from; to; factor; domain; } → 자동으로 { to; from; 1/factor; } 추가
  conversions = [
    # 길이
    { from = "km"; to = "m"; factor = "1000"; domain = "길이"; }
    { from = "m"; to = "cm"; factor = "100"; domain = "길이"; }
    { from = "m"; to = "mm"; factor = "1000"; domain = "길이"; }
    { from = "cm"; to = "mm"; factor = "10"; domain = "길이"; }
    { from = "km"; to = "cm"; factor = "100000"; domain = "길이"; }
    { from = "인치"; to = "cm"; factor = "2.54"; domain = "길이"; }
    { from = "피트"; to = "m"; factor = "0.3048"; domain = "길이"; }
    { from = "마일"; to = "km"; factor = "1.60934"; domain = "길이"; }
    # 질량
    { from = "kg"; to = "g"; factor = "1000"; domain = "질량"; }
    { from = "g"; to = "mg"; factor = "1000"; domain = "질량"; }
    { from = "톤"; to = "kg"; factor = "1000"; domain = "질량"; }
    { from = "파운드"; to = "kg"; factor = "0.453592"; domain = "질량"; }
    # 시간
    { from = "시간"; to = "분"; factor = "60"; domain = "시간"; }
    { from = "분"; to = "초"; factor = "60"; domain = "시간"; }
    { from = "시간"; to = "초"; factor = "3600"; domain = "시간"; }
    { from = "일"; to = "시간"; factor = "24"; domain = "시간"; }
    # 각도
    { from = "도"; to = "라디안"; factor = "0.0174533"; domain = "각도"; }
    # 넓이
    { from = "km²"; to = "m²"; factor = "1000000"; domain = "넓이"; }
    { from = "m²"; to = "cm²"; factor = "10000"; domain = "넓이"; }
    # 부피
    { from = "L"; to = "mL"; factor = "1000"; domain = "부피"; }
    # 속도
    { from = "km/h"; to = "m/s"; factor = "0.277778"; domain = "속도"; }
  ];

  # 역방향 자동 생성 활성화
  auto-reverse = "true";
}
