# coding-agent classifier entries — generic constructor (헌법 §20 정합)
# ====================================================================
#
# 7 verb (ask / plan / patch / verify / rollback / decide / retention) 마다
# handoff-classifier entry 가 *list of strings* 으로 query-classifiers.px 에
# 박혀 있던 것을 generic constructor (`mkCodingAgentVerbEntry`) 로 lift.
# 헌법 §20: ".px 도 하드코딩 목록으로 쓰지 마라" — generic 함수 + small data 만
# 으로 attrset 자체가 build 되어야 한다.
#
# query-classifiers.px 가 이 file 의 `entries` 를 import 해서 handoff-classifiers
# list 에 concat. kernel parser (pnix-query-runtime/src/kernel.rs) 는 evaluate
# 결과의 attrset list 만 받으므로 generic constructor 는 evaluate 시점에
# inline 된다 — runtime overhead 0.

let
  # generic constructor — 7 verb 모두 같은 schema (template-id / tags /
  # execution-owner / visibility / handoff-route / coding-agent-family /
  # match-any) 에서 verb / family / keywords 만 다르다. 새 verb 추가 시 data
  # entry 1줄 만 추가.
  mkCodingAgentVerbEntry = { verb, family, keywords }: {
    template-id = "pnix.coding-agent." + verb + ".handoff";
    tags = [ "coding-agent" "typed-artifact" verb ];
    execution-owner = "puck-cli|freecat-cli";
    visibility = "safe-handoff";
    handoff-route = "coding-agent-handoff";
    coding-agent-family = family;
    match-any = keywords;
  };

  # 7 verb 의 *base list* — `pnix coding-agent {ask|plan|patch|verify|rollback|
  # decide|retention}` CLI 의 verb cardinality 를 *.px-first* 로 carry.
  # AgentVerb enum (`crates/pnix-executor-graph/src/cli/args.rs::AgentVerb`)
  # 의 *.px* mirror — Rust enum 이 owner 이지만 *.px* 가 verb space 를 fold
  # 할 수 있도록 list 형태로 carry. enum 변경 시 이 list 도 같이 update
  # (drift 방지: 두 source 의 verb cardinality 가 같다).
  codingAgentVerbs = [ "ask" "plan" "patch" "verify" "rollback" "decide" "retention" ];

  # verb → coding.{family-suffix} mapping. family suffix 는 pnix CLI 가
  # emit 하는 typed artifact family 의 suffix (`pnix-executor-graph::cli` 의
  # `CodingAgentRequestArtifact::artifact_family` 등 참조). brain-ankh-cax
  # policy primitives (`stdlib/lib/gate/brain-ankh-cax-policy-primitives.px`)
  # 의 codingSpecs 와 family namespace 일치.
  verbToFamilySuffix = {
    "ask" = "request";
    "plan" = "plan";
    "patch" = "patch-proposal";
    "verify" = "verify-receipt";
    "rollback" = "rollback-receipt";
    "decide" = "human-promotion-decision";
    "retention" = "retention-receipt";
  };

  # verb → Korean trigger keyword list. utterance 매칭은 evidence-only
  # (분류 결정은 evaluate-select-route-adapter.px 의 macro-native ranking 이
  # owns). 새 keyword 추가/제거는 이 attrset 에서만.
  verbToKeywords = {
    "ask" = [
      "코드 봐줘"
      "코드 봐주세요"
      "코드 검토"
      "구현해줘"
      "구현해주세요"
      "리팩터"
      "리팩토링"
      "코딩 도와"
      "ask"
    ];
    "plan" = [
      "plan 만들어"
      "plan 보여줘"
      "plan 알려줘"
      "계획 만들어"
      "계획 보여줘"
      "execute plan"
    ];
    "patch" = [
      "patch 만들어"
      "패치 만들어"
      "patch 보여줘"
      "diff 봐줘"
      "diff 만들어"
      "patch 제안"
    ];
    "verify" = [
      "verify 해줘"
      "검증해줘"
      "verification 해줘"
      "패치 검증"
    ];
    "rollback" = [
      "rollback 해줘"
      "되돌려줘"
      "롤백 해줘"
      "취소해줘"
    ];
    "decide" = [
      "decide 해줘"
      "결정 해줘"
      "promotion 해줘"
      "승인 해줘"
    ];
    "retention" = [
      "retention 해줘"
      "정리해줘"
      "보존 해줘"
      "retention receipt"
    ];
  };

  # verb 단독 → verb data attrset 로 fold. 7 entries 가 list literal 이
  # 아니라 *base verb list × 두 lookup attrset × map fold* 로 *생성*.
  # 헌법 §20 generic form (data + map fold, not hardcoded list).
  mkVerbData = verb: {
    inherit verb;
    family = "coding." + builtins.getAttr verb verbToFamilySuffix;
    keywords = builtins.getAttr verb verbToKeywords;
  };

  codingAgentVerbData = builtins.map mkVerbData codingAgentVerbs;
in {
  inherit
    mkCodingAgentVerbEntry
    codingAgentVerbs
    verbToFamilySuffix
    verbToKeywords
    mkVerbData
    codingAgentVerbData;
  entries = builtins.map mkCodingAgentVerbEntry codingAgentVerbData;
  meta = {
    source = "doghouse-core data";
    owner = "doghouse.coding-agent.classifier-entries";
    constructor = "mkCodingAgentVerbEntry";
    verb-count = 7;
    family-prefix = "coding.";
    consumer-shape = "builtins.map mkCodingAgentVerbEntry codingAgentVerbData";
    consumer = "query-classifiers.px handoff-classifiers list (concat via import)";
    constitution-anchor = "pnix CLAUDE.md §20 (generic constructor + data, no hardcoded list)";
    rev_note = "7 verb classifier entries 가 generic constructor + data 로 lift. 새 verb 추가 시 codingAgentVerbData 에 entry 1 줄 추가, mkCodingAgentVerbEntry 자체는 변경 X.";
  };
}
