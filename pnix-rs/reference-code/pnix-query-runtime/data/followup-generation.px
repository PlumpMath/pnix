# followup-generation.px — held 판단에서 follow-up 질문 생성 (hot-reloadable)
#
# held judgement가 발생했을 때, 경쟁하는 해석들의 구분 조건을 분석하여
# 사용자에게 물어야 할 질문을 자동 생성.
#
# 핵심: "왜 이 질문을 하는지"의 근거가 ontology에 있다.
# LLM이 추측하는 것이 아니라, 해석 경쟁의 구분 조건을 명시적으로 추출.
{
  # held → follow-up 질문 생성 규칙
  # 해석 경쟁에서 구분 조건이 되는 predicate → 질문 패턴
  # 템플릿은 "held judgement" 라는 canonical 영어 phrase 를 노출한다.
  # 같은 phrase 가 korean-morphology.px follow-up hint 에도 쓰이며,
  # 테스트 / ratchet 이 이 문구를 기대한다.
  disambiguation-questions = [
    {
      # 실험/맥락이 다르면 해석이 갈리는 경우
      distinguishing-predicate = "experimental-context";
      question-template = "'${term}'에 대해 held judgement 중이라 어떤 맥락에서 물어보는 건지 더 좁혀 줘";
      choices-template = "예를 들어 ${suggestions}";
      example = "'빛은 뭐야?' → 이중슬릿? 광전효과? 일반적?";
    }
    {
      # 도메인이 다르면 해석이 갈리는 경우
      distinguishing-predicate = "domain";
      question-template = "'${term}'에 대해 held judgement 중이라 어떤 분야에서 쓰이는 건지 좁혀 줘";
      choices-template = "예를 들어 ${suggestions}";
      example = "'함수는 뭐야?' → 수학? 프로그래밍? 언어학?";
    }
    {
      # 시대/학파가 다르면 해석이 갈리는 경우
      distinguishing-predicate = "historical-context";
      question-template = "'${term}'에 대해 held judgement 중이라 어떤 시대/관점이 궁금한지 좁혀 줘";
      choices-template = "예를 들어 ${suggestions}";
    }
    {
      # 단순히 정의가 없는 경우 (경쟁 해석 없음)
      distinguishing-predicate = "unknown-term";
      question-template = "'${term}'에 대해 held judgement 중이라 더 구체적으로 설명해줄 수 있어?";
      choices-template = "";
    }
  ];

  # held reason → disambiguation question route.
  # Rust는 reason key lookup + predicate 선택 + ${...} 치환만 수행한다.
  reason-question-rules = [
    {
      reason = "unknown-term";
      predicate = "unknown-term";
    }
    {
      reason = "requires-context";
      predicate = "experimental-context";
    }
  ];

  # held reopen policy.
  # 모든 held reason은 여기서 명시적으로 닫혀야 한다.
  # Rust는 reason key 매칭 + ${...} 치환만 수행한다.
  reopen-rules = [
    {
      reason = "requires-context";
      carry-term-policy = "when-missing";
      effective-utterance-template = "${term} ${utterance}";
    }
    {
      reason = "unknown-term";
      carry-term-policy = "never";
      effective-utterance-template = "${utterance}";
    }
  ];

  # follow-up 선택지를 webview 버튼으로 렌더
  choice-render = {
    max-choices = "5";
    button-style = "concept-chip";
  };

  # 개념별 구체적 선택지 (hot-reloadable)
  # concept의 context 기반으로 선택지 생성
  concept-choices = [
    {
      term = "빛";
      choices = ["이중슬릿 실험에서 빛은?" "광전효과에서 빛은?" "일반적인 빛의 성질은?"];
    }
    {
      term = "에너지";
      choices = ["운동에너지?" "위치에너지?" "열에너지?" "핵에너지?"];
    }
    {
      term = "힘";
      choices = ["뉴턴 역학에서?" "상대론에서?" "양자역학에서?"];
    }
    {
      term = "함수";
      choices = ["수학에서 함수?" "프로그래밍에서 함수?"];
    }
  ];

  # held follow-up 선택지 선택 정책.
  # Rust는 when + choice-source만 해석한다.
  choice-rules = [
    {
      when = "term-present-with-concept-choice";
      choice-source = "concept";
    }
    {
      when = "term-present-without-concept-choice";
      choice-source = "default";
    }
    {
      when = "term-missing";
      choice-source = "default";
    }
  ];

  # 선택지가 없는 개념에 대한 기본 선택지
  default-choices = ["더 구체적으로 알려줘" "예시를 들어줘" "관련 개념은?"];

  # held hint/response에서 ${term}에 무엇을 넣을지 결정.
  # Rust는 when + term-source만 해석한다.
  resolved-term-rules = [
    {
      when = "term-present";
      term-source = "term";
    }
    {
      when = "term-missing";
      term-source = "literal";
      value = "질문";
    }
  ];

  # held 응답 본문과 held-term note/fact emission 정책.
  # Rust는 when + template + emit-held-term만 해석한다.
  held-response-rules = [
    {
      when = "term-present";
      template = "지금은 '${term}'을(를) 바로 판정할 근거가 부족해서 held한다.";
      emit-held-term = "true";
    }
    {
      when = "term-missing";
      template = "지금은 질문의 핵심 개념을 아직 판정하지 못해서 held한다.";
      emit-held-term = "false";
    }
  ];

  # term이 추출되지 않았을 때 follow-up hint에서 사용하는 라벨
  unknown-term-label = "질문";

}
