#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"

"$root/bin/build-clr"
"$root/bin/pnix-clr-identity-gate"
"$root/clr-meta/scripts/clr-meta-gate" --no-build
# Named ClojureCLR profiles (tool-eval / multi / bootstrap-project); ~17s.
"$root/bin/clojure-clr-profiles-smoke"
"$root/bin/build-pnix-clr-artifact" >/dev/null
"$root/bin/pnix-clr-artifact-gate" --no-build
# docs/CAPABILITIES.md drift gate: committed doc must match a fresh render
# off the just-built artifact (builtins-entries introspection + CLI surface).
"$root/bin/pnix-clr" capabilities-check

# Local nupkg layout when an export already exists (no rebuild; skip if missing).
lib_dir="${PNIX_CLR_LIBRARY:-$root/pnix-clr/target/pnix-clr-library}"
if [[ -f "$lib_dir/manifest.json" ]]; then
  "$root/bin/pnix-clr-nupkg-smoke" --no-export
else
  echo "pnix-clr-gate: skip nupkg-smoke (no $lib_dir/manifest.json)"
fi

# Experimental in-process parity: run when substrate + artifact are present.
# Skip with PNIX_CLR_INPROCESS_GATE=0 (or if paths missing).
substrate="${PNIX_CLR_SUBSTRATE:-$root/clojure-clr-clojure-1.12.3-alpha8/Clojure/Clojure.Main/bin/Release/net10.0/publish}"
artifact="${PNIX_CLR_ARTIFACT:-${PNIX_CLR_RUNTIME_ARTIFACT:-$root/pnix-clr/target/runtime-artifact}}"
if [[ "${PNIX_CLR_INPROCESS_GATE:-auto}" == "0" ]]; then
  echo "pnix-clr-gate: skip inprocess-eval-gate (PNIX_CLR_INPROCESS_GATE=0)"
elif [[ -f "$substrate/Clojure.dll" && -f "$artifact/manifest.json" ]]; then
  export PNIX_CLR_SUBSTRATE="$substrate"
  export PNIX_CLR_ARTIFACT="$artifact"
  export PNIX_CLR_RUNTIME_ARTIFACT="$artifact"
  export PNIX_CLR="${PNIX_CLR:-$root/bin/pnix-clr}"
  export PNIX_CLR_ROOT="${PNIX_CLR_ROOT:-$root}"
  "$root/bin/pnix-clr-inprocess-eval-gate"
else
  echo "pnix-clr-gate: skip inprocess-eval-gate (need substrate+artifact; or set paths)"
fi

export CLOJURE_LOAD_PATH="$root/pnix-clr/src:$root/pnix-clr/test"
"$root/bin/clojure-clr-bootstrap" -m pnix-clr.test-runner "$root"
"$root/bin/pnix-clr-production-outcome-gate"

echo "pnix-clr gate: PASS"
