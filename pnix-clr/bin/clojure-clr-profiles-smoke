#!/usr/bin/env bash
# Gate named ClojureCLR entry profiles (honest split).
#
# Profiles under test:
#   tool-eval          — bin/clojure-clr  (-e / one file; multi-arg fails closed)
#   bootstrap-project  — examples/clojure-clr-project multi-ns → 42
#
# Does not claim full ClojureCLR replacement or Stage15/N.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
pass=0
fail=0

ok() { echo "  OK  $*"; pass=$((pass + 1)); }
bad() { echo "  FAIL $*"; fail=$((fail + 1)); }

echo "== clojure-clr-profiles-smoke =="

# --- tool-eval: positive ---
if out="$("$root/bin/clojure-clr" -e '(+ 20 22)' 2>/dev/null)"; then
  if echo "$out" | grep -q ':value 42'; then
    ok "tool-eval -e => value 42"
  else
    bad "tool-eval -e unexpected: $out"
  fi
else
  bad "tool-eval -e failed (substrate/build-clr needed?)"
fi

# --- tool-eval: fail-closed multi-arg ---
if "$root/bin/clojure-clr" -i x -e 1 >/dev/null 2>&1; then
  bad "tool-eval should reject -i/-e multi-arg"
else
  ok "tool-eval rejects multi-arg (exit non-zero)"
fi

# --- tool-eval: --help ---
if "$root/bin/clojure-clr" --help 2>/dev/null | grep -q 'tool-eval'; then
  ok "tool-eval --help lists profile"
else
  bad "tool-eval --help missing profile text"
fi

# --- tool-eval-multi: multi-form file ---
multi_tmp="$(mktemp "${TMPDIR:-/tmp}/clojure-clr-multi.XXXXXX.clj")"
printf '%s\n' '(+ 1 2)' '(+ 20 22)' >"$multi_tmp"
if multi_out="$("$root/bin/clojure-clr" --multi-form "$multi_tmp" 2>/dev/null)"; then
  if echo "$multi_out" | grep -q ':profile :tool-eval-multi' \
    && echo "$multi_out" | grep -q ':value 42'; then
    ok "tool-eval-multi --multi-form => value 42"
  else
    bad "tool-eval-multi unexpected: $multi_out"
  fi
else
  bad "tool-eval-multi --multi-form failed"
fi
rm -f "$multi_tmp"

# --- tool-eval-multi: --multi-e ---
if multi_e_out="$("$root/bin/clojure-clr" --multi-e $'(+ 1 2)\n(+ 20 22)' 2>/dev/null)"; then
  if echo "$multi_e_out" | grep -q ':value 42'; then
    ok "tool-eval-multi --multi-e => value 42"
  else
    bad "tool-eval-multi --multi-e unexpected: $multi_e_out"
  fi
else
  bad "tool-eval-multi --multi-e failed"
fi

# --- tool-eval-multi: stdin ---
if multi_in_out="$(printf '%s\n' '(+ 1 2)' '(+ 20 22)' | "$root/bin/clojure-clr" --multi-form - 2>/dev/null)"; then
  if echo "$multi_in_out" | grep -q ':value 42'; then
    ok "tool-eval-multi --multi-form - (stdin) => value 42"
  else
    bad "tool-eval-multi stdin unexpected: $multi_in_out"
  fi
else
  bad "tool-eval-multi stdin failed"
fi

# --- bootstrap-project multi-ns ---
if [[ -x "$root/examples/clojure-clr-project/smoke" ]]; then
  if "$root/examples/clojure-clr-project/smoke" >/dev/null 2>&1; then
    ok "bootstrap-project multi-ns smoke (42)"
  else
    bad "bootstrap-project smoke failed"
  fi
else
  bad "missing examples/clojure-clr-project/smoke"
fi

echo "== summary: pass=$pass fail=$fail =="
[[ "$fail" -eq 0 ]]
