#!/usr/bin/env bash
# Minimal ripgrep-compatible shim for clr-meta gate scripts when real `rg`
# is not installed. Prefer installing ripgrep in CI.
set -euo pipefail
quiet=0
pattern=""
files=()
while [ $# -gt 0 ]; do
  case "$1" in
    -q|--quiet) quiet=1; shift ;;
    -n|--line-number) shift ;;
    -e|--regexp) pattern="$2"; shift 2 ;;
    -F|--fixed-strings) shift ;;
    --) shift; break ;;
    -*) shift ;;
    *)
      if [ -z "$pattern" ]; then pattern="$1"; else files+=("$1"); fi
      shift
      ;;
  esac
done
while [ $# -gt 0 ]; do files+=("$1"); shift; done
[ -n "$pattern" ] || { echo "rg-shim: missing pattern" >&2; exit 2; }

if [ ${#files[@]} -eq 0 ]; then
  if [ "$quiet" -eq 1 ]; then
    grep -Eq -- "$pattern" && exit 0 || exit 1
  else
    if grep -En -- "$pattern"; then
      exit 0
    else
      exit 1
    fi
  fi
fi

matched=0
for f in "${files[@]}"; do
  if [ "$quiet" -eq 1 ]; then
    if grep -Eq -- "$pattern" "$f" 2>/dev/null; then exit 0; fi
  else
    if grep -En -- "$pattern" "$f" 2>/dev/null; then matched=1; fi
  fi
done
if [ "$quiet" -eq 1 ]; then
  exit 1
elif [ "$matched" -eq 1 ]; then
  exit 0
else
  exit 1
fi
