expect_existing_output_rejection() {
  local label="$1"
  local output="$2"
  set +e
  "$public_cli" --build-compiler-selfhost-stage2 "$stage1" "$output" \
    >"$tmp/$label.stdout" 2>"$tmp/$label.stderr"
  local rc=$?
  set -e
  [[ "$rc" == 1 && ! -s "$tmp/$label.stdout" ]] || fail "$label-status"
  rg -F 'clr-meta compiler selfhost Stage2 builder: output-exists' \
    "$tmp/$label.stderr" >/dev/null || fail "$label-diagnostic"
}

printf 'preserve-file\n' >"$tmp/existing-output-file"
existing_file_sha256="$(sha256_file "$tmp/existing-output-file")"
expect_existing_output_rejection existing-output-file "$tmp/existing-output-file"
[[ "$existing_file_sha256" == "$(sha256_file "$tmp/existing-output-file")" ]] || \
  fail existing-output-file-preservation

mkdir "$tmp/existing-output-directory"
printf 'preserve-directory\n' >"$tmp/existing-output-directory/sentinel"
existing_directory_sha256="$(sha256_file "$tmp/existing-output-directory/sentinel")"
expect_existing_output_rejection existing-output-directory "$tmp/existing-output-directory"
[[ "$existing_directory_sha256" == \
   "$(sha256_file "$tmp/existing-output-directory/sentinel")" ]] || \
  fail existing-output-directory-preservation

ln -s "$tmp/absent-existing-output-target" "$tmp/existing-output-symlink"
existing_symlink_target="$(readlink "$tmp/existing-output-symlink")"
expect_existing_output_rejection existing-output-symlink "$tmp/existing-output-symlink"
[[ -L "$tmp/existing-output-symlink" && \
   "$(readlink "$tmp/existing-output-symlink")" == "$existing_symlink_target" ]] || \
  fail existing-output-symlink-preservation

printf 'preserve-hardlink\n' >"$tmp/existing-output-hardlink-source"
ln "$tmp/existing-output-hardlink-source" "$tmp/existing-output-hardlink"
existing_hardlink_sha256="$(sha256_file "$tmp/existing-output-hardlink")"
expect_existing_output_rejection existing-output-hardlink "$tmp/existing-output-hardlink"
[[ "$existing_hardlink_sha256" == \
   "$(sha256_file "$tmp/existing-output-hardlink")" ]] || \
  fail existing-output-hardlink-preservation
cmp "$tmp/existing-output-hardlink-source" "$tmp/existing-output-hardlink" >/dev/null || \
  fail existing-output-hardlink-source-preservation

run_builder_rejection lexical-output-overlap "$stage1" \
  "$stage1/lexical-overlap-output" lexical-output-overlaps-stage1-bundle

ln -s "$tmp" "$tmp/physical-alias-root"
