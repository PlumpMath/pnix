race_output="$tmp/publication-race-output"
set +e
"$public_cli" --build-compiler-selfhost-stage2 "$stage1" "$race_output" \
  >"$tmp/publication-race.stdout" 2>"$tmp/publication-race.stderr" &
race_pid=$!
set -e
race_armed=false
for ((attempt = 0; attempt < 10000; attempt++)); do
  if find "$tmp" -maxdepth 1 -type d -name '.compiler-selfhost-stage2.*' \
    -print -quit | grep -q .; then
    mkdir "$race_output"
    printf 'race-winner\n' >"$race_output/sentinel"
    race_armed=true
    break
  fi
  if ! kill -0 "$race_pid" 2>/dev/null; then
    break
  fi
  sleep 0.001
done
[[ "$race_armed" == true ]] || {
  wait "$race_pid" || true
  fail publication-race-not-armed
}
set +e
wait "$race_pid"
race_status=$?
set -e
[[ "$race_status" == 1 && ! -s "$tmp/publication-race.stdout" ]] || \
  fail publication-race-status
rg -F '"class":"output-exists"' "$tmp/publication-race.stderr" >/dev/null || \
  fail publication-race-rejection
rg -F 'clr-meta compiler selfhost Stage2 builder: publish-directory' \
  "$tmp/publication-race.stderr" >/dev/null || fail publication-race-diagnostic
[[ "$(cat "$race_output/sentinel")" == race-winner ]] || \
  fail publication-race-preservation
[[ "$(find "$race_output" -mindepth 1 -maxdepth 1 | wc -l | tr -d ' ')" == 1 ]] || \
  fail publication-race-partial-output

[[ "$stage1_manifest_sha256_before" == "$(sha256_file "$stage1_manifest")" ]] || \
  fail parent-manifest-mutated
[[ "$stage1_compiler_sha256_before" == "$(sha256_file "$stage1_compiler")" ]] || \
  fail parent-compiler-mutated
[[ "$canonical_source_sha256_before" == "$(sha256_file "$canonical_source")" ]] || \
  fail canonical-source-mutated
[[ "$stage2_manifest_sha256_before" == "$(sha256_file "$stage2_manifest")" ]] || \
  fail stage2-manifest-mutated
[[ "$stage2_compiler_sha256_before" == "$(sha256_file "$stage2_compiler")" ]] || \
  fail stage2-compiler-mutated

snapshot_rows "$stage1" "$tmp/stage1-payload-paths" "$tmp/stage1-payload-after.json"
cmp "$tmp/stage1-payload-before.json" "$tmp/stage1-payload-after.json" >/dev/null || \
  fail parent-payload-mutated
snapshot_rows "$stage2" "$tmp/stage2-payload-paths" "$tmp/stage2-payload-after.json"
cmp "$tmp/stage2-payload-before.json" "$tmp/stage2-payload-after.json" >/dev/null || \
  fail stage2-payload-mutated
snapshot_rows "$clr_meta_root" "$tmp/stage2-input-paths" "$tmp/stage2-live-inputs-after.json"
cmp "$tmp/stage2-live-inputs.json" "$tmp/stage2-live-inputs-after.json" >/dev/null || \
  fail stage2-live-input-mutated
assert_exact_tree "$stage1" "$tmp/expected-stage1-files" \
  "$tmp/expected-stage-directories" stage1-bundle-final
assert_exact_tree "$stage2" "$tmp/expected-stage2-files" \
  "$tmp/expected-stage-directories" stage2-bundle-final

if find "$tmp" -type f -name '*.tmp.*' -print -quit | grep -q .; then
  fail leaked-transaction-temporary
fi

