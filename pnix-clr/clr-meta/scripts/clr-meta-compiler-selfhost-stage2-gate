[[ "$(for mutation in identity add subtract; do
  sha256_file "$mutation_root/$mutation.clj"
done | LC_ALL=C sort -u | wc -l | tr -d ' ')" == 3 ]] || \
  fail mutation-source-hashes-not-distinct

compile_mutated_stage2() {
  local label="$1"
  local source_path="$mutation_root/$label.clj"
  local child="$mutation_root/$label-stage2.dll"
  support_call "$tmp" "$stage1_support" compile \
    "$stage1_compiler" "$source_path" "$child" \
    >"$tmp/$label-mutated-stage2-descriptor.json" \
    2>"$tmp/$label-mutated-stage2.stderr" || {
    sed -n '1,160p' "$tmp/$label-mutated-stage2.stderr" >&2
    fail "$label-mutated-stage2-compile"
  }
  [[ ! -s "$tmp/$label-mutated-stage2.stderr" ]] || \
    fail "$label-mutated-stage2-stderr"
  [[ -f "$child" && ! -L "$child" ]] || fail "$label-mutated-stage2-output"
  [[ "$(support_call "$tmp" "$stage1_support" prepare "$child")" == 27 ]] || \
    fail "$label-mutated-stage2-prepare"
  support_call "$tmp" "$stage1_support" describe "$child" \
    >"$tmp/$label-mutated-stage2-description.json"
  jq -e '
    .assembly == "Pnix.ClrMeta.Generated.CompilerKernel" and
    .type == "Pnix.ClrMeta.Generated.CompilerKernel" and
    .fields == 9 and (.methods | length) == 27 and
    .references == ["Pnix.ClrMeta.CompilerSupport","System.Private.CoreLib"] and
    .resources == []
  ' "$tmp/$label-mutated-stage2-description.json" >/dev/null || \
    fail "$label-mutated-stage2-description"
}

compile_mutated_stage2 identity
compile_mutated_stage2 add
compile_mutated_stage2 subtract
jq -e '
  .metadata == {
    "GeneratedBy":"pnix.clr-meta.compiler-kernel.v1",
    "KernelEntry":"compile-source",
    "KernelIdentity":"pnix.clr-meta.compiler-kernel.v1",
    "KernelNamespace":"pnix.clr-meta.compiler-kernel.v1",
    "SourceProfileId":"pnix.clr-meta.compiler-kernel-source.v1",
    "SupportAbiId":"pnix.clr-meta.compiler-support.v1"
  }
' "$tmp/identity-mutated-stage2-description.json" >/dev/null || \
  fail identity-mutated-stage2-metadata-not-canonical

compile_mutation_target() {
  local label="$1"
  local source_path="$2"
  local child="$mutation_root/$label-stage2.dll"
  local child_isolated="$mutation_root/$label-isolated"
  local grandchild="$mutation_root/$label-target.dll"
  mkdir "$child_isolated"
  copy_support_triplet "$stage2/runtime" "$child_isolated"
  cp "$child" "$child_isolated/CompilerStage2.dll"
  assert_flat_tree "$child_isolated" "$label-mutated-isolated" \
    CompilerStage2.dll \
    Pnix.ClrMeta.CompilerSupport.deps.json \
    Pnix.ClrMeta.CompilerSupport.dll \
    Pnix.ClrMeta.CompilerSupport.runtimeconfig.json
  [[ ! -e "$child_isolated/CompilerStage1.dll" && \
     ! -e "$child_isolated/compiler_kernel.clj" && \
     ! -e "$child_isolated/manifest.json" && \
     ! -e "$child_isolated/Clojure.Main.dll" && \
     ! -e "$child_isolated/Clojure.dll" && ! -e "$child_isolated/pnix" ]] || \
    fail "$label-mutated-source-hidden"
  support_call "$child_isolated" \
    "$child_isolated/Pnix.ClrMeta.CompilerSupport.dll" compile \
    "$child_isolated/CompilerStage2.dll" "$source_path" "$grandchild" \
    >"$tmp/$label-grandchild-descriptor.json" \
    2>"$tmp/$label-grandchild.stderr" || {
    sed -n '1,160p' "$tmp/$label-grandchild.stderr" >&2
    fail "$label-grandchild-compile"
  }
  [[ ! -s "$tmp/$label-grandchild.stderr" ]] || fail "$label-grandchild-stderr"
  [[ -f "$grandchild" && ! -L "$grandchild" ]] || fail "$label-grandchild-output"
}

