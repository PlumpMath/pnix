#!/usr/bin/env bash
set -euo pipefail
umask 077

clr_meta_root="$(cd "$(dirname "$0")/.." && pwd -P)"
root="$(cd "$clr_meta_root/.." && pwd -P)"
family_root="$clr_meta_root/compiler-selfhost"
canonical_source="$family_root/compiler_kernel.clj"
stage2_contract="$family_root/stage2-contract.edn"
public_cli="$root/bin/clr-meta"
dotnet_bin="$(command -v dotnet || true)"

fail() {
  echo "clr-meta compiler selfhost Stage2 gate: $1" >&2
  exit 1
}

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    shasum -a 256 "$1" | awk '{print $1}'
  fi
}

sha256_stdin() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum | awk '{print $1}'
  else
    shasum -a 256 | awk '{print $1}'
  fi
}

assert_rejection_json() {
  local path="$1"
  local phase="$2"
  local class="$3"
  [[ "$(wc -l <"$path" | tr -d ' ')" == 1 ]] || fail rejection-line-count
  jq -e --arg phase "$phase" --arg class "$class" '
    (keys_unsorted | sort) == (["class","message","phase","schema"] | sort) and
    .schema == "pnix.clr-meta.compiler-selfhost-error.v1" and
    .phase == $phase and .class == $class and
    (.message | type == "string" and length > 0)
  ' "$path" >/dev/null || fail "rejection-$phase-$class"
}

assert_exact_tree() {
  local directory="$1"
  local expected_files="$2"
  local expected_directories="$3"
  local label="$4"
  if find "$directory" -type l -print -quit | grep -q .; then
    fail "$label-symlink"
  fi
  if find "$directory" -mindepth 1 ! -type f ! -type d -print -quit | grep -q .; then
    fail "$label-special-entry"
  fi
  (
    cd "$directory"
    find . -type f -print | sed 's#^\./##' | LC_ALL=C sort
  ) >"$tmp/$label-actual-files"
  cmp "$expected_files" "$tmp/$label-actual-files" >/dev/null || fail "$label-file-set"
  (
    cd "$directory"
    find . -type d -print | sed 's#^\./##' | LC_ALL=C sort
  ) >"$tmp/$label-actual-directories"
  cmp "$expected_directories" "$tmp/$label-actual-directories" >/dev/null || \
    fail "$label-directory-set"
}

snapshot_rows() {
  local directory="$1"
  local paths_file="$2"
  local output="$3"
  : >"$output.rows"
  while IFS= read -r relative; do
    jq -cn --arg path "$relative" --arg sha256 "$(sha256_file "$directory/$relative")" \
      '{path:$path,sha256:$sha256}' >>"$output.rows"
  done <"$paths_file"
  jq -sS '.' "$output.rows" >"$output"
}

rows_closure() {
  jq -r '.[] | "\(.sha256)  \(.path)"' "$1" | sha256_stdin
}

support_call() {
  local cwd="$1"
  local support="$2"
  shift 2
  (
    cd "$cwd"
    "${clean_environment[@]}" "$dotnet_bin" "$support" "$@"
  )
}

run_builder_rejection() {
  local label="$1"
  local parent="$2"
  local output="$3"
  local marker="$4"
  set +e
  "$public_cli" --build-compiler-selfhost-stage2 "$parent" "$output" \
    >"$tmp/$label.stdout" 2>"$tmp/$label.stderr"
  local rc=$?
  set -e
  [[ "$rc" == 1 && ! -s "$tmp/$label.stdout" ]] || fail "$label-status"
  rg -F "clr-meta compiler selfhost Stage2 builder: $marker" \
    "$tmp/$label.stderr" >/dev/null || fail "$label-diagnostic"
  [[ ! -e "$output" && ! -L "$output" ]] || fail "$label-output-created"
}

for command in jq rg strings find cmp sed awk; do
  command -v "$command" >/dev/null 2>&1 || fail "$command-missing"
done
[[ -n "$dotnet_bin" && -f "$dotnet_bin" ]] || fail dotnet-missing
for input in "$public_cli" "$canonical_source" "$stage2_contract" \
  "$family_root/unseen_add.clj" "$family_root/unseen_subtract.clj" \
  "$family_root/unseen_equal.clj" "$family_root/unseen_truthy.clj"; do
  [[ -f "$input" && ! -L "$input" ]] || fail required-input-missing
done

tmp_base="$(cd "${TMPDIR:-/tmp}" && pwd -P)"
tmp="$(mktemp -d "$tmp_base/clr-meta-selfhost-stage2.XXXXXX")"
trap 'rm -rf "$tmp"' EXIT
mkdir -p "$tmp/home" "$tmp/process-tmp" "$tmp/dotnet-home" "$tmp/poison"

clean_environment=(
  env -i
  "PATH=/usr/bin:/bin"
  "HOME=$tmp/home"
  "TMPDIR=$tmp/process-tmp"
  "DOTNET_CLI_HOME=$tmp/dotnet-home"
  "DOTNET_CLI_TELEMETRY_OPTOUT=1"
  "DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1"
  "DOTNET_CLI_WORKLOAD_UPDATE_NOTIFY_DISABLE=1"
  "DOTNET_NOLOGO=1"
  "CLOJURE_LOAD_PATH=$tmp/poison"
  "CLOJURE_COMPILE_PATH=$tmp/poison"
  "CLR_META_SOURCE_ROOT=$tmp/poison"
)
if [[ -n "${DOTNET_ROOT:-}" ]]; then
  clean_environment+=("DOTNET_ROOT=$DOTNET_ROOT")
fi

stage1="$tmp/stage1"
"$public_cli" --build-compiler-selfhost-stage1 "$stage1" \
  >"$tmp/stage1-builder.stdout" 2>"$tmp/stage1-builder.stderr" || {
  sed -n '1,200p' "$tmp/stage1-builder.stderr" >&2
  fail public-stage1-builder
}
cmp "$tmp/stage1-builder.stdout" "$stage1/manifest.json" >/dev/null || \
  fail public-stage1-builder-stdout
[[ ! -s "$tmp/stage1-builder.stderr" ]] || fail public-stage1-builder-stderr

printf '%s\n' \
  compiler/CompilerStage1.dll \
  manifest.json \
  runtime/Pnix.ClrMeta.CompilerSupport.deps.json \
  runtime/Pnix.ClrMeta.CompilerSupport.dll \
  runtime/Pnix.ClrMeta.CompilerSupport.runtimeconfig.json \
  | LC_ALL=C sort >"$tmp/expected-stage1-files"
printf '%s\n' . compiler runtime | LC_ALL=C sort >"$tmp/expected-stage-directories"
assert_exact_tree "$stage1" "$tmp/expected-stage1-files" \
  "$tmp/expected-stage-directories" stage1-bundle

stage1_manifest="$stage1/manifest.json"
stage1_compiler="$stage1/compiler/CompilerStage1.dll"
stage1_support="$stage1/runtime/Pnix.ClrMeta.CompilerSupport.dll"

jq -e '
  (keys_unsorted | sort) == ([
    "admission","bootstrap","boundaries","bundle_closure_sha256","bundle_files",
    "checkpoint","claims","compiler","execution","family","input_closure_sha256",
    "inputs","schema","stage","toolchain"
  ] | sort) and
  .schema == "pnix.clr-meta.compiler-selfhost-stage1-artifact.v1" and
  .checkpoint == "c2-executable-compiler-stage1" and
  .family == "pnix.clr-meta.compiler-kernel.v1" and .stage == 1 and
  .admission.checkpoint == "c1-source-admission" and .admission.ready == true and
  .claims.compiler_stage1_artifact == true and .claims.compiler_executable == true and
  .claims.compiler_stage2 == false and .claims.self_reproduction == false and
  .claims.fixed_point == false and .claims.raw_artifact_reproducibility == false and
  .claims.clojureclr_replacement == false and
  .compiler.path == "compiler/CompilerStage1.dll" and .compiler.prepared_methods == 27 and
  [.bundle_files[].path] == [
    "compiler/CompilerStage1.dll",
    "runtime/Pnix.ClrMeta.CompilerSupport.deps.json",
    "runtime/Pnix.ClrMeta.CompilerSupport.dll",
    "runtime/Pnix.ClrMeta.CompilerSupport.runtimeconfig.json"
  ]
' "$stage1_manifest" >/dev/null || fail stage1-manifest

printf '%s\n' \
  compiler/CompilerStage1.dll \
  runtime/Pnix.ClrMeta.CompilerSupport.deps.json \
  runtime/Pnix.ClrMeta.CompilerSupport.dll \
  runtime/Pnix.ClrMeta.CompilerSupport.runtimeconfig.json \
  >"$tmp/stage1-payload-paths"
snapshot_rows "$stage1" "$tmp/stage1-payload-paths" "$tmp/stage1-payload.json"
jq -S '.bundle_files' "$stage1_manifest" >"$tmp/stage1-manifest-payload.json"
cmp "$tmp/stage1-payload.json" "$tmp/stage1-manifest-payload.json" >/dev/null || \
  fail stage1-bundle-file-hashes
[[ "$(rows_closure "$tmp/stage1-payload.json")" == \
   "$(jq -r '.bundle_closure_sha256' "$stage1_manifest")" ]] || \
  fail stage1-bundle-closure
[[ "$(sha256_file "$stage1_compiler")" == \
   "$(jq -r '.compiler.sha256' "$stage1_manifest")" ]] || fail stage1-compiler-hash

support_call "$tmp" "$stage1_support" describe "$stage1_compiler" \
  >"$tmp/stage1-description.json" 2>"$tmp/stage1-description.stderr" || \
  fail stage1-describe
[[ ! -s "$tmp/stage1-description.stderr" ]] || fail stage1-describe-stderr
jq -S '.' "$tmp/stage1-description.json" >"$tmp/stage1-description.canonical.json"
jq -S '.compiler.description' "$stage1_manifest" \
  >"$tmp/stage1-manifest-description.canonical.json"
cmp "$tmp/stage1-description.canonical.json" \
  "$tmp/stage1-manifest-description.canonical.json" >/dev/null || \
  fail stage1-description
[[ "$(support_call "$tmp" "$stage1_support" prepare "$stage1_compiler")" == 27 ]] || \
  fail stage1-prepare

stage2="$tmp/stage2"
"$public_cli" --build-compiler-selfhost-stage2 "$stage1" "$stage2" \
  >"$tmp/stage2-builder.stdout" 2>"$tmp/stage2-builder.stderr" || {
  sed -n '1,240p' "$tmp/stage2-builder.stderr" >&2
  fail public-stage2-builder
}
cmp "$tmp/stage2-builder.stdout" "$stage2/manifest.json" >/dev/null || \
  fail public-stage2-builder-stdout
[[ ! -s "$tmp/stage2-builder.stderr" ]] || fail public-stage2-builder-stderr

printf '%s\n' \
  compiler/CompilerStage2.dll \
  manifest.json \
  runtime/Pnix.ClrMeta.CompilerSupport.deps.json \
  runtime/Pnix.ClrMeta.CompilerSupport.dll \
  runtime/Pnix.ClrMeta.CompilerSupport.runtimeconfig.json \
  | LC_ALL=C sort >"$tmp/expected-stage2-files"
assert_exact_tree "$stage2" "$tmp/expected-stage2-files" \
  "$tmp/expected-stage-directories" stage2-bundle

stage2_manifest="$stage2/manifest.json"
stage2_compiler="$stage2/compiler/CompilerStage2.dll"
stage2_support="$stage2/runtime/Pnix.ClrMeta.CompilerSupport.dll"

# The exact manifest contract is checked below after the live lineage values are
# materialized. This is deliberately reflection/closure evidence; no raw PE
# equality or inequality between Stage1 and Stage2 is a gate condition.

stage1_manifest_sha256="$(sha256_file "$stage1_manifest")"
stage1_compiler_sha256="$(sha256_file "$stage1_compiler")"
stage1_description_sha256="$(sha256_file "$tmp/stage1-description.canonical.json")"
stage2_compiler_sha256="$(sha256_file "$stage2_compiler")"
canonical_source_sha256="$(sha256_file "$canonical_source")"
stage2_contract_sha256="$(sha256_file "$stage2_contract")"
dotnet_host_sha256="$(sha256_file "$dotnet_bin")"
dotnet_version="$("${clean_environment[@]}" "$dotnet_bin" --version)"
parent_source_sha256="$(jq -r '
  .inputs[] | select(.path == "compiler-selfhost/compiler_kernel.clj") | .sha256
' "$stage1_manifest")"

jq -e \
  --arg canonical_source_sha256 "$canonical_source_sha256" \
  --arg contract_sha256 "$stage2_contract_sha256" \
  --arg dotnet_host_sha256 "$dotnet_host_sha256" \
  --arg dotnet_version "$dotnet_version" \
  --arg parent_bundle_closure_sha256 "$(jq -r '.bundle_closure_sha256' "$stage1_manifest")" \
  --arg parent_compiler_sha256 "$stage1_compiler_sha256" \
  --arg parent_description_sha256 "$stage1_description_sha256" \
  --arg parent_dotnet_host_sha256 "$(jq -r '.toolchain.dotnet_host_sha256' "$stage1_manifest")" \
  --arg parent_dotnet_version "$(jq -r '.toolchain.dotnet_version' "$stage1_manifest")" \
  --arg parent_input_closure_sha256 "$(jq -r '.input_closure_sha256' "$stage1_manifest")" \
  --arg parent_manifest_sha256 "$stage1_manifest_sha256" \
  --arg stage2_compiler_sha256 "$stage2_compiler_sha256" '
  def exact_keys($expected):
    (keys_unsorted | sort) == ($expected | sort);
  def hash: type == "string" and test("^[0-9a-f]{64}$");
  def row:
    exact_keys(["path","sha256"]) and
    (.path | type == "string" and length > 0) and (.sha256 | hash);
  exact_keys([
    "boundaries","bundle_closure_sha256","bundle_files","checkpoint","claims",
    "compilation","compiler","contract","execution","family",
    "input_closure_sha256","inputs","parent","schema","stage","support",
    "toolchain"
  ]) and
  .schema == "pnix.clr-meta.compiler-selfhost-stage2-artifact.v1" and
  .checkpoint == "c3-executable-compiler-stage2" and
  .family == "pnix.clr-meta.compiler-kernel.v1" and .stage == 2 and
  .contract == {
    path:"compiler-selfhost/stage2-contract.edn",sha256:$contract_sha256
  } and
  .parent == {
    bundle_closure_sha256:$parent_bundle_closure_sha256,
    checkpoint:"c2-executable-compiler-stage1",
    compiler_description_sha256:$parent_description_sha256,
    compiler_sha256:$parent_compiler_sha256,
    input_closure_sha256:$parent_input_closure_sha256,
    manifest_sha256:$parent_manifest_sha256,
    schema:"pnix.clr-meta.compiler-selfhost-stage1-artifact.v1",
    stage:1,
    validated:true
  } and
  (.compilation | exact_keys([
      "canonical_source","canonical_source_sha256","command","compiled_language",
      "compiler","descriptor","host","replay_source_packaged","source_hash_chain",
      "source_language","source_language_equals_compiled_language",
      "source_unchanged_after_compile","transition_source_present"
    ]) and
    .canonical_source == "compiler-selfhost/compiler_kernel.clj" and
    .canonical_source_sha256 == $canonical_source_sha256 and
    .source_language == "pnix.clr-meta.compiler-kernel-source.v1" and
    .compiled_language == "pnix.clr-meta.compiler-kernel-source.v1" and
    .source_language_equals_compiled_language == true and
    .transition_source_present == true and .replay_source_packaged == false and
    .source_unchanged_after_compile == true and
    .compiler == "STAGE1_BUNDLE/compiler/CompilerStage1.dll" and
    .host == "STAGE1_BUNDLE/runtime/Pnix.ClrMeta.CompilerSupport.dll" and
    .command == [
      "dotnet","STAGE1_BUNDLE/runtime/Pnix.ClrMeta.CompilerSupport.dll","compile",
      "STAGE1_BUNDLE/compiler/CompilerStage1.dll","FROZEN_TRANSITION_SOURCE",
      "compiler/CompilerStage2.dll"
    ] and
    (.source_hash_chain | exact_keys([
      "contract_sha256","frozen_source_sha256_after","frozen_source_sha256_before",
      "live_after_sha256","live_before_sha256","parent_c2_input_sha256"
    ]) and all(.[]; . == $canonical_source_sha256)) and
    (.descriptor | exact_keys([
      "kernel_entry","kernel_identity","kernel_namespace","path","schema","sha256",
      "source_profile_id"
    ]) and
      .schema == "pnix.clr-meta.compiler-selfhost-artifact-descriptor.v1" and
      .kernel_entry == "compile-source" and
      .kernel_identity == "pnix.clr-meta.compiler-kernel.v1" and
      .kernel_namespace == "pnix.clr-meta.compiler-kernel.v1" and
      .source_profile_id == "pnix.clr-meta.compiler-kernel-source.v1" and
      .path == "compiler/CompilerStage2.dll" and
      .sha256 == $stage2_compiler_sha256)) and
  (.compiler | exact_keys([
      "description","description_sha256","path","prepared_methods",
      "sha256","structural_description_equal_to_stage1"
    ]) and .path == "compiler/CompilerStage2.dll" and
    .sha256 == $stage2_compiler_sha256 and .prepared_methods == 27 and
    .structural_description_equal_to_stage1 == true and
    (.description_sha256 | hash) and
    (.description | exact_keys([
      "assembly","fields","metadata","methods","references","resources","schema","type"
    ]) and
      .schema == "pnix.clr-meta.compiler-selfhost-description.v1" and
      .assembly == "Pnix.ClrMeta.Generated.CompilerKernel" and
      .type == "Pnix.ClrMeta.Generated.CompilerKernel" and .fields == 9 and
      .methods == [
        "bind-parameters/3","bind-support-call/3","binding-arity-is?/2",
        "binding-kind?/2","callable-binding?/1","collect-definitions/3",
        "compile-source/2","count-at-least?/2","count-is?/2",
        "declare-definitions/3","fn-initializer?/1","initialize-constants/4",
        "literal-kind/1","literal?/1","lower-definition/3",
        "lower-definitions/4","lower-node/5","lower-program/3",
        "resolve-required/3","seed-intrinsics/1","seed-support-calls/1",
        "select-intrinsic-opcode/2","symbol-named?/2","validate-definition/2",
        "validate-definitions/3","validate-node/4","validate-program/1"
      ] and
      .references == ["Pnix.ClrMeta.CompilerSupport","System.Private.CoreLib"] and
      .resources == [] and
      .metadata == {
        GeneratedBy:"pnix.clr-meta.compiler-kernel.v1",
        KernelEntry:"compile-source",
        KernelIdentity:"pnix.clr-meta.compiler-kernel.v1",
        KernelNamespace:"pnix.clr-meta.compiler-kernel.v1",
        SourceProfileId:"pnix.clr-meta.compiler-kernel-source.v1",
        SupportAbiId:"pnix.clr-meta.compiler-support.v1"
      })) and
  .execution == {
    command:["dotnet","runtime/Pnix.ClrMeta.CompilerSupport.dll","compile",
             "compiler/CompilerStage2.dll","SOURCE","OUTPUT"],
    host:"runtime/Pnix.ClrMeta.CompilerSupport.dll"
  } and
  (.inputs | type == "array" and length == 3 and all(.[]; row) and
    map(.path) == [
      "compiler-selfhost/compiler_kernel.clj",
      "compiler-selfhost/stage2-contract.edn",
      "scripts/clr-meta-build-compiler-selfhost-stage2"
    ]) and
  (.input_closure_sha256 | hash) and
  (.bundle_files | type == "array" and length == 4 and all(.[]; row) and
    map(.path) == [
      "compiler/CompilerStage2.dll",
      "runtime/Pnix.ClrMeta.CompilerSupport.deps.json",
      "runtime/Pnix.ClrMeta.CompilerSupport.dll",
      "runtime/Pnix.ClrMeta.CompilerSupport.runtimeconfig.json"
    ]) and
  (.bundle_closure_sha256 | hash) and
  (.support | exact_keys(["abi_id","closure_sha256","copied_from_parent","files"]) and
    .abi_id == "pnix.clr-meta.compiler-support.v1" and
    .copied_from_parent == true and (.closure_sha256 | hash) and
    (.files | type == "array" and length == 3 and all(.[]; row) and
      map(.path) == [
        "runtime/Pnix.ClrMeta.CompilerSupport.deps.json",
        "runtime/Pnix.ClrMeta.CompilerSupport.dll",
        "runtime/Pnix.ClrMeta.CompilerSupport.runtimeconfig.json"
      ])) and
  .toolchain == {
    parent_dotnet_host_sha256:$parent_dotnet_host_sha256,
    parent_dotnet_version:$parent_dotnet_version,
    same_toolchain_observed:(
      $parent_dotnet_host_sha256 == $dotnet_host_sha256 and
      $parent_dotnet_version == $dotnet_version
    ),
    same_toolchain_required:false,
    transition_dotnet_host_sha256:$dotnet_host_sha256,
    transition_dotnet_version:$dotnet_version
  } and
  .boundaries == {
    clojureclr_packaged:false,
    compiler_source_packaged:false,
    direct_stage1_copy:false,
    embedded_artifact_payload:false,
    generated_artifact_clojureclr_reference:false,
    generated_artifact_host_compiler_use:false,
    generated_artifact_host_source_load_use:false,
    replay_source_packaged:false,
    source_replay_fallback:false,
    stage1_artifact_packaged:false
  } and
  .claims == {
    clojureclr_replacement:false,
    compiler_executable:true,
    compiler_source_free_runtime_bundle:true,
    compiler_stage2:true,
    cross_host_canonical_equivalence:false,
    fixed_point:false,
    formal_semantic_equivalence:false,
    full_clojure_surface:false,
    host_free_bootstrap:false,
    os_sandbox:false,
    parent_stage1_admitted:true,
    pnix_semantics:false,
    raw_artifact_reproducibility:false,
    same_source_recompile:true,
    self_reproduction:false,
    stage15_n:false,
    stage1_ancestor_validated:true,
    stage2_fresh_target_replay:false,
    stage3:false,
    standalone_lineage_replay:false,
    standalone_source_free_distribution:false
  }
' "$stage2_manifest" >/dev/null || fail stage2-manifest-contract

[[ "$parent_source_sha256" == "$canonical_source_sha256" ]] || \
  fail parent-c2-source-lineage
[[ "$(jq -r '.contract.sha256' "$stage2_manifest")" == "$stage2_contract_sha256" ]] || \
  fail stage2-contract-lineage

printf '%s\n' \
  compiler-selfhost/compiler_kernel.clj \
  compiler-selfhost/stage2-contract.edn \
  scripts/clr-meta-build-compiler-selfhost-stage2 \
  >"$tmp/stage2-input-paths"
snapshot_rows "$clr_meta_root" "$tmp/stage2-input-paths" "$tmp/stage2-live-inputs.json"
jq -S '.inputs' "$stage2_manifest" >"$tmp/stage2-manifest-inputs.json"
cmp "$tmp/stage2-live-inputs.json" "$tmp/stage2-manifest-inputs.json" >/dev/null || \
  fail stage2-live-input-hashes
[[ "$(rows_closure "$tmp/stage2-live-inputs.json")" == \
   "$(jq -r '.input_closure_sha256' "$stage2_manifest")" ]] || \
  fail stage2-input-closure

printf '%s\n' \
  compiler/CompilerStage2.dll \
  runtime/Pnix.ClrMeta.CompilerSupport.deps.json \
  runtime/Pnix.ClrMeta.CompilerSupport.dll \
  runtime/Pnix.ClrMeta.CompilerSupport.runtimeconfig.json \
  >"$tmp/stage2-payload-paths"
snapshot_rows "$stage2" "$tmp/stage2-payload-paths" "$tmp/stage2-payload.json"
jq -S '.bundle_files' "$stage2_manifest" >"$tmp/stage2-manifest-payload.json"
cmp "$tmp/stage2-payload.json" "$tmp/stage2-manifest-payload.json" >/dev/null || \
  fail stage2-bundle-file-hashes
[[ "$(rows_closure "$tmp/stage2-payload.json")" == \
   "$(jq -r '.bundle_closure_sha256' "$stage2_manifest")" ]] || \
  fail stage2-bundle-closure

for name in \
  Pnix.ClrMeta.CompilerSupport.deps.json \
  Pnix.ClrMeta.CompilerSupport.dll \
  Pnix.ClrMeta.CompilerSupport.runtimeconfig.json; do
  cmp "$stage1/runtime/$name" "$stage2/runtime/$name" >/dev/null || \
    fail support-triplet-parent-copy
done

support_call "$tmp" "$stage2_support" describe "$stage2_compiler" \
  >"$tmp/stage2-description.json" 2>"$tmp/stage2-description.stderr" || \
  fail stage2-describe
[[ ! -s "$tmp/stage2-description.stderr" ]] || fail stage2-describe-stderr
jq -S '.' "$tmp/stage2-description.json" >"$tmp/stage2-description.canonical.json"
jq -S '.compiler.description' "$stage2_manifest" \
  >"$tmp/stage2-manifest-description.canonical.json"
cmp "$tmp/stage2-description.canonical.json" \
  "$tmp/stage2-manifest-description.canonical.json" >/dev/null || \
  fail stage2-description
cmp "$tmp/stage1-description.canonical.json" \
  "$tmp/stage2-description.canonical.json" >/dev/null || \
  fail stage2-structural-description
[[ "$(support_call "$tmp" "$stage2_support" prepare "$stage2_compiler")" == 27 ]] || \
  fail stage2-prepare

jq '[.[] | select(.path | startswith("runtime/"))]' \
  "$tmp/stage2-payload.json" >"$tmp/stage2-support-rows.json"
jq -S '.support.files' "$stage2_manifest" >"$tmp/stage2-manifest-support-rows.json"
cmp "$tmp/stage2-support-rows.json" "$tmp/stage2-manifest-support-rows.json" >/dev/null || \
  fail stage2-support-file-hashes
[[ "$(rows_closure "$tmp/stage2-support-rows.json")" == \
   "$(jq -r '.support.closure_sha256' "$stage2_manifest")" ]] || \
  fail stage2-support-closure

stage1_manifest_sha256_before="$(sha256_file "$stage1_manifest")"
stage1_compiler_sha256_before="$(sha256_file "$stage1_compiler")"
canonical_source_sha256_before="$(sha256_file "$canonical_source")"
stage2_manifest_sha256_before="$(sha256_file "$stage2_manifest")"
stage2_compiler_sha256_before="$(sha256_file "$stage2_compiler")"
snapshot_rows "$stage1" "$tmp/stage1-payload-paths" "$tmp/stage1-payload-before.json"
snapshot_rows "$stage2" "$tmp/stage2-payload-paths" "$tmp/stage2-payload-before.json"

copy_support_triplet() {
  local source_runtime="$1"
  local destination="$2"
  mkdir -p "$destination"
  for name in \
    Pnix.ClrMeta.CompilerSupport.deps.json \
    Pnix.ClrMeta.CompilerSupport.dll \
    Pnix.ClrMeta.CompilerSupport.runtimeconfig.json; do
    cp "$source_runtime/$name" "$destination/$name"
    cmp "$source_runtime/$name" "$destination/$name" >/dev/null || \
      fail support-runtime-copy
  done
}

assert_flat_tree() {
  local directory="$1"
  local label="$2"
  shift 2
  printf '%s\n' "$@" | LC_ALL=C sort >"$tmp/$label-expected-files"
  printf '%s\n' . >"$tmp/$label-expected-directories"
  assert_exact_tree "$directory" "$tmp/$label-expected-files" \
    "$tmp/$label-expected-directories" "$label"
}

isolated="$tmp/stage2-isolated"
targets="$tmp/post-stage2-target-sources"
target_artifacts="$tmp/post-stage2-target-artifacts"
mkdir -p "$isolated" "$targets" "$target_artifacts"
copy_support_triplet "$stage2/runtime" "$isolated"
cp "$stage2_compiler" "$isolated/CompilerStage2.dll"
cmp "$stage2_compiler" "$isolated/CompilerStage2.dll" >/dev/null || \
  fail stage2-isolated-copy
for fixture in unseen_add.clj unseen_subtract.clj unseen_equal.clj unseen_truthy.clj; do
  cp "$family_root/$fixture" "$targets/$fixture"
done

assert_flat_tree "$isolated" stage2-isolated-initial \
  CompilerStage2.dll \
  Pnix.ClrMeta.CompilerSupport.deps.json \
  Pnix.ClrMeta.CompilerSupport.dll \
  Pnix.ClrMeta.CompilerSupport.runtimeconfig.json
[[ ! -e "$isolated/CompilerStage1.dll" && ! -e "$isolated/compiler_kernel.clj" && \
   ! -e "$isolated/manifest.json" && ! -e "$isolated/Clojure.Main.dll" && \
   ! -e "$isolated/Clojure.dll" && ! -e "$isolated/pnix" ]] || \
  fail stage2-source-hidden-layout
if strings "$isolated/CompilerStage2.dll" | rg -n \
  'Clojure\.Main|clojure\.lang\.Compiler|Clojure\.Compiler|compiler_kernel\.clj|compiler-selfhost-stage1|System\.Diagnostics\.Process|ProcessStartInfo|Convert\.FromBase64String' \
  >"$tmp/stage2-forbidden-strings"; then
  fail stage2-forbidden-bootstrap-payload
fi

isolated_support="$isolated/Pnix.ClrMeta.CompilerSupport.dll"
isolated_compiler="$isolated/CompilerStage2.dll"

compile_stage2_target() {
  local label="$1"
  local source_path="$2"
  local output="$target_artifacts/$label.dll"
  support_call "$isolated" "$isolated_support" compile \
    "$isolated_compiler" "$source_path" "$output" \
    >"$tmp/$label-descriptor.json" 2>"$tmp/$label-compile.stderr" || {
    sed -n '1,160p' "$tmp/$label-compile.stderr" >&2
    fail "$label-compile"
  }
  [[ ! -s "$tmp/$label-compile.stderr" ]] || fail "$label-compile-stderr"
  [[ -f "$output" && ! -L "$output" ]] || fail "$label-output"
  jq -e --arg path "$output" --arg sha256 "$(sha256_file "$output")" '
    (keys_unsorted | sort) == ([
      "kernel_entry","kernel_identity","kernel_namespace","path","schema","sha256",
      "source_profile_id"
    ] | sort) and
    .schema == "pnix.clr-meta.compiler-selfhost-artifact-descriptor.v1" and
    .kernel_entry == "compile-source" and
    .kernel_identity == "pnix.clr-meta.compiler-kernel.v1" and
    .kernel_namespace == "pnix.clr-meta.compiler-kernel.v1" and
    .source_profile_id == "pnix.clr-meta.compiler-kernel-source.v1" and
    .path == $path and .sha256 == $sha256
  ' "$tmp/$label-descriptor.json" >/dev/null || fail "$label-descriptor"
}

execute_target() {
  local label="$1"
  local artifact="$2"
  local invoke_command="$3"
  local expected="$4"
  shift 4
  local execution="$tmp/execute-$label"
  mkdir "$execution"
  copy_support_triplet "$stage2/runtime" "$execution"
  cp "$artifact" "$execution/Target.dll"
  cmp "$artifact" "$execution/Target.dll" >/dev/null || fail "$label-execution-copy"
  assert_flat_tree "$execution" "execution-$label" \
    Pnix.ClrMeta.CompilerSupport.deps.json \
    Pnix.ClrMeta.CompilerSupport.dll \
    Pnix.ClrMeta.CompilerSupport.runtimeconfig.json \
    Target.dll
  [[ ! -e "$execution/CompilerStage1.dll" && \
     ! -e "$execution/CompilerStage2.dll" && \
     ! -e "$execution/compiler_kernel.clj" && \
     ! -e "$execution/manifest.json" && \
     ! -e "$execution/Clojure.Main.dll" && \
     ! -e "$execution/Clojure.dll" && ! -e "$execution/pnix" ]] || \
    fail "$label-execution-source-hidden"
  local actual
  actual="$(support_call "$execution" \
    "$execution/Pnix.ClrMeta.CompilerSupport.dll" \
    "$invoke_command" "$execution/Target.dll" "$@")"
  [[ "$actual" == "$expected" ]] || fail "$label-execution"
}

compile_stage2_target add "$targets/unseen_add.clj"
compile_stage2_target subtract "$targets/unseen_subtract.clj"
compile_stage2_target equal "$targets/unseen_equal.clj"
compile_stage2_target truthy "$targets/unseen_truthy.clj"

execute_target add "$target_artifacts/add.dll" invoke-i64 42 20 22
execute_target subtract "$target_artifacts/subtract.dll" invoke-i64 -2 20 22
execute_target equal-true "$target_artifacts/equal.dll" invoke-i64 true 42 42
execute_target equal-false "$target_artifacts/equal.dll" invoke-i64 false 42 41
execute_target truthy-zero "$target_artifacts/truthy.dll" invoke-i64 9 0 9
execute_target truthy-false "$target_artifacts/truthy.dll" invoke-values 0 false i64:9
execute_target truthy-nil "$target_artifacts/truthy.dll" invoke-values 0 nil i64:9

post_stage2_nonce="post-stage2-$(dd if=/dev/urandom bs=32 count=1 2>/dev/null | sha256_stdin)"
[[ "$(support_call "$isolated" "$isolated_support" contains-text \
  "$stage1_compiler" "$post_stage2_nonce")" == false ]] || \
  fail nonce-present-in-stage1
[[ "$(support_call "$isolated" "$isolated_support" contains-text \
  "$isolated_compiler" "$post_stage2_nonce")" == false ]] || \
  fail nonce-present-in-stage2
for name in \
  Pnix.ClrMeta.CompilerSupport.deps.json \
  Pnix.ClrMeta.CompilerSupport.dll \
  Pnix.ClrMeta.CompilerSupport.runtimeconfig.json; do
  [[ "$(support_call "$isolated" "$isolated_support" contains-text \
    "$isolated/$name" "$post_stage2_nonce")" == false ]] || \
    fail nonce-present-in-support-triplet
done
printf '%s\n' \
  '(ns pnix.clr-meta.compiler-kernel.v1)' \
  "(def post-stage2-nonce \"$post_stage2_nonce\")" \
  '(def compile-source (fn* compile-source [left right] post-stage2-nonce))' \
  >"$targets/fresh_nonce.clj"
compile_stage2_target fresh-nonce "$targets/fresh_nonce.clj"
[[ "$(support_call "$isolated" "$isolated_support" contains-text \
  "$target_artifacts/fresh-nonce.dll" "$post_stage2_nonce")" == true ]] || \
  fail nonce-absent-from-fresh-target
execute_target fresh-nonce "$target_artifacts/fresh-nonce.dll" \
  invoke-values "$post_stage2_nonce" nil false

assert_flat_tree "$isolated" stage2-isolated-final \
  CompilerStage2.dll \
  Pnix.ClrMeta.CompilerSupport.deps.json \
  Pnix.ClrMeta.CompilerSupport.dll \
  Pnix.ClrMeta.CompilerSupport.runtimeconfig.json

