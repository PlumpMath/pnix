mkdir "$mutation_root"
[[ "$(rg -F -o '(def kernel-identity "pnix.clr-meta.compiler-kernel.v1")' \
  "$canonical_source" | wc -l | tr -d ' ')" == 1 ]] || fail identity-mutation-anchor
[[ "$(rg -F -o '(def add-opcode "add.ovf")' \
  "$canonical_source" | wc -l | tr -d ' ')" == 1 ]] || fail add-mutation-anchor
[[ "$(rg -F -o '(def subtract-opcode "sub.ovf")' \
  "$canonical_source" | wc -l | tr -d ' ')" == 1 ]] || fail subtract-mutation-anchor

mutation_identity="c3-mutated-$(dd if=/dev/urandom bs=32 count=1 2>/dev/null | sha256_stdin)"
[[ "$(support_call "$isolated" "$isolated_support" contains-text \
  "$stage1_compiler" "$mutation_identity")" == false ]] || \
  fail mutation-identity-present-in-stage1
[[ "$(support_call "$isolated" "$isolated_support" contains-text \
  "$stage2_compiler" "$mutation_identity")" == false ]] || \
  fail mutation-identity-present-in-stage2
[[ "$(support_call "$isolated" "$isolated_support" contains-text \
  "$stage2_support" "$mutation_identity")" == false ]] || \
  fail mutation-identity-present-in-support

sed "s#(def kernel-identity \"pnix.clr-meta.compiler-kernel.v1\")#(def kernel-identity \"$mutation_identity\")#" \
  "$canonical_source" >"$mutation_root/identity.clj"
sed 's#(def add-opcode "add.ovf")#(def add-opcode "sub.ovf")#' \
  "$canonical_source" >"$mutation_root/add.clj"
sed 's#(def subtract-opcode "sub.ovf")#(def subtract-opcode "add.ovf")#' \
  "$canonical_source" >"$mutation_root/subtract.clj"
for mutation in identity add subtract; do
  [[ "$(sha256_file "$mutation_root/$mutation.clj")" != "$canonical_source_sha256" ]] || \
    fail "$mutation-mutation-noop"
