<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Example targets net10 (current pnix-clr host TFM). Pnix.Clr still multi-targets net8+net10. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Prefer exported library; fall back to in-tree build props. -->
  <PropertyGroup>
    <_PnixLib Condition="'$(PNIX_CLR_LIBRARY)' != ''">$(PNIX_CLR_LIBRARY)</_PnixLib>
    <_PnixLib Condition="'$(_PnixLib)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../target/pnix-clr-library'))</_PnixLib>
  </PropertyGroup>
  <Import Project="$(_PnixLib)/build/Pnix.Clr.props"
          Condition="Exists('$(_PnixLib)/build/Pnix.Clr.props')" />
  <Import Project="$(_PnixLib)/build/Pnix.Clr.targets"
          Condition="Exists('$(_PnixLib)/build/Pnix.Clr.targets')" />

  <!-- In-tree ProjectReference when library not yet exported. -->
  <ItemGroup Condition="!Exists('$(_PnixLib)/lib/net8.0/Pnix.Clr.dll')">
    <ProjectReference Include="../../Pnix.Clr/Pnix.Clr.csproj" />
  </ItemGroup>
</Project>
