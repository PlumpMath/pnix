#!/usr/bin/env bash
# Primary gate for hy-meta: self-check + stage7-check (practical peer floor).
# Full ladder (stage8..stagen) is available via bootstrap.py; not default here.
set -euo pipefail
META_DIR="$(cd "$(dirname "$0")/.." && pwd)"
ROOT="$(cd "$META_DIR/.." && pwd)"
cd "$ROOT"

PY="${HY_META_PYTHON:-}"
if [[ -z "$PY" ]]; then
  for candidate in \
    /tmp/pnix-hy-py311-venv/bin/python \
    /tmp/pnix-hy-py314-venv/bin/python \
    /usr/local/bin/python3.11 \
    /usr/local/opt/python@3.14/bin/python3.14; do
    # An executable alone is not a proof host.  Keep looking when a system
    # Python exists but lacks the pinned Hy runtime or parser dependency.
    if [[ -x "$candidate" ]] && \
       "$candidate" -c 'import hy, funcparserlib' 2>/dev/null; then
      PY="$candidate"
      break
    fi
  done
fi
if [[ -z "${PY:-}" ]]; then
  echo "hy-meta-gate: no usable Python 3.11/3.14 proof host found; set HY_META_PYTHON" >&2
  echo "  the interpreter must import the pinned Hy plus funcparserlib" >&2
  exit 2
fi

# The proof interpreter carries the flake-pinned Hy 1.3.1 plus dependencies.
# Native Hy source corpora are materialized separately under ROOT/tests.
if ! "$PY" -c 'import hy, funcparserlib' 2>/dev/null; then
  echo "hy-meta-gate: need hy + funcparserlib on $PY" >&2
  echo "  e.g. $PY -m pip install 'hy==1.3.1' 'funcparserlib~=1.0'" >&2
  echo "  or: /usr/local/bin/python3.11 -m venv /tmp/pnix-hy-py311-venv && ..." >&2
  exit 2
fi

MODE="${1:-primary}"

# self-host-check/bootstrap-fixedpoint-check compile tests/resources/__init__.py
# from the hy-src corpus, which imports pytest -- a dependency this script's own
# `import hy, funcparserlib` probe above doesn't cover. Outside `nix develop`
# (whose shellHook materializes ./tests/ and provides pytest on PATH), this fails
# several frames deep inside a Hy macro-expansion HyRequireError that doesn't
# name pytest as the cause. Check it up front for these two modes only.
case "$MODE" in
  full|self-host-check|bootstrap-fixedpoint-check)
    if [[ ! -e "$ROOT/tests" ]]; then
      echo "hy-meta-gate: $ROOT/tests is missing (needed by self-host-check /" >&2
      echo "  bootstrap-fixedpoint-check). Enter 'nix develop' once to materialize" >&2
      echo "  it from the pinned hy-src input, then re-run (works outside the" >&2
      echo "  devShell afterward)." >&2
      exit 2
    fi
    if ! "$PY" -c 'import pytest' 2>/dev/null; then
      echo "hy-meta-gate: $PY has no pytest (needed by self-host-check /" >&2
      echo "  bootstrap-fixedpoint-check, via tests/resources/__init__.py)." >&2
      echo "  Run inside 'nix develop' (its python has pytest), or set" >&2
      echo "  HY_META_PYTHON to an interpreter that does." >&2
      exit 2
    fi
    ;;
esac
case "$MODE" in
  primary|self-check)
    "$PY" hy-meta/bootstrap.py self-check
    if [[ "$MODE" == "primary" ]]; then
      "$PY" hy-meta/bootstrap.py stage7-check
    fi
    echo "hy-meta-gate ($MODE): PASS"
    ;;
  stage7)
    "$PY" hy-meta/bootstrap.py stage7-check
    echo "hy-meta-gate (stage7): PASS"
    ;;
  full)
    # Documented high ladder subset; still not claiming Stage15 replacement.
    for cmd in self-check chain-check stage7-check self-host-check bootstrap-fixedpoint-check; do
      echo "[hy-meta-gate] $cmd"
      "$PY" hy-meta/bootstrap.py "$cmd"
    done
    echo "hy-meta-gate (full subset): PASS"
    ;;
  *)
    echo "usage: hy-meta-gate [primary|self-check|stage7|full]" >&2
    exit 2
    ;;
esac
