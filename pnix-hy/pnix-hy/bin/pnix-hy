#!/usr/bin/env python3
"""Thin shim: the developer CLI lives in pnix_hy/cli.py (so it is importable and works as
a console_scripts entry point). This wrapper just makes `bin/pnix-hy` runnable from
a source checkout without installing."""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from pnix_hy.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
